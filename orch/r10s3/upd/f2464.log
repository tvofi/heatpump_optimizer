2026-10-20T00:16:23.0326072Z ##[group]Run if [ "pull_request" = "pull_request" ]; then
2026-10-20T00:16:23.0326563Z if [ "pull_request" = "pull_request" ]; then
2026-10-20T00:16:23.0326959Z   # The PR's merge-base with its target: exactly the code this
2026-10-20T00:16:23.0327760Z   # PR forked from, so the drift comparison isolates the PR.
2026-10-20T00:16:23.0328153Z   REF=$(git merge-base "origin/main" HEAD)
2026-10-20T00:16:23.0328533Z   # The branch's OWN claim list is read from the PR head, not the
2026-10-20T00:16:23.0328994Z   # synthetic merge tree this checkout is (env_drift's CLAIM_HEAD).
2026-10-20T00:16:23.0329497Z   echo "CLAIM_HEAD=c4a357e5e3393d2f570e6061d283f680a317947f" >> "$GITHUB_ENV"
2026-10-20T00:16:23.0329941Z elif [ "pull_request" = "merge_group" ]; then
2026-10-20T00:16:23.0330332Z   # A queue entry is a merge commit (merge method MERGE): its first
2026-10-20T00:16:23.0330811Z   # parent is the main tip or the entry ahead of it, its second the
2026-10-20T00:16:23.0331275Z   # pull request's head. That is the shape of a pull request's
2026-10-20T00:16:23.0331923Z   # synthetic merge, whose merge-base with its target is the same
2026-10-20T00:16:23.0332386Z   # first parent, so the drift comparison and the claim list are
2026-10-20T00:16:23.0332836Z   # read exactly as on the pull request. No second parent means the
2026-10-20T00:16:23.0333258Z   # queue's merge method changed; fail rather than guess.
2026-10-20T00:16:23.0333697Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-20T00:16:23.0334154Z   PR_TIP=$(git rev-parse --verify --quiet 'HEAD^2^{commit}') || {
2026-10-20T00:16:23.0334705Z     echo "This merge_group commit has no second parent; the queue must merge with merge method MERGE."
2026-10-20T00:16:23.0335170Z     exit 1
2026-10-20T00:16:23.0335382Z   }
2026-10-20T00:16:23.0335623Z   echo "CLAIM_HEAD=${PR_TIP}" >> "$GITHUB_ENV"
2026-10-20T00:16:23.0335935Z elif [ "" = "true" ]; then
2026-10-20T00:16:23.0336290Z   # Autofix dispatch is not a pull_request event. Compare against
2026-10-20T00:16:23.0336745Z   # main the same way a PR would, not HEAD^1 (the autofix commit's
2026-10-20T00:16:23.0337387Z   # parent), so leftover drift vs main cannot hide.
2026-10-20T00:16:23.0337863Z   git fetch --no-tags origin main
2026-10-20T00:16:23.0338167Z   REF=$(git merge-base origin/main HEAD)
2026-10-20T00:16:23.0338453Z else
2026-10-20T00:16:23.0338729Z   # Push to main: compare against the state before this push.
2026-10-20T00:16:23.0339168Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-20T00:16:23.0339695Z fi
2026-10-20T00:16:23.0339946Z if [ -z "${REF}" ]; then
2026-10-20T00:16:23.0340291Z   # An empty GOLDEN_REF is not "no preference": run.sh and
2026-10-20T00:16:23.0340741Z   # env_drift.py both fall back to origin/main, which on a push to
2026-10-20T00:16:23.0341199Z   # main IS this commit -- the tree would be compared against
2026-10-20T00:16:23.0341642Z   # itself and pass no matter what it did. Fail here instead, where
2026-10-20T00:16:23.0342013Z   # the reason is visible.
2026-10-20T00:16:23.0342369Z   echo "Could not resolve a comparison ref for this pull_request."
2026-10-20T00:16:23.0342831Z   echo "The drift gate needs a baseline that is not this commit;"
2026-10-20T00:16:23.0343262Z   echo "an empty ref silently becomes origin/main == HEAD."
2026-10-20T00:16:23.0343604Z   exit 1
2026-10-20T00:16:23.0343806Z fi
2026-10-20T00:16:23.0344038Z echo "GOLDEN_REF=${REF}" >> "$GITHUB_ENV"
