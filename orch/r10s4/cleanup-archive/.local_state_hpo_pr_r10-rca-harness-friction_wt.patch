+    f"above-min kWh {_sp_above_min_kwh(_sp_fix):.2f} (control "
+    f"{_sp_above_min_kwh(_sp_ctl):.2f}), objective {_sp_fix_obj:.3f} vs {_sp_ctl_obj:.3f}",
