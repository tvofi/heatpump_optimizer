index 000000000..cb39c713a
--- /dev/null
+++ b/dev/audit/harnesses/r10_sav_baseline_mutants.py
@@ -0,0 +1,87 @@
+#!/usr/bin/env python3
+"""R10-SAV-BASELINE (#2255) mutation proof: each mutant applied in turn, the #2255 checks re-run, restored.
+
+The checks are the "3L-G7 -- monthly savings history" section of tests/features.py (which holds
+the #2255 checks), extracted and run alone so a mutant costs minutes, not the full script. Each
+mutant replaces one predicate of the fix with its pre-fix or degenerate form; a mutant no check
+fails is printed with failing=0. M0 is the unmutated null run. Run it on a scratch copy of the
+tree: it rewrites a production file per mutant and restores it in a `finally`.
+
+    PYTHONPATH=tests/hastub:tests:custom_components python3 dev/audit/harnesses/r10_sav_baseline_mutants.py <repo> [M1 M2 ...]
+"""
+import pathlib
+import subprocess
+import sys
+
+ROOT = pathlib.Path(sys.argv[1] if len(sys.argv) > 1 else ".").resolve()
+PKG = ROOT / "custom_components/heatpump_optimizer"
+SECTION = """
+import sys
+sys.path.insert(0, 'tests')
+from datetime import timedelta
+import numpy as np
+from harness import Results
+from profiles import solve_inputs
+R = Results('2255 section')
+src = open('tests/features.py').read()
+start = src.index('R.section("3L-G7 \u2014 monthly savings history")')
+end = src.index('import inspect as _sav_inspect', start)
+exec(compile(src[start:end], 'features_2255', 'exec'))
+sys.exit(R.close('2255'))
+"""
+M = [
+ ("M1 baseline starts from the plan's state", "optimizer.py",
+  "        state = _thermostat_held_state(\n            self.model, initial_state, weather,\n            _baseline_target(comfort_targets, 0, self.config.target_temp),\n        )\n",
+  "        state = initial_state\n"),
+ ("M2 held slab without its demand term", "optimizer.py",
+  "        slab_temperature=target + max(0.0, q_floor) / model.params.slab_heat_transfer_floored,", "        slab_temperature=target,"),
+ ("M3 row actual from savings_actual", "ledger.py",
+  "            actual_sek = self.month_cost(key)\n", '            actual_sek = float(self.line(key, "savings_actual")["sek"])\n'),
+ ("M4 coverage factor -> calendar day", "ledger.py",
+  "            return max(1.0, month_hours(now) / settled)\n", "            return pro_rata_factor(now)\n"),
+ ("M5 savings priced at spot only", "ledger.py",
+  "            spot=spot + fee_per_kwh,\n", "            spot=spot,\n"),
+ ("M6 capacity extrapolated", "ledger.py",
+  "                actual_sek = (actual_sek - capacity) * factor + capacity\n", "                actual_sek = actual_sek * factor\n"),
+ ("M7 metered energy without immersion", "ledger.py",
+  'ENERGY_LINES = ("spot", "immersion")\n', 'ENERGY_LINES = ("spot",)\n'),
+ ("M9 no start settlement (space path)", "optimizer.py",
+  "        ) - self._start_gap_cost(\n            initial_state, weather, comfort_targets, prices, outdoor_temps,\n            space_caps, h.humidity, baseline_cost,  # the space-only reference\n        )\n",
+  "        )\n"),
+ ("M10 start debit unbounded", "optimizer.py",
+  "        return capped - min(surplus_above_caps, max(0.0, space_baseline_cost))", "        return capped - surplus_above_caps"),
+ ("M11 start settled at the caps only", "optimizer.py",
+  "        return capped - min(surplus_above_caps, max(0.0, space_baseline_cost))", "        return capped"),
+ ("M12 DHW path bounds the start by baseline_cost", "optimizer.py",
+  "            float(energy_cost_of(baseline_power)),\n", "            baseline_cost,\n"),
+ ("M13 coverage factor unclamped", "ledger.py",
+  "            return max(1.0, month_hours(now) / settled)\n", "            return month_hours(now) / settled\n"),
+ ("M14 negative thermostat cost unclamped", "optimizer.py",
+  "max(0.0, space_baseline_cost))", "space_baseline_cost)"),
+ ("M15 start surplus unclamped", "optimizer.py",
+  "        surplus_above_caps = max(0.0, capped - uncapped)\n", "        surplus_above_caps = capped - uncapped\n"),
+ ("M16 held slab below target", "optimizer.py",
+  "slab_temperature=target + max(0.0, q_floor) / model.params.slab_heat_transfer_floored,", "slab_temperature=target + q_floor / model.params.slab_heat_transfer_floored,"),
+ ("M8 settled hours never folded", "ledger.py",
+  "        if dt > 0:\n            self.observe_meta_mean(when, SETTLED_HOURS_META, dt)\n",
+  "        if False:\n            self.observe_meta_mean(when, SETTLED_HOURS_META, dt)\n"),
+]
+
+only = sys.argv[2:]
+for name, f, old, new in [("M0 unmutated", "ledger.py", "", "")] + M:
+    if only and name.split()[0] not in only:
+        continue
+    path = PKG / f
+    orig = path.read_text()
+    if old:
+        assert orig.count(old) == 1, name
+        path.write_text(orig.replace(old, new))
+    try:
+        out = subprocess.run([sys.executable, "-c", SECTION], cwd=ROOT, capture_output=True, text=True,
+                             env={"PYTHONPATH": "tests/hastub:tests:custom_components", "PATH": "/usr/bin:/bin"})
+    finally:
+        path.write_text(orig)
+    fails = [l.strip() for l in out.stdout.splitlines() if l.strip().startswith("FAIL")]
+    print(f"{name}: rc={out.returncode} failing={len(fails)}", flush=True)
+    for l in fails:
+        print(f"    {l[:150]}", flush=True)
diff --git a/dev/audit/harnesses/r10_sav_null_terms.py b/dev/audit/harnesses/r10_sav_null_terms.py
new file mode 100644
index 000000000..484554ff7
--- /dev/null
+++ b/dev/audit/harnesses/r10_sav_null_terms.py
@@ -0,0 +1,74 @@
+#!/usr/bin/env python3
+"""R10-SAV-BASELINE (#2255) round 2: the flat-price null's residual, split into its terms.
+
+WHY IT EXISTS. ``r10_sav_baseline.py null`` reads 10.83 % saved on a flat
+price with the plant equal to the model. The PR #2411 reviewer wrote this probe
+(round 1, 2026-10-18) to show that residual is not one term: it replays the
+harness's null loop exactly and prices a steady thermostat both at the comfort
+target and at the room the plan delivered, through the production
+``_floor_demand_at_target`` and ``compute_cop``. It is kept here, as the
+reviewer wrote it, so the carry's owner (R10-ADVISOR) re-takes the terms
+at its own head. Three terms:
+
+  comfort  steady thermostat at target less steady at the delivered room.
+  timing   the plan's power-weighted COP against the thermostat's: at a flat
+           price COP still varies with the outdoor temperature, so buying in
+           the warmer hours is a real saving, not an accounting artefact.
+  stored   the house's stored-heat change over the window, which the month
+           row does not settle (only ``predicted_savings`` does).
+
+The ``const`` arm holds the outdoor temperature at the window's mean. Timing
+then reads +0.00 %, which is the control that separates it from comfort.
+
+    PYTHONPATH=tests/hastub:tests:custom_components python3 dev/audit/harnesses/r10_sav_null_terms.py [const]
+"""
+import sys
+sys.path.insert(0, "dev/audit/harnesses")
+from datetime import timedelta
+import numpy as np
+import r10_sav_baseline as h
+from heatpump_optimizer.optimizer import _floor_demand_at_target
+from heatpump_optimizer.thermal_model import WeatherSeries
+from profiles import DT, prices, solve_inputs, weather
+
+CONST_OUTDOOR = sys.argv[1:2] == ["const"]
+opt, model, _ = h._optimizer()
+days, replan = 2, 4
+total = int(days * 24 / DT); span = total + int(24 / DT) + 4
+tile = lambda a: np.tile(np.asarray(a, float), int(np.ceil(span / len(a))))[:span]
+pr = tile(prices("flat", h.START)); out, wind, rain, sol = (tile(a) for a in weather("winter_cold", h.START))
+if CONST_OUTDOOR:
+    out = np.full_like(out, float(np.mean(out[:int(days * 24 / DT)])))
+hs = int(24 / DT); state = h._state(21.0, 22.0, float(out[0])); plan = None; s0 = (state.room_temperature, state.slab_temperature); th_b = 0.0; copw = 0.0
+kp = kb = ea = eb = 0.0
+for k in range(total):
+    now = h.START + timedelta(hours=k * DT)
+    if k % replan == 0:
+        plan = opt.optimize(inputs=solve_inputs(initial_state=state, prices=pr[k:k+hs], outdoor_temps=out[k:k+hs],
+            wind_speeds=wind[k:k+hs], precipitation=rain[k:k+hs], solar_radiation=sol[k:k+hs], start_time=now))
+    o = k % replan; p = float(plan.power_schedule[o])
+    kp += p * DT; kb += float(plan.baseline_power_schedule[o]) * DT
+    tgt = opt.config.get_comfort_temp(now.hour + now.minute / 60.0, when=now)
+    cop = model.compute_cop(float(out[k]))
+    copw += p * cop; th_bw = globals().get('th_bw', 0.0) + float(plan.baseline_power_schedule[o]) * cop; globals()['th_bw'] = th_bw
+    room_before = state.room_temperature
+    room, slab, up, lo, *_ = model.simulate_trajectory(initial_state=state, power_schedule=np.array([p]),
+        weather=WeatherSeries(outdoor_temps=out[k:k+1], wind_speeds=wind[k:k+1], precipitation=rain[k:k+1],
+        solar_radiation=sol[k:k+1]), dt_hours=DT)
+    room_mid = 0.5 * (room_before + float(room[-1]))
+    args = (float(out[k]), float(wind[k]), float(rain[k]), float(sol[k]))
+    ea += max(0.0, _floor_demand_at_target(model, tgt, *args)) / cop * DT
+    eb += max(0.0, _floor_demand_at_target(model, room_mid, *args)) / cop * DT
+    th_b += max(0.0, _floor_demand_at_target(model, room_mid, *args)) * DT
+    state = h._state(float(room[-1]), float(slab[-1]), float(out[k]))
+    state.upper_floor_temperature = float(up[-1]); state.lower_floor_temperature = float(lo[-1])
+print(f"RESULT probe booked_thermostat_kwh {kb:.1f} plan_kwh {kp:.1f} gap {kb-kp:.1f}")
+print(f"RESULT probe steady_at_target_kwh {ea:.1f} steady_at_delivered_room_kwh {eb:.1f} comfort_gap {ea-eb:.1f}")
+print(f"RESULT probe plan_vs_steady_at_delivered_room {kp-eb:+.1f} kWh ({(eb-kp)/ea*100:+.2f} % of steady_at_target)")
+pm = model.params
+drain = pm.room_thermal_mass * (s0[0] - state.room_temperature) + pm.slab_thermal_mass * (s0[1] - state.slab_temperature)
+print(f"RESULT probe start room/slab {s0[0]:.2f}/{s0[1]:.2f} end {state.room_temperature:.2f}/{state.slab_temperature:.2f} stored_heat_drawn_kwh_th {drain:.1f}")
+print(f"RESULT probe thermal_loss_at_delivered_room_kwh_th {th_b:.1f}; plan_effective_cop {(th_b - drain)/kp:.3f} vs steady_cop {th_b/eb:.3f}")
+print(f"RESULT probe drawdown_at_steady_cop_kwh_e {drain/(th_b/eb):.1f}")
+print(f"RESULT probe power_weighted_cop plan {copw/kp:.3f} thermostat {th_bw/kb:.3f} (outdoor-timing gain {(copw/kp)/(th_bw/kb)*100-100:+.2f} %)")
+print(f"RESULT probe outdoor min/max over loop {float(np.min(out[:total])):.1f}/{float(np.max(out[:total])):.1f} C; thermal_delivered_by_plan_at_its_cop {copw*DT:.1f} kWh_th vs loss+charge {th_b - drain:.1f}")
diff --git a/dev/audit/harnesses/r10_savings_upgrade_month.py b/dev/audit/harnesses/r10_savings_upgrade_month.py
