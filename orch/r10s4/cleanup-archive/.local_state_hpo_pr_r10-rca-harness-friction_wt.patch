new file mode 100755
index 000000000..64c9bfe5a
--- /dev/null
+++ b/dev/audit/harnesses/r10_train_raise_hold_replay.py
@@ -0,0 +1,173 @@
+#!/usr/bin/env python3
+"""R10-TRAIN-RAISE-HOLD (#2401): replay the train's raise reading on live pull requests.
+
+    python3 dev/audit/harnesses/r10_train_raise_hold_replay.py PR[:BASE] [PR[:BASE] ...]
+    python3 dev/audit/harnesses/r10_train_raise_hold_replay.py --self-test
+
+For each pull request, at its live head and three-dot from origin/main (or
+from BASE, for one main already holds: #2401 merged at 07a09406a, its base
+was 176851e950), prints two readings of "is this a budget raise":
+
+  path     the defect's rule, as merge_train.py's approve and
+           queue_pre_flight.py applied it before the fix: any changed path
+           ending `_budgets.json` is a raise;
+  gate     `Train.raise_hold`, the fix: budget_raise_gate's own
+           `raises_between` from the merge base, then -- on a raise only --
+           the owner's approval at the head with the body's justification and
+           the mandate judged now, exactly as approve and pre-flight read it.
+
+Read-only: it fetches the head and calls `gh` read APIs; it never pushes,
+approves, comments or merges. A read that fails prints the train's own Stop
+and the exit status is 1: every read here (`gh pr view`, `git fetch`, `git
+merge-base`, `git diff`) is checked on its return code, and the head and the
+base must each be a 40-hex object name before anything is read from them. The
+reading used to take `t.out`'s text for the value, so an unauthenticated gh
+(HTTP 403) became the "head", the diff became error words, `raise_hold` took
+its cheap no-budget-file exit and a real raise (#2368) printed
+"0 raise(s), HOLDS" -- the fail-open shape this PR closes in the train.
+`--self-test` plants each failing read and a healthy control.
+"""
+import sys
+import tempfile
+from pathlib import Path
+
+
+
+def repo_root(start):
+    """The directory holding custom_components/heatpump_optimizer/manifest.json."""
+    from pathlib import Path
+    here = Path(start).resolve()
+    if here.is_file():
+        here = here.parent
+    marker = Path("custom_components") / "heatpump_optimizer" / "manifest.json"
+    for cand in (here, *here.parents):
+        if (cand / marker).is_file():
+            return cand
+    raise RuntimeError(f"no repository root above {start}")
+
+
+ROOT = repo_root(__file__)
+sys.path.insert(0, str(ROOT / "tools/audit/seat"))
+import merge_train as mt  # noqa: E402
+
+
+class ReadFailed(Exception):
+    """A read the replay depends on failed: the value is unknown, never a hold."""
+
+
+def read(t, what: str, *argv: str) -> str:
+    """The stdout of <argv>, or ReadFailed: a non-zero rc is a failed read."""
+    rc, text = t.run(list(argv))
+    if rc != 0:
+        raise ReadFailed(f"{what} failed (rc={rc}): {text.strip()[:120]}")
+    return text.strip()
+
+
+def sha(t, what: str, *argv: str) -> str:
+    v = read(t, what, *argv)
+    if not mt.is_sha(v):
+        raise ReadFailed(f"{what} is not a 40-hex object name: {v[:60]!r}")
+    return v
+
+
+def replay(t, pr: int, at: str) -> int:
+    """Print the two readings for <pr>; 0, or 1 when a read failed."""
+    try:
+        h = sha(t, "gh pr view headRefOid", "gh", "pr", "view", str(pr), "--repo", t.repo,
+                "--json", "headRefOid", "--jq", ".headRefOid")
+        read(t, "git fetch", "git", "fetch", "-q", "origin", "main", h)
+        base = sha(t, "git merge-base", "git", "merge-base", at or "origin/main", h)
+        files = read(t, "git diff", "git", "diff", "--no-renames", "--name-only", base, h).split()
+    except ReadFailed as e:
+        print(f"#{pr}")
+        print(f"  gate : STOP read: {e}")
+        return 1
+    path = [f for f in files if f.endswith("_budgets.json")]
+    print(f"#{pr} head {h[:12]} base {base[:12]}")
+    print(f"  path : {'RAISE' if path else 'none'} ({', '.join(path) or 'no budget path'})")
+    if at:  # raise_hold reads the merge base with origin/main; answer it with BASE's
+        real = t.run
+
+        def run(argv, cwd=mt.ROOT, stdin=None, real=real, base=base):
+            if argv[:3] == ["git", "merge-base", "origin/main"]:
+                return 0, base + "\n"
+            return real(argv, cwd=cwd, stdin=stdin)
+        t.run = run
+    try:
+        raises, held, why = t.raise_hold(pr, h, files)
+        print(f"  gate : {len(raises)} raise(s), {'HOLDS' if held else 'STOPS'}: {why}")
+    except mt.Stop as s:
+        print(f"  gate : STOP {s.step}: {s.why}")
+    return 0
+
+
+def main(argv: "list[str]") -> int:
+    if argv == ["--self-test"]:
+        return self_test()
+    if not argv or not all(a.split(":")[0].isdigit() for a in argv):
+        print(__doc__)
+        return 2
+    rc = 0
+    with tempfile.TemporaryDirectory() as d:
+        t = mt.Train("tvofi/heatpump_optimizer", Path(d), None, "", (), 1)
+        for arg in argv:
+            pr, _, at = arg.partition(":")
+            t.run = t._run  # a BASE answers its own entry only
+            rc |= replay(t, int(pr), at)
+    return rc
+
+
+def self_test() -> int:
+    """Plant each failing read; a healthy control must still print the hold."""
+    import contextlib
+    import io
+    H, B = "a" * 40, "b" * 40
+    ok = {"gh": (0, H + "\n"), "fetch": (0, ""), "merge-base": (0, B + "\n"),
+          "diff": (0, "tests/stress_budgets.json\n")}
+
+    def drive(fail: "dict[str, tuple[int, str]]"):
+        answers = {**ok, **fail}
+
+        class T:
+            repo = "o/r"
+
+            def run(self, argv, cwd=None, stdin=None):
+                key = argv[0] if argv[0] == "gh" else argv[1]
+                return answers[key]
+
+            def raise_hold(self, pr, h, files):
+                return [], True, "no budget raise (planted)"
+        buf = io.StringIO()
+        with contextlib.redirect_stdout(buf):
+            rc = replay(T(), 2368, "")
+        return rc, buf.getvalue()
+
+    bad = 0
+
+    def check(name: str, cond: bool) -> None:
+        nonlocal bad
+        print(("  ok   " if cond else "  FAIL ") + name)
+        bad += 0 if cond else 1
+    rc, out = drive({})
+    check("null control: every read healthy prints the train's reading and exits 0",
+          rc == 0 and "HOLDS" in out and "path : RAISE" in out)
+    for name, key, bodyv in (
+            ("gh unauthenticated (HTTP 403)", "gh", (1, "HTTP 403: Forbidden")),
+            ("git fetch failing", "fetch", (128, "fatal: unable to access")),
+            ("git merge-base failing", "merge-base", (1, "fatal: Not a valid object")),
+            ("git diff failing", "diff", (128, "fatal: bad object"))):
+        rc, out = drive({key: bodyv})
+        check(f"{name} prints a Stop and exits non-zero, never a hold",
+              rc == 1 and "STOP read" in out and "HOLDS" not in out and "path :" not in out)
+    rc, out = drive({"gh": (0, "HTTP 403: Gi\n")})
+    check("a head that is not 40-hex is a Stop even when gh exits 0",
+          rc == 1 and "STOP read" in out and "HOLDS" not in out)
+    rc, out = drive({"merge-base": (0, "fatal: Not a\n")})
+    check("a base that is not 40-hex is a Stop even when git exits 0",
+          rc == 1 and "STOP read" in out and "HOLDS" not in out)
+    print(f"replay self-test: {bad} failed")
+    return 1 if bad else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
diff --git a/dev/audit/harnesses/r10_trust_relative_bundle.py b/dev/audit/harnesses/r10_trust_relative_bundle.py
new file mode 100644
index 000000000..cbb987cf5
--- /dev/null
+++ b/dev/audit/harnesses/r10_trust_relative_bundle.py
@@ -0,0 +1,129 @@
+#!/usr/bin/env python3
+"""The heat-loss learners' step on an install's own stores, reseeded or not (#2252).
+
+Written by the R10-TRUST-RELATIVE fixer. STUDY R10-RESEED found the learner's
+trust region fixed in multiplier units: a saturated step is ``base_u *
+trust_region`` in UA, so it grows with learned/prior, and moving the learned
+value into the settings (a reseed) changed nothing but the step size. This
+drives the production step (``thermal_model.learner_newton_step``, the
+coordinator's own constants, the ``_apply_*`` bounds) on the configuration
+and learned state of a diagnostics bundle, per learner, in paired arms on one
+noise stream:
+
+  * ``as_is``    -- base = the configured nameplate, current = the learned value;
+  * ``reseeded`` -- base = nameplate x learned, current = 1.0 (settings match
+    the learned values: the forward-carried null control);
+  * ``zero_evidence`` -- current = 1.0 and the truth is the nameplate (an
+    install with no evidence);
+  * ``at_min`` / ``at_max`` -- current on the ``_apply_*`` clamp, truth there.
+
+The plant is the learner's own linear relation: an interval's residual is
+``(U_cur - U_true) * dT * dt / C`` plus Gaussian sensor noise, so the learned
+value is right (U_true = base x current) and every arm should hold it. Per
+arm it prints the effective UA's std and RMSE against the truth (W/K) and the
+one-step forecast MAE (degC, the |residual| the learner sees); per learner
+the reseeded/as-is ratios. Expected: ratios exactly 1.0000 once the trust
+region is relative; != 1 at a baseline whose trust region is fixed.
+Perturbation: ``--trust-region 1e9`` (the study's) collapses the ratios to
+1.0000 at either tree. Null control: ``--learned 1.0`` (prior already right)
+reads ratios of 1.0000 at either tree.
+
+The bundle is given on the command line and never committed (a user's
+private data). Run from a worktree root, at the base and at the head:
+
+    PYTHONPATH=tests/hastub:custom_components \\
+        python3 dev/audit/harnesses/r10_trust_relative_bundle.py BUNDLE.json
+"""
+from __future__ import annotations
+
+import argparse
+import json
+
+import numpy as np
+
+from heatpump_optimizer import coordinator as coord_mod
+from heatpump_optimizer.const import (
+    HOUSE_HEAT_LOSS_SCALE_MAX,
+    HOUSE_HEAT_LOSS_SCALE_MIN,
+    LOWER_FLOOR_LOSS_RATIO_MAX,
+    LOWER_FLOOR_LOSS_RATIO_MIN,
+)
+from heatpump_optimizer.thermal_model import ThermalParameters, learner_newton_step
+
+
+def walk(base_u, capacity, current, truth_u, noise, delta_t, dt_h, bounds, trust_region):
+    """The learner's walk on one noise stream; (UA path, |residual| path)."""
+    ua, err = [], []
+    for n in noise:
+        resid = (base_u * current - truth_u) * delta_t * dt_h / capacity + n
+        err.append(abs(resid))
+        if abs(resid) <= coord_mod.HOUSE_LOSS_MAX_RESIDUAL:
+            step = learner_newton_step(
+                current, base_u, capacity, resid, delta_t, dt_h,
+                trust_region=trust_region,
+                alpha=coord_mod.HOUSE_LOSS_ALPHA,
+            )
+            if step is not None:
+                current = float(np.clip(step[1], *bounds))
+        ua.append(base_u * current)
+    return np.asarray(ua), np.asarray(err)
+
+
+def arms(name, base_u, capacity, learned, bounds, noise, a):
+    truth = base_u * learned
+    lo, hi = bounds
+    spec = {
+        "as_is": (base_u, learned, truth),
+        "reseeded": (truth, 1.0, truth),
+        "zero_evidence": (base_u, 1.0, base_u),
+        "at_min": (base_u, lo, base_u * lo),
+        "at_max": (base_u, hi, base_u * hi),
+    }
+    out = {}
+    for arm, (b, cur, t) in spec.items():
+        ua, err = walk(b, capacity, cur, t, noise, a.delta_t, a.dt_hours, bounds, a.trust_region)
+        out[arm] = {
+            "ua_std_w_per_k": float(np.std(ua)) * 1000.0,
+            "ua_rmse_w_per_k": float(np.sqrt(np.mean((ua - t) ** 2))) * 1000.0,
+            "fc_mae_c": float(np.mean(err)),
+        }
+        for k, v in out[arm].items():
+            print(f"RESULT {name}.{arm}.{k}={v:.6f}")
+    for k in ("ua_std_w_per_k", "ua_rmse_w_per_k", "fc_mae_c"):
+        print(f"RESULT {name}.ratio_reseeded_over_as_is.{k}="
+              f"{out['reseeded'][k] / out['as_is'][k]:.4f}")
+    return out
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("bundle")
+    ap.add_argument("--samples", type=int, default=4000)
+    ap.add_argument("--sigma", type=float, default=0.1, help="sensor noise, degC")
+    ap.add_argument("--delta-t", type=float, default=20.0, help="indoor-outdoor, K")
+    ap.add_argument("--dt-hours", type=float, default=0.25)
+    ap.add_argument("--seed", type=int, default=2252)
+    ap.add_argument("--learned", type=float, default=None,
+                    help="override both learned values (null control: 1.0)")
+    ap.add_argument("--trust-region", type=float, default=coord_mod._LEARNER_TRUST_REGION)
+    a = ap.parse_args()
+    with open(a.bundle) as fh:
+        data = json.load(fh)["data"]
+    th = next(v for k, v in data["debug"]["stores"].items() if k.endswith("_thermal_learning"))
+    s = float(th["house_heat_loss_scale"]) if a.learned is None else a.learned
+    r = float(th["lower_floor_loss_ratio"]) if a.learned is None else a.learned
+    p = ThermalParameters.from_config(dict(data["config"]))
+    print(f"trust_region={a.trust_region} learned_scale={s:.4f} learned_ratio={r:.4f} "
+          f"two_zone={p.two_zone_enabled} samples={a.samples} sigma={a.sigma}")
+    rng = np.random.default_rng(a.seed)
+    noise = rng.normal(0.0, a.sigma, a.samples)
+    base_u, capacity = coord_mod._house_loss_terms(p)
+    arms("house", base_u, capacity, s,
+         (HOUSE_HEAT_LOSS_SCALE_MIN, HOUSE_HEAT_LOSS_SCALE_MAX), noise, a)
+    if p.two_zone_enabled:
+        arms("lower", p.lower_floor_heat_loss * s, p.lower_floor_thermal_mass, r,
+             (LOWER_FLOOR_LOSS_RATIO_MIN, LOWER_FLOOR_LOSS_RATIO_MAX), noise, a)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/dev/audit/harnesses/r10_vent_bias_window.py b/dev/audit/harnesses/r10_vent_bias_window.py
new file mode 100644
index 000000000..cad925b05
--- /dev/null
+++ b/dev/audit/harnesses/r10_vent_bias_window.py
@@ -0,0 +1,199 @@
+"""R10-VENT-DETECTOR (#2241, D2-s3-72): does the open-window detector separate
+a persistent model bias from a planted open window?
+
+Metric (one line each, per scenario):
+  false_share = share of 15-min intervals OUTSIDE any planted window after
+      which the PRODUCTION ``_learning_frozen(indoor, outdoor)`` returns
+      "ventilation" (the freeze the finder counted, with the real freeze in
+      place, so a self-latch shows);
+  detect_h    = hours from a planted window opening to the first interval
+      frozen "ventilation" (nan: never inside the window);
+  release_h   = hours from the window closing to the first interval not
+      frozen (nan: still frozen at the end);
+  held_share  = share of the window's intervals from detection to closing
+      that stay frozen (a level that absorbs the window releases early);
+  longest_false_h = the longest unbroken freeze outside any window, hours
+      (a self-latch reads as days);
+  ua_bias     = learned effective UA over the last 3 days / true UA - 1.
+
+Command (tree root):
+    PYTHONPATH=tests/hastub python3 dev/audit/harnesses/r10_vent_bias_window.py [--days 14] [--seeds 2]
+
+Scenarios: delivery g in {1.0, 0.6, 0.4} (the plant receives g x the commanded
+power the model replays: a meter or COP off by 1/g), UA truth 1.0 or 1.6 x the
+prior (or a drop to g on day 4: a fault arriving mid-life), power by a smooth feed-forward + P loop ("pi") or a hysteresis on/off
+thermostat ("onoff", full power in blocks: the hardest shape for a bias that is
+proportional to power), with no window or a planted one (an extra ``vent_w_k``
+W/K on the sensed upper zone, opened on day 10 at 18:00 for ``hours``; the
+sizes are ``WINDOWS``). false_onsets_h lists the hours (from the start) at
+which a freeze outside the window began.
+
+Plant: the catch-up verifier's two-zone house (tests/profiles.py:house(two_zone=True),
+radiators on the sensed upper zone), same weather and loop as
+dev/audit/rounds/round10/catchup/study/learner_v2.py --two-zone.
+Instrumented symbols (driven, none re-implemented):
+    heatpump_optimizer.coordinator:HeatPumpOptimizerCoordinator._async_learn_house_heat_loss
+    heatpump_optimizer.coordinator:HeatPumpOptimizerCoordinator._async_learn_lower_floor_loss
+    heatpump_optimizer.coordinator:HeatPumpOptimizerCoordinator._learning_frozen
+    heatpump_optimizer.thermal_model:ThermalModel.simulate_step (plant)
+Null control: g 1.0, UA 1.0, no window -> false_share 0.
+Perturbation: the planted window -> detect_h finite on every arm at g 1.0; and
+    g 1.0 -> 0.4 is the finding's own perturbation of false_share.
+"""
+import os
+
+for _v in ("OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
+           "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS"):
+    os.environ.setdefault(_v, "1")
+
+import argparse  # noqa: E402
+import asyncio  # noqa: E402
+import math  # noqa: E402
+import sys  # noqa: E402
+from dataclasses import replace  # noqa: E402
+from datetime import datetime, timedelta  # noqa: E402
+
+sys.path.insert(0, "tests")
+sys.path.insert(0, "custom_components")
+
+import numpy as np  # noqa: E402
+
+from harness import FakeEntry, FakeHass  # noqa: E402
+from homeassistant.util import dt as dt_util  # noqa: E402
+from profiles import house  # noqa: E402
+
+from heatpump_optimizer.coordinator import HeatPumpOptimizerCoordinator  # noqa: E402
+from heatpump_optimizer.thermal_model import ThermalModel, ThermalParameters, ThermalState  # noqa: E402
+
+DT = 0.25
+START = datetime(2026, 10, 1, 0, 0)
+KEYS = ("indoor_temp_entity", "outdoor_temp_entity")
+WINDOW_DAY, WINDOW_HOUR = 10, 18.0
+#: (extra W/K on the upper zone, hours open). The upper zone's own UA is
+#: 100 W/K here, so 300 W/K is a window opened wide for airing and 150 W/K a
+#: tilted one; 100 W/K moves the residual (~0.13 K per 15 min at dT 16 K)
+#: barely past the CUSUM's per-sample drift allowance, below its reach.
+WINDOWS = ((0.0, 0.0), (300.0, 2.0), (300.0, 8.0), (300.0, 12.0), (150.0, 4.0), (100.0, 8.0))
+#: (delivery g, UA truth / prior, day the delivery drops from 1.0 to g or
+#: None for g from the start). The step is a meter or COP fault arriving
+#: mid-life: a persistent bias whose onset looks exactly like a window's.
+SCENARIOS = ((1.0, 1.0, None), (0.6, 1.0, None), (0.4, 1.0, None), (1.0, 1.6, None), (0.4, 1.0, 4))
+
+
+def cfg_base():
+    c = house(two_zone=True, dhw=False, buffer_tank_volume=0.0, house_heat_loss_coefficient=0.18,
+              window_area=15.0, heat_pump_max_power=6.0, heat_pump_min_power=0.0,
+              target_temperature=21.0)
+    c["lower_floor_temp_entity"] = "sensor.synthetic_lower"
+    return c
+
+
+def ua_of(p, c):
+    return (p.upper_floor_heat_loss + p.lower_floor_heat_loss * c._lower_floor_loss_ratio) * c._house_heat_loss_scale
+
+
+def run(days, seed, delivery, ua_true, control, vent_w_k, hours, step_day=None):
+    cfg = cfg_base()
+    truth = ThermalParameters.from_config(cfg)
+    truth.dhw_enabled = False
+    truth.heat_loss_coefficient *= ua_true
+    truth.upper_floor_heat_loss *= ua_true
+    truth.lower_floor_heat_loss *= ua_true
+    plant = ThermalModel(truth)
+    vented = ThermalModel(replace(truth, upper_floor_heat_loss=truth.upper_floor_heat_loss + vent_w_k / 1000.0))
+    prior = ThermalParameters.from_config(cfg)
+    prior_m = ThermalModel(prior)
+    c = HeatPumpOptimizerCoordinator(FakeHass(), FakeEntry(data=cfg))
+    p = ThermalParameters.from_config(cfg)
+    p.dhw_enabled = False
+    c._thermal_params = p
+    c._thermal_model = ThermalModel(p)
+    rng = np.random.default_rng(seed)
+    n = int(days * 24 / DT)
+    w0 = int((WINDOW_DAY * 24 + WINDOW_HOUR) / DT)
+    w1 = w0 + int(hours / DT) if vent_w_k > 0 else w0
+    clear = rng.uniform(0.2, 1.0, size=days + 2)
+    st = ThermalState(room_temperature=21.0, slab_temperature=22.0, outdoor_temperature=5.0)
+    ar = 0.0
+    on = False
+    frozen = []
+    ua = []
+    loop = asyncio.new_event_loop()
+    for i in range(n):
+        now = START + timedelta(hours=i * DT)
+        h = (i * DT) % 24.0
+        ar = 0.9 * ar + rng.normal(0, 0.2)
+        t_out = 5.0 + 4.0 * math.cos(2 * math.pi * (h - 15) / 24) + ar
+        irr = 450.0 * max(0.0, math.sin(math.pi * (h - 7) / 10)) * clear[int(i * DT / 24)]
+        sensed = st.upper_floor_temperature + rng.normal(0, 0.05)
+        if control == "onoff":
+            on = sensed < 20.7 if not on else sensed < 21.3
+            power = 6.0 if on else 0.0
+        else:
+            cop = prior_m.compute_cop(t_out)
+            ff = (prior.upper_floor_heat_loss + prior.lower_floor_heat_loss) * max(21.0 - t_out, 0.0) / max(cop, 1.0)
+            power = float(np.clip(ff + 2.0 * (21.0 - sensed), 0.0, 6.0))
+        seen = replace(st, room_temperature=sensed, upper_floor_temperature=sensed,
+                       lower_floor_temperature=st.lower_floor_temperature + rng.normal(0, 0.05),
+                       outdoor_temperature=t_out, solar_radiation=irr)
+        dt_util.freeze(now)
+        c._current_state = seen
+        c._weather_forecast = [{"wind_speed": 0.0, "precipitation": 0.0}]
+        loop.run_until_complete(c._async_learn_lower_floor_loss())
+        loop.run_until_complete(c._async_learn_house_heat_loss())
+        c._refresh_model_corrections()
+        c._current_action = {"power": power, "dhw_power": 0.0}
+        ua.append(ua_of(p, c))
+        frozen.append(type(c)._learning_frozen(c, *KEYS) == "ventilation")
+        m = vented if w0 <= i < w1 else plant
+        g = delivery if step_day is None or i >= step_day * 24 / DT else 1.0
+        st = m.simulate_step(replace(st, solar_radiation=irr), power * g, t_out,
+                             solar_radiation=irr, dt_hours=DT, hour_of_day=h)
+    dt_util.freeze(None)
+    loop.close()
+    ua_t = truth.upper_floor_heat_loss + truth.lower_floor_heat_loss
+    last = int(3 * 24 / DT)
+    # The learners see interval i's state at step i, so the window's first
+    # effect is read at step w0 + 1; a release is read at w1 + 1 onwards.
+    in_window = (lambda j: w0 < j <= w1 + int(24 / DT)) if vent_w_k > 0 else (lambda j: False)
+    outside = [f for j, f in enumerate(frozen) if not in_window(j)]
+    onsets = [j for j in range(1, n) if frozen[j] and not frozen[j - 1] and not in_window(j)]
+    detect = next((j for j in range(w0 + 1, w1 + 1) if frozen[j]), None) if vent_w_k > 0 else None
+    release = next((j for j in range(w1 + 1, n) if not frozen[j]), None) if vent_w_k > 0 else None
+    held = frozen[detect:w1 + 1] if detect is not None else []
+    longest, cur = 0, 0
+    for j, f in enumerate(frozen):
+        cur = cur + 1 if (f and not in_window(j)) else 0
+        longest = max(longest, cur)
+    return {
+        "false_share": sum(outside) / len(outside),
+        "detect_h": (detect - w0) * DT if detect is not None else float("nan"),
+        "release_h": (release - w1) * DT if release is not None else float("nan"),
+        "ua_bias": float(np.mean(ua[-last:]) / ua_t - 1.0),
+        "false_onsets_h": [round(j * DT, 2) for j in onsets],
+        "held_share": (sum(held) / len(held)) if held else float("nan"),
+        "longest_false_h": longest * DT,
+    }
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--days", type=int, default=14)
+    ap.add_argument("--seeds", type=int, default=2)
+    a = ap.parse_args()
+    for seed in range(1, a.seeds + 1):
+        for control in ("pi", "onoff"):
+            for g, ua_t, step in SCENARIOS:
+                for vent, hours in WINDOWS:
+                    r = run(a.days, seed, g, ua_t, control, vent, hours, step)
+                    st = f".step{step}" if step is not None else ""
+                    tag = f"seed{seed}.{control}.g{g}{st}.ua{ua_t}.vent{vent:.0f}x{hours:.0f}h"
+                    print(f"RESULT {tag} false_share={r['false_share']:.3f} detect_h={r['detect_h']:.2f} "
+                          f"held_share={r['held_share']:.2f} release_h={r['release_h']:.2f} "
+                          f"longest_false_h={r['longest_false_h']:.2f} ua_bias={r['ua_bias']:+.4f} "
+                          f"false_onsets_h={r['false_onsets_h'][:6]}", flush=True)
+    print(f"RESULT load1={os.getloadavg()[0]:.2f}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/dev/audit/harnesses/r10_vent_probe_companion.py b/dev/audit/harnesses/r10_vent_probe_companion.py
new file mode 100644
index 000000000..6da5450f6
--- /dev/null
+++ b/dev/audit/harnesses/r10_vent_probe_companion.py
@@ -0,0 +1,100 @@
+"""Companion to the round-10 P5 sweep instruments for #2241 (D2-s3-72).
+
+Both finder instruments read flat across the fix, because each is keyed to
+the instance rather than the property:
+  dev/audit/rounds/round10/D14/sweep-P5/probe_vent_bias.py builds a bare
+      ``drift.Cusum(threshold, drift, side=-1)`` -- the primitive's default,
+      which the fix leaves alone (the COP-health watch uses it);
+  dev/audit/rounds/round10/D14/sweep-P5/enumerate.py marks a Cusum an
+      instance when its ``.update()`` argument names "residual" -- a name the
+      fix rightly keeps, since the residual stays the detector's signal.
+This applies the tree's own rule to the probe's inputs.
+
+Part 1 (the probe's series, through the coordinator's OWN detector): a fresh
+real coordinator per arm, its ``_vent_cusum`` fed 96 x 15-min samples of a
+constant cold bias (-0.00, -0.05, -0.10, -0.40 K), then the same arm with a
+window planted on top (the bias plus a further -0.50 K for 4 samples).
+Property: no bias arm trips; every planted window does.
+Null control: bias 0.00 -> no trip at both ends. Perturbation: the planted
+window -> trips at both ends.
+
+Part 2 (the class rule): every ``Cusum(...)`` construction in the package,
+with whether it is read in ``_learning_frozen`` and whether it sets
+``reference_hours`` -- a learning gate whose zero is not the signal's
+normal needs one.
+
+Command (tree root):
+    PYTHONPATH=tests/hastub python3 dev/audit/harnesses/r10_vent_probe_companion.py
+"""
+import ast
+import sys
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+
+sys.path.insert(0, "tests")
+sys.path.insert(0, "custom_components")
+
+from harness import FakeEntry, FakeHass  # noqa: E402
+from profiles import house  # noqa: E402
+
+from heatpump_optimizer.coordinator import HeatPumpOptimizerCoordinator  # noqa: E402
+
+T0 = datetime(2026, 1, 1, tzinfo=timezone.utc)
+PKG = Path("custom_components/heatpump_optimizer")
+
+
+def detector():
+    return HeatPumpOptimizerCoordinator(FakeHass(), FakeEntry(data=house(dhw=False)))._vent_cusum
+
+
+def feed(c, series):
+    tripped_at = None
+    for i, r in enumerate(series):
+        c.update(T0 + timedelta(minutes=15 * i), r)
+        if c.tripped and tripped_at is None:
+            tripped_at = i
+    return tripped_at
+
+
+def part1():
+    bad = 0
+    for bias in (0.0, 0.05, 0.10, 0.40):
+        quiet = feed(detector(), [-bias] * 96)
+        window = feed(detector(), [-bias] * 96 + [-bias - 0.5] * 4)
+        ok = quiet is None and window is not None and window >= 96
+        bad += not ok
+        print(f"RESULT bias={bias:.2f} bias_only_trips_at={quiet} window_trips_at={window} "
+              f"{'ok' if ok else 'FAIL'}")
+    print(f"RESULT part1_failures={bad}")
+    return bad
+
+
+def part2():
+    gated = set()
+    rows = []
+    for f in sorted(PKG.rglob("*.py")):
+        tree = ast.parse(f.read_text())
+        for node in ast.walk(tree):
+            if isinstance(node, ast.FunctionDef) and node.name == "_learning_frozen":
+                for a in ast.walk(node):
+                    if isinstance(a, ast.Attribute) and a.attr == "tripped" and isinstance(a.value, ast.Attribute):
+                        gated.add(a.value.attr)
+        for node in ast.walk(tree):
+            if isinstance(node, ast.Assign) and isinstance(node.value, ast.Call) \
+                    and getattr(node.value.func, "id", None) == "Cusum":
+                kw = {k.arg for k in node.value.keywords}
+                for t in node.targets:
+                    if isinstance(t, ast.Attribute):
+                        rows.append((f.relative_to(PKG).as_posix(), t.attr, "reference_hours" in kw))
+    open_seams = 0
+    for rel, name, ref in rows:
+        g = name in gated
+        flag = "OPEN" if (g and not ref) else "ok"
+        open_seams += flag == "OPEN"
+        print(f"RESULT cusum {rel}:{name} gates_learning={g} referenced={ref} {flag}")
+    print(f"RESULT cusums={len(rows)} open_learning_gates={open_seams}")
+    return open_seams
+
+
+if __name__ == "__main__":
+    sys.exit(1 if (part1() + part2()) else 0)
