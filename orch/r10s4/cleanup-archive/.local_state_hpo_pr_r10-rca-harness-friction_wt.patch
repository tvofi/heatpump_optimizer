@@ -0,0 +1,118 @@
+#!/usr/bin/env python3
+"""Can the heat-loss learners' per-interval rate limit bind? (R10-DEAD-RATE-LIMIT)
+
+Written by the R10-DEAD-RATE-LIMIT fixer. ``learner_newton_step`` used to end
+in a rate limit, ``clip(updated, current +- current * max_step_fraction)``,
+fed ``HOUSE_LOSS_MAX_STEP`` at both call sites. Once the trust region is a
+fraction of the current estimate (#2252), the EWMA moves a sample by
+``alpha * (target - current)`` with ``|target - current| <= trust_region *
+current``, so no sample can move the estimate further than ``alpha *
+trust_region`` of it, inside the limit.
+
+This drives the production step over a grid of every input the two call
+sites can reach -- ``current`` across the ``_apply_*`` clamps (the same
+[0.3, 3.0] for the scale and the ratio), residuals across the accepted
+range and far past it, every gated delta-T and interval length -- and per
+point compares the step to the same step with the limit applied on top of
+it (at a tree whose step still takes ``max_step_fraction``, the step with
+an unbounded fraction). It prints:
+
+  * ``points``      -- grid points evaluated, and ``none`` those with no step;
+  * ``binds``       -- points where the limit changes the step (rule: the
+    clipped and unclipped ``updated`` differ by more than 1e-15);
+  * ``max_moved_fraction`` -- max over the grid of |updated - current| / current;
+  * ``bound``       -- ``alpha * trust_region``, the derived ceiling;
+  * ``digest``      -- sha1 over every point's production (target, updated)
+    reprs -- the limit at ``--limit`` applied where the step still takes it --
+    so two trees whose production steps are bit-identical print one digest.
+
+Expected at the shipped constants: binds=0 at the pre-#2252 base, the
+#2252 merge and the fix head alike, max_moved_fraction == bound after #2252.
+Null controls, each reading binds > 0 at any tree where the limit is a
+fraction of the estimate: ``--alpha 1.0`` (an EWMA that outruns it), and
+``--current-min 0.05 --current-max 0.2`` at the pre-#2252 base (a fixed
+trust-region offset is a larger fraction of a small estimate; unreachable
+under the clamps). Run from a worktree root:
+
+    PYTHONPATH=tests/hastub:custom_components \\
+        python3 dev/audit/harnesses/r10_dead_rate_limit.py
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import inspect
+import itertools
+
+import numpy as np
+
+from heatpump_optimizer import coordinator as coord_mod
+from heatpump_optimizer.const import (
+    HOUSE_HEAT_LOSS_SCALE_MAX,
+    HOUSE_HEAT_LOSS_SCALE_MIN,
+    LOWER_FLOOR_LOSS_RATIO_MAX,
+    LOWER_FLOOR_LOSS_RATIO_MIN,
+)
+from heatpump_optimizer.thermal_model import learner_newton_step
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--alpha", type=float, default=coord_mod.HOUSE_LOSS_ALPHA)
+    ap.add_argument("--trust-region", type=float, default=coord_mod._LEARNER_TRUST_REGION)
+    ap.add_argument("--limit", type=float, default=coord_mod.HOUSE_LOSS_MAX_STEP,
+                    help="the rate-limit fraction probed (default: HOUSE_LOSS_MAX_STEP)")
+    ap.add_argument("--current-min", type=float,
+                    default=min(HOUSE_HEAT_LOSS_SCALE_MIN, LOWER_FLOOR_LOSS_RATIO_MIN))
+    ap.add_argument("--current-max", type=float,
+                    default=max(HOUSE_HEAT_LOSS_SCALE_MAX, LOWER_FLOOR_LOSS_RATIO_MAX))
+    a = ap.parse_args()
+
+    takes_limit = "max_step_fraction" in inspect.signature(learner_newton_step).parameters
+    kw = {"trust_region": a.trust_region, "alpha": a.alpha}
+    if takes_limit:
+        kw["max_step_fraction"] = float("inf")
+
+    max_res = coord_mod.HOUSE_LOSS_MAX_RESIDUAL
+    currents = np.unique(np.concatenate([
+        np.linspace(a.current_min, a.current_max, 28), [a.current_min, a.current_max, 1.0]]))
+    residuals = np.concatenate([np.linspace(-max_res, max_res, 41), [-1e6, -50.0, 50.0, 1e6]])
+    delta_ts = [coord_mod.HOUSE_LOSS_MIN_DELTA, 10.0, 20.0, 40.0]
+    dts = [coord_mod.HOUSE_LOSS_MIN_SAMPLE_HOURS, 0.25, 0.5, coord_mod.HOUSE_LOSS_MAX_SAMPLE_HOURS]
+    base_us = [0.02, 0.15, 0.4]
+    capacities = [2.0, 10.0, 30.0]
+
+    points = none = binds = 0
+    moved = 0.0
+    digest = hashlib.sha1()
+    for cur, res, d_t, dt, bu, cap in itertools.product(
+            currents, residuals, delta_ts, dts, base_us, capacities):
+        points += 1
+        cur = float(cur)
+        step = learner_newton_step(cur, bu, cap, float(res), d_t, dt, **kw)
+        if step is None:
+            digest.update(b"None")
+            none += 1
+            continue
+        updated = step[1]
+        lim = cur * a.limit
+        clipped = float(np.clip(updated, cur - lim, cur + lim))
+        # What production returns: the limit applied where the step takes it.
+        digest.update(repr((step[0], clipped if takes_limit else updated)).encode())
+        if abs(clipped - updated) > 1e-15:
+            binds += 1
+        moved = max(moved, abs(updated - cur) / cur)
+
+    print(f"takes_max_step_fraction={takes_limit} alpha={a.alpha} "
+          f"trust_region={a.trust_region} limit={a.limit} "
+          f"current=[{a.current_min}, {a.current_max}]")
+    print(f"RESULT points={points}")
+    print(f"RESULT none={none}")
+    print(f"RESULT binds={binds}")
+    print(f"RESULT max_moved_fraction={moved:.12f}")
+    print(f"RESULT bound={a.alpha * a.trust_region:.12f}")
+    print(f"RESULT digest={digest.hexdigest()}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/dev/audit/harnesses/r10_dhw_lift_law_grid.py b/dev/audit/harnesses/r10_dhw_lift_law_grid.py
new file mode 100644
index 000000000..f0a3273dd
--- /dev/null
+++ b/dev/audit/harnesses/r10_dhw_lift_law_grid.py
@@ -0,0 +1,96 @@
+"""R10-PUMP-MODEL, D2-s2-01: how many ways one hot-water tank is priced.
+
+`ThermalModel.compute_cop_dhw` prices one kWh into the DHW tank. Until this
+finding it chose between two laws on `cop_flow_carnot`, a SPACE-circuit flag:
+behind a valve, `_cop_law` at the tank's own water temperature (the buffer's
+Carnot lift); without one, the plain curve times a linear 0.008/K penalty from
+35 C, floored at 0.5. The ruling on #201 (comment 6240984157) accepted one law
+on every plant; this census is the judge's two grids from that ruling, landed
+so a later seat can re-run them.
+
+Metrics, over a 41-outdoor (-25..15 C) x 51-tank (20..70 C) grid, 1 K steps:
+  `dev_cells`    -- cells where the valve and the direct plant price the tank
+                    differently (ratio above 1 + 1e-12). 0 when one law prices
+                    both plants.
+  `worst_ratio`  -- the largest valve/direct ratio on the grid, and its cell.
+  `within_ratio` -- ONE direct install (no valve, flow-curve COP on): the
+                    tank's price against the space curve's own lift at the same
+                    water temperature, at 7 C outdoor / 55 C water. 1.0000 when
+                    the tank and the space side pay one lift.
+  `below_ref_boost` -- the largest direct-plant tank price over the plain
+                    curve's, for a tank below the reference flow. 1.0000 when
+                    a cold tank earns no boost.
+
+Null control: `null_max_diff` -- the two plants at a 35 C tank (the reference
+flow, where both laws must agree at every outdoor), must be 0.
+Perturbation: `--perturb` reinstates the retired linear law on the direct
+plant in this process (the old `compute_cop_dhw` body), which must move
+`dev_cells` off 0 at a head that has one law.
+
+    PYTHONPATH=tests/hastub python3 dev/audit/harnesses/r10_dhw_lift_law_grid.py \
+        [--root DIR] [--perturb]
+
+Counts and ratios only, deterministic; writes nothing.
+"""
+from __future__ import annotations
+
+import argparse
+import sys
+from pathlib import Path
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--root", default=".")
+    ap.add_argument("--perturb", action="store_true")
+    args = ap.parse_args()
+    root = Path(args.root).resolve()
+    sys.path[:0] = [str(root / "tests" / "hastub"), str(root)]
+    import numpy as np
+    from custom_components.heatpump_optimizer.thermal_model import (
+        ThermalModel,
+        ThermalParameters,
+    )
+
+    def model(flag: bool, **kw) -> ThermalModel:
+        return ThermalModel(ThermalParameters(cop_flow_carnot=flag, **kw))
+
+    valve, direct = model(True), model(False)
+    within = model(False, flow_curve_cop=True)
+    if args.perturb:
+        def linear_law(self, outdoor_temp, dhw_temp, humidity=None):
+            base = self._cop_law(outdoor_temp, humidity, None)
+            return max(base * max(0.5, 1.0 - 0.008 * (dhw_temp - 35.0)), 1.0)
+        for m in (direct, within):
+            m.compute_cop_dhw = linear_law.__get__(m)
+
+    outs = np.arange(-25, 16, 1.0)
+    tanks = np.arange(20, 71, 1.0)
+    dev, worst, boost = 0, (1.0, None), 1.0
+    for o in outs:
+        for t in tanks:
+            a, b = valve.compute_cop_dhw(o, t), direct.compute_cop_dhw(o, t)
+            r = max(a, b) / min(a, b)
+            if r > 1.0 + 1e-12:
+                dev += 1
+            if r > worst[0]:
+                worst = (r, (float(o), float(t)))
+            if t < direct.params.cop_flow_reference_temp:
+                boost = max(boost, b / direct._cop_law(o, None, None))
+    null = max(abs(valve.compute_cop_dhw(o, 35.0) - direct.compute_cop_dhw(o, 35.0))
+               for o in outs)
+    space = within._cop_law(7.0, None, None) * within.flow_lift_factor(7.0, 55.0)
+    within_ratio = within.compute_cop_dhw(7.0, 55.0) / max(space, 1.0)
+
+    print(f"RESULT cells={len(outs) * len(tanks)} count")
+    print(f"RESULT dev_cells={dev} count")
+    print(f"RESULT worst_ratio={worst[0]:.4f} at={worst[1]}")
+    print(f"RESULT within_ratio={max(within_ratio, 1 / within_ratio):.4f} "
+          f"(tank {within.compute_cop_dhw(7.0, 55.0):.4f} vs space lift {space:.4f})")
+    print(f"RESULT below_ref_boost={boost:.4f}")
+    print(f"RESULT null_max_diff={null:.3e}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/dev/audit/harnesses/r10_field_coverage_paths.sh b/dev/audit/harnesses/r10_field_coverage_paths.sh
new file mode 100644
index 000000000..4555cc461
--- /dev/null
+++ b/dev/audit/harnesses/r10_field_coverage_paths.sh
@@ -0,0 +1,46 @@
+#!/bin/bash
+# R10-SEAT-SELFTESTS-CI fold (a finding from R10-ARCHSCORE-COVERAGE's census
+# work): does a pull request touching one of its inputs select governance.yml's
+# field-coverage step? The probes are the census inputs and the moved homes of
+# the inputs field_coverage.mjs reads (tests/layout.json's retired entries).
+# It reads the step's own pathspec from the workflow at the ref given (default
+# HEAD) and runs the step's own predicate,
+# `git diff --quiet "$SINCE" HEAD -- <pathspec>`, in a throwaway repository
+# over one-file commits. rc 1 from the predicate means "an input changed: run".
+#   bash dev/audit/harnesses/r10_field_coverage_paths.sh [<ref>]
+# Prints one line per probe file, `RUN` or `SKIPPED`, and exits 1 unless every
+# census input reads RUN and the unrelated file (the null control) SKIPPED.
+set -uo pipefail
+cd "$(git -C "$(dirname -- "$0")" rev-parse --show-toplevel)" || exit 1
+REF=${1:-HEAD}
+line=$(git show "$REF:.github/workflows/governance.yml" | grep -E 'git diff --quiet "\$SINCE" HEAD -- ') \
+  || { echo "no field-coverage predicate in governance.yml at $REF"; exit 2; }
+spec=${line#*HEAD -- }; spec=${spec%%; then*}
+eval "set -- $spec"   # the workflow's own quoting, as bash reads it there
+SPEC=("$@")
+. tests/throwaway_git.sh
+T=$(mktemp -d); trap 'rm -rf "$T"' EXIT
+throwaway_git_init "$T/r" -q -b main
+throwaway_git_env
+g() { git -C "$T/r" "$@"; }
+echo seed > "$T/r/seed"; g add seed; g commit -qm seed; BASE=$(g rev-parse HEAD)
+bad=0
+probe() { # <path> <want RUN|SKIPPED>: one commit on BASE touching <path> alone
+  g checkout -q "$BASE"; mkdir -p "$T/r/$(dirname -- "$1")"; echo x > "$T/r/$1"
+  g add -A; g commit -qm probe
+  if (cd "$T/r" && git diff --quiet "$BASE" HEAD -- "${SPEC[@]}"); then got=SKIPPED; else got=RUN; fi
+  [ "$got" = "$2" ] || bad=$((bad + 1))
+  echo "$got $1 (want $2)"
+}
+probe tests/ci_budgets.json RUN
+probe tests/ci_ratchet.py RUN
+probe tools/audit/archscore/score.py RUN
+probe custom_components/heatpump_optimizer/www/heatpump-optimizer-card.js RUN
+probe tests/structure_budgets.json RUN
+probe tests/seam_map.json RUN
+probe tools/policy/policy_lint.mjs RUN
+probe tools/policy/fixtures/required-contexts.json RUN
+probe dev/governance/config/policy_budgets.json RUN
+probe README.md SKIPPED
+echo "RESULT misread=$bad"
+[ "$bad" = 0 ]
diff --git a/dev/audit/harnesses/r10_ftol_cell_search.py b/dev/audit/harnesses/r10_ftol_cell_search.py
new file mode 100644
index 000000000..2fc448493
--- /dev/null
+++ b/dev/audit/harnesses/r10_ftol_cell_search.py
@@ -0,0 +1,229 @@
+"""D2-s2-01's ruling step 2 (#201 comment 6240984157): re-select the cell of
+tests/optimality.py's stop-rule (ftol) check when its own cell stops
+separating.
+
+Metric, one line: per candidate cell, the gap by which each loosened-ftol
+arm's plan costs more than production's, on the check's own cost rule, under
+whichever BLAS kernel the run selects (OPENBLAS_CORETYPE).
+
+A cell is (two_zone, price profile, weather profile) on the check's house,
+DHW on, the check's initial state and start date. The arms are the ones
+k1725_blas_kernel_gap.py races at the check's cell:
+  prod      -- the production solve (ftol 1e-6 at both sites);
+  both_1e2 / both_1e3 -- every _scoped_minimize call, multi-start refinement
+              and restart polish alike, at the loosened ftol;
+  loose_1e3 -- the round-4 single-site class (multi-start refinement
+              loosened, restart restored to production's ftol).
+A gap is 100 * (arm - prod) / arm, the check's own expression; a cell can
+carry the check only if every loosened arm's gap is positive on every kernel,
+and the bound is half the smallest of them (the ruling's derivation).
+
+Null control: `--perturb` loosens PRODUCTION itself to the both-sites 1e-2
+stop rule (the failure the check exists to catch); every gap of the cell the
+check is moved to must then read zero for both_1e2, the construction by which
+the check goes red.
+
+Run from the repository root, once per kernel:
+
+    PYTHONPATH=tests/hastub python3 dev/audit/harnesses/r10_ftol_cell_search.py [--perturb] [--cells tz:price:weather,...]
+
+It prints an environment line, one RESULT line per cell, and the contract's
+thread_factor/load1/swapins lines (dev/audit/README.md).
+"""
+import argparse
+import os
+
+for _v in ("OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
+           "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS"):
+    os.environ.setdefault(_v, "1")
+
+import resource  # noqa: E402
+import subprocess  # noqa: E402
+import sys  # noqa: E402
+import time  # noqa: E402
+from datetime import datetime  # noqa: E402
+from pathlib import Path  # noqa: E402
+from unittest import mock  # noqa: E402
+
+
+def repo_root(start):
+    """The directory holding custom_components/heatpump_optimizer/manifest.json."""
+    from pathlib import Path
+    here = Path(start).resolve()
+    if here.is_file():
+        here = here.parent
+    marker = Path("custom_components") / "heatpump_optimizer" / "manifest.json"
+    for cand in (here, *here.parents):
+        if (cand / marker).is_file():
+            return cand
+    raise RuntimeError(f"no repository root above {start}")
+
+
+ROOT = str(repo_root(__file__))
+os.chdir(ROOT)
+for _part in ("custom_components", os.path.join("tests", "hastub"), "tests"):
+    sys.path.insert(0, os.path.join(ROOT, _part))
+
+import numpy as np  # noqa: E402
+
+from profiles import DT, house, prices, solve_inputs, weather  # noqa: E402
+from heatpump_optimizer import optimizer as optm  # noqa: E402
+from heatpump_optimizer.optimizer import (  # noqa: E402
+    HeatPumpOptimizer, OptimizationConfig)
+from heatpump_optimizer.thermal_model import (  # noqa: E402
+    ThermalModel, ThermalParameters, ThermalState, WeatherSeries)
+
+PRICES = ("winter_typical", "winter_extreme", "winter_moderate",
+          "winter_narrow", "shoulder", "flat")
+WEATHERS = ("winter_cold", "winter_mild", "shoulder")
+START = datetime(2026, 1, 15)
+
+
+def env_line():
+    core = os.environ.get("OPENBLAS_CORETYPE") or ""
+    env = dict(os.environ, OPENBLAS_VERBOSE="2")
+    p = subprocess.run([sys.executable, "-c", "import numpy"], env=env,
+                       capture_output=True, text=True, timeout=60)
+    for line in p.stderr.splitlines():
+        if "Core:" in line:
+            core = line.split("Core:", 1)[1].strip()
+    cpu = "unknown"
+    try:
+        with open("/proc/cpuinfo") as fh:
+            for line in fh:
+                if line.startswith(("model name", "Hardware")):
+                    cpu = line.split(":", 1)[1].strip()
+                    break
+    except OSError:
+        cpu = subprocess.run(["sysctl", "-n", "machdep.cpu.brand_string"],
+                             capture_output=True, text=True).stdout.strip()
+    print(f"environment: core={core} cpu={cpu} numpy={np.__version__} "
+          f"python={sys.version.split()[0]}", flush=True)
+
+
+def setup(two_zone, price, wx):
+    """optimality.py's _dhw_setup, with the price and weather profiles free."""
+    p = ThermalParameters.from_config(house(two_zone=two_zone))
+    p.dhw_enabled = True
+    m = ThermalModel(p)
+    o = HeatPumpOptimizer(m, OptimizationConfig(
+        horizon_hours=24, time_step_minutes=15,
+        target_temp=21.0, min_temp=17.0, max_temp=23.0))
+    pr = prices(price, START)
+    ot, wi, ra, so = weather(wx, START)
+    st = ThermalState(
+        room_temperature=21.0, slab_temperature=22.0,
+        outdoor_temperature=float(ot[0]), upper_floor_temperature=21.0,
+        lower_floor_temperature=21.0, buffer_tank_temperature=40.0,
+        dhw_temperature=48.0)
+    return o, m, pr, ot, wi, ra, so, st
+
+
+def score(m, pw, st, ot, wi, ra, so, pr, min_t=16.5):
+    """optimality.py's score_plan cost and comfort violation."""
+    room = m.simulate_trajectory(st, pw, WeatherSeries(
+        outdoor_temps=ot, wind_speeds=wi, precipitation=ra,
+        solar_radiation=so), dt_hours=DT)[0]
+    return (float(np.sum(pr * pw * DT)),
+            float(np.maximum(0, min_t - room[1:]).sum()))
+
+
+full_scoped = optm._scoped_minimize
+full_ms = optm._multi_start_minimize
+full_restart = optm._lbfgsb_restart
+
+
+def _ftol_scoped(ftol):
+    def wrap(*a, **kw):
+        kw = dict(kw)
+        opts = dict(kw.get("options") or {})
+        opts["ftol"] = ftol
+        kw["options"] = opts
+        return full_scoped(*a, **kw)
+    return wrap
+
+
+def _restart_tight(*a, **kw):
+    with mock.patch.object(optm, "_scoped_minimize", full_scoped):
+        return full_restart(*a, **kw)
+
+
+def _loose_ms(ftol):
+    def wrap(objective, starts, bounds, *a, **kw):
+        with mock.patch.object(optm, "_lbfgsb_restart", _restart_tight):
+            with mock.patch.object(optm, "_scoped_minimize", _ftol_scoped(ftol)):
+                return full_ms(objective, starts, bounds, *a, **kw)
+    return wrap
+
+
+def _both_ms(ftol):
+    def wrap(objective, starts, bounds, *a, **kw):
+        with mock.patch.object(optm, "_scoped_minimize", _ftol_scoped(ftol)):
+            return full_ms(objective, starts, bounds, *a, **kw)
+    return wrap
+
+
+ARMS = (("both_1e2", _both_ms(1e-2)), ("both_1e3", _both_ms(1e-3)),
+        ("loose_1e3", _loose_ms(1e-3)))
+
+
+def solve(cell, ms_patch):
+    o, m, pr, ot, wi, ra, so, st = setup(*cell)
+    kw = dict(initial_state=st, prices=pr, outdoor_temps=ot, wind_speeds=wi,
+              precipitation=ra, solar_radiation=so, start_time=START)
+    if ms_patch is None:
+        r = o.optimize(inputs=solve_inputs(**kw))
+    else:
+        with mock.patch.object(optm, "_multi_start_minimize", ms_patch):
+            r = o.optimize(inputs=solve_inputs(**kw))
+    return score(m, np.asarray(r.power_schedule, dtype=float),
+                 st, ot, wi, ra, so, pr)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--perturb", action="store_true",
+                    help="loosen production itself to the both-sites 1e-2 rule")
+    ap.add_argument("--cells", default="",
+                    help="tz:price:weather,... (tz 1 or 0); default every cell")
+    a = ap.parse_args()
+    if a.cells:
+        cells = [(c.split(":")[0] == "1", c.split(":")[1], c.split(":")[2])
+                 for c in a.cells.split(",")]
+    else:
+        cells = [(tz, p, w) for tz in (True, False) for p in PRICES
+                 for w in WEATHERS]
+    env_line()
+    prod_patch = _both_ms(1e-2) if a.perturb else None
+    for cell in cells:
+        t0 = time.perf_counter()
+        c0, v0 = solve(cell, prod_patch)
+        parts = [f"prod={c0:.4f}"]
+        gaps = []
+        viol = v0
+        for name, patch in ARMS:
+            c, v = solve(cell, patch)
+            viol = max(viol, v)
+            g = 100.0 * (c - c0) / c if c else 0.0
+            gaps.append(g)
+            parts.append(f"{name}={c:.4f} gap_{name}={g:+.3f}")
+        tz, p, w = cell
+        print(f"RESULT cell={int(tz)}:{p}:{w} {' '.join(parts)} "
+              f"min_gap={min(gaps):+.3f} max_viol={viol:.4f} "
+              f"perturb={int(a.perturb)} wall={time.perf_counter() - t0:.1f}s",
+              flush=True)
+    factor = (time.process_time() / time.thread_time()
+              if time.thread_time() else 1.0)
+    print(f"RESULT thread_factor={factor:.3f}", flush=True)
+    try:
+        with open("/proc/loadavg") as fh:
+            load1 = fh.read().split()[0]
+    except OSError:
+        load1 = "unknown"
+    print(f"RESULT load1={load1}", flush=True)
+    print(f"RESULT swapins={resource.getrusage(resource.RUSAGE_SELF).ru_nswap}",
+          flush=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/dev/audit/harnesses/r10_rca_name_kept_plant.py b/dev/audit/harnesses/r10_rca_name_kept_plant.py
new file mode 100644
index 000000000..a8f517b41
--- /dev/null
+++ b/dev/audit/harnesses/r10_rca_name_kept_plant.py
@@ -0,0 +1,125 @@
+#!/usr/bin/env python3
+"""A dead member kept alive by a shared name: does the ratchet refuse it? (R10-N-structure-blind).
+
+Written by the round-10 root-cause seat for N-structure-blind (#2235,
+``dev/audit/rca/R10-N-structure-blind.md``). Every arm drives the production
+``tests/structure.py:measure`` of ``--structure`` (default ``tests/structure.py``)
+over an in-memory copy of the tree: ``module_trees`` is swapped, nothing on disk
+changes. Each arm compares the measured rows with ``--budgets`` (default
+``tests/structure_budgets.json``) the way ``ratchet`` does: a row over its
+budget is a refusal.
+
+  clean   the unchanged tree.
+  plant   ``diagnostics.py`` (a module Home Assistant loads) gains a live class
+          ``PlantedRecord`` whose ``as_dict`` nothing calls but an untyped
+          ``x.as_dict()``; other classes define ``as_dict``, so the census can
+          only keep it by name.
+  null    the same plant with the member uniquely named (``zz_unique_member``,
+          loaded as ``x.zz_other_name()``): no other class keeps it, so
+          ``dead_methods`` measures it dead.
+  typed   the plant with its receiver annotated ``PlantedRecord``: the load now
+          reaches the member, which is live, and nothing is name-kept.
+
+Command:
+  PYTHONPATH=tests/hastub python3 dev/audit/harnesses/r10_rca_name_kept_plant.py \
+      [--structure PATH --budgets PATH]
+
+Expected, with the name_kept_members row (this seat's head):
+  RESULT clean_refused=0 count   RESULT plant_refused=1 count (name_kept_members)
+  RESULT null_refused=1 count (dead_methods)   RESULT typed_refused=0 count
+  and *_name_kept = clean N, plant N+1, null N, typed N.
+Expected, origin/main's own structure.py and budgets (no row): plant_refused=0 --
+the dead member passes; null_refused=1, the control still fails.
+Perturbation: drop the ``name_kept_members`` row from ``measure()`` and the
+plant arm reads refused=0 again.
+"""
+from __future__ import annotations
+
+import os
+
+for _v in ("OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
+           "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS"):
+    os.environ.setdefault(_v, "1")
+
+import ast  # noqa: E402
+import importlib.util  # noqa: E402
+import json  # noqa: E402
+import sys  # noqa: E402
+from pathlib import Path  # noqa: E402
+
+
+def repo_root(start):
+    """The directory holding custom_components/heatpump_optimizer/manifest.json."""
+    from pathlib import Path
+    here = Path(start).resolve()
+    if here.is_file():
+        here = here.parent
+    marker = Path("custom_components") / "heatpump_optimizer" / "manifest.json"
+    for cand in (here, *here.parents):
+        if (cand / marker).is_file():
+            return cand
+    raise RuntimeError(f"no repository root above {start}")
+
+
+ROOT = repo_root(__file__)
+args = sys.argv[1:]
+spath = Path(args[args.index("--structure") + 1]) if "--structure" in args \
+    else ROOT / "tests" / "structure.py"
+bpath = Path(args[args.index("--budgets") + 1]) if "--budgets" in args \
+    else ROOT / "tests" / "structure_budgets.json"
+sys.path.insert(0, str(ROOT / "tests"))
+spec = importlib.util.spec_from_file_location("structure_under_test", spath)
+S = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(S)
+S.REPO_ROOT = ROOT
+S.PACKAGE_DIR = ROOT / "custom_components" / "heatpump_optimizer"
+S.SEAM_MAP_FILE = ROOT / "tests" / "seam_map.json"
+TARGET = "diagnostics.py"
+ENTRY = "async def async_get_config_entry_diagnostics("
+FIRST = '    coord = entry.runtime_data if hasattr(entry, "runtime_data") else None\n'
+
+
+def planted(src: str, member: str, load: str, annotation: str = "Any") -> str:
+    """``src`` with a live PlantedRecord whose ``member`` only ``x.<load>()`` reads."""
+    assert src.count(ENTRY) == 1 and src.count(FIRST) == 1, "diagnostics.py moved: re-anchor"
+    src = src.replace(ENTRY, f"def _planted_root(x: {annotation}) -> int:\n"
+                             f"    x.{load}()\n    return PlantedRecord().used()\n\n\n" + ENTRY)
+    src = src.replace(FIRST, FIRST + "    _planted_root(entry)\n")
+    return src + (f"\n\nclass PlantedRecord:\n    def {member}(self) -> dict:\n"
+                  "        return {}\n\n    def used(self) -> int:\n        return 1\n")
+
+
+def measure(edit) -> dict:
+    orig = S.module_trees
+
+    def trees():
+        out = []
+        for path in sorted(S.PACKAGE_DIR.rglob("*.py")):
+            text = path.read_text()
+            if path.name == TARGET and edit:
+                text = edit(text)
+            out.append((path, ast.parse(text, filename=str(path))))
+        return out
+
+    S.module_trees = trees
+    try:
+        result = S.measure()
+    finally:
+        S.module_trees = orig
+    return {**result["metrics"], "_name_kept": len(result["tables"]["name_kept"])}
+
+
+budgets = {k: v for k, v in json.loads(bpath.read_text()).items() if k != "recorded_at"}
+ARMS = {
+    "clean": None,
+    "plant": lambda s: planted(s, "as_dict", "as_dict"),
+    "null": lambda s: planted(s, "zz_unique_member", "zz_other_name"),
+    "typed": lambda s: planted(s, "as_dict", "as_dict", '"PlantedRecord"'),
+}
+for arm, edit in ARMS.items():
+    m = measure(edit)
+    over = sorted(k for k in budgets if k in m and m[k] > budgets[k])
+    print(f"RESULT {arm}_name_kept={m['_name_kept']} count")
+    print(f"RESULT {arm}_dead_methods={m['dead_methods']} count")
+    print(f"RESULT {arm}_refused={len(over)} count{(' (' + ', '.join(over) + ')') if over else ''}")
+print(f"RESULT row_in_budgets={'name_kept_members' in budgets}")
