+        _SavDT(2026, 2, 9, _h, 0), 1.0, {"baseline_kw": 0.75}, 1.0, 1.0
+    )
+    _neg.add(_SavDT(2026, 2, 9, _h, 0), "spot", kwh=1.0, sek=1.0)
