+def _lane_body(text: str, lane: str) -> str:
+    """One `lane_<name>() {` function of tests/run.sh, code lines only."""
+    m = re.search(rf"^lane_{lane}\(\) \{{\n(.*?)^\}}", text, re.M | re.S)
+    return "" if not m else "\n".join(
