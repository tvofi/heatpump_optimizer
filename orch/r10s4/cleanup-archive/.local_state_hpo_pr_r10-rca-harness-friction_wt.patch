index 000000000..e4657d622
--- /dev/null
+++ b/dev/audit/harnesses/r10_seat_selftests_mutants.py
@@ -0,0 +1,244 @@
+#!/usr/bin/env python3
+"""R10-SEAT-SELFTESTS-CI: each seat self-test step, and the wiring check, against a mutant.
+
+    python3 dev/audit/harnesses/r10_seat_selftests_mutants.py            # all
+    python3 dev/audit/harnesses/r10_seat_selftests_mutants.py M0 S07 W1  # named
+
+Run from a clean checkout of the branch: every mutant edits the committed
+file in place and restores its bytes, and a dirty file refuses first.
+
+M0 runs every seat step in governance.yml's `instrument-self-tests` as CI
+does (its `run:` text, under `bash -e`, with RUNNER_TEMP set, a throwaway
+HOME and no inherited PYTHONUNBUFFERED) and must exit 0 for each. S01..S30 each plant one production-line
+mutant in one file -- outside that file's self-test function -- and run only
+the step that names the file: a killed mutant reddens the step, and the same
+step on the unmutated file must pass first (NOT RUN otherwise). S04U is S04 run with
+PYTHONUNBUFFERED=1 in the step's environment, as a Linux container sets it.
+W1..W3 drive
+the wiring step: an unwired self-testing file, a step reduced to a comment
+naming its file, and a trailing comment, each of which must redden it.
+Prints one line per mutant, `KILLED` or `SURVIVED`, with the step's last
+line, and `RESULT survivors=<n>`; exit 1 when any survived or M0 failed.
+"""
+from __future__ import annotations
+
+import os
+import re
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+
+def repo_root(start):
+    """The directory holding custom_components/heatpump_optimizer/manifest.json."""
+    from pathlib import Path
+    here = Path(start).resolve()
+    if here.is_file():
+        here = here.parent
+    marker = Path("custom_components") / "heatpump_optimizer" / "manifest.json"
+    for cand in (here, *here.parents):
+        if (cand / marker).is_file():
+            return cand
+    raise RuntimeError(f"no repository root above {start}")
+
+
+ROOT = repo_root(__file__)
+WF = ROOT / ".github" / "workflows" / "governance.yml"
+SEAT = "tools/audit/seat"
+
+# name, file, old (exactly once in the file), new
+MUTANTS = [
+    ("S01", "ci-watch.sh", '[ -n "$RS" ] && REQ=$(gh api', '[ -n "$RS" ] || REQ=$(gh api'),
+    ("S02", "cloud_dispatch.py", "return len(head) == 40 and set(head) <= LOWER_HEX",
+     "return len(head) != 40 and set(head) <= LOWER_HEX"),
+    ("S03", "cloud_relay.sh", 'if [ -f "$led" ] && grep -qxF "$ref $sha" "$led"; then',
+     'if [ -f "$led" ] && ! grep -qxF "$ref $sha" "$led"; then'),
+    ("S04", "daemonize.py", '"-u" not in run_argv[1:2]:', '"-u" in run_argv[1:2]:'),
+    ("S05", "delivery_row.sh", 'if [ -n "${4:-}" ]; then', 'if [ -z "${4:-}" ]; then'),
+    ("S06", "failure_logs.sh", 'if [ -z "$jid" ]; then', 'if [ -n "$jid" ]; then'),
+    ("S07", "features_block.py", 'i = source.rindex("\\n", 0, source.index(start)) + 1',
+     'i = source.rindex("\\n", 0, source.index(start)) + 0'),
+    ("S09", "handover_prompt.py",
+     "if stage not in roster_lib.DONE_STAGES and stage != NOT_STARTED:",
+     "if stage not in roster_lib.DONE_STAGES and stage == NOT_STARTED:"),
+    ("S10", "merge_pr.sh", '[ "$4" = 1 ] || { echo "DRAFT:', 'true || { echo "DRAFT:'),
+    ("S11", "moved_paths.py", 'e["new"] or "(retired)"', 'e["new"] and "(retired)"'),
+    ("S13", "plan_table.py",
+     '        ids[g] = _task_id(g, ids)\n    lanes = sorted({open_[g].get("lane") or "?"',
+     '        ids[g] = _task_id(g, ids)\n    lanes = sorted({open_[g].get("lane") and "?"'),
+    ("S14", "pr_args.sh", '"$*" >&2; exit 1; }', '"$*" >&2; exit 0; }'),
+    ("S15", "pr_cap.py", 'a = pr.get("author") or {}', 'a = pr.get("author") and {}'),
+    ("S16", "proof_watch.py", 'and last[n].get("conclusion") not in GREEN)',
+     'and last[n].get("conclusion") in GREEN)'),
+    ("S17", "prune_refs.py", "    if sha in main_reachable:\n        return DELETE_MERGED",
+     "    if sha not in main_reachable:\n        return DELETE_MERGED"),
+    ("S18", "queue_pre_flight.py", "if not mt.is_sha(v):", "if mt.is_sha(v):"),
+    ("S19", "record_row.py", 'if n in required and r.get("conclusion") in bad)',
+     'if n in required and r.get("conclusion") not in bad)'),
+    ("S20", "resume_doc.py", "done = {k for k in G if k not in open_}",
+     "done = {k for k in G if k in open_}"),
+    ("S21", "roster_edit.py", "    if r.returncode != 0:\n        raise Refuse(",
+     "    if r.returncode == 0:\n        raise Refuse("),
+    ("S22", "roster_lib.py", '    m = _ROSTER_NAME.match(path.rsplit("/", 1)[-1])\n    if not m:',
+     '    m = _ROSTER_NAME.match(path.rsplit("/", 1)[-1])\n    if m:'),
+    ("S23", "run_twins.py", '    pr = [r for r in runs if r.get("event") == "pull_request"]\n    ts = {',
+     '    pr = [r for r in runs if r.get("event") != "pull_request"]\n    ts = {'),
+    ("S24", "seat_venv.sh", '|| die "$VENV_HA is missing a pinned homeassistant',
+     '|| true "$VENV_HA is missing a pinned homeassistant'),
+    ("S25", "state_docs.py", "        if a.roster_file:\n            return roster_lib.roster_round(a.roster_file)",
+     "        if not a.roster_file:\n            return roster_lib.roster_round(a.roster_file)"),
+    ("S26", "tick_loop.sh", '[ "$rrc" = 0 ] && rrc=ok', '[ "$rrc" != 0 ] && rrc=ok'),
+    ("S28", "offline_spy.py", "and bool(URL_RE.search(parts[2])))", "and False)"),
+    ("S29", "selftest_wiring.py", 'return [COMMENT_RE.sub("", x) for x in out]', "return out"),
+    ("S30", "selftest_wiring.py", "return 1 if unwired else 0", "return 0"),
+]
+
+# Mutants run with extra step environment: (name, base mutant, env).
+ENV_MUTANTS = [("S04U", "S04", {"PYTHONUNBUFFERED": "1"})]
+
+# The wrappers' own line is the dispatch to the self-tests they delegate.
+WRAPPERS = [
+    ("S08", "handoff_push.sh",
+     '[ "${1:-}" = --self-test ] && exec bash "$(dirname -- "$0")/delivery_row.sh" --self-test',
+     '[ "${1:-}" = --self-test ] && exit 0'),
+    ("S12", "open_pr.sh",
+     'bash "$(dirname -- "$0")/pr_args.sh" --self-test || exit 1; exit $r; }',
+     'exit $r; }'),
+    ("S27", "update_pr.sh",
+     '[ "${1:-}" = --self-test ] && { bash "$(dirname -- "$0")/delivery_row.sh" --self-test; r=$?',
+     '[ "${1:-}" = --self-test ] && { r=0'),
+]
+
+
+def steps() -> list[tuple[str, str]]:
+    """(name, run text) of each step in instrument-self-tests."""
+    text = WF.read_text()
+    job = text[text.index("\n  instrument-self-tests:\n"):]
+    job = job[:re.search(r"\n  [a-z][\w-]*:\n", job[1:]).start() + 1]
+    out = []
+    for blk in job.split("\n      - name: ")[1:]:
+        name = blk.split("\n", 1)[0]
+        m = re.search(r"\n        run: \|\n((?:          .*\n|\s*\n)+)", blk + "\n")
+        if m:
+            out.append((name, "\n".join(x[10:] for x in m.group(1).splitlines())))
+        else:
+            m = re.search(r"\n        run: (.*)", blk)
+            if m:
+                out.append((name, m.group(1)))
+    return out
+
+
+def step_for(file: str) -> tuple[str, str]:
+    pat = re.compile(re.escape(f"{SEAT}/{file}") + r" --self-test")
+    hits = [s for s in steps() if pat.search(s[1])]
+    assert len(hits) == 1, f"{file}: {len(hits)} steps"
+    return hits[0]
+
+
+def run_step(run: str, extra: dict | None = None) -> tuple[int, str]:
+    with tempfile.TemporaryDirectory() as tmp:
+        script = Path(tmp, "step.sh")
+        script.write_text(run + "\n")
+        # A throwaway HOME, as on a runner, and python3 the interpreter running
+        # this harness: a seat shim on PATH finds its venv under the real HOME,
+        # and without it every step exits 127.
+        pybin = Path(tmp, "pybin")
+        pybin.mkdir()
+        for name in ("python3", "python"):
+            (pybin / name).symlink_to(sys.executable)
+        env = dict(os.environ, RUNNER_TEMP=tmp, HOME=tmp, PYTHONDONTWRITEBYTECODE="1",
+                   PATH=f"{pybin}{os.pathsep}{os.environ.get('PATH', '')}")
+        env.pop("PYTHONUNBUFFERED", None)
+        env.update(extra or {})
+        p = subprocess.run(["bash", "-e", str(script)], cwd=ROOT, env=env,
+                           capture_output=True, text=True, timeout=900)
+    lines = (p.stdout + p.stderr).strip().splitlines()
+    return p.returncode, lines[-1] if lines else ""
+
+
+def clean(path: Path) -> bool:
+    return subprocess.run(["git", "diff", "--quiet", "--", str(path)], cwd=ROOT).returncode == 0
+
+
+def mutate(path: Path, old: str, new: str, fn) -> tuple[int, str]:
+    orig = path.read_bytes()
+    text = orig.decode()
+    if text.count(old) != 1:
+        return -1, f"PATTERN FOUND {text.count(old)} TIMES"
+    path.write_text(text.replace(old, new))
+    try:
+        return fn()
+    finally:
+        path.write_bytes(orig)
+
+
+def main(want: list[str]) -> int:
+    pick = lambda n: not want or n in want  # noqa: E731
+    survivors = 0
+    baseline: dict = {}
+    if pick("M0"):
+        bad = 0
+        for name, run in steps():
+            if SEAT not in run:
+                continue
+            rc, last = run_step(run)
+            bad += rc != 0
+            print(f"== M0 rc={rc} {name} | {last}", flush=True)
+        print(f"== M0: {bad} seat step(s) red")
+        survivors += bad
+    by_name = {m[0]: m for m in MUTANTS + WRAPPERS}
+    plan = [(*m, {}) for m in MUTANTS + WRAPPERS] + [
+        (name, *by_name[base][1:], env) for name, base, env in ENV_MUTANTS]
+    for name, file, old, new, extra in plan:
+        if not pick(name):
+            continue
+        path = ROOT / SEAT / file
+        if not clean(path):
+            print(f"== {name}: {file} has uncommitted edits; the restore would erase them")
+            return 2
+        _, run = step_for(file)
+        # The null control per mutant: the same step on the unmutated file
+        # must pass, or a red below says nothing about the mutant.
+        key = (run, tuple(sorted(extra.items())))
+        if key not in baseline:
+            baseline[key] = run_step(run, extra)
+        base = baseline[key]
+        if base[0] != 0:
+            survivors += 1
+            print(f"== {name} {file}: NOT RUN, the step is red unmutated | {base[1]}", flush=True)
+            continue
+        rc, last = mutate(path, old, new, lambda: run_step(run, extra))
+        verdict = "NOT RUN" if rc == -1 else ("KILLED" if rc else "SURVIVED")
+        survivors += rc <= 0
+        print(f"== {name} {file}: {verdict} rc={rc} | {last}", flush=True)
+    _, wiring = [s for s in steps() if "selftest_wiring.py --check" in s[1]][0]
+    if any(pick(w) for w in ("W1", "W2", "W3")) and run_step(wiring)[0] != 0:
+        print("== W: NOT RUN, the wiring step is red unmutated")
+        return 1
+    if pick("W1"):
+        extra = ROOT / SEAT / "zz_unwired_probe.py"
+        extra.write_text("import sys\nif sys.argv[1:] == ['--self-test']:\n    print('ok')\n")
+        try:
+            rc, last = run_step(wiring)
+        finally:
+            extra.unlink()
+        survivors += rc == 0
+        print(f"== W1 an unwired self-testing file: {'KILLED' if rc else 'SURVIVED'} rc={rc} | {last}")
+    for name, old, new, what in (
+        ("W2", "          bash tools/audit/seat/tick_loop.sh --self-test",
+         "          # bash tools/audit/seat/tick_loop.sh --self-test", "a step reduced to a comment"),
+        ("W3", "          bash tools/audit/seat/tick_loop.sh --self-test",
+         "          true  # bash tools/audit/seat/tick_loop.sh --self-test", "a trailing comment"),
+    ):
+        if not pick(name):
+            continue
+        rc, last = mutate(WF, old, new, lambda: run_step(wiring))
+        survivors += rc <= 0
+        print(f"== {name} {what}: {'KILLED' if rc > 0 else 'SURVIVED'} rc={rc} | {last}")
+    print(f"RESULT survivors={survivors}")
+    return 1 if survivors else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
diff --git a/dev/audit/harnesses/r10_setpoint_boost.py b/dev/audit/harnesses/r10_setpoint_boost.py
new file mode 100644
index 000000000..6e25e0ca8
--- /dev/null
+++ b/dev/audit/harnesses/r10_setpoint_boost.py
@@ -0,0 +1,192 @@
+"""R10-SETPOINT-BOOST: the heating floor against the gate, the censored draw window, and the solver nulls.
+
+    PYTHONPATH=tests/hastub:custom_components:tests \\
+        python3 dev/audit/harnesses/r10_setpoint_boost.py [--no-solves]
+
+Synthetic throughout; no private data. Three parts, each run on the tree the
+harness runs in (a tree without a symbol falls back to what main does):
+
+1. ``floor``: every inlet 10-40 degC on every entity minimum the gate can
+   take (none, 20, 25, 28, 30): how many cells write a heating step at the
+   floor at or below what a step that does not heat writes.
+2. ``window``: an owner-shaped set-point-driven install, configured
+   1.5-5.0 kW, whose synthetic pump truly runs up to 3.0 kW and idles at
+   0.30 kW. Its draw is a function of the set-point the tree writes and the
+   tank: idle below a 4 K lift, else ``min(3.0, 0.3 + 0.12 * lift)``. A day
+   of the levels a plan books (p_min 70 %, 2 kW 20 %, 3 kW 10 %) over tanks
+   18-34 degC is folded through ``draw_range.fold``; then a probe-shaped
+   window where every sample was written at the ceiling. Printed: engaged,
+   the learned (low, high), the idle draw.
+3. ``solves`` (skipped with ``--no-solves``): 16 synthetic installs -- UA
+   scale 0.6/1.7 x 750 L buffer or none x hot water off/on x set-point-driven
+   (levels ship rounded) or duty-cycling -- each solved at one spread price
+   day starting 21:00 and at its flat mean, with and without #2445's relaxed
+   start. Printed per cell and price: the sha1 of the published plan (the
+   byte-identity null across trees), the objective delta of the relaxed
+   start, the share of space kWh at near-floor levels (<= 1.1 x p_min) in
+   steps priced above the day's median, the cheapest quarter's share of
+   space kWh, and ``predicted_savings``. The failure count is printed last.
+"""
+from __future__ import annotations
+
+import hashlib
+import inspect
+import itertools
+import sys
+from datetime import datetime, timezone
+from types import SimpleNamespace as NS
+
+import numpy as np
+
+from harness import FakeHass, FakeState
+from heatpump_optimizer import draw_range, pump_arbiter
+from heatpump_optimizer import optimizer as opt_mod
+from heatpump_optimizer.optimizer import HeatPumpOptimizer, OptimizationConfig
+from heatpump_optimizer.thermal_model import ThermalModel, ThermalParameters, ThermalState
+from profiles import solve_inputs
+
+T0 = datetime(2026, 1, 12, 20, 0, tzinfo=timezone.utc)
+ENTITY = "number.flow"
+CFG_MIN, CFG_MAX, TRUE_MAX, IDLE_KW = 1.5, 5.0, 3.0, 0.30
+
+
+def write(kw: float, tank: float, entity_min: float | None = 20, duty: str = "space"):
+    attrs = {"max": 70} if entity_min is None else {"min": entity_min, "max": 70}
+    states = {ENTITY: FakeState("40", attributes=attrs),
+              "sensor.tank": FakeState(str(tank), unit="°C")}
+    return pump_arbiter._flow_target(NS(
+        config={"space_setpoint_entity": ENTITY, "buffer_tank_temp_entity": "sensor.tank"},
+        hass=FakeHass(states),
+        state=NS(outdoor_temperature=0.0, buffer_tank_temperature=tank,
+                 floor_return_temperature=None),
+        thermal=NS(params=None, curve_flow_temp=lambda _o: None),
+        params=NS(min_electrical_power=CFG_MIN, max_electrical_power=CFG_MAX),
+        plan=NS(timestamps=[T0], power_schedule=[kw]),
+    ), duty, T0)
+
+
+def floor_census() -> None:
+    cells = [(t, lo) for t in range(10, 41) for lo in (None, 20, 25, 28, 30)]
+    bad = [c for c in cells if not write(CFG_MIN, *c) > write(0.0, *c, duty="idle")]
+    print(f"floor: cells {len(cells)} heating floor at or below the gate {len(bad)} "
+          f"(first {bad[:3]})")
+
+
+def drawn(setpoint: float, tank: float) -> float:
+    lift = setpoint - tank
+    return IDLE_KW if lift < 4.0 else min(TRUE_MAX, 0.3 + 0.12 * lift)
+
+
+def fold_window(probe: bool) -> draw_range.DrawRange:
+    takes = "command" in inspect.signature(draw_range.fold).parameters
+    d = draw_range.DrawRange()
+    params = NS(min_electrical_power=CFG_MIN, max_electrical_power=CFG_MAX)
+    levels = [CFG_MIN] * 7 + [2.0] * 2 + [3.0]
+    gate = write(0.0, 20.0, duty="idle")
+    ceiling = write(CFG_MAX, 20.0)
+    for k in range(96):
+        tank = 18.0 + 16.0 * ((k * 5) % 17) / 16.0
+        if k % 4 == 0:  # an idle step at the gate
+            sp, split = gate, (0.0, 0.0)
+        else:
+            sp = ceiling if probe else write(levels[k % len(levels)], tank)
+            split = (CFG_MAX if probe else levels[k % len(levels)], 0.0)
+        cmd = NS(written_c=sp, gate_c=gate, ceiling_c=ceiling)
+        kw = {"command": cmd} if takes else {}
+        draw_range.fold(d, drawn(sp, tank), split, params, frozen=False,
+                        distorted=False, defrost=False, **kw)
+    return d
+
+
+def window_census() -> None:
+    for probe in (False, True):
+        d = fold_window(probe)
+        idle = getattr(d, "idle_kw", lambda: None)()
+        print(f"window {'probe' if probe else 'plan'}: running samples {len(d.samples)} "
+              f"engaged {d.engaged} observed {d.observed()} idle {idle} "
+              f"planned {d.planned(CFG_MIN, CFG_MAX)}")
+
+
+STEPS = np.arange(96)
+HOUR = (21.0 + STEPS / 4.0) % 24.0
+SPREAD = 1.6 * np.interp(
+    HOUR, [0, 3, 5, 7, 9, 12, 15, 17, 19, 21, 23, 24],
+    [0.65, 0.58, 0.62, 1.2, 1.35, 0.95, 0.9, 1.3, 1.5, 1.25, 0.85, 0.65],
+)
+FLAT = np.full(96, float(SPREAD.mean()))
+CELLS = list(itertools.product((0.6, 1.7), (750.0, 0.0), (False, True), (True, False)))
+
+
+def solve(cell, prices, relaxed: bool):
+    loss, buffer_l, dhw, rounded = cell
+    p = ThermalParameters()
+    if buffer_l:
+        p.mixing_valve_mode, p.buffer_tank_volume = "manual", buffer_l
+    p.min_electrical_power, p.max_electrical_power = CFG_MIN, CFG_MAX
+    p.dhw_enabled, p.house_heat_loss_scale = dhw, loss
+    opt = HeatPumpOptimizer(ThermalModel(p), OptimizationConfig(clamp_planned_levels=rounded))
+    kept = getattr(opt_mod, "_relaxed_starts", None)
+    if not relaxed and kept is not None:
+        opt_mod._relaxed_starts = lambda _opt, *args: args[-2]
+    try:
+        return opt.optimize(inputs=solve_inputs(
+            initial_state=ThermalState(
+                room_temperature=20.0, upper_floor_temperature=20.0,
+                lower_floor_temperature=20.0, slab_temperature=20.5,
+                outdoor_temperature=5.0, buffer_tank_temperature=24.0,
+                dhw_temperature=48.0,
+            ),
+            prices=prices, outdoor_temps=np.full(96, 5.0), start_time=T0,
+        ))
+    finally:
+        if kept is not None:
+            opt_mod._relaxed_starts = kept
+
+
+def shape(result, prices) -> tuple[float, float]:
+    plan = np.asarray(result.power_schedule, float)
+    kwh = plan.sum()
+    dear = prices > np.median(SPREAD)
+    near = (plan > 0) & (plan <= 1.1 * CFG_MIN) & dear
+    cheap = np.argsort(SPREAD, kind="stable")[:24]
+    return (float(plan[near].sum() / kwh) if kwh else 0.0,
+            float(plan[cheap].sum() / kwh) if kwh else 0.0)
+
+
+def solve_census() -> int:
+    failures = 0
+    for tag, prices in (("spread", SPREAD), ("flat", FLAT)):
+        lower = higher = same = 0
+        for cell in CELLS:
+            try:
+                fix, ctl = solve(cell, prices, True), solve(cell, prices, False)
+            except Exception as err:  # counted, never dropped
+                failures += 1
+                print(f"  {tag} {cell} failed: {err!r}")
+                continue
+            sha = hashlib.sha1(np.asarray(
+                fix.power_schedule + list(fix.dhw_power_schedule or []), float
+            ).tobytes()).hexdigest()[:12]
+            delta = float(fix.objective_value) - float(ctl.objective_value)
+            lower += delta < -1e-9
+            higher += delta > 1e-9
+            same += fix.power_schedule == ctl.power_schedule
+            near, cheap = shape(fix, prices)
+            print(f"  {tag} {cell} plan {sha} relaxed-delta {delta:+.3f} "
+                  f"near-floor-dear {near:.3f} cheap-quarter {cheap:.3f} "
+                  f"savings {float(fix.predicted_savings):.2f}")
+        print(f"{tag}: cells {len(CELLS)} relaxed start objective lower {lower} "
+              f"higher {higher} identical plan {same}")
+    return failures
+
+
+def main(argv: list[str]) -> int:
+    floor_census()
+    window_census()
+    failures = 0 if "--no-solves" in argv else solve_census()
+    print(f"failures {failures}")
+    return 1 if failures else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
diff --git a/dev/audit/harnesses/r10_setpoint_power.py b/dev/audit/harnesses/r10_setpoint_power.py
new file mode 100644
index 000000000..0608e8584
--- /dev/null
+++ b/dev/audit/harnesses/r10_setpoint_power.py
@@ -0,0 +1,90 @@
+"""R10-SETPOINT-POWER: the rounded-level flat band, census over synthetic installs.
+
+    PYTHONPATH=tests/hastub:custom_components:tests \\
+        python3 dev/audit/harnesses/r10_setpoint_power.py
+
+Every cell is a synthetic 750 L buffered install behind a manual mixing valve
+whose levels ship rounded (``clamp_planned_levels``), p_min 1.5 kW, p_max
+5.5 kW: two-zone off/on x hot water off/on x heat-loss scale 0.6/1.0 x outdoor
+mean -4/+2 degC x starting tank 25/34 degC = 32 cells, one sinusoidal price
+day (1.3 +/- 0.9) and its flat mean. Each cell is solved twice per price
+vector on the tree it runs in: as shipped, and with
+``optimizer._relaxed_starts`` replaced by the identity (the control arm; on a
+tree without the function both arms are the tree). Printed per price vector:
+how many cells the shipped solve scores lower / higher by the plan's own
+``objective_value`` than the control arm, how many publish the identical plan,
+and the failure count. No private data: every input is written here.
+"""
+from __future__ import annotations
+
+import itertools
+from datetime import datetime, timezone
+
+import numpy as np
+
+from heatpump_optimizer import optimizer as opt_mod
+from heatpump_optimizer.optimizer import HeatPumpOptimizer, OptimizationConfig
+from heatpump_optimizer.thermal_model import ThermalModel, ThermalParameters, ThermalState
+from profiles import solve_inputs
+
+STEPS = np.arange(96)
+SPREAD = 1.3 + 0.9 * np.sin(2 * np.pi * (STEPS - 30) / 96.0)
+FLAT = np.full(96, float(SPREAD.mean()))
+CELLS = list(itertools.product(
+    (False, True), (False, True), (0.6, 1.0), (-4.0, 2.0), (25.0, 34.0),
+))
+
+
+def solve(cell: tuple, prices: np.ndarray, relaxed: bool) -> tuple[np.ndarray, float]:
+    two_zone, dhw, loss, out_mean, tank = cell
+    params = ThermalParameters()
+    params.mixing_valve_mode = "manual"
+    params.buffer_tank_volume = 750.0
+    params.min_electrical_power, params.max_electrical_power = 1.5, 5.5
+    params.two_zone_enabled, params.dhw_enabled = two_zone, dhw
+    params.house_heat_loss_scale = loss
+    outdoor = out_mean + 3.0 * np.sin(2 * np.pi * (STEPS - 50) / 96.0)
+    opt = HeatPumpOptimizer(ThermalModel(params), OptimizationConfig(clamp_planned_levels=True))
+    kept = getattr(opt_mod, "_relaxed_starts", None)
+    if not relaxed and kept is not None:
+        opt_mod._relaxed_starts = lambda _opt, *args: args[-2]
+    try:
+        result = opt.optimize(inputs=solve_inputs(
+            initial_state=ThermalState(
+                room_temperature=20.5, upper_floor_temperature=20.5,
+                lower_floor_temperature=20.5, slab_temperature=21.0,
+                outdoor_temperature=float(outdoor[0]),
+                buffer_tank_temperature=tank, dhw_temperature=50.0,
+            ),
+            prices=prices, outdoor_temps=outdoor,
+            start_time=datetime(2026, 1, 10, tzinfo=timezone.utc),
+        ))
+    finally:
+        if kept is not None:
+            opt_mod._relaxed_starts = kept
+    return np.asarray(result.power_schedule, float), float(result.objective_value)
+
+
+def main() -> int:
+    failures = 0
+    for tag, prices in (("spread", SPREAD), ("flat", FLAT)):
+        lower = higher = same = 0
+        for cell in CELLS:
+            try:
+                plan, value = solve(cell, prices, True)
+                ctl_plan, ctl_value = solve(cell, prices, False)
+            except Exception as err:  # counted, never dropped
+                failures += 1
+                print(f"  {tag} {cell} failed: {err}")
+                continue
+            lower += value < ctl_value - 1e-9
+            higher += value > ctl_value + 1e-9
+            same += bool(np.array_equal(plan, ctl_plan))
+        print(f"{tag}: cells {len(CELLS)} objective lower {lower} higher {higher} "
+              f"identical plan {same}")
+    print(f"failures {failures}")
+    return 1 if failures else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
