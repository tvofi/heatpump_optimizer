+    ThermalParameters as _SpTP,
+    ThermalState as _SpTS,
+)
+
+_SP_STEPS = np.arange(96)
+_SP_SPREAD = 1.3 + 0.9 * np.sin(2 * np.pi * (_SP_STEPS - 30) / 96.0)
