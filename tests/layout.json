{
 "_doc": "The target layout of the repository reorganisation (lane RO). Checked by tests/layout.py; the categories are ordered and a path must match exactly one. `retired` is generated with `python3 tests/layout.py --gen-retired <inventory.tsv>`; an entry's `since` names the pull request that made the move, and null means planned. `historical` prefixes keep the paths that were true when they were written (tvofi's D2), matched on a file's path or on where the move map puts it.",
 "categories": [
  {
   "name": "root",
   "why": "what GitHub, HACS and the release stamp read at the top level",
   "globs": [
    "README.md",
    "LICENSE",
    "NOTICE",
    "DISCLAIMER.md",
    "SECURITY.md",
    "RELEASE_NOTES.md",
    "VERSION",
    "hacs.json",
    ".gitignore",
    ".gitattributes"
   ]
  },
  {
   "name": "product",
   "why": "what an installation runs: the integration, and the blueprints whose source_url pins raw .../main/blueprints/",
   "globs": [
    "custom_components/**",
    "blueprints/automation/*.yaml"
   ]
  },
  {
   "name": "docs",
   "why": "product documentation, read by users; the page URLs stay stable for users and HACS",
   "globs": [
    "docs/{setup,configuration,automations,dashboard-card,ecl110,how-it-works,architecture}.md",
    "docs/img/brand/*",
    "docs/img/card/*",
    "docs/img/model/*",
    "docs/img/readme/*",
    "docs/img/setup/*",
    "docs/design/*/{design,plan}.md",
    "docs/index.html",
    "docs/site/**"
   ]
  },
  {
   "name": "tests",
   "why": "the gate: code, fixtures, ledgers and this manifest",
   "globs": [
    "tests/**"
   ]
  },
  {
   "name": "dev/governance",
   "why": "policy that binds every seat: canonical rules (D1), role contracts, dimension briefs, ADRs, policy-lint config",
   "globs": [
    "dev/governance/rules/*.md",
    "dev/governance/roles/*.md",
    "dev/governance/dimensions/*.md",
    "dev/governance/decisions/*.md",
    "dev/governance/config/*.json"
   ]
  },
  {
   "name": "dev/programme",
   "why": "the fix programme record: the living handover, the plan of record, delivery rows, live carries, rosters, the register",
   "globs": [
    "dev/programme/HANDOVER.md",
    "dev/programme/plan-*.md",
    "dev/programme/delivery/*.md",
    "dev/programme/carries/carry-*.json",
    "dev/programme/rosters/*.json",
    "dev/programme/register/*.md"
   ]
  },
  {
   "name": "dev/audit",
   "why": "how findings are produced, and their evidence",
   "globs": [
    "dev/audit/README.md",
    "dev/audit/config/*.json",
    "dev/audit/rounds/**",
    "dev/audit/rca/**",
    "dev/audit/harnesses/**",
    "dev/audit/waves/**"
   ]
  },
  {
   "name": "dev/archive",
   "why": "obsolete but still referenced: read-only, never linted as live",
   "globs": [
    "dev/archive/**"
   ]
  },
  {
   "name": "tools",
   "why": "executable instruments only, at the depth that keeps ROOT=../..",
   "globs": [
    "tools/policy/**",
    "tools/pr/**",
    "tools/audit/{judge_batch.py,check_scopes.py,prepare_baseline.sh,merge_throughput.py,worktree_gc.sh}",
    "tools/audit/seat/**",
    "tools/coverage/**",
    "tools/devices/**",
    "tools/release/**",
    "tools/merge/**",
    "tools/replay/**",
    "tools/site/**"
   ]
  },
  {
   "name": "agent-config",
   "why": "harness-specific files, each where its harness looks: root entry points, the .claude allowlist, generated rule copies",
   "globs": [
    "CLAUDE.md",
    "AGENTS.md",
    ".claude/settings.json",
    ".claude/hooks/*.sh",
    ".claude/skills/*/SKILL.md",
    ".claude/rules/*.md",
    ".claude/workflows/{audit,web}-*.js",
    ".claude/workflows/web-fragments.md",
    ".cursor/rules/*.mdc"
   ]
  },
  {
   "name": "ci",
   "why": "GitHub reads it only here",
   "globs": [
    ".github/**"
   ]
  }
 ],
