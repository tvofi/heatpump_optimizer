diff --git a/.claude/workflows/rule_frontmatter.mjs b/.claude/workflows/rule_frontmatter.mjs
new file mode 100644
index 00000000..dbd2801a
--- /dev/null
+++ b/.claude/workflows/rule_frontmatter.mjs
@@ -0,0 +1,11 @@
+// The ONE reader of a rule's `paths:` frontmatter (I4 fix demo). policy_lint.mjs
+// and rules_sync.mjs both import it; the algorithm is policy_lint's rulePaths.
+export function frontmatterPaths(raw) {
+  if (raw == null) return null
+  const fm = /^---\n([\s\S]*?)\n---/.exec(raw)
+  if (!fm) return null
+  const fmBody = fm[1] + '\n'
+  const block = /^paths:\n((?:[ \t]*-[ \t]*.*\n)+)/m.exec(fmBody)
+  if (!block) return null
+  return [...block[1].matchAll(/-\s*"([^"]+)"/g)].map((m) => m[1])
+}
