#!/bin/bash
# hpo-gh-shim
# The seat's gh (P284). Installed as `gh` beside the python shims by
# `seat_venv.sh --install-shims <dir>`. It appends ONE line per call to
# $HPO_STATE_DIR/gh-calls.log (default $HOME/.local/state/hpo):
#
#   <utc> <parent pid> <parent argv[0] [script], first 80 chars> <gh subcommand> <target>
#
# <target> is the api path (query string cut) for `gh api`, the verb for `pr`
# and `run` and any other subcommand with one, else `-`. The value of every
# flag is skipped, never logged: `-f`/`-F`/`--input` and the rest take their
# argument out of the line, and a token outside [A-Za-z0-9_./:-] is logged `?`.
# The caller is the point: the shared token's core bucket was spent twice
# with no host log naming who (P284); tools/audit/seat/gh_calls.py reads this.
# The parent command is argv[0]'s basename plus, for a shell or interpreter, at most one
# more word: its script or `-m <module>` as given, or the flag name alone of a `-c`, `-e`,
# `-s`, `--eval`, `--print` or `--command` option, any code attached to it cut off. An
# option the rule does not know ends the field unlogged; the field is cleaned and cut to
# 80 characters. argv[0] and the script path are logged by design: a secret placed in a
# path is logged too, `=` turned `?` (P284 residual). The state directory
# is created if missing (mkdir -p); a path that cannot be made is skipped, never fatal.
# A directory or log the shim creates is owner-only (umask 077), whatever the caller's umask,
# and an existing log (or its rotated .1) is set 0600 on each write.
#
# Then it execs the real gh -- the first `gh` on PATH that is a regular
# executable file and not a shim (line 2 above), past this file's own
# directory. stdin, stdout, exit status and signals are the real gh's own.
# A log it cannot write is skipped: no output, no status of its own.
# The log is capped: past HPO_GH_LOG_MAX bytes (default 1048576) it is moved
# to gh-calls.log.1, replacing the older one.
is_shim() { local l1= l2=; { IFS= read -r l1; IFS= read -r l2; } < "$1" 2>/dev/null; [ "$l2" = '# hpo-gh-shim' ]; }
usable() { [ -f "$1" ] && [ -x "$1" ] && ! is_shim "$1"; }
real=
ifs=$IFS; IFS=:
for d in $PATH; do
  [ -n "$d" ] || d=.
  if usable "$d/gh"; then real=$d/gh; break; fi
done
IFS=$ifs
[ -n "$real" ] || { echo "gh shim: no real gh on PATH" >&2; exit 127; }

sub=; verb=; third=; skip=0
for a in "$@"; do
  if [ $skip = 1 ]; then
    skip=0; continue
  fi
  case $a in
    -f|-F|--field|--raw-field|--input) skip=1 ;;
    -X|--method|-H|-q|-t|-p|-R|-B|-b|--body|--body-file|--header|--jq|--template|--hostname|--cache|--preview|--repo) skip=1 ;;
    -*) ;;
    *) if [ -z "$sub" ]; then sub=$a; elif [ -z "$verb" ]; then verb=$a; else third=$a; break; fi ;;
  esac
done
case $sub in
  api) verb=${verb%%\?*} ;;
  pr|run|workflow|issue|release|repo|search|label|cache|secret|variable) ;;
  *) verb= ;;
esac

# A subshell: the umask that makes the state dir and log owner-only (the log names
# callers) is its own, so the real gh below runs under the caller's.
(
  umask 077
  state=${HPO_STATE_DIR:-$HOME/.local/state/hpo}
  log=$state/gh-calls.log
  max=${HPO_GH_LOG_MAX:-1048576}
  # The parent field names the caller and nothing it was given: argv[0]'s basename and,
  # for a shell or interpreter, one more word. Options are read one letter at a time:
  # a known no-value letter is passed over; a known value-taking letter (python -W/-X,
  # shell -o/-O) ends the field unlogged, its value never read, so a value of one argv
  # word with a space in it is not split into a logged script; `c`, `e` or `s` (code on
  # the line, or a script on stdin) logs the option up to that letter and ends the field;
  # any other letter or long option ends it unlogged. The first word that is not an
  # option is the script and ends it. So no option value, code, stdin-script argument or
  # later word reaches the log, bar the argv[0]/script-path residual above (P284). ps
  # joins argv with spaces, so the line is split on spaces and a script path containing
  # a space is cut at it.
  pargs=$(ps -o args= -p "$PPID" </dev/null 2>/dev/null | tr -c '[:print:]' ' ')
  set -f; read -r -a pw <<< "$pargs"; set +f
  pcmd=${pw[0]##*/}
  case $pcmd in
    python|python[0-9]*|Python|pypy*) flags='[bBdEhiIOqPRSuvVx]' vals='[WX]' ;;
    sh|bash|zsh|dash|ksh) flags='[abfhiklmnprtuvxBCEHPT]' vals='[oO]' ;;
    node|perl|ruby) flags=w vals= ;;
    *) flags= ;;
  esac
  i=1 end=
  [ -n "$flags" ] || end=1
  while [ -z "$end" ] && [ "$i" -lt "${#pw[@]}" ]; do
    a=${pw[$i]}
    case $a in
      -m) pcmd="$pcmd -m ${pw[$((i + 1))]}"; end=1 ;;
      --eval|--eval=*|--print|--print=*|--command|--command=*) pcmd="$pcmd ${a%%=*}"; end=1 ;;
      --*) end=1 ;;
      -?*)
        j=1
        while [ "$j" -lt "${#a}" ]; do
          ch=${a:$j:1}
          case $ch in
            c|e|s) pcmd="$pcmd ${a:0:$((j + 1))}"; end=1; break ;;
            $vals) end=1; break ;;
            $flags) ;;
            *) end=1; break ;;
          esac
          j=$((j + 1))
        done ;;
      *) pcmd="$pcmd $a"; end=1 ;;
    esac
    i=$((i + 1))
  done
  pcmd=$(printf '%s' "$pcmd" | tr -c 'A-Za-z0-9_./: -' '?' | cut -c1-80)
  mkdir -p "$state"
  clean() { printf '%s' "${1:--}" | tr -c 'A-Za-z0-9_./:-' '?'; }
  if [ -f "$log" ]; then
    size=$(wc -c < "$log" 2>/dev/null)
    case $size in ''|*[!0-9' ']*) ;; *) [ "$((size + 0))" -gt "$max" ] && mv -f "$log" "$log.1" && chmod 600 "$log.1" ;; esac
  fi
  printf '%s %s %s %s %s\n' "$(date -u +%FT%TZ)" "$PPID" "${pcmd:--}" "$(clean "$sub")" "$(clean "$verb")" >> "$log"
  # umask governs creation only: a log an earlier shim wrote 0644 is made owner-only here
  chmod 600 "$log"
) 2>/dev/null || true

# The record-issue comment guard (R10-RAISE-GATE-SHIM; tools/pr/gh_comment.py's mandate_guard
# lives in that script alone, so a raw post bypassed it). DENY BY DEFAULT: a call that could
# write a comment on a record issue (#201, or its continuation) is refused unless the caller is python running the
# baked tree's gh_comment.py, or a checkout's tracked and unmodified one (by real path; below); it is let through only when it is on an explicit
# list of calls that cannot. The list is gh's own command table, not a list of spellings:
#   - no subcommand, or --version/--help alone: pass; any other leading flag: refused;
#   - `issue`: view/list/status/create pass; comment, close, reopen, edit, delete, lock,
#     unlock, pin, unpin, transfer and develop pass only with exactly one target that reads as
#     a plain number other than a tracker, under gh's own flag table (an unknown flag, or a
#     short-flag cluster, is refused: it could be a value that moves the target); any other
#     verb is refused;
#   - `pr`: refused when any word reads as a tracker's number (a PR cannot be the issue,
#     so this is belt and braces); otherwise passes;
#   - `api`: a call with no body field, no --input, no method but GET and no header but
#     Accept is a read and passes (flags read by gh api's own table, an unknown one refused with its own "unknown gh api flag" message;
#     the output-only --allow-escape-sequences is known);
#     a write is refused at issues/<tracker>/comments, at an unreadable path, at
#     issues/comments/<id> (a comment by id names no issue), and at graphql unless the
#     document has no `mutation` or `subscription` and is not read from a file or --input;
#   - the command groups with no issue-comment surface (workflow, release, run, repo, label,
#     auth, secret, variable, cache, config, gist, ssh-key, gpg-key, codespace, project,
#     ruleset, org, search, browse, status, completion, help, version, attestation) pass;
#   - everything else is refused: an unknown subcommand, a gh alias, an extension.
# The number is read after dropping leading zeros, a trailing slash, a query or anchor, one
# %-decoding and `.`/`..`/empty path segments, matched in lower case. Residual, by design: the caller test reads
# `ps` args, which a caller writes (`exec -a`), so a deliberate spoof of the parent passes
# (Carry: R10-RAISE-GATE-SHIM); the shim is a guard against a seat's habit, not an adversary.
# The trackers: budget_raise_gate.RECORD_ISSUES, the one definition (gh_calls.py's self-test
# pins this line to it). #201 hit GitHub's 2,500-comment cap; the record continues in the last.
trackers='201 3394'
# gh_comment.py's own path: seat_venv.sh --install-shims bakes the tree's into the next
# line; a shim run from its place in the tree derives it; anywhere else it stays empty,
# and then no caller passes.
gcpy=@HPO_GH_COMMENT@
case $gcpy in @*) case $0 in */tools/audit/seat/shims/*) gcpy=${0%/tools/audit/seat/shims/*}/tools/pr/gh_comment.py ;; *) gcpy= ;; esac ;; esac

# num <word>: the decimal number a word names, leading zeros dropped, or ? when it is not
# one plain number (a URL counts only as .../issues/<n> or .../pull/<n>)
num() {
  local w=$1 n p
  case $w in *\\*) printf '?'; return ;; esac
  w=${w%%[#?]*}; w=${w#\#}
  case $w in *%*) w=$(printf '%b' "${w//%/\\x}"); case $w in *[%#?\\]*) printf '?'; return ;; esac ;; esac
  while [ "${w%/}" != "$w" ]; do w=${w%/}; done
  case $w in
    */*) n=${w##*/}; p=${w%/*}; case ${p##*/} in issues|pull) ;; *) printf '?'; return ;; esac ;;
    *) n=$w ;;
  esac
  case $n in ''|*[!0-9]*) printf '?'; return ;; esac
  n=${n#"${n%%[!0]*}"}
  printf '%s' "${n:-0}"
}
# norm <path>: the path's segments after %-decoding, dropping a URL's scheme and host, a query
# or anchor, and `.`/`..`/empty segments, and lower-casing every letter (a path segment is
# matched in lower case: `ISSUES/201/COMMENTS` is a tracker's), into NSEG; 1 when it cannot be read
norm() {
  local w=$1 IFS=/ seg
  local -a segs
  NSEG=()
  case $w in *\\*|*$'\n'*) return 1 ;; esac
  w=${w%%[#?]*}
  case $w in *%*) w=$(printf '%b' "${w//%/\\x}"); case $w in *[%#?\\]*|*$'\n'*) return 1 ;; esac ;; esac
  case $w in *://*) w=${w#*://}; w=${w#*/} ;; esac
  w=$(printf '%s' "$w" | tr 'A-Z' 'a-z')
  set -f; read -r -a segs <<< "$w"; set +f
  for seg in "${segs[@]}"; do
    case $seg in
      ''|.) ;;
      ..) [ "${#NSEG[@]}" -gt 0 ] && NSEG=("${NSEG[@]:0:$((${#NSEG[@]} - 1))}") ;;
      *) NSEG+=("$seg") ;;
    esac
  done
  return 0
}
# has <list> <word>: 0 when the space-separated list holds the word
has() { case " $1 " in *" $2 "*) return 0 ;; esac; return 1; }
# rp <file>: the physical path of an existing regular file that is not a symlink, else nothing
rp() {
  local p=$1 d
  case $p in /*) ;; *) p=$PWD/$p ;; esac
  { [ -f "$p" ] && [ ! -L "$p" ]; } || return 1
  d=$(cd "${p%/*}" 2>/dev/null && pwd -P) || return 1
  printf '%s/%s' "$d" "${p##*/}"
}

ISSUE_VAL='-b --body -F --body-file -R --repo -c --comment -r --reason -t --title -a --assignee --add-assignee --remove-assignee -l --label --add-label --remove-label -m --milestone -p --project --add-project --remove-project -T --template -d --duplicate-of'
ISSUE_BOOL='-w --web -e --editor --edit-last --create-if-none --delete-last --yes --remove-milestone -h --help'
issue_gate() {
  local a skip=0 t verb bad=
  local -a pos=()
  shift
  for a in "$@"; do
    if [ $skip = 1 ]; then skip=0; continue; fi
    case $a in
      --) bad=1 ;;
      --*=*) has "$ISSUE_VAL" "${a%%=*}" || bad=1 ;;
      --*|-?) if has "$ISSUE_VAL" "$a"; then skip=1; elif ! has "$ISSUE_BOOL" "$a"; then bad=1; fi ;;
      -*) has "$ISSUE_VAL" "${a:0:2}" || bad=1 ;;
      *) pos+=("$a") ;;
    esac
  done
  verb=${pos[0]:-}
  case $verb in
    ''|view|list|status|create) return 0 ;;
    comment|close|reopen|edit|delete|lock|unlock|pin|unpin|transfer|develop)
      [ -z "$bad" ] && [ "${#pos[@]}" -eq 2 ] || return 1
      t=$(num "${pos[1]}"); [ "$t" != '?' ] && ! has "$trackers" "$t" ;;
    *) return 1 ;;
  esac
}
pr_gate() {
  local a
  shift
  for a in "$@"; do
    case $a in -*) ;; *) has "$trackers" "$(num "$a")" && return 1 ;; esac
  done
  return 0
}
API_VAL='-q --jq -t --template -p --preview --hostname --cache'
API_BOOL='--paginate --slurp -i --include --silent --verbose -h --help --allow-escape-sequences'
api_gate() {
  local a skip= path= meth= write= fields= unread= k t nxt low
  local -a pos=()
  shift
  for a in "$@"; do
    if [ -n "$skip" ]; then
      case $skip in
        m) meth=$a ;;
        f) write=1; fields="$fields $a"; case $a in *=@*) unread=1 ;; esac ;;
        i) write=1; unread=1 ;;
        h) case $a in [Aa]ccept:*) ;; *) write=1 ;; esac ;;
      esac
      skip=; continue
    fi
    case $a in
      -X|--method) skip=m ;;
      -X?*) meth=${a#-X} ;;
      --method=*) meth=${a#*=} ;;
      -f|-F|--field|--raw-field) skip=f ;;
      -f?*|-F?*) a=${a#-?}; write=1; fields="$fields $a"; case $a in *=@*) unread=1 ;; esac ;;
      --field=*|--raw-field=*) a=${a#*=}; write=1; fields="$fields $a"; case $a in *=@*) unread=1 ;; esac ;;
      --input) skip=i ;;
      --input=*) write=1; unread=1 ;;
      -H|--header) skip=h ;;
      --header=*) case ${a#*=} in [Aa]ccept:*) ;; *) write=1 ;; esac ;;
      -H?*) case ${a#-H} in [Aa]ccept:*) ;; *) write=1 ;; esac ;;
      --*=*) has "$API_VAL" "${a%%=*}" || { unk=${a%%=*}; return 1; } ;;
      --*|-?) if has "$API_VAL" "$a"; then skip=v; elif ! has "$API_BOOL" "$a"; then unk=$a; return 1; fi ;;
      -*) has "$API_VAL" "${a:0:2}" || { unk=${a:0:2}; return 1; } ;;
      *) pos+=("$a") ;;
    esac
  done
  [ "${#pos[@]}" -le 1 ] || return 1
  path=${pos[0]:-}
  if [ -z "$write" ]; then
    case ${meth:-GET} in GET|get) return 0 ;; esac
  fi
  norm "$path" || return 1
  low=$(printf '%s' "$fields" | tr 'A-Z' 'a-z')
  k=0
  while [ "$k" -lt "${#NSEG[@]}" ]; do
    case ${NSEG[$k]} in
      graphql)
        [ -z "$unread" ] || return 1
        case $low in *mutation*|*subscription*) return 1 ;; esac ;;
      issues)
        nxt=${NSEG[$((k + 1))]:-}
        [ "$nxt" = comments ] && return 1
        if [ "${NSEG[$((k + 2))]:-}" = comments ]; then
          t=$(num "$nxt"); { [ "$t" != '?' ] && ! has "$trackers" "$t"; } || return 1
        fi ;;
    esac
    k=$((k + 1))
  done
  return 0
}
gate() {
  case ${1-} in
    '') return 0 ;;
    --version|--help|-h) [ $# -eq 1 ] ;;
    -*) return 1 ;;
    api) api_gate "$@" ;;
    issue) issue_gate "$@" ;;
    pr) pr_gate "$@" ;;
    workflow|release|run|repo|label|auth|secret|variable|cache|config|gist|ssh-key|gpg-key|codespace|project|ruleset|org|search|browse|status|completion|help|version|attestation) return 0 ;;
    *) return 1 ;;
  esac
}
gate "$@" || hit=1
if [ -n "${hit:-}" ]; then
  gcp=$(ps -o args= -p "$PPID" </dev/null 2>/dev/null | tr -c '[:print:]' ' ')
  set -f; read -r -a gw <<< "$gcp"; set +f
  ok=
  # python's own option table (as the parent field above reads it): the script is the first
  # word that is not an option nor an option's value; -c, -m and any option unknown end it
  case ${gw[0]##*/} in python|python[0-9]*)
    i=1 script=
    while [ "$i" -lt "${#gw[@]}" ]; do
      w=${gw[$i]}
      case $w in
        --*) break ;;
        -?*)
          j=1
          while [ "$j" -lt "${#w}" ]; do
            case ${w:$j:1} in
              [bBdEhiIOqPRSuvVx]) ;;
              [WX]) [ "$((j + 1))" -eq "${#w}" ] && i=$((i + 1)); break ;;
              *) break 2 ;;
            esac
            j=$((j + 1))
          done ;;
        *) script=$w; break ;;
      esac
      i=$((i + 1))
    done
    if [ -n "$script" ] && [ -n "$gcpy" ]; then
      a=$(rp "$script") && b=$(rp "$gcpy") && [ "$a" = "$b" ] && ok=1
      # Another checkout's gh_comment.py (R10-GH-READ-RESIDUE, P449; SHIM-COMMENT-GUARD-ONE-CHECKOUT,
      # P591): the daemons' PATH carries one install, and three live checkouts run seat tools.
      # Admitted by real path <root>/tools/pr/gh_comment.py when <root> is a checkout of this
      # repository (it tracks this shim) and the script is tracked and unmodified against HEAD,
      # so its mandate_guard is the committed one. A file merely so named, an untracked one, or
      # one with a local edit stays refused.
      if [ -z "$ok" ] && [ -n "$a" ]; then
        case $a in */tools/pr/gh_comment.py)
          troot=${a%/tools/pr/gh_comment.py}
          git -C "$troot" ls-files --error-unmatch tools/audit/seat/shims/seat-gh >/dev/null 2>&1 \
            && git -C "$troot" ls-files --error-unmatch tools/pr/gh_comment.py >/dev/null 2>&1 \
            && git -C "$troot" diff --quiet HEAD -- tools/pr/gh_comment.py >/dev/null 2>&1 \
            && ok=1 ;;
        esac
      fi
    fi ;;
  esac
  [ -z "$ok" ] && [ -n "${unk:-}" ] && { echo "gh shim: unknown gh api flag ${unk//[![:print:]]/?}; refused" >&2; exit 1; }
  [ -n "$ok" ] || { echo "gh shim: a comment write on a record issue (#${trackers// /, #}) goes through tools/pr/gh_comment.py (its mandate guard refuses a post that voids a mandate); refused" >&2; exit 1; }
fi

exec "$real" "$@"
