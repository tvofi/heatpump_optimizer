+# --- the shell hazards a diff ADDS to tools/**/*.sh (R10-PREPR-DARWIN-SELFTEST-LANE) ---
+# Two shapes reached CI as a red no cheaper detector read. (1) A raw `wc` count
+# compared as a string: BSD `wc` pads it ("       1"), so the compare passed on
+# every Linux host and failed on the macOS seat alone (#3455; two more instances
+# in round 10, dev/audit/rca/R10-RCA-PREPR-DARWIN-SELFTEST.md). (2) An early-exit
+# reader on a pipe under `pipefail`: the reader leaves at its match, the writer takes
+# SIGPIPE, and a found match reads 141 once the producer outgrows the pipe buffer
+# (dev/audit/rca/R10-RCA-FAMILY-PIPEFAIL-SIGPIPE.md). Only ADDED lines are read, so
+# the sites already in the tree cost nothing; a comment line is skipped, and a line
+# carrying `shell-hazard-ok` with its reason is the reviewer-visible opt-out.
+# Known shape only: a count assigned and compared on a later line is not seen.
+# The patterns are written as classes (`[ ]`) so this file's own lines are not sites.
+SHELL_HAZARD_AWK='
+/^\+\+\+ / { f = substr($0, 7); next }
+/^@@/ { s = $0; sub(/^@@ -[0-9,]+ \+/, "", s); sub(/[ ,].*/, "", s); n = s + 0; next }
+/^\+/ {
+  t = substr($0, 2); ln = n; n++
+  if (t ~ /^[ \t]*#/ || index(t, "shell-hazard-ok")) next
+  if (t !~ /(-eq|-ne|-lt|-gt|-le|-ge|\(\()/ && match(t, /\$\([^()]*wc[ \t]+-[lcwm][^()]*\)/)) {
+    seg = substr(t, RSTART, RLENGTH)
+    if (seg !~ /\|[ \t]*(tr|awk|sed|xargs|cut)([ \t]|$)/ &&
+        (t ~ /(^|[;&|(])[ \t]*st[ \t]+"\$\(/ || t ~ /\[\[?[ \t][^]]*(==?|!=)/ || t ~ /case[ \t]+"?\$\(/)) {
+      printf "wc\t%s\t%d\t%s\n", f, ln, t; next
+    }
+  }
+  if (t ~ /\|\|[ \t]*(true|:)([ \t;)]|$)/) next
+  if (t ~ /(^|[^|])\|[ \t]*grep[ \t]+(-[a-zA-Z0-9]*[qm]|--quiet|--max-count)/) {
+    printf "pipe\t%s\t%d\t%s\n", f, ln, t; next
+  }
+  if (t ~ /(^|[^|])\|[ \t]*head([ \t]|$)/ &&
+      (t ~ /(^|[ \t;(])(if|while|until)[ \t]/ || t ~ /&&|\|\|/ || t ~ /(^|[ \t;(])![ \t]/))
+    printf "head\t%s\t%d\t%s\n", f, ln, t
+}'
+shell_hazard_sites() { # base -> one `file:line: kind: text` per site, then the repairs; rc 0 none, 1 found
+  local cand kind f ln txt pf_yes=$'\n' pf_no=$'\n' out='' kinds=' '
+  cand=$(git diff -U0 --no-renames --diff-filter=AM "$1"...HEAD -- 'tools/*.sh' 2>/dev/null | awk "$SHELL_HAZARD_AWK")
+  while IFS=$'\t' read -r kind f ln txt; do
+    [ -n "$kind" ] || continue
+    if [ "$kind" != wc ]; then # a pipe only bites a script that sets pipefail, as the head's copy reads it
+      case "$pf_no" in *$'\n'"$f"$'\n'*) continue ;; esac
+      case "$pf_yes" in *$'\n'"$f"$'\n'*) ;; *)
+        if awk '/^[ \t]*#/ { next } /pipefail/ { p = 1 } END { exit !p }' <<<"$(git show "HEAD:$f" 2>/dev/null)"; then
+          pf_yes="$pf_yes$f"$'\n'
+        else pf_no="$pf_no$f"$'\n'; continue; fi ;;
+      esac
+    fi
+    txt=${txt#"${txt%%[![:space:]]*}"}
