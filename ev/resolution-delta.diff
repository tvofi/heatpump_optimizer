+def _run_case(case: str, prog: Path, shim: Path, w: Path) -> dict:
+    fn = CASES[case]
+    w.mkdir(parents=True, exist_ok=True)
+    if case == "6":
+        return fn(prog, w, shim)
+    return fn(prog, w)
