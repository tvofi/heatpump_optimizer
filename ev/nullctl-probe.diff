diff --git a/tools/audit/seat/pr_args.sh b/tools/audit/seat/pr_args.sh
index 7df0b7106..d220c1e1c 100644
--- a/tools/audit/seat/pr_args.sh
+++ b/tools/audit/seat/pr_args.sh
@@ -860,7 +860,7 @@ print("free")' "$1"
     # Those two mutants' holders free the lock only after the detach that follows the mark, so their
     # arms wait for the lock free, bounded at 10 s, a third of the stub's 30 s push: held at the bound
     # is a holder that drains (#2825 round 3: one read at the mark was red in 4 of 6 runs under load).
-    case $1 in drain | pushhold) untilfree "$lf" 200 ;; esac
+    t0=$(date +%s.%N); case $1 in drain | pushhold | ctl) untilfree "$lf" 200 ;; esac; echo "$1 $(date +%s.%N) $t0" >> "$NULLW"
     lockstate "$lf" > "$t/state"; cut -d' ' -f3 "$lf" 2>/dev/null > "$t/mark" || :; wtstate > "$t/wt1"
     [ "$sig$1" != KILL- ] || { touch "$REAP_DIR/fast"; updt 2 "$sd"; }  # every later run's stub exits at once
     rclean; untilfree "$lf"; lockstate "$lf" > "$t/after"; wtstate > "$t/wt2"
@@ -889,6 +889,9 @@ print("free")' "$1"
   sigrun pushhold KILL 2>/dev/null
   ck "  mutant mut:pushhold (its line deleted): the push holds no lock, so the holder lets go while it runs" \
      "$( [ "$(cat "$t/treen")" = 4 ] && [ "$(cat "$t/state")" = free ] && echo 0 || echo 1 )"
+  sigrun ctl KILL 2>/dev/null
+  ck "  NULLCTL: no line deleted, the correct holder reads held at the drain/pushhold bound" \
+     "$( [ "$(cat "$t/treen")" = 4 ] && [ "$(cat "$t/state")" = held ] && echo 0 || echo 1 )"
   for g in grpTERM grpHUP; do
     sigrun - $g 2>/dev/null
     ck "update_pr: ${g#grp} to the run's whole group: the holder outlives it and drains, letting go once nothing of the push holds its lock" \
