  "new": "(\"$HPO_RELAY_BODYPUSH\" \"$topic\" \"$body\")"
 },
 {
  "name": "rv-real-bodypush-outside-wt",
  "file": "tools/audit/seat/cloud_relay.sh",
  "old": "(cd \"$wt\" && bash \"$HERE/body_push.sh\"",
  "new": "(bash \"$HERE/body_push.sh\""
 },
 {
  "name": "rv-privref-not-deleted",
  "file": "tools/audit/seat/cloud_relay.sh",
  "old": "git update-ref -d \"refs/hpo-relay/fold/$topic\" 2>/dev/null",
  "new": "true"
 },
 {
  "name": "rv-nohandoff-not-on-level",
  "file": "tools/audit/seat/cloud_relay.sh",
  "old": "if [ $rc = 0 ]; then echo \"$topic $bsha\" >> \"$state/cloud-folded\"",
  "new": "if [ $rc = 0 ] || [ -z \"$htip\" ]; then echo \"$topic $bsha\" >> \"$state/cloud-folded\""
 },
 {
  "name": "r3-folded-skip-off",
  "file": "tools/audit/seat/cloud_relay.sh",
  "old": "[ -f \"$state/cloud-folded\" ] && grep -qxF \"$topic $bsha\" \"$state/cloud-folded\" && continue",
  "new": "[ -f \"$state/cloud-folded\" ] && grep -qxF \"$topic $bsha\" \"$state/cloud-folded\" && true"
 },
 {
  "name": "rv3-folded-skip-topic-only",
  "file": "tools/audit/seat/cloud_relay.sh",
  "old": "[ -f \"$state/cloud-folded\" ] && grep -qxF \"$topic $bsha\" \"$state/cloud-folded\" && continue",
  "new": "[ -f \"$state/cloud-folded\" ] && grep -q \"^$topic \" \"$state/cloud-folded\" && continue"
 },
 {
  "name": "rv3-folded-not-recorded",
  "file": "tools/audit/seat/cloud_relay.sh",
  "old": "echo \"$topic $bsha\" >> \"$state/cloud-folded\";",
  "new": "true;"
 },
 {
  "name": "rv3-wt-not-removed",
  "file": "tools/audit/seat/cloud_relay.sh",
  "old": "git worktree remove --force \"$wt\" 2>/dev/null; git update-ref",
