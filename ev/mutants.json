 },
 {
  "name": "rv-blocked-never-stands",
  "file": "tools/audit/seat/cloud_relay.sh",
  "old": "blocked:*|folded:*) return 0;;",
  "new": "folded:*) return 0;;"
 },
 {
  "name": "rv-memo-not-saved",
  "file": "tools/audit/seat/cloud_relay.sh",
  "old": "mv -f \"$memo.$$\" \"$memo\";",
  "new": "rm -f \"$memo.$$\";"
 },
 {
  "name": "rv-stub-outside-wt",
  "file": "tools/audit/seat/cloud_relay.sh",
