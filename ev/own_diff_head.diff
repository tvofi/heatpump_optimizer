+                "          bash tools/{n}.sh --self-test | tee \"$RUNNER_TEMP/{n}.txt\"\n"
+                "          grep -Eq '^{n} self-test: [1-9][0-9]* checks, 0 failed$' \"$RUNNER_TEMP/{n}.txt\"\n")
