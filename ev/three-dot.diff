index 000000000..af6078a0f
--- /dev/null
+++ b/tools/audit/seat/sweep_gantt.py
@@ -0,0 +1,252 @@
+#!/usr/bin/env python3
+"""Compare the live state against the plan's Gantt and print each unacknowledged slip.
+
+sweep_gantt.py --plan PLAN.json --baseline BASE.json --acks ACKS.txt --roster ROSTER.json
+               --open-prs PRS.json (--handoffs REFS.txt | --handoff-rows ROWS.tsv)
+               (--fired LEDGER.txt) [--now ISO]
+sweep_gantt.py --self-test
+
+Owner ruling (tvofi 2026-11-01): each time the plan html is updated, compare the
+real state against the gantt, mechanically if possible, and surface slips to act on,
+defer or accept. Owner ruling (2026-11-06): a handoff already in main is not work in
+flight, and an old fire line kept a finished group busy, so BOTH busy inputs are
+bounded to the last 12 h (LIVE_H) before they count:
+  live_handoffs(rows, now)  keeps a `<sha> <ref> <committer-unix>` row only when its
+                            tip was committed within 12 h (merged or squashed
+                            handoffs keep old tips) and returns the refs;
+  recent_fired(lines, now)  keeps a ledger line only when its leading UTC stamp is
+                            within 12 h.
+`--handoffs` takes the file of refs and `--fired` the ledger; the `--handoff-rows`
+and `--fired-ledger` forms apply the 12 h filters here, so the runner has no
+second copy of them. Both filters are applied at their one owner, this file.
+
+Slip kinds, one line each, `GANTT-SLIP <KEY> <detail>`:
+  IDLE:<group>     the plan starts the group by now (+GRACE) and nothing is working on it:
+                   no open PR, no handoff ref, no FIRED line naming its topic or group.
+                   A critical-path group is tagged CP.
+  LATE:<group>     its planned finish moved more than GROUP_H hours past the baseline's.
+  CLOSURE          the plan's closure moved more than CLOSURE_H hours past the baseline's.
+The baseline is the plan as last accepted; a missing baseline is seeded from --plan.
+
+Acks file, one per line: `<ISO> <KEY> act|defer|accept [until=<ISO>] <reason>`.
+  act / defer   silence KEY until `until` (default: 6 h after the ack's own time).
+  accept        silence KEY for good AND re-baseline it (LATE: that group's finish;
+                CLOSURE: the whole plan), so only a further slip reports again.
+"""
+import argparse, datetime as dt, json, re, sys
+
+GRACE_MIN = 60
+GROUP_H = 6.0
+CLOSURE_H = 2.0
+ACT_DEFAULT_H = 6.0
+CLOSED_STAGES = {"done", "rca-done"}
+LIVE_H = 12.0
+
+
+def ts(s):
+    return dt.datetime.fromisoformat(str(s).replace("Z", "+00:00"))
+
+
+def iso(t):
+    return t.strftime("%Y-%m-%dT%H:%MZ")
+
+
+def topic_of(name, group):
+    br = ((group or {}).get("resume") or {}).get("branch") or ""
+    t = br.split("/", 1)[1] if "/" in br else br
+    if t:
+        return t
+    return "r10-" + name[len("R10-"):].lower() if name.startswith("R10-") else name.lower()
+
+
+def live_handoffs(rows, now):
+    """`<sha>\\t<ref>\\t<committer-unix>` rows -> refs whose tip is at most LIVE_H old."""
+    cut = now.timestamp() - LIVE_H * 3600
+    out = []
+    for r in rows:
+        p = r.split("\t")
+        if len(p) >= 3 and p[2].strip().isdigit() and int(p[2]) >= cut:
+            out.append(p[1])
+    return out
+
+
+def recent_fired(lines, now):
+    """Ledger lines whose leading `YYYY-MM-DDTHH:MM[:SS]Z` stamp is at most LIVE_H old."""
+    cut = now - dt.timedelta(hours=LIVE_H)
+    out = []
+    for l in lines:
+        m = re.match(r"(\d{4}-\d\d-\d\dT\d\d:\d\d(?::\d\d)?)Z", l)
+        if m and ts(m.group(1) + "+00:00") >= cut:
+            out.append(l)
+    return out
+
+
+def read_acks(lines, now):
+    live, accepted = {}, set()
+    for ln in lines:
+        p = ln.split()
+        if len(p) < 3 or p[2] not in ("act", "defer", "accept"):
+            continue
+        at, key, verb = ts(p[0]), p[1], p[2]
+        if verb == "accept":
+            accepted.add(key)
+            continue
+        m = re.search(r"until=(\S+)", ln)
+        until = ts(m.group(1)) if m else at + dt.timedelta(hours=ACT_DEFAULT_H)
+        if until > now:
+            live[key] = until
+    return live, accepted
+
+
+def rebaseline(base, plan, accepted):
+    """Fold accepted keys into the baseline; return (baseline, changed)."""
+    changed = False
+    if "CLOSURE" in accepted and base.get("accepted_closure") != plan["summary"]["closure"]:
+        base = {"summary": dict(plan["summary"]), "groups": {n: {"finish": g.get("finish")} for n, g in plan["groups"].items()},
+                "accepted_closure": plan["summary"]["closure"], "accepted": sorted(accepted)}
+        return base, True
+    for key in accepted:
+        if key.startswith("LATE:"):
+            n = key[5:]
+            f = plan["groups"].get(n, {}).get("finish")
+            if f and base["groups"].get(n, {}).get("finish") != f and n not in base.get("accepted_groups", {}):
+                base["groups"].setdefault(n, {})["finish"] = f
+                base.setdefault("accepted_groups", {})[n] = f
+                changed = True
+    return base, changed
+
+
+def slips(plan, base, roster, open_prs, handoffs, fired, now):
+    groups = {g["group"]: g for g in roster}
+    cp = set(plan.get("critical_path") or [])
+    out = []
+    pr_titles = [p.get("title", "") for p in open_prs]
+    for n, g in sorted(plan["groups"].items()):
+        if g.get("done"):
+            continue
+        stage = ((groups.get(n) or {}).get("resume") or {}).get("stage")
+        if stage in CLOSED_STAGES:
+            continue
+        start = g.get("start")
+        if start and ts(start) <= now + dt.timedelta(minutes=GRACE_MIN):
+            topic = topic_of(n, groups.get(n))
+            busy = (any(n in t for t in pr_titles)
+                    or any(r.endswith("/" + topic) or r.endswith("/" + topic + "-p2") or ("/" + topic + "-") in r for r in handoffs)
+                    or any(n in f or topic in f for f in fired))
+            if not busy:
+                out.append((0 if n in cp else 1, f"IDLE:{n}", f"{'CP ' if n in cp else ''}planned start {iso(ts(start))}, stage {stage}, no PR, handoff or fire"))
+        bf = (base.get("groups", {}).get(n) or {}).get("finish")
+        if bf and g.get("finish"):
+            h = (ts(g["finish"]) - ts(bf)).total_seconds() / 3600
+            if h > GROUP_H:
+                out.append((0 if n in cp else 2, f"LATE:{n}", f"{'CP ' if n in cp else ''}finish {iso(ts(g['finish']))}, {h:+.1f} h vs baseline {iso(ts(bf))}"))
+    c, bc = plan["summary"]["closure"], base["summary"]["closure"]
+    h = (ts(c) - ts(bc)).total_seconds() / 3600
+    if h > CLOSURE_H:
+        out.append((0, "CLOSURE", f"closure {iso(ts(c))}, {h:+.1f} h vs baseline {iso(ts(bc))}"))
+    return [(k, d) for _, k, d in sorted(out)]
+
+
+def run(a):
+    now = ts(a.now) if a.now else dt.datetime.now(dt.timezone.utc)
+    plan = json.load(open(a.plan))
+    try:
+        base = json.load(open(a.baseline))
+    except FileNotFoundError:
+        base = {"summary": dict(plan["summary"]), "groups": {n: {"finish": g.get("finish")} for n, g in plan["groups"].items()},
+                "seeded": iso(now)}
+        json.dump(base, open(a.baseline, "w"), indent=1)
+        print(f"GANTT-BASELINE seeded closure {base['summary']['closure']}")
+    try:
+        ack_lines = open(a.acks).read().splitlines()
+    except FileNotFoundError:
+        ack_lines = []
+    live, accepted = read_acks(ack_lines, now)
+    base, changed = rebaseline(base, plan, accepted)
+    if changed:
+        json.dump(base, open(a.baseline, "w"), indent=1)
+        print(f"GANTT-BASELINE re-baselined (accepted: {', '.join(sorted(accepted))})")
+    roster = json.load(open(a.roster))
+    roster = roster["groups"] if isinstance(roster, dict) else roster
+    prs = json.load(open(a.open_prs))
+    if a.handoff_rows:
+        handoffs = live_handoffs(open(a.handoff_rows).read().splitlines(), now)
+    else:
+        handoffs = [l.split()[-1] for l in open(a.handoffs).read().splitlines() if l.strip()]
+    fired = [l for l in recent_fired(open(a.fired).read().splitlines(), now) if "FIRED" in l]
+    n = 0
+    for key, detail in slips(plan, base, roster, prs, handoffs, fired, now):
+        if key in live or key in accepted:
+            continue
+        print(f"GANTT-SLIP {key} {detail} -> ack: {iso(now)} {key} act|defer|accept [until=ISO] <reason> >> {a.acks}")
+        n += 1
+    return 0
+
+
+def self_test():
+    now = ts("2026-11-01T18:00:00Z")
+    plan = {"critical_path": ["G-CP"], "summary": {"closure": "2026-11-05T04:00:00Z"},
+            "groups": {"G-CP": {"start": "2026-11-01T17:00:00Z", "finish": "2026-11-02T04:00:00Z", "done": False},
+                       "G-BUSY": {"start": "2026-11-01T17:00:00Z", "finish": "2026-11-02T04:00:00Z", "done": False},
+                       "G-LATER": {"start": "2026-11-03T00:00:00Z", "finish": "2026-11-03T20:00:00Z", "done": False},
+                       "G-DONE": {"start": None, "finish": None, "done": True}}}
+    base = {"summary": {"closure": "2026-11-04T00:00:00Z"},
+            "groups": {"G-CP": {"finish": "2026-11-02T04:00:00Z"}, "G-LATER": {"finish": "2026-11-03T08:00:00Z"}}}
+    roster = [{"group": "G-CP", "resume": {"stage": "carries-open"}},
+              {"group": "G-BUSY", "resume": {"stage": "in-progress", "branch": "handoff/r10-busy"}},
+              {"group": "G-LATER", "resume": {"stage": "not-started"}}, {"group": "G-DONE", "resume": {"stage": "done"}}]
+    got = dict(slips(plan, base, roster, [], ["x refs/heads/handoff/r10-busy"], [], now))
+    want = {"IDLE:G-CP", "LATE:G-LATER", "CLOSURE"}
+    assert set(got) == want, got
+    assert got["IDLE:G-CP"].startswith("CP "), got
+    # null control: the busy group is silent because of its handoff; remove it and it fires
+    got2 = dict(slips(plan, base, roster, [], [], [], now))
+    assert "IDLE:G-BUSY" in got2, got2
+    # a FIRED line naming the group's topic also counts as busy
+    got3 = dict(slips(plan, base, roster, [], [], ["2026-11-01T17:08:35Z FIRED G-CP p2"], now))
+    assert "IDLE:G-CP" not in got3, got3
+    # acks: act silences for 6 h by default, expired act does not, accept re-baselines
+    live, acc = read_acks(["2026-11-01T17:30Z IDLE:G-CP act fixer firing",
+                           "2026-11-01T08:00Z LATE:G-LATER defer waits on X",
+                           "2026-11-01T17:40Z CLOSURE accept owner ruled"], now)
+    assert "IDLE:G-CP" in live and "LATE:G-LATER" not in live and acc == {"CLOSURE"}, (live, acc)
+    nb, ch = rebaseline(base, plan, acc)
+    assert ch and nb["summary"]["closure"] == plan["summary"]["closure"]
+    assert "CLOSURE" not in dict(slips(plan, nb, roster, [], [], [], now))
+    nb2, ch2 = rebaseline(base, plan, {"LATE:G-LATER"})
+    assert ch2 and "LATE:G-LATER" not in dict(slips(plan, nb2, roster, [], [], [], now))
+    # 12 h filters (2026-11-06); a null control beside each: the same input inside the window counts
+    now2 = ts("2026-11-06T12:00:00Z")
+    hrs = lambda h: int(now2.timestamp() - h * 3600)
+    rows = [f"aaa\trefs/heads/handoff/r10-old\t{hrs(13)}", f"bbb\trefs/heads/handoff/r10-new\t{hrs(11)}", "ccc\trefs/heads/x\tnotanumber"]
+    assert live_handoffs(rows, now2) == ["refs/heads/handoff/r10-new"], live_handoffs(rows, now2)
+    # null control: three hours earlier the same 13 h-old row is inside the window
+    assert live_handoffs(rows, now2 - dt.timedelta(hours=3)) == ["refs/heads/handoff/r10-old", "refs/heads/handoff/r10-new"]
+    led = ["2026-11-05T22:00:00Z FIRED G-A", "2026-11-06T03:00Z FIRED G-B", "2026-11-06T09:30:15Z FIRED G-C", "free text"]
+    assert recent_fired(led, now2) == led[1:3], recent_fired(led, now2)
+    assert recent_fired(led, now2 - dt.timedelta(hours=3)) == led[:3]
+    # end to end: an old handoff row no longer keeps the CP group busy; a fresh one does
+    plan3 = {"critical_path": ["G-CP"], "summary": {"closure": "2026-11-07T00:00:00Z"},
+             "groups": {"G-CP": {"start": "2026-11-06T00:00:00Z", "finish": "2026-11-06T20:00:00Z", "done": False}}}
+    base3 = {"summary": {"closure": "2026-11-07T00:00:00Z"}, "groups": {"G-CP": {"finish": "2026-11-06T20:00:00Z"}}}
+    ros3 = [{"group": "G-CP", "resume": {"stage": "carries-open", "branch": "handoff/r10-cp"}}]
+    old = live_handoffs([f"a\trefs/heads/handoff/r10-cp\t{hrs(30)}"], now2)
+    fresh = live_handoffs([f"a\trefs/heads/handoff/r10-cp\t{hrs(2)}"], now2)
+    assert "IDLE:G-CP" in dict(slips(plan3, base3, ros3, [], old, [], now2))
+    assert "IDLE:G-CP" not in dict(slips(plan3, base3, ros3, [], fresh, [], now2))
+    oldf = recent_fired(["2026-11-05T09:00:00Z FIRED r10-cp"], now2)
+    newf = recent_fired(["2026-11-06T10:00:00Z FIRED r10-cp"], now2)
+    assert "IDLE:G-CP" in dict(slips(plan3, base3, ros3, [], [], oldf, now2))
+    assert "IDLE:G-CP" not in dict(slips(plan3, base3, ros3, [], [], newf, now2))
+    import inspect
+    print(f"sweep_gantt self-test: {inspect.getsource(self_test).count(chr(10) + '    assert ')} checks, 0 failed")
+    return 0
+
+
+if __name__ == "__main__":
+    ap = argparse.ArgumentParser()
+    for f in ("plan", "baseline", "acks", "roster", "open-prs", "handoffs", "handoff-rows", "fired", "now"):
+        ap.add_argument("--" + f)
+    ap.add_argument("--self-test", action="store_true")
+    a = ap.parse_args()
+    sys.exit(self_test() if a.self_test else run(a))
diff --git a/tools/audit/seat/sweep_runner.sh b/tools/audit/seat/sweep_runner.sh
new file mode 100755
index 000000000..3223d54ce
--- /dev/null
+++ b/tools/audit/seat/sweep_runner.sh
@@ -0,0 +1,73 @@
+#!/bin/bash
+# The sweep's mechanical steps as one loop (tvofi 2026-10-31: mechanical seat work goes into the sweep
+# script). Runs the actionable-line steps of tools/audit/seat/sweep_template.md and writes ONLY actionable
+# lines to $SWEEP_STATE_DIR/sweep-runner/new.txt (+ new.stamp), which the orchestrator's one wake reads.
+#
+#   SWEEP_STATE_DIR=<dir> SWEEP_CHECKOUT=<checkout> SWEEP_REPO=<owner/name> bash tools/audit/seat/sweep_runner.sh
+#
+# Required: SWEEP_STATE_DIR (the orchestrator state dir; exported as HPO_STATE_DIR), SWEEP_CHECKOUT (a
+# checkout fetched fresh by the session; NEVER the one tick_loop.sh / cloud_relay.sh run from: bash reads
+# scripts incrementally), SWEEP_REPO. Optional: SWEEP_ONCE=1 (one pass, no sleep), SWEEP_SLEEP (900 s),
+# SWEEP_FIRED_LEDGER (the fire ledger, `<UTC stamp> FIRED ...` lines), SWEEP_ROSTER_QUEUE (+ SWEEP_ROSTER_EDIT,
+# SWEEP_ROSTER_WT, SWEEP_ROSTER_LINT: the manual roster-drain path), SWEEP_TRAIN_GLOB (merge-train logs),
+# SWEEP_ROSTER_REF (default handoff/audit-r10-roster), SWEEP_DISK_FLOOR_GIB (15), SWEEP_PLAN_SLOTS (16),
+# SWEEP_PLAN_SEATS (16), SWEEP_PY (python3). Every state file lives under SWEEP_STATE_DIR.
+set -u
+if [ "${1:-}" = "--self-test" ]; then exec "${SWEEP_PY:-python3}" -I "$(dirname "$0")/sweep_runner_selftest.py" --self-test; fi
+: "${SWEEP_STATE_DIR:?SWEEP_STATE_DIR is required}" "${SWEEP_CHECKOUT:?SWEEP_CHECKOUT is required}" "${SWEEP_REPO:?SWEEP_REPO is required}"
+O=$SWEEP_STATE_DIR; W=$SWEEP_CHECKOUT; REPO=$SWEEP_REPO; PY=${SWEEP_PY:-python3}
+R=$O/sweep-runner; G=$O/gantt; mkdir -p "$R" "$G"
+REF=${SWEEP_ROSTER_REF:-handoff/audit-r10-roster}; LEDGER=${SWEEP_FIRED_LEDGER:-}
+export PATH=$W/tools/audit/seat/shims:$PATH HPO_STATE_DIR=$O
+n=0
+emit(){ printf '%s\n' "$@" >> "$R/new.tmp"; }
+while :; do
+  n=$((n+1)); : > "$R/new.tmp"; cd "$W" || exit 1
+  # roster queue drain (the manual path; the beat's roster-drain row is the unattended one): refusals and unrun lines only
+  if [ -n "${SWEEP_ROSTER_QUEUE:-}" ]; then
+    timeout 3700 $PY -I tools/audit/seat/roster_drain.py --queue "$SWEEP_ROSTER_QUEUE" --work-dir "$R" \
+      --edit-checkout "${SWEEP_ROSTER_EDIT:?}" --worktree "${SWEEP_ROSTER_WT:?}" --lint-clone "${SWEEP_ROSTER_LINT:?}" --branch "$REF" >> "$R/new.tmp" 2>&1
+  fi
+  # (1b) pulse: STOPPED / UNREADABLE only
+  timeout 200 $PY -I tools/audit/seat/pulse.py --repo "$REPO" > "$R/pulse.txt" 2>&1
+  grep -E 'STOPPED|UNREADABLE' "$R/pulse.txt" | sed 's/^/PULSE: /' >> "$R/new.tmp"
+  # (4e) cancel superseded runs; report only if it cancelled something or failed
+  timeout 200 $PY -I tools/pr/cancel_superseded.py sweep --repo "$REPO" > "$R/cancel.txt" 2>&1 || emit "CANCEL-SWEEP failed: $(tail -1 "$R/cancel.txt")"
+  grep -q 'cancelled [1-9]' "$R/cancel.txt" && grep 'CANCEL-SWEEP' "$R/cancel.txt" >> "$R/new.tmp"
+  # (8) disk floor
+  free=$(df -Pk / | awk 'NR==2{print int($4/1048576)}'); floor=${SWEEP_DISK_FLOOR_GIB:-15}
+  [ "${free:-99}" -lt "$floor" ] && { emit "DISK: ${free} GiB free (<$floor); running worktree_gc"; bash tools/audit/worktree_gc.sh "$REPO" > "$R/gc.txt" 2>&1; }
+  # every 2nd pass (~30 min): (4b) plan render, gantt drift, verdict audit, state docs, owed_unactioned
+  if [ $((n % 2)) -eq 1 ]; then
+    git fetch -q origin "$REF" 2>/dev/null
+    timeout 300 $PY tools/plan/replan.py --out "$O/plan-live.json" --slots "${SWEEP_PLAN_SLOTS:-16}" --seats "${SWEEP_PLAN_SEATS:-16}" > "$R/replan.txt" 2>&1 || emit "REPLAN failed: $(tail -1 "$R/replan.txt")"
+    timeout 150 $PY tools/audit/seat/plan_page.py --plan "$O/plan-live.json" --html "$O/plan-live.html" > "$R/plan_page.txt" 2>&1 || emit "PLAN-PAGE failed: $(tail -1 "$R/plan_page.txt")"
+    grep -q "refused" "$R/plan_page.txt" && emit "PLAN-PAGE refused: $(grep -m1 refused "$R/plan_page.txt" | cut -c1-200)"
+    # tvofi 2026-11-06: every sweep updates the plan artifact; a re-render that differs from the published page owes a republish
+    cmp -s "$O/plan-live.html" "$O/plan.html" || { cp "$O/plan-live.html" "$O/plan.html" && emit "PLAN MOVED: plan.html re-rendered; republish owed"; }
+    # tvofi 2026-11-01: each plan render is compared against the Gantt baseline; every unacked slip is owed act|defer|accept
+    git show "origin/$REF:dev/programme/rosters/wave-r10-groups.json" > "$G/roster.json" 2>/dev/null
+    # a handoff already in main is not work in flight; sweep_gantt.py keeps only tips committed in the last 12 h,
+    # and only fire lines from the last 12 h (both filters are its own, so this runner holds no second copy)
+    git fetch -q origin '+refs/heads/handoff/*:refs/gantt/handoff/*' '+refs/heads/handoff-wip/*:refs/gantt/handoff-wip/*' 2>/dev/null
+    git for-each-ref --format='%(objectname)%09%(refname)%09%(committerdate:unix)' refs/gantt/ | sed 's#\trefs/gantt/#\trefs/heads/#' > "$G/handoff-rows.tsv"
+    [ -n "$LEDGER" ] && [ -f "$LEDGER" ] && cp "$LEDGER" "$G/fired.txt" || : > "$G/fired.txt"
+    gh pr list --repo "$REPO" --state open --limit 100 --json number,title > "$G/prs.json" 2>/dev/null || echo '[]' > "$G/prs.json"
+    timeout 120 $PY -I tools/audit/seat/sweep_gantt.py --plan "$O/plan-live.json" --baseline "$G/baseline.json" --acks "$G/acks.txt" \
+      --roster "$G/roster.json" --open-prs "$G/prs.json" --handoff-rows "$G/handoff-rows.tsv" --fired "$G/fired.txt" > "$R/gantt.txt" 2>&1 || emit "GANTT-DRIFT failed: $(tail -1 "$R/gantt.txt")"
+    grep -E '^GANTT-(SLIP|BASELINE)' "$R/gantt.txt" | sed 's/^/GANTT: /' >> "$R/new.tmp"
+    # tvofi 2026-11-06: no PR waits unheld; every open PR is mapped to its verdict and holder
+    timeout 300 $PY -I tools/audit/seat/verdict_audit.py --repo "$REPO" --fired "$G/fired.txt" --train-glob "${SWEEP_TRAIN_GLOB:-}" --skip "$G/unheld-skip.txt" > "$R/unheld.txt" 2>&1 || emit "VERDICT-AUDIT failed: $(tail -1 "$R/unheld.txt")"
+    grep '^UNHELD' "$R/unheld.txt" >> "$R/new.tmp"
+    timeout 900 $PY -u tools/audit/seat/state_docs.py --push --mirror "$O/state-mirror" --plan "$O/plan-live.json" > "$R/state.txt" 2>&1; src=$?
+    [ $src -ne 0 ] && emit "STATE-DOCS rc=$src (124 = timeout): $(grep -i -E 'refus|unavail|error' "$R/state.txt" | tail -1)"
+    grep -h '^summary:' "$R/replan.txt" > "$R/plan-summary.txt"
+    $PY -I tools/audit/seat/owed_unactioned.py --tick "$O/tick.txt" --state "$O/owed-unactioned.json" --acks "$O/seat-ledger.md" > "$R/unact.txt" 2>&1; rc=$?
+    [ $rc -eq 1 ] && grep -E '^\s+-> |^\s+ack:' "$R/unact.txt" | sed 's/^ */UNACTIONED: /' >> "$R/new.tmp"
+    [ $rc -eq 2 ] && emit "UNACTIONED-UNREADABLE: $(tail -1 "$R/unact.txt")"
+  fi
+  if [ -s "$R/new.tmp" ]; then mv "$R/new.tmp" "$R/new.txt"; date -u +%FT%TZ > "$R/new.stamp"; else rm -f "$R/new.tmp"; fi
+  echo "$(date -u +%FT%TZ) pass $n new=$( [ -f "$R/new.stamp" ] && cat "$R/new.stamp" || echo -) $(cut -c1-60 "$R/plan-summary.txt" 2>/dev/null)"
+  [ -n "${SWEEP_ONCE:-}" ] && exit 0
+  sleep "${SWEEP_SLEEP:-900}"
+done
diff --git a/tools/audit/seat/sweep_runner_selftest.py b/tools/audit/seat/sweep_runner_selftest.py
new file mode 100644
index 000000000..6e3d4fbb9
--- /dev/null
+++ b/tools/audit/seat/sweep_runner_selftest.py
@@ -0,0 +1,101 @@
+#!/usr/bin/env python3
+"""Self-test of sweep_runner.sh: one real pass over a temp checkout of stub instruments.
+
+Invoked as `python3 -I tools/audit/seat/sweep_runner_selftest.py --self-test` (or `bash tools/audit/seat/sweep_runner.sh --self-test`). The stubs stand in for the
+network instruments (replan, plan_page, state_docs, pulse, owed_unactioned, cancel_superseded,
+git, gh); sweep_gantt.py, verdict_audit.py and roster_drain.py are the tracked ones, linked in.
+Each owed line is proved present, then proved absent by a null control that changes one input.
+"""
+import json, os, shutil, subprocess, sys, tempfile, time
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+SH = os.path.join(HERE, "sweep_runner.sh")
+N = BAD = 0
+
+
+def check(name, cond):
+    global N, BAD
+    N += 1
+    if not cond:
+        BAD += 1
+        print(f"FAIL {name}")
+
+
+def w(path, text, mode=None):
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    open(path, "w").write(text)
+    if mode:
+        os.chmod(path, mode)
+
+
+def one_pass(tmp, name, handoff_age_h, fire_age_h, html_same, queue=None):
+    root = os.path.join(tmp, name)
+    co, st, bin_ = (os.path.join(root, d) for d in ("co", "state", "bin"))
+    for f in ("sweep_gantt.py", "verdict_audit.py", "roster_drain.py"):
+        w(os.path.join(co, "tools/audit/seat", f), open(os.path.join(HERE, f)).read())
+    stub = "import sys\nsys.exit(0)\n"
+    for f in ("tools/audit/seat/pulse.py", "tools/audit/seat/owed_unactioned.py", "tools/pr/cancel_superseded.py"):
+        w(os.path.join(co, f), stub)
+    w(os.path.join(co, "tools/audit/seat/state_docs.py"), stub)
+    now = time.time()
+    plan = {"critical_path": ["G-CP"], "summary": {"closure": "2026-11-07T00:00:00Z"},
+            "groups": {"G-CP": {"start": "2026-11-01T00:00:00Z", "finish": "2026-11-06T20:00:00Z", "done": False}}}
+    w(os.path.join(co, "tools/plan/replan.py"),
+      "import sys, json\nopen(sys.argv[sys.argv.index('--out') + 1], 'w').write(%r)\nprint('summary: stub')\n" % json.dumps(plan))
+    w(os.path.join(co, "tools/audit/seat/plan_page.py"),
+      "import sys\nopen(sys.argv[sys.argv.index('--html') + 1], 'w').write('<html>new</html>')\n")
+    if html_same:
+        w(os.path.join(st, "plan.html"), "<html>new</html>")
+    else:
+        w(os.path.join(st, "plan.html"), "<html>old</html>")
+    roster = {"groups": [{"group": "G-CP", "resume": {"stage": "carries-open", "branch": "handoff/r10-cp"}}]}
+    # git: fetch no-ops, show prints the roster, for-each-ref prints one handoff row of the given age
+    w(os.path.join(bin_, "git"),
+      "#!/bin/bash\ncase \"$1\" in show) echo '%s';; for-each-ref) printf 'abc\\trefs/gantt/handoff/r10-cp\\t%d\\n';; esac\nexit 0\n"
+      % (json.dumps(roster), int(now - handoff_age_h * 3600)), 0o700)
+    w(os.path.join(bin_, "gh"), "#!/bin/bash\necho '[]'\n", 0o700)
+    stamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(now - fire_age_h * 3600))
+    w(os.path.join(st, "fired.ledger"), f"{stamp} FIRED r10-cp\n")
+    env = dict(os.environ, SWEEP_STATE_DIR=st, SWEEP_CHECKOUT=co, SWEEP_REPO="o/r", SWEEP_ONCE="1",
+               SWEEP_FIRED_LEDGER=os.path.join(st, "fired.ledger"), PATH=bin_ + os.pathsep + os.environ["PATH"])
+    if queue is not None:
+        w(os.path.join(st, "q.txt"), queue)
+        env.update(SWEEP_ROSTER_QUEUE=os.path.join(st, "q.txt"), SWEEP_ROSTER_EDIT=os.path.join(root, "e"),
+                   SWEEP_ROSTER_WT=os.path.join(root, "wt"), SWEEP_ROSTER_LINT=os.path.join(root, "l"))
+        os.makedirs(env["SWEEP_ROSTER_EDIT"], exist_ok=True)
+    r = subprocess.run(["bash", SH], env=env, capture_output=True, text=True, timeout=120)
+    p = os.path.join(st, "sweep-runner", "new.txt")
+    return r, (open(p).read() if os.path.exists(p) else "")
+
+
+def main():
+    with tempfile.TemporaryDirectory() as tmp:
+        # live handoff (2 h) -> the CP group is busy; a plan re-render differing from plan.html -> PLAN MOVED
+        r, new = one_pass(tmp, "live", 2, 30, False)
+        check("pass exits 0", r.returncode == 0)
+        check("PLAN MOVED emitted when the render differs from the published page", "PLAN MOVED" in new)
+        check("a 2 h-old handoff keeps the CP group busy (no GANTT slip)", "GANTT-SLIP IDLE:G-CP" not in new)
+        # (a) the 12 h handoff filter: a 20 h-old tip is not work in flight
+        r, new = one_pass(tmp, "stale", 20, 30, True)
+        check("null control: unchanged plan page -> no PLAN MOVED", "PLAN MOVED" not in new)
+        check("a 20 h-old handoff tip no longer counts: IDLE slip", "GANTT: GANTT-SLIP IDLE:G-CP" in new)
+        # (a) the 12 h fire filter: a 2 h-old fire line is a live seat
+        r, new = one_pass(tmp, "fired", 20, 2, True)
+        check("a 2 h-old fire line keeps the group busy", "GANTT-SLIP IDLE:G-CP" not in new)
+        # (b) verdict audit: gh returns no PRs here, so it prints nothing and the step must not fail
+        check("verdict audit step ran without VERDICT-AUDIT failed", "VERDICT-AUDIT failed" not in new)
+        # (d) roster drain: a ' #' line is skipped with its notice and reaches new.txt
+        r, new = one_pass(tmp, "drain", 2, 2, True, queue="set-stage G done # tail\n")
+        check("roster drain notice is forwarded", "ROSTER-SKIPPED" in new)
+        r, new = one_pass(tmp, "nodrain", 2, 2, True)
+        check("null control: no queue configured -> no roster line", "ROSTER-" not in new)
+    rc = subprocess.run(["bash", "-n", SH]).returncode
+    check("sweep_runner.sh parses", rc == 0)
+    text = open(SH).read()
+    check("the runner carries no host path", "/Users/" not in text and "/home/" not in text and "<STATE_DIR>" not in text)
+    print(f"sweep_runner self-test: {N} checks, {BAD} failed")
+    return 1 if BAD else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
