@@ -5540,6 +5540,9 @@ class HeatPumpOptimizerCoordinator(DataUpdateCoordinator):
             ctx._current_state.lower_floor_temperature = (
                 ctx._current_state.room_temperature
             )
+        return await self._update_current_state_part1(ctx, floor_return, lower_floor, reader)
+
+    async def _update_current_state_part1(self, ctx, floor_return, lower_floor, reader):  # type: ignore[no-untyped-def]
         self._audit_lower_floor_sensor()
         self._audit_comfort_band()
 
@@ -5578,11 +5581,17 @@ class HeatPumpOptimizerCoordinator(DataUpdateCoordinator):
                 self._solar_radiation = observed
                 ctx._current_state.solar_radiation = observed
 
+        return await self._update_current_state_part2(ctx, floor_return, lower_floor, reader)
+
+    async def _update_current_state_part2(self, ctx, floor_return, lower_floor, reader):  # type: ignore[no-untyped-def]
         # DHW temperature sensor. Without an ok reading the tank is seeded
         # from the previous plan's own trajectory (open-loop propagation,
         # R9 D12-s1-01); the 55 °C dataclass default reached every solve
         # otherwise, so every plan believed the tank was just charged.
         dhw = reader.read(CONF_DHW_TEMP_ENTITY)
+        return await self._update_current_state_part3(ctx, dhw, floor_return, lower_floor, reader)
+
+    async def _update_current_state_part3(self, ctx, dhw, floor_return, lower_floor, reader):  # type: ignore[no-untyped-def]
         if dhw.ok:
             self._dhw_temperature = dhw.value
             ctx._current_state.dhw_temperature = self._dhw_temperature
