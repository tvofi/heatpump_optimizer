-color,#888)\" stroke-width=\"1\" opacity=\"0.3\"/><line class=\"grid grid-v\" x1=\"604\" y1=\"16\" x2=\"604\" y2=\"80.26\" stroke=\"var(--secondary-text-color,#888)\" stroke-width=\"1\" opacity=\"0.3\"/><line class=\"grid grid-v\" x1=\"604\" y1=\"96.26\" x2=\"604\" y2=\"174.8\" stroke=\"var(--secondary-text-color,#888)\" stroke-width=\"1\" opacity=\"0.3\"/><line class=\"grid grid-v\" x1=\"604\" y1=\"190.8\" x2=\"604\" y2=\"286\" stroke=\"var(--secondary-text-color,#888)\" stroke-width=\"1\" opacity=\"0.3\"/><line class=\"grid grid-v\" x1=\"673\" y1=\"16\" x2=\"673\" y2=\"80.26\" stroke=\"var(--secondary-text-color,#888)\" stroke-width=\"1\" opacity=\"0.3\"/><line class=\"grid grid-v\" x1=\"673\" y1=\"96.26\" x2=\"673\" y2=\"174.8\" stroke=\"var(--secondary-text-color,#888)\" stroke-width=\"1\" opacity=\"0.3\"/><line class=\"grid grid-v\" x1=\"673\" y1=\"190.8\" x2=\"673\" y2=\"286\" stroke=\"var(--secondary-text-color,#888)\" stroke-width=\"1\" opacity=\"0.3\"/><line class=\"grid grid-v\" x1=\"742\" y1=\"16\" x2=\"742\" y2=\"80.26\" stroke=\"var(--secondary-text-color,#888)\" stroke-width=\"1\" opacity=\"0.3\"/><line class=\"grid grid-v\" x1=\"742\" y1=\"96.26\" x2=\"742\" y2=\"174.8\" stroke=\"var(--secondary-text-color,#888)\" stroke-width=\"1\" opacity=\"0.3\"/><line class=\"grid grid-v\" x1=\"742\" y1=\"190.8\" x2=\"742\" y2=\"286\" stroke=\"var(--secondary-text-color,#888)\" stroke-width=\"1\" opacity=\"0.3\"/><line class=\"grid grid-v\" x1=\"811\" y1=\"16\" x2=\"811\" y2=\"80.26\" stroke=\"var(--secondary-text-color,#888)\" stroke-width=\"1\" opacity=\"0.3\"/><line class=\"grid grid-v\" x1=\"811\" y1=\"96.26\" x2=\"811\" y2=\"174.8\" stroke=\"var(--secondary-text-color,#888)\" stroke-width=\"1\" opacity=\"0.3\"/><line class=\"grid grid-v\" x1=\"811\" y1=\"190.8\" x2=\"811\" y2=\"286\" stroke=\"var(--secondary-text-color,#888)\" stroke-width=\"1\" opacity=\"0.3\"/><line class=\"grid grid-v\" x1=\"880\" y1=\"16\" x2=\"880\" y2=\"80.26\" stroke=\"var(--secondary