3 207.93 C 512.00 208.06 514.88 207.82 517.75 207.81 C 520.63 207.79 523.50 207.83 526.38 207.84 C 529.25 207.85 532.13 207.86 535.00 207.87 C 537.88 207.87 540.75 207.86 543.63 207.87 C 546.50 207.87 549.38 207.89 552.25 207.90 C 555.13 207.91 558.00 209.01 560.88 207.93 C 563.75 206.85 566.63 202.13 569.50 201.40 C 572.38 200.67 575.25 202.85 578.13 203.58 C 581.00 204.31 583.88 205.47 586.75 205.78 C 589.63 206.09 592.50 205.47 595.38 205.45 C 598.25 205.44 601.13 205.61 604.00 205.69 C 606.88 205.77 609.75 205.86 612.63 205.93 C 615.50 206.01 618.38 206.07 621.25 206.14 C 624.13 206.21 627.00 206.30 629.88 206.38 C 632.75 206.46 635.63 206.54 638.50 206.62 C 641.38 206.70 644.25 206.78 647.13 206.86 C 650.00 206.93 652.88 206.99 655.75 207.06 C 658.63 207.14 662.94 207.26 664.38 207.30\" fill=\"none\" stroke=\"var(--hpo-series-dhw_temp, #c2477a)\" stroke-width=\"1.8\" stroke-dasharray=\"3 3\" stroke-opacity=\"0.7\"/><path class=\"series\" data-key=\"dhw_temp\" pointer-events=\"none\" d=\"M 52.00 168.79 C 53.44 169.25 57.75 170.62 60.63 171.53 C 63.50 172.45 66.38 173.99 69.25 174.27 C 72.13 174.56 75.00 172.70 77.88 173.26 C 80.75 173.82 83.63 176.19 86.50 177.64 C 89.38 179.10 92.25 180.54 95.13 181.99 C 98.00 183.45 100.88 184.90 103.75 186.35 C 106.63 187.79 109.50 189.64 112.38 190.67 C 115.25 191.70 118.13 191.90 121.00 192.52 C 123.88 193.14 126.75 193.77 129.63 194.40 C 132.50 195.02 135.38 195.98 138.25 196.24 C 141.13 196.51 144.00 196.00 146.88 196.00 C 149.75 196.00 152.63 196.17 155.50 196.24 C 158.38 196.32 161.25 196.38 164.13 196.45 C 167.00 196.52 169.88 196.59 172.75 196.66 C 175.63 196.73 178.50 196.80 181.38 196.87 C 184.25 196.94 187.13 197.01 190.00 197.08 C 192.88 197.15 195.75 197.22 198.63 197.29 C 201.50 197.36 204.38 197.42 207.25 197.50 C 210.13 197.57 213.00 197.66 215.88 197.73 C 218.75 197.81 221.63 197.87 224.50 197.94 C 227.38 198.01 230.25 198.08 233.13 198.15 C 236.00 198.22 238.88 198.29 241.75 198.36 C 244.63 198.43 247.50 198