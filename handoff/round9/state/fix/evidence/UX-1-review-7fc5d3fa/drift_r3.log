18.4788732394367\" y1=\"201.60000000000002\" x2=\"518.4788732394367\" y2=\"304\" stroke=\"var(--secondary-text-color,#888)\" stroke-width=\"1\" opacity=\"0.3\"/><line class=\"grid grid-v\" x1=\"611.7746478873239\" y1=\"16\" x2=\"611.7746478873239\" y2=\"85.12\" stroke=\"var(--secondary-text-color,#888)\" stroke-width=\"1\" opacity=\"0.3\"/><line class=\"grid grid-v\" x1=\"611.7746478873239\" y1=\"101.12\" x2=\"611.7746478873239\" y2=\"185.60000000000002\" stroke=\"var(--secondary-text-color,#888)\" stroke-width=\"1\" opacity=\"0.3\"/><line class=\"grid grid-v\" x1=\"611.7746478873239\" y1=\"201.60000000000002\" x2=\"611.7746478873239\" y2=\"304\" stroke=\"var(--secondary-text-color,#888)\" stroke-width=\"1\" opacity=\"0.3\"/><line class=\"grid grid-v\" x1=\"705.0704225352113\" y1=\"16\" x2=\"705.0704225352113\" y2=\"85.12\" stroke=\"var(--secondary-text-color,#888)\" stroke-width=\"1\" opacity=\"0.3\"/><line class=\"grid grid-v\" x1=\"705.0704225352113\" y1=\"101.12\" x2=\"705.0704225352113\" y2=\"185.60000000000002\" stroke=\"var(--secondary-text-color,#888)\" stroke-width=\"1\" opacity=\"0.3\"/><line class=\"grid grid-v\" x1=\"705.0704225352113\" y1=\"201.60000000000002\" x2=\"705.0704225352113\" y2=\"304\" stroke=\"var(--secondary-text-color,#888)\" stroke-width=\"1\" opacity=\"0.3\"/><line class=\"grid grid-v\" x1=\"798.3661971830986\" y1=\"16\" x2=\"798.3661971830986\" y2=\"85.12\" stroke=\"var(--secondary-text-color,#888)\" stroke-width=\"1\" opacity=\"0.3\"/><line class=\"grid grid-v\" x1=\"798.3661971830986\" y1=\"101.12\" x2=\"798.3661971830986\" y2=\"185.60000000000002\" stroke=\"var(--secondary-text-color,#888)\" stroke-width=\"1\" opacity=\"0.3\"/><line class=\"grid grid-v\" x1=\"798.3661971830986\" y1=\"201.60000000000002\" x2=\"798.3661971830986\" y2=\"304\" stroke=\"var(--secondary-text-color,#888)\" stroke-width=\"1\" opacity=\"0.3\"/><text x=\"52\" y=\"360\" font-size=\"10\" text-anchor=\"start\" fill=\"var(--secondary-text-color,#888)\">08:00 PM</t