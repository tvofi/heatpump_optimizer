@@ -126,6 +134,15 @@ if [ "$SELF_TEST" = 1 ]; then
   st refuse main    "{\"tool_input\":{\"file_path\":\"$R/.cursor/rules/gate-scoping.mdc\"}}"            "and on main too -- generation is not branch-dependent"
   st refuse feature "{\"tool_input\":{\"file_path\":\"$R/RELEASE_NOTES.md\",\"new_string\":\"## v9.9.9\\n\"}}" "a new RELEASE_NOTES heading on a branch is refused"
   st allow  feature "{\"tool_input\":{\"file_path\":\"$R/RELEASE_NOTES.md\",\"new_string\":\"- a body line\\n\"}}" "a body line under an existing heading is allowed"
+  # MultiEdit carries its text in tool_input.edits[*].new_string, which the
+  # Edit/Write fields do not name; the matcher admits it, so the heading rule
+  # must read it (round-10 D11-s1-01: one of sixteen seams escaped).
+  st refuse feature "{\"tool_input\":{\"file_path\":\"$R/RELEASE_NOTES.md\",\"edits\":[{\"old_string\":\"x\",\"new_string\":\"## v9.9.9\\n\"}]}}" "a MultiEdit that writes a new RELEASE_NOTES heading is refused"
+  st refuse feature "{\"tool_input\":{\"file_path\":\"$R/RELEASE_NOTES.md\",\"edits\":[{\"old_string\":\"a\",\"new_string\":\"- body\"},{\"old_string\":\"b\",\"new_string\":\"## v9.9.9\\n\"}]}}" "a heading in a LATER edit is refused (one value per line, not one joined line)"
+  st allow  feature "{\"tool_input\":{\"file_path\":\"$R/RELEASE_NOTES.md\",\"edits\":[{\"old_string\":\"x\",\"new_string\":\"- a body line\\n\"}]}}" "a MultiEdit body line is allowed (null control)"
