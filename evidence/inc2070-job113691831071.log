2026-10-09T05:58:04.4268332Z # Under the 170-minute step timeout with room for the runs in flight
2026-10-09T05:58:04.4268804Z # (R9-F10.12): admission charges a lazy driver its run alone, so a
2026-10-09T05:58:04.4269304Z # red run's baseline and null control are paid past the deadline --
2026-10-09T05:58:04.4269774Z # boost_drift_replay.py's three runs are ~26 minutes at its recorded
2026-10-09T05:58:04.4270222Z # seconds. At 90 minutes four shards of 14 pinned 19 of #2025's 56
2026-10-09T05:58:04.4270671Z # sites, each site ~2000 s of driver work; six sites a shard fit 120
2026-10-09T05:58:04.4271089Z # (R9-CI-1). Only a base program that has a flag gets it.
2026-10-09T05:58:04.4271410Z budget=()
2026-10-09T05:58:04.4271624Z shard=()
2026-10-09T05:58:04.4271839Z run=1
2026-10-09T05:58:04.4272174Z if grep -qE '^MUTATION TABLE REFUSED -- [0-9]+ unpinned site\(s\) against' \
2026-10-09T05:58:04.4272595Z      "$RUNNER_TEMP/mutation-table.txt" \
2026-10-09T05:58:04.4273061Z    && git show "$PR_BASE":tests/mutation_table.py > tests/_mutation_table_base.py \
2026-10-09T05:58:04.4273562Z    && grep -q -- '--pin-killed' tests/_mutation_table_base.py; then
2026-10-09T05:58:04.4273974Z   echo tests/_mutation_table_base.py >> .git/info/exclude
2026-10-09T05:58:04.4274688Z   grep -q -- '--budget-minutes' tests/_mutation_table_base.py \
2026-10-09T05:58:04.4275196Z     && budget=(--budget-minutes 120)
2026-10-09T05:58:04.4275563Z   if grep -q -- '--shard' tests/_mutation_table_base.py; then
2026-10-09T05:58:04.4275926Z     shard=(--shard "$SHARD/$SHARDS")
2026-10-09T05:58:04.4276215Z   elif [ "$SHARD" != 1 ]; then
2026-10-09T05:58:04.4276469Z     run=0
2026-10-09T05:58:04.4276797Z     echo "base program has no --shard: shard 1 measures the whole pool"
2026-10-09T05:58:04.4277155Z   fi
2026-10-09T05:58:04.4277446Z   # A refusal exits non-zero; the runner's `bash -e` would end the
2026-10-09T05:58:04.4277871Z   # step there, before measurement() wrote any status, and
2026-10-09T05:58:04.4278306Z   # mutation-autofix then read a missing file as skip-no-measurement
2026-10-09T05:58:04.4278750Z   # (#2025, run 37663843895). measurement() grades the run instead.
2026-10-09T05:58:04.4279275Z   [ "$run" = 1 ] && { python3 tests/_mutation_table_base.py --pin-killed --base origin/main --jobs 3 \
2026-10-09T05:58:04.4279809Z     "${budget[@]}" "${shard[@]}" 2>&1 | tee "$RUNNER_TEMP/pin-run.txt" \
2026-10-09T05:58:04.4280237Z     || echo "pin run exited non-zero; measurement() grades it"; }
2026-10-09T05:58:04.4280559Z fi
2026-10-09T05:58:04.4280809Z rm -f tests/_mutation_table_base.py
2026-10-09T05:58:04.4281097Z [ "$run" = 1 ] || exit 0
2026-10-09T05:58:04.4281374Z python3 - "$RUNNER_TEMP" "$out" <<'PY'
2026-10-09T05:58:04.4281667Z import json, sys
2026-10-09T05:58:04.4281917Z from pathlib import Path
2026-10-09T05:58:04.4282183Z sys.path.insert(0, "tests")
2026-10-09T05:58:04.4282553Z import mutation_table
2026-10-09T05:58:04.4282851Z tmp, out = Path(sys.argv[1]), Path(sys.argv[2])
2026-10-09T05:58:04.4283167Z run = tmp / "pin-run.txt"
2026-10-09T05:58:04.4283470Z status, added = mutation_table.measurement(
2026-10-09T05:58:04.4283810Z     (tmp / "mutation-table.txt").read_text(),
2026-10-09T05:58:04.4284405Z     run.read_text() if run.exists() else None,
2026-10-09T05:58:04.4284775Z     json.loads((tmp / "ledger-before.json").read_text()),
2026-10-09T05:58:04.4285122Z     mutation_table.load_budgets())
2026-10-09T05:58:04.4285473Z (out / "pins.json").write_text(json.dumps(added, indent=2))
2026-10-09T05:58:04.4285846Z (out / "status").write_text(status + "\n")
2026-10-09T05:58:04.4286194Z print(f"measure: {status}, {len(added)} anchor(s)")
