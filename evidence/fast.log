2026-10-18T11:40:10.9905577Z ##[group]Run if [ "pull_request" = "pull_request" ]; then
2026-10-18T11:40:10.9906036Z if [ "pull_request" = "pull_request" ]; then
2026-10-18T11:40:10.9906416Z   # The PR's merge-base with its target: exactly the code this
2026-10-18T11:40:10.9906842Z   # PR forked from, so the drift comparison isolates the PR.
2026-10-18T11:40:10.9907227Z   REF=$(git merge-base "origin/main" HEAD)
2026-10-18T11:40:10.9907606Z   # The branch's OWN claim list is read from the PR head, not the
2026-10-18T11:40:10.9908065Z   # synthetic merge tree this checkout is (env_drift's CLAIM_HEAD).
2026-10-18T11:40:10.9908565Z   echo "CLAIM_HEAD=bcaf7d61e237c800fc3678047bffeb6ef9714017" >> "$GITHUB_ENV"
2026-10-18T11:40:10.9909035Z elif [ "pull_request" = "merge_group" ]; then
2026-10-18T11:40:10.9909426Z   # A queue entry is a merge commit (merge method MERGE): its first
2026-10-18T11:40:10.9909919Z   # parent is the main tip or the entry ahead of it, its second the
2026-10-18T11:40:10.9910360Z   # pull request's head. That is the shape of a pull request's
2026-10-18T11:40:10.9910803Z   # synthetic merge, whose merge-base with its target is the same
2026-10-18T11:40:10.9911241Z   # first parent, so the drift comparison and the claim list are
2026-10-18T11:40:10.9911669Z   # read exactly as on the pull request. No second parent means the
2026-10-18T11:40:10.9912083Z   # queue's merge method changed; fail rather than guess.
2026-10-18T11:40:10.9912497Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-18T11:40:10.9912933Z   PR_TIP=$(git rev-parse --verify --quiet 'HEAD^2^{commit}') || {
2026-10-18T11:40:10.9913947Z     echo "This merge_group commit has no second parent; the queue must merge with merge method MERGE."
2026-10-18T11:40:10.9914413Z     exit 1
2026-10-18T11:40:10.9914620Z   }
2026-10-18T11:40:10.9914861Z   echo "CLAIM_HEAD=${PR_TIP}" >> "$GITHUB_ENV"
2026-10-18T11:40:10.9915167Z elif [ "" = "true" ]; then
2026-10-18T11:40:10.9915511Z   # Autofix dispatch is not a pull_request event. Compare against
2026-10-18T11:40:10.9915949Z   # main the same way a PR would, not HEAD^1 (the autofix commit's
2026-10-18T11:40:10.9916359Z   # parent), so leftover drift vs main cannot hide.
2026-10-18T11:40:10.9916685Z   git fetch --no-tags origin main
2026-10-18T11:40:10.9916978Z   REF=$(git merge-base origin/main HEAD)
2026-10-18T11:40:10.9917252Z else
2026-10-18T11:40:10.9917526Z   # Push to main: compare against the state before this push.
2026-10-18T11:40:10.9917964Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-18T11:40:10.9918304Z fi
2026-10-18T11:40:10.9918496Z if [ -z "${REF}" ]; then
2026-10-18T11:40:10.9918816Z   # An empty GOLDEN_REF is not "no preference": run.sh and
2026-10-18T11:40:10.9919233Z   # env_drift.py both fall back to origin/main, which on a push to
2026-10-18T11:40:10.9919656Z   # main IS this commit -- the tree would be compared against
2026-10-18T11:40:10.9920076Z   # itself and pass no matter what it did. Fail here instead, where
2026-10-18T11:40:10.9920428Z   # the reason is visible.
2026-10-18T11:40:10.9920761Z   echo "Could not resolve a comparison ref for this pull_request."
2026-10-18T11:40:10.9921201Z   echo "The drift gate needs a baseline that is not this commit;"
2026-10-18T11:40:10.9921620Z   echo "an empty ref silently becomes origin/main == HEAD."
2026-10-18T11:40:10.9921943Z   exit 1
2026-10-18T11:40:10.9922132Z fi
2026-10-18T11:40:10.9922352Z echo "GOLDEN_REF=${REF}" >> "$GITHUB_ENV"
