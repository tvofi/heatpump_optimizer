2026-10-15T17:41:26.9817676Z   # A queue entry is a merge commit (merge method MERGE): its first
2026-10-15T17:41:26.9818160Z   # parent is the main tip or the entry ahead of it, its second the
2026-10-15T17:41:26.9818588Z   # pull request's head. That is the shape of a pull request's
2026-10-15T17:41:26.9819021Z   # synthetic merge, whose merge-base with its target is the same
2026-10-15T17:41:26.9819453Z   # first parent, so the drift comparison and the claim list are
2026-10-15T17:41:26.9819884Z   # read exactly as on the pull request. No second parent means the
2026-10-15T17:41:26.9820299Z   # queue's merge method changed; fail rather than guess.
2026-10-15T17:41:26.9820718Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-15T17:41:26.9821147Z   PR_TIP=$(git rev-parse --verify --quiet 'HEAD^2^{commit}') || {
2026-10-15T17:41:26.9821683Z     echo "This merge_group commit has no second parent; the queue must merge with merge method MERGE."
2026-10-15T17:41:26.9822127Z     exit 1
2026-10-15T17:41:26.9822328Z   }
2026-10-15T17:41:26.9822554Z   echo "CLAIM_HEAD=${PR_TIP}" >> "$GITHUB_ENV"
2026-10-15T17:41:26.9822855Z elif [ "" = "true" ]; then
2026-10-15T17:41:26.9823204Z   # Autofix dispatch is not a pull_request event. Compare against
2026-10-15T17:41:26.9823636Z   # main the same way a PR would, not HEAD^1 (the autofix commit's
2026-10-15T17:41:26.9824031Z   # parent), so leftover drift vs main cannot hide.
2026-10-15T17:41:26.9824357Z   git fetch --no-tags origin main
2026-10-15T17:41:26.9824653Z   REF=$(git merge-base origin/main HEAD)
2026-10-15T17:41:26.9824926Z else
2026-10-15T17:41:26.9825202Z   # Push to main: compare against the state before this push.
2026-10-15T17:41:26.9825623Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-15T17:41:26.9826126Z fi
2026-10-15T17:41:26.9826323Z if [ -z "${REF}" ]; then
2026-10-15T17:41:26.9826636Z   # An empty GOLDEN_REF is not "no preference": run.sh and
2026-10-15T17:41:26.9827051Z   # env_drift.py both fall back to origin/main, which on a push to
2026-10-15T17:41:26.9827473Z   # main IS this commit -- the tree would be compared against
2026-10-15T17:41:26.9827896Z   # itself and pass no matter what it did. Fail here instead, where
2026-10-15T17:41:26.9828255Z   # the reason is visible.
2026-10-15T17:41:26.9828590Z   echo "Could not resolve a comparison ref for this pull_request."
2026-10-15T17:41:26.9829030Z   echo "The drift gate needs a baseline that is not this commit;"
2026-10-15T17:41:26.9829446Z   echo "an empty ref silently becomes origin/main == HEAD."
2026-10-15T17:41:26.9829761Z   exit 1
2026-10-15T17:41:26.9829946Z fi
2026-10-15T17:41:26.9830161Z echo "GOLDEN_REF=${REF}" >> "$GITHUB_ENV"
2026-10-15T17:41:26.9869218Z shell: /usr/bin/bash -e {0}
