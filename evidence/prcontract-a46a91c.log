2026-10-02T12:36:30.6826168Z          | .name' | sort -u > /tmp/pr-reds.txt
2026-10-02T12:36:30.6826555Z printf 'red checks the body must answer: %s\n' \
2026-10-02T12:36:30.6826895Z   "$(paste -sd, /tmp/pr-reds.txt)"
