2026-11-27T10:03:14.4642592Z ##[group]Run if [ "pull_request" = "pull_request" ]; then
2026-11-27T10:03:14.4642968Z if [ "pull_request" = "pull_request" ]; then
2026-11-27T10:03:14.4643289Z   # The PR's merge-base with its target: exactly the code this
2026-11-27T10:03:14.4643634Z   # PR forked from, so the drift comparison isolates the PR.
2026-11-27T10:03:14.4643946Z   REF=$(git merge-base "origin/main" HEAD)
2026-11-27T10:03:14.4644259Z   # The branch's OWN claim list is read from the PR head, not the
2026-11-27T10:03:14.4644633Z   # synthetic merge tree this checkout is (env_drift's CLAIM_HEAD).
2026-11-27T10:03:14.4645037Z   echo "CLAIM_HEAD=a8dff54818f8749246fffb9e18344dbbb1318735" >> "$GITHUB_ENV"
2026-11-27T10:03:14.4645396Z elif [ "pull_request" = "merge_group" ]; then
2026-11-27T10:03:14.4645723Z   # A queue entry is a merge commit (merge method MERGE): its first
2026-11-27T10:03:14.4646127Z   # parent is the main tip or the entry ahead of it, its second the
2026-11-27T10:03:14.4646505Z   # pull request's head. That is the shape of a pull request's
2026-11-27T10:03:14.4646867Z   # synthetic merge, whose merge-base with its target is the same
2026-11-27T10:03:14.4647492Z   # first parent, so the drift comparison and the claim list are
2026-11-27T10:03:14.4647850Z   # read exactly as on the pull request. No second parent means the
2026-11-27T10:03:14.4648185Z   # queue's merge method changed; fail rather than guess.
2026-11-27T10:03:14.4648530Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-11-27T10:03:14.4648889Z   PR_TIP=$(git rev-parse --verify --quiet 'HEAD^2^{commit}') || {
2026-11-27T10:03:14.4649324Z     echo "This merge_group commit has no second parent; the queue must merge with merge method MERGE."
2026-11-27T10:03:14.4649694Z     exit 1
2026-11-27T10:03:14.4649876Z   }
2026-11-27T10:03:14.4650101Z   echo "CLAIM_HEAD=${PR_TIP}" >> "$GITHUB_ENV"
2026-11-27T10:03:14.4650403Z elif [ "pull_request" = "workflow_dispatch" ]; then
2026-11-27T10:03:14.4650742Z   # Autofix dispatch is not a pull_request event. Compare against
2026-11-27T10:03:14.4651093Z   # main the same way a PR would, not HEAD^1 (the autofix commit's
2026-11-27T10:03:14.4651414Z   # parent), so leftover drift vs main cannot hide.
2026-11-27T10:03:14.4651682Z   git fetch --no-tags origin main
2026-11-27T10:03:14.4651927Z   REF=$(git merge-base origin/main HEAD)
2026-11-27T10:03:14.4652213Z elif [ "$LIGHT" = "true" ] && [ -n "$RANGE_BASE" ]; then
2026-11-27T10:03:14.4652566Z   # A light push (#3885): scoped against its range base, so the drift
2026-11-27T10:03:14.4652899Z   # comparison spans every commit the scope does.
2026-11-27T10:03:14.4653237Z   REF=$(git rev-parse --verify --quiet "${RANGE_BASE}^{commit}") || REF=""
2026-11-27T10:03:14.4653708Z else
2026-11-27T10:03:14.4653942Z   # Push to main: compare against the state before this push.
2026-11-27T10:03:14.4654289Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-11-27T10:03:14.4654564Z fi
2026-11-27T10:03:14.4654746Z if [ -z "${REF}" ]; then
2026-11-27T10:03:14.4655011Z   # An empty GOLDEN_REF is not "no preference": run.sh and
2026-11-27T10:03:14.4655368Z   # env_drift.py both fall back to origin/main, which on a push to
2026-11-27T10:03:14.4655711Z   # main IS this commit -- the tree would be compared against
2026-11-27T10:03:14.4656059Z   # itself and pass no matter what it did. Fail here instead, where
2026-11-27T10:03:14.4656356Z   # the reason is visible.
2026-11-27T10:03:14.4656633Z   echo "Could not resolve a comparison ref for this pull_request."
2026-11-27T10:03:14.4657310Z   echo "The drift gate needs a baseline that is not this commit;"
2026-11-27T10:03:14.4657665Z   echo "an empty ref silently becomes origin/main == HEAD."
2026-11-27T10:03:14.4657932Z   exit 1
2026-11-27T10:03:14.4658100Z fi
2026-11-27T10:03:14.4658294Z echo "GOLDEN_REF=${REF}" >> "$GITHUB_ENV"
