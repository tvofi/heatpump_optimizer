2026-10-28T04:37:33.0072637Z ##[group]Run if [ "pull_request" = "pull_request" ]; then
2026-10-28T04:37:33.0073102Z if [ "pull_request" = "pull_request" ]; then
2026-10-28T04:37:33.0073482Z   # The PR's merge-base with its target: exactly the code this
2026-10-28T04:37:33.0073909Z   # PR forked from, so the drift comparison isolates the PR.
2026-10-28T04:37:33.0074288Z   REF=$(git merge-base "origin/main" HEAD)
2026-10-28T04:37:33.0074675Z   # The branch's OWN claim list is read from the PR head, not the
2026-10-28T04:37:33.0075142Z   # synthetic merge tree this checkout is (env_drift's CLAIM_HEAD).
2026-10-28T04:37:33.0075640Z   echo "CLAIM_HEAD=75ae7b26ff81949586a3c3053a9f0542819a39b3" >> "$GITHUB_ENV"
2026-10-28T04:37:33.0076072Z elif [ "pull_request" = "merge_group" ]; then
2026-10-28T04:37:33.0076444Z   # A queue entry is a merge commit (merge method MERGE): its first
2026-10-28T04:37:33.0076914Z   # parent is the main tip or the entry ahead of it, its second the
2026-10-28T04:37:33.0077347Z   # pull request's head. That is the shape of a pull request's
2026-10-28T04:37:33.0077786Z   # synthetic merge, whose merge-base with its target is the same
2026-10-28T04:37:33.0078221Z   # first parent, so the drift comparison and the claim list are
2026-10-28T04:37:33.0078650Z   # read exactly as on the pull request. No second parent means the
2026-10-28T04:37:33.0079400Z   # queue's merge method changed; fail rather than guess.
2026-10-28T04:37:33.0079838Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-28T04:37:33.0080370Z   PR_TIP=$(git rev-parse --verify --quiet 'HEAD^2^{commit}') || {
2026-10-28T04:37:33.0080919Z     echo "This merge_group commit has no second parent; the queue must merge with merge method MERGE."
2026-10-28T04:37:33.0081378Z     exit 1
2026-10-28T04:37:33.0081583Z   }
2026-10-28T04:37:33.0081821Z   echo "CLAIM_HEAD=${PR_TIP}" >> "$GITHUB_ENV"
2026-10-28T04:37:33.0082176Z elif [ "pull_request" = "workflow_dispatch" ]; then
2026-10-28T04:37:33.0082583Z   # Autofix dispatch is not a pull_request event. Compare against
2026-10-28T04:37:33.0083037Z   # main the same way a PR would, not HEAD^1 (the autofix commit's
2026-10-28T04:37:33.0083431Z   # parent), so leftover drift vs main cannot hide.
2026-10-28T04:37:33.0083756Z   git fetch --no-tags origin main
2026-10-28T04:37:33.0084050Z   REF=$(git merge-base origin/main HEAD)
2026-10-28T04:37:33.0084324Z else
2026-10-28T04:37:33.0084594Z   # Push to main: compare against the state before this push.
2026-10-28T04:37:33.0085019Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-28T04:37:33.0085411Z fi
2026-10-28T04:37:33.0085719Z if [ -z "${REF}" ]; then
2026-10-28T04:37:33.0086036Z   # An empty GOLDEN_REF is not "no preference": run.sh and
2026-10-28T04:37:33.0086447Z   # env_drift.py both fall back to origin/main, which on a push to
2026-10-28T04:37:33.0086867Z   # main IS this commit -- the tree would be compared against
2026-10-28T04:37:33.0087288Z   # itself and pass no matter what it did. Fail here instead, where
2026-10-28T04:37:33.0087645Z   # the reason is visible.
2026-10-28T04:37:33.0088177Z   echo "Could not resolve a comparison ref for this pull_request."
2026-10-28T04:37:33.0088603Z   echo "The drift gate needs a baseline that is not this commit;"
2026-10-28T04:37:33.0089296Z   echo "an empty ref silently becomes origin/main == HEAD."
2026-10-28T04:37:33.0089769Z   exit 1
2026-10-28T04:37:33.0089956Z fi
2026-10-28T04:37:33.0090171Z echo "GOLDEN_REF=${REF}" >> "$GITHUB_ENV"
