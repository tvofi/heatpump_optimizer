2026-10-02T13:03:40.6054694Z ##[group]Run if [ "pull_request" = "pull_request" ]; then
2026-10-02T13:03:40.6055186Z if [ "pull_request" = "pull_request" ]; then
2026-10-02T13:03:40.6055600Z   # The PR's merge-base with its target: exactly the code this
2026-10-02T13:03:40.6056046Z   # PR forked from, so the drift comparison isolates the PR.
2026-10-02T13:03:40.6056428Z   REF=$(git merge-base "origin/main" HEAD)
2026-10-02T13:03:40.6056808Z   # The branch's OWN claim list is read from the PR head, not the
2026-10-02T13:03:40.6057270Z   # synthetic merge tree this checkout is (env_drift's CLAIM_HEAD).
2026-10-02T13:03:40.6057779Z   echo "CLAIM_HEAD=ddaf6bf73c4bbb5d604a9348ab9ccdacb50feb5e" >> "$GITHUB_ENV"
2026-10-02T13:03:40.6058228Z elif [ "pull_request" = "merge_group" ]; then
2026-10-02T13:03:40.6058627Z   # A queue entry is a merge commit (merge method MERGE): its first
2026-10-02T13:03:40.6059103Z   # parent is the main tip or the entry ahead of it, its second the
2026-10-02T13:03:40.6059542Z   # pull request's head. That is the shape of a pull request's
2026-10-02T13:03:40.6059978Z   # synthetic merge, whose merge-base with its target is the same
2026-10-02T13:03:40.6060420Z   # first parent, so the drift comparison and the claim list are
2026-10-02T13:03:40.6060906Z   # read exactly as on the pull request. No second parent means the
2026-10-02T13:03:40.6061323Z   # queue's merge method changed; fail rather than guess.
2026-10-02T13:03:40.6061747Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-02T13:03:40.6062179Z   PR_TIP=$(git rev-parse --verify --quiet 'HEAD^2^{commit}') || {
2026-10-02T13:03:40.6062726Z     echo "This merge_group commit has no second parent; the queue must merge with merge method MERGE."
2026-10-02T13:03:40.6063373Z     exit 1
2026-10-02T13:03:40.6063573Z   }
2026-10-02T13:03:40.6063804Z   echo "CLAIM_HEAD=${PR_TIP}" >> "$GITHUB_ENV"
2026-10-02T13:03:40.6064385Z elif [ "" = "true" ]; then
2026-10-02T13:03:40.6064737Z   # Autofix dispatch is not a pull_request event. Compare against
2026-10-02T13:03:40.6065196Z   # main the same way a PR would, not HEAD^1 (the autofix commit's
2026-10-02T13:03:40.6065601Z   # parent), so leftover drift vs main cannot hide.
2026-10-02T13:03:40.6065929Z   git fetch --no-tags origin main
2026-10-02T13:03:40.6066230Z   REF=$(git merge-base origin/main HEAD)
2026-10-02T13:03:40.6066505Z else
2026-10-02T13:03:40.6066781Z   # Push to main: compare against the state before this push.
2026-10-02T13:03:40.6067237Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-02T13:03:40.6067612Z fi
2026-10-02T13:03:40.6067815Z if [ -z "${REF}" ]; then
2026-10-02T13:03:40.6068141Z   # An empty GOLDEN_REF is not "no preference": run.sh and
2026-10-02T13:03:40.6068571Z   # env_drift.py both fall back to origin/main, which on a push to
2026-10-02T13:03:40.6069008Z   # main IS this commit -- the tree would be compared against
2026-10-02T13:03:40.6069447Z   # itself and pass no matter what it did. Fail here instead, where
2026-10-02T13:03:40.6069812Z   # the reason is visible.
2026-10-02T13:03:40.6070161Z   echo "Could not resolve a comparison ref for this pull_request."
2026-10-02T13:03:40.6070608Z   echo "The drift gate needs a baseline that is not this commit;"
2026-10-02T13:03:40.6071040Z   echo "an empty ref silently becomes origin/main == HEAD."
2026-10-02T13:03:40.6071373Z   exit 1
2026-10-02T13:03:40.6071559Z fi
2026-10-02T13:03:40.6071786Z echo "GOLDEN_REF=${REF}" >> "$GITHUB_ENV"
