"""Record every check on ``R``; ``_parent`` is the test process's pid."""
R.section("worker read timeout — a silent worker is reaped, not waited on")
import threading as threading
import time as time
timeout_cls = getattr(_coord, "ProcessWorkerTimeout", None)
saved = (_coord.PROCESS_REPLY_TIMEOUT_S, _coord._SHUTDOWN_LOCK_TIMEOUT_S)
R.check(
"the reply deadline sits in its derived band: 4 x 426 s <= deadline <= 30 min",
4 * 426 <= saved[0] <= 30 * 60,
f"PROCESS_REPLY_TIMEOUT_S = {saved[0]!r}",
)
R.check(
"the stop path's lock wait and the timed-out reap stay at the 5 s design bound",
saved[1] == 5.0,
f"_SHUTDOWN_LOCK_TIMEOUT_S = {saved[1]!r}",
)
try:
pid_before = _coord._run_in_process(_os.getpid, ())
_coord.PROCESS_REPLY_TIMEOUT_S = 0.5
ok_err, ok_out = _submit(_coord._run_in_process, time.sleep, (0.05,))
ok_pid = _coord._run_in_process(_os.getpid, ())
R.check(
"null control: a job that answers in time returns and keeps its worker",
ok_err is None and ok_out is None and ok_pid == pid_before,
f"raised {ok_err!r}; pid {pid_before} -> {ok_pid}",
)
t0 = time.monotonic()
err, out = _submit(_coord._run_in_process, time.sleep, (30,))
elapsed = time.monotonic() - t0
lock_free = _coord._PROCESS_LOCK.acquire(blocking=False)
if lock_free:
_coord._PROCESS_LOCK.release()
_coord.PROCESS_REPLY_TIMEOUT_S = saved[0]
pid_after = _coord._run_in_process(_os.getpid, ())
R.check(
"a worker that gives no reply within the deadline raises ProcessWorkerTimeout",
timeout_cls is not None and isinstance(err, timeout_cls)
and out is None and elapsed < 10,
f"raised {err!r} after {elapsed:.1f} s; returned {out!r}",
)
R.check(
"and it frees the lock and the next job gets a fresh worker",
lock_free and pid_after not in (pid_before, _parent),
f"lock_free={lock_free} before={pid_before} after={pid_after}",
)
_solve(_harness.SleepyOptimizer(0))
_coord.PROCESS_REPLY_TIMEOUT_S = 5.0
fast_err, fast_plan, fast_hass, _ = _solve(_harness.SleepyOptimizer(0.05))
R.check(
"null control: a solve inside the deadline returns its plan through the worker",
fast_err is None and isinstance(fast_plan, tuple)
and fast_plan[0] == "slept" and fast_plan[1] != _parent
and fast_hass.jobs == [_coord._run_in_process],
f"raised {fast_err!r}; returned {fast_plan!r}",
)
raised, plan, hass, warned = _solve(_harness.SleepyOptimizer(30))
R.check(
"_await_optimize keeps the last plan on a timeout: translated UpdateFailed, no in-process solve",
plan is None
and type(raised).__name__ == "UpdateFailed"
and getattr(raised, "translation_key", None) == "process_worker_timeout"
and hass.jobs == [_coord._run_in_process]
and [i for i in hass.issues if i[1] == "solve_worker_fallback"] == [],
f"raised {raised!r}; returned {plan!r}; jobs={hass.jobs!r} "
f"issues={hass.issues!r}",
)
latch_sink = _LogSink()
latch_sink.setLevel(_logging.INFO)
latch_log = _logging.getLogger(_coord.log_held.__module__)
latch_log.addHandler(latch_sink)
latch_level = latch_log.level
latch_log.setLevel(_logging.INFO)
one_hass = _Hass()
try:
for n in range(2):
try:
_asyncio.run(_coord._await_optimize(
one_hass, _harness.SleepyOptimizer(30), "STATE"))
except Exception:  # noqa: BLE001 - the UpdateFailed is checked above
pass
_coord.PROCESS_REPLY_TIMEOUT_S = saved[0]
_asyncio.run(_coord._await_optimize(
one_hass, _harness.SleepyOptimizer(0), "STATE"))
finally:
latch_log.removeHandler(latch_sink)
latch_log.setLevel(latch_level)
_coord.PROCESS_REPLY_TIMEOUT_S = 0.5
latch_msgs = [(r.levelno, r.getMessage()) for r in latch_sink.records
if "process worker" in r.getMessage() or "process_worker" in r.getMessage()
or "Resolved" in r.getMessage()]
R.check(
"two timeouts in a row warn once, and the next solve logs the recovery",
[lv for lv, _ in latch_msgs] == [_logging.WARNING, _logging.INFO],
f"latch records={latch_msgs!r}",
)
_coord.PROCESS_REPLY_TIMEOUT_S = saved[0]
_coord._run_in_process(_os.getpid, ())  # warm the fresh worker
_coord.PROCESS_REPLY_TIMEOUT_S = 0.5
ol_ok_hass = _Hass()
ol_ok = _asyncio.run(_coord._await_off_loop(ol_ok_hass, _os.getpid))
R.check(
"null control: an off-loop job inside the deadline returns through the worker",
ol_ok not in (None, _parent) and ol_ok_hass.jobs == [_coord._run_in_process],
f"returned {ol_ok!r}; jobs={ol_ok_hass.jobs!r}",
)
ol_hass = _Hass()
t2 = time.monotonic()
try:
_asyncio.run(_coord._await_off_loop(ol_hass, time.sleep, 30))
ol_err = None
except Exception as e:  # noqa: BLE001
ol_err = e
ol_s = time.monotonic() - t2
R.check(
"_await_off_loop raises a timeout to its caller instead of rerunning it on the executor",
timeout_cls is not None and isinstance(ol_err, timeout_cls)
and ol_hass.jobs == [_coord._run_in_process] and ol_s < 10,
f"raised {ol_err!r} after {ol_s:.1f} s; jobs={ol_hass.jobs!r}",
)
olw_sink = _LogSink()
olw_sink.setLevel(_logging.INFO)
olw_log = _logging.getLogger(_coord.log_held.__module__)
olw_log.addHandler(olw_sink)
olw_level = olw_log.level
olw_log.setLevel(_logging.INFO)
olw_hass = _Hass()
try:
for n in range(2):
try:
_asyncio.run(_coord._await_off_loop(olw_hass, time.sleep, 30))
except Exception:  # noqa: BLE001 - the raise is checked above
pass
_coord.PROCESS_REPLY_TIMEOUT_S = saved[0]
_asyncio.run(_coord._await_off_loop(olw_hass, time.sleep, 0))
finally:
olw_log.removeHandler(olw_sink)
olw_log.setLevel(olw_level)
_coord.PROCESS_REPLY_TIMEOUT_S = 0.5
olw_msgs = [(r.levelno, r.getMessage()) for r in olw_sink.records
if "sleep" in r.getMessage()]
R.check(
"two off-loop timeouts of one job warn once, naming it, and its next completion logs the recovery",
[lv for lv, _ in olw_msgs] == [_logging.WARNING, _logging.INFO]
and "Resolved" in olw_msgs[1][1]
and all("off loop timeout:sleep" in m or "sleep skipped" in m for _, m in olw_msgs),
f"latch records={olw_msgs!r}",
)
frame_saved = _coord._REPLY_FRAME_TIMEOUT_S
R.check(
"the reply frame deadline stays at its 60 s design value",
frame_saved == 60.0,
f"_REPLY_FRAME_TIMEOUT_S = {frame_saved!r}",
)
R.check(
"the reply frame size cap stays at its 256 MiB design value",
_coord._REPLY_FRAME_MAX_BYTES == 256 * 1024 * 1024,
f"_REPLY_FRAME_MAX_BYTES = {_coord._REPLY_FRAME_MAX_BYTES!r}",
)
_coord.PROCESS_REPLY_TIMEOUT_S = saved[0]
_coord._run_in_process(_os.getpid, ())  # warm a worker under the real deadline
big_t0 = time.monotonic()
big_err, big = _submit(_coord._run_in_process, bytes, (50_000_000,))
big_s = time.monotonic() - big_t0
R.check(
"null control: a 50 MB reply arrives whole through the frame reader, inside its deadline",
big_err is None and isinstance(big, bytes) and len(big) == 50_000_000
and big_s < frame_saved,
f"raised {big_err!r}; {len(big or b'')} bytes in {big_s:.2f} s",
)
big = None
_coord._REPLY_FRAME_TIMEOUT_S = 0.5
try:
split_ok_err, split_ok = _submit(
_coord._run_in_process, _harness.split_reply, (0.05,))
R.check(
"null control: a reply frame written in two halves inside the frame deadline returns",
split_ok_err is None and split_ok == "split",
f"raised {split_ok_err!r}; returned {split_ok!r}",
)
_coord._shutdown_process_pool()  # that child exited after its frame
_coord._run_in_process(_os.getpid, ())  # warm a fresh one
split_t0 = time.monotonic()
split_err, split_out = _submit(
_coord._run_in_process, _harness.split_reply, (30,))
split_s = time.monotonic() - split_t0
split_free = _coord._PROCESS_LOCK.acquire(blocking=False)
if split_free:
_coord._PROCESS_LOCK.release()
R.check(
"a worker stopped mid-reply raises ProcessWorkerTimeout, is reaped and frees the lock",
timeout_cls is not None and isinstance(split_err, timeout_cls)
and "mid-reply" in str(split_err) and split_out is None
and split_s < 10 and split_free
and _coord._PROCESS_WORKER is None,
f"raised {split_err!r} after {split_s:.1f} s; returned {split_out!r}; "
f"lock_free={split_free} worker={_coord._PROCESS_WORKER!r}",
)
_coord._run_in_process(_os.getpid, ())  # warm a fresh one
eof_t0 = time.monotonic()
eof_err, _ = _submit(
_coord._run_in_process, _harness.split_reply, (0.05, False))
eof_s = time.monotonic() - eof_t0
R.check(
"a worker that dies mid-reply is a transport fault, not a timeout",
isinstance(eof_err, _coord.ProcessWorkerUnavailable)
and timeout_cls is not None and not isinstance(eof_err, timeout_cls)
and eof_s < 0.5,
f"raised {eof_err!r} after {eof_s:.2f} s",
)
cap_saved = _coord._REPLY_FRAME_MAX_BYTES
_coord._REPLY_FRAME_MAX_BYTES = 1_000_000
try:
cap_ok_err, cap_ok = _submit(
_coord._run_in_process, bytes, (900_000,))
cap_t0 = time.monotonic()
cap_err, cap_out = _submit(
_coord._run_in_process, bytes, (2_000_000,))
cap_s = time.monotonic() - cap_t0
finally:
_coord._REPLY_FRAME_MAX_BYTES = cap_saved
cap_free = _coord._PROCESS_LOCK.acquire(blocking=False)
if cap_free:
_coord._PROCESS_LOCK.release()
R.check(
"null control: a reply under the frame size cap returns whole",
cap_ok_err is None and cap_ok == bytes(900_000),
f"raised {cap_ok_err!r}; {len(cap_ok or b'')} bytes",
)
R.check(
"a reply frame past its size cap is a transport fault: the worker is reaped and the lock freed",
isinstance(cap_err, _coord.ProcessWorkerUnavailable)
and timeout_cls is not None and not isinstance(cap_err, timeout_cls)
and "exceeds 1000000 bytes" in str(cap_err) and cap_out is None
and cap_s < 0.5 and cap_free and _coord._PROCESS_WORKER is None,
f"raised {cap_err!r} after {cap_s:.2f} s; returned {len(cap_out or b'')} bytes; "
f"lock_free={cap_free} worker={_coord._PROCESS_WORKER!r}",
)
finally:
_coord._REPLY_FRAME_TIMEOUT_S = frame_saved
_coord.PROCESS_REPLY_TIMEOUT_S = 0.5
rl_r, rl_w = _os.pipe()
try:
_os.write(rl_w, b"ab\ncd")
rl = _coord._frame_reader(rl_r, 1.0)
rl_line, rl_rest = rl.readline(), rl.read(2)
_os.close(rl_w)
rl_w = None
rl_tail = rl.readline()
finally:
_os.close(rl_r)
if rl_w is not None:
_os.close(rl_w)
R.check(
"the frame reader's readline returns one line, the rest stays unread, and it stops at end of stream",
(rl_line, rl_rest, rl_tail) == (b"ab\n", b"cd", b""),
f"line={rl_line!r} rest={rl_rest!r} tail={rl_tail!r}",
)
dl_r, dl_w = _os.pipe()
dl = []
try:
for dl_size in (_coord._REPLY_FRAME_MAX_BYTES + 1,
_coord._REPLY_FRAME_MAX_BYTES):
dl_t0 = time.monotonic()
try:
_coord._frame_reader(dl_r, 0.3).read(dl_size)
dl.append(("returned", 0.0))
except Exception as dl_exc:  # noqa: BLE001 - the class is the result
dl.append((type(dl_exc).__name__, time.monotonic() - dl_t0))
finally:
_os.close(dl_r)
_os.close(dl_w)
R.check(
"the frame reader refuses a declared length past its cap at once, and waits on one at it",
len(dl) == 2 and dl[0][0] == "ValueError" and dl[0][1] < 0.1
and dl[1][0] == "ProcessWorkerTimeout" and dl[1][1] >= 0.25,
f"results={dl!r}",
)
import resource as resource
import gc as gc
soft, hard = resource.getrlimit(resource.RLIMIT_NOFILE)
fds = []
hi_fd = -1
hi_ok = hi_err = hi_warm = None
try:
want = 1200
if soft != resource.RLIM_INFINITY and soft < want:
resource.setrlimit(resource.RLIMIT_NOFILE, (
want if hard == resource.RLIM_INFINITY else min(want, hard),
hard))
_coord._shutdown_process_pool()
gc.collect()
while len(fds) < 1100:
fds.append(_os.open(_os.devnull, _os.O_RDONLY))
_coord.PROCESS_REPLY_TIMEOUT_S = saved[0]
hi_warm, _ = _submit(_coord._run_in_process, _os.getpid, ())
if _coord._PROCESS_WORKER is not None:
hi_fd = _coord._PROCESS_WORKER.stdout.fileno()
_coord.PROCESS_REPLY_TIMEOUT_S = 0.5
hi_ok, _ = _submit(_coord._run_in_process, time.sleep, (0.05,))
hi_err, _ = _submit(_coord._run_in_process, time.sleep, (30,))
finally:
for fd in fds:
_os.close(fd)
_coord._shutdown_process_pool()
resource.setrlimit(resource.RLIMIT_NOFILE, (soft, hard))
R.check(
"a worker pipe at fd >= 1024 answers in time and still times out as a timeout",
hi_warm is None and hi_fd >= 1024 and hi_ok is None
and timeout_cls is not None and type(hi_err) is timeout_cls,
f"warm raised {hi_warm!r}; stdout fd={hi_fd}; fast job raised {hi_ok!r}; slow job raised {hi_err!r}",
)
_coord.PROCESS_REPLY_TIMEOUT_S = saved[0]
_coord._SHUTDOWN_LOCK_TIMEOUT_S = 0.2
_coord._run_in_process(_os.getpid, ())
release = threading.Event()
def hold() -> None:
with _coord._PROCESS_LOCK:
release.wait(10)
holder = threading.Thread(target=hold, daemon=True)
holder.start()
time.sleep(0.05)
t1 = time.monotonic()
_coord._shutdown_process_pool()
stop_s = time.monotonic() - t1
release.set()
holder.join(5)
R.check(
"the stop path returns within its lock timeout while the lock is held",
stop_s < 3,
f"_shutdown_process_pool took {stop_s:.2f} s with the lock held",
)
finally:
_coord.PROCESS_REPLY_TIMEOUT_S, _coord._SHUTDOWN_LOCK_TIMEOUT_S = saved
from heatpump_optimizer import services as svc
from homeassistant.exceptions import HomeAssistantError as HAE
svc_coord_mod = sys.modules[svc.__name__.rsplit(".", 1)[0] + ".coordinator"]
class _WtDiagCoord:
def __init__(self, outcome):
self.outcome = outcome
async def async_diagnose_interval(self):
if isinstance(self.outcome, BaseException):
raise self.outcome
return self.outcome
def diagnose(outcome):
saved = svc._manual_targets
svc._manual_targets = lambda hass, target: [("e1", _WtDiagCoord(outcome))]
try:
return None, _asyncio.run(svc.handle_diagnose_interval(
None, SimpleNamespace(data={})))
except Exception as err:  # noqa: BLE001 - the error IS the measurement
return err, None
finally:
svc._manual_targets = saved
dg_ok_err, dg_ok = diagnose({"residual": 0.1})
R.check(
"null control: a diagnosis that runs is returned by the service",
dg_ok_err is None and dg_ok == {"diagnosis": {"e1": {"residual": 0.1}}},
f"raised {dg_ok_err!r}; returned {dg_ok!r}",
)
for dg_exc in (
svc_coord_mod.ProcessWorkerTimeout("process worker gave no reply within 1800 s"),
svc_coord_mod.ProcessWorkerUnavailable("process worker cannot start: boom"),
):
dg_err, _ = diagnose(dg_exc)
R.check(
f"a diagnosis failing with {type(dg_exc).__name__} reaches the service caller translated",
isinstance(dg_err, HAE)
and not isinstance(dg_err, svc_coord_mod.ProcessWorkerUnavailable)
and getattr(dg_err, "translation_key", None) == "diagnose_interval_failed"
and getattr(dg_err, "translation_placeholders", None)
== {"entry_ids": "e1", "error": str(dg_exc)},
f"raised {dg_err!r}",
)
