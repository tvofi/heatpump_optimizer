2026-10-10T10:06:36.9713588Z mkdir -p "$out"
2026-10-10T10:06:36.9713866Z printf '%s\n' "$PR_HEAD" > "$out/head"
2026-10-10T10:06:36.9714195Z touch "$RUNNER_TEMP/mutation-table.txt"
2026-10-10T10:06:36.9714820Z python3 -c 'import json, sys; sys.path.insert(0, "tests"); import mutation_table as m; print(json.dumps(m.load_budgets()))' \
2026-10-10T10:06:36.9715416Z   > "$RUNNER_TEMP/ledger-before.json"
2026-10-10T10:06:36.9715738Z rm -f "$RUNNER_TEMP/pin-run.txt"
2026-10-10T10:06:36.9716126Z # 260 minutes under a 340-minute step and a 350-minute job, sized
2026-10-10T10:06:36.9716608Z # from the run that measured the pool instead of estimating it
2026-10-10T10:06:36.9717085Z # (R9-CI-1 round 2, run 37925123437 shard 3, base b2b6acd64: 5
2026-10-10T10:06:36.9717533Z # draw_range.py sites). Its shared drivers are ~3160 s of recorded
2026-10-10T10:06:36.9717999Z # seconds a site; the 3-worker pool cost 1.46x that, so five sites
2026-10-10T10:06:36.9718456Z # took ~128 min of shared work, and each survivor's EXCLUSIVE tail
2026-10-10T10:06:36.9718924Z # (stress.py and harness_headers.py, a settle and a run each, ~980 s)
2026-10-10T10:06:36.9719403Z # would have added ~114 min more -- ~248 min against the 120-minute
2026-10-10T10:06:36.9719862Z # budget the run had, so every tail was cut and the shard refused
2026-10-10T10:06:36.9720318Z # having completed nothing. 260 covers it. The step adds the worst
2026-10-10T10:06:36.9720749Z # run that can still be in flight at the deadline --
2026-10-10T10:06:36.9721214Z # driver_timeout is TIMEOUT_SCALE (3) x the driver's own seconds, so
2026-10-10T10:06:36.9721710Z # boost_drift_replay.py's recorded 1489.6 s is ~75 min -- and the
2026-10-10T10:06:36.9722547Z # job adds this runner's checkout, pip install and upload. A base
2026-10-10T10:06:36.9723001Z # program that has the flag gets it; pin_shard_count sizes the
2026-10-10T10:06:36.9723392Z # matrix so a shard holds five sites.
2026-10-10T10:06:36.9723681Z budget=()
2026-10-10T10:06:36.9723891Z shard=()
2026-10-10T10:06:36.9724273Z run=1
2026-10-10T10:06:36.9724627Z if grep -qE '^MUTATION TABLE REFUSED -- [0-9]+ unpinned site\(s\) against' \
2026-10-10T10:06:36.9725083Z      "$RUNNER_TEMP/mutation-table.txt" \
2026-10-10T10:06:36.9725535Z    && git show "$PR_BASE":tests/mutation_table.py > tests/_mutation_table_base.py \
2026-10-10T10:06:36.9726050Z    && grep -q -- '--pin-killed' tests/_mutation_table_base.py; then
2026-10-10T10:06:36.9726504Z   echo tests/_mutation_table_base.py >> .git/info/exclude
2026-10-10T10:06:36.9726929Z   grep -q -- '--budget-minutes' tests/_mutation_table_base.py \
2026-10-10T10:06:36.9727311Z     && budget=(--budget-minutes 260)
2026-10-10T10:06:36.9727669Z   if grep -q -- '--shard' tests/_mutation_table_base.py; then
2026-10-10T10:06:36.9728037Z     shard=(--shard "$SHARD/$SHARDS")
2026-10-10T10:06:36.9728324Z   elif [ "$SHARD" != 1 ]; then
2026-10-10T10:06:36.9728585Z     run=0
2026-10-10T10:06:36.9728909Z     echo "base program has no --shard: shard 1 measures the whole pool"
2026-10-10T10:06:36.9729293Z   fi
2026-10-10T10:06:36.9729587Z   # A refusal exits non-zero; the runner's `bash -e` would end the
2026-10-10T10:06:36.9730026Z   # step there, before measurement() wrote any status, and
2026-10-10T10:06:36.9730495Z   # mutation-autofix then read a missing file as skip-no-measurement
2026-10-10T10:06:36.9731121Z   # (#2025, run 37663843895). measurement() grades the run instead.
2026-10-10T10:06:36.9731678Z   [ "$run" = 1 ] && { python3 tests/_mutation_table_base.py --pin-killed --base origin/main --jobs 3 \
2026-10-10T10:06:36.9732553Z     "${budget[@]}" "${shard[@]}" 2>&1 | tee "$RUNNER_TEMP/pin-run.txt" \
2026-10-10T10:06:36.9733019Z     || echo "pin run exited non-zero; measurement() grades it"; }
2026-10-10T10:06:36.9733384Z fi
2026-10-10T10:06:36.9733625Z rm -f tests/_mutation_table_base.py
2026-10-10T10:06:36.9733925Z [ "$run" = 1 ] || exit 0
2026-10-10T10:06:36.9734216Z python3 - "$RUNNER_TEMP" "$out" <<'PY'
2026-10-10T10:06:36.9734512Z import json, sys
2026-10-10T10:06:36.9734755Z from pathlib import Path
2026-10-10T10:06:36.9735024Z sys.path.insert(0, "tests")
2026-10-10T10:06:36.9735299Z import mutation_table
2026-10-10T10:06:36.9735603Z tmp, out = Path(sys.argv[1]), Path(sys.argv[2])
2026-10-10T10:06:36.9735926Z run = tmp / "pin-run.txt"
2026-10-10T10:06:36.9736224Z status, added = mutation_table.measurement(
2026-10-10T10:06:36.9736573Z     (tmp / "mutation-table.txt").read_text(),
2026-10-10T10:06:36.9736912Z     run.read_text() if run.exists() else None,
2026-10-10T10:06:36.9737281Z     json.loads((tmp / "ledger-before.json").read_text()),
2026-10-10T10:06:36.9737649Z     mutation_table.load_budgets())
2026-10-10T10:06:36.9738011Z (out / "pins.json").write_text(json.dumps(added, indent=2))
2026-10-10T10:06:36.9738389Z (out / "status").write_text(status + "\n")
2026-10-10T10:06:36.9738741Z print(f"measure: {status}, {len(added)} anchor(s)")
2026-10-10T10:06:36.9739063Z PY
