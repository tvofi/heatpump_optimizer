2026-10-28T05:16:22.4281935Z # jq, NOT python. The derivation must stay on this job's pin
2026-10-28T05:16:22.4282198Z # allowlist (`codeowners_gap.py`'s admitted(): no heredoc, no `-c`,
2026-10-28T05:16:22.4282461Z # no `-`). A `python3 - <<'PY'` heredoc is not an admitted command, so
2026-10-28T05:16:22.4282728Z # it taints the job from its line on and unpins every file after it --
2026-10-28T05:16:22.4282992Z # `tools/pr/preflight.sh` just below and `tools/pr/prepr.sh` in the
2026-10-28T05:16:22.4283255Z # version-edit step, both of which the restore above puts back from
2026-10-28T05:16:22.4283508Z # the base. That unpinning is what `codeowners_gap.py --check` refuses
2026-10-28T05:16:22.4283940Z # (#1515; decision 0013), so a rewrite back to python must keep an
2026-10-28T05:16:22.4284196Z # admitted command or the pin falls. Same extraction and set
2026-10-28T05:16:22.4284436Z # arithmetic as the seat's prepr.sh states: closes = a number after a
2026-10-28T05:16:22.4284695Z # closing keyword; never = a roster `issues` number no group names in
2026-10-28T05:16:22.4284921Z # `fixes`; intended = closes minus never.
2026-10-28T05:16:22.4285798Z INTENDED=$(jq -rs --rawfile body /tmp/pr-body.md '. as $r | [$r[].groups[]? | .fixes[]?] as $fixes | [$r[].groups[]? | .issues[]?] as $issues | [$issues[] | select(. as $n | ($fixes | index($n)) == null)] as $never | [ $body | match("\\b(?:close[sd]?|fix(?:e[sd])?|resolve[sd]?)\\s*:?\\s+(?:https?://[^ ]*/issues/|[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#|GH-|#)([0-9]+)"; "gi") | .captures[0].string | tonumber ] as $closes | [$closes[] | select(. as $n | ($never | index($n)) == null)] | unique | sort | map(tostring) | join(" ")' dev/programme/rosters/wave-r*-groups.json)
2026-10-28T05:16:22.4286869Z if test -f tools/audit/preflight.sh; then bash tools/audit/preflight.sh $INTENDED < /tmp/pr-body.md; else bash tools/pr/preflight.sh $INTENDED < /tmp/pr-body.md; fi
