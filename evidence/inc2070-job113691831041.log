2026-10-09T05:57:58.0983336Z # Under the 170-minute step timeout with room for the runs in flight
2026-10-09T05:57:58.0983798Z # (R9-F10.12): admission charges a lazy driver its run alone, so a
2026-10-09T05:57:58.0984300Z # red run's baseline and null control are paid past the deadline --
2026-10-09T05:57:58.0984761Z # boost_drift_replay.py's three runs are ~26 minutes at its recorded
2026-10-09T05:57:58.0985203Z # seconds. At 90 minutes four shards of 14 pinned 19 of #2025's 56
2026-10-09T05:57:58.0985648Z # sites, each site ~2000 s of driver work; six sites a shard fit 120
2026-10-09T05:57:58.0986067Z # (R9-CI-1). Only a base program that has a flag gets it.
2026-10-09T05:57:58.0986401Z budget=()
2026-10-09T05:57:58.0986626Z shard=()
2026-10-09T05:57:58.0986845Z run=1
2026-10-09T05:57:58.0987206Z if grep -qE '^MUTATION TABLE REFUSED -- [0-9]+ unpinned site\(s\) against' \
2026-10-09T05:57:58.0987627Z      "$RUNNER_TEMP/mutation-table.txt" \
2026-10-09T05:57:58.0988059Z    && git show "$PR_BASE":tests/mutation_table.py > tests/_mutation_table_base.py \
2026-10-09T05:57:58.0988557Z    && grep -q -- '--pin-killed' tests/_mutation_table_base.py; then
2026-10-09T05:57:58.0988977Z   echo tests/_mutation_table_base.py >> .git/info/exclude
2026-10-09T05:57:58.0989394Z   grep -q -- '--budget-minutes' tests/_mutation_table_base.py \
2026-10-09T05:57:58.0989927Z     && budget=(--budget-minutes 120)
2026-10-09T05:57:58.0990284Z   if grep -q -- '--shard' tests/_mutation_table_base.py; then
2026-10-09T05:57:58.0990669Z     shard=(--shard "$SHARD/$SHARDS")
2026-10-09T05:57:58.0990967Z   elif [ "$SHARD" != 1 ]; then
2026-10-09T05:57:58.0991237Z     run=0
2026-10-09T05:57:58.0991816Z     echo "base program has no --shard: shard 1 measures the whole pool"
2026-10-09T05:57:58.0992193Z   fi
2026-10-09T05:57:58.0992494Z   # A refusal exits non-zero; the runner's `bash -e` would end the
2026-10-09T05:57:58.0992915Z   # step there, before measurement() wrote any status, and
2026-10-09T05:57:58.0993358Z   # mutation-autofix then read a missing file as skip-no-measurement
2026-10-09T05:57:58.0993820Z   # (#2025, run 37663843895). measurement() grades the run instead.
2026-10-09T05:57:58.0994341Z   [ "$run" = 1 ] && { python3 tests/_mutation_table_base.py --pin-killed --base origin/main --jobs 3 \
2026-10-09T05:57:58.0994873Z     "${budget[@]}" "${shard[@]}" 2>&1 | tee "$RUNNER_TEMP/pin-run.txt" \
2026-10-09T05:57:58.0995305Z     || echo "pin run exited non-zero; measurement() grades it"; }
2026-10-09T05:57:58.0995678Z fi
2026-10-09T05:57:58.0995931Z rm -f tests/_mutation_table_base.py
2026-10-09T05:57:58.0996225Z [ "$run" = 1 ] || exit 0
2026-10-09T05:57:58.0996523Z python3 - "$RUNNER_TEMP" "$out" <<'PY'
2026-10-09T05:57:58.0996820Z import json, sys
2026-10-09T05:57:58.0997077Z from pathlib import Path
2026-10-09T05:57:58.0997355Z sys.path.insert(0, "tests")
2026-10-09T05:57:58.0997745Z import mutation_table
2026-10-09T05:57:58.0998055Z tmp, out = Path(sys.argv[1]), Path(sys.argv[2])
2026-10-09T05:57:58.0998379Z run = tmp / "pin-run.txt"
2026-10-09T05:57:58.0998687Z status, added = mutation_table.measurement(
2026-10-09T05:57:58.0999206Z     (tmp / "mutation-table.txt").read_text(),
2026-10-09T05:57:58.0999685Z     run.read_text() if run.exists() else None,
2026-10-09T05:57:58.1000066Z     json.loads((tmp / "ledger-before.json").read_text()),
2026-10-09T05:57:58.1000422Z     mutation_table.load_budgets())
2026-10-09T05:57:58.1000789Z (out / "pins.json").write_text(json.dumps(added, indent=2))
2026-10-09T05:57:58.1001160Z (out / "status").write_text(status + "\n")
2026-10-09T05:57:58.1001792Z print(f"measure: {status}, {len(added)} anchor(s)")
