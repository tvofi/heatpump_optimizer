2026-10-08T22:14:38.1208861Z ##[group]Run if [ "pull_request" = "pull_request" ]; then
2026-10-08T22:14:38.1209491Z if [ "pull_request" = "pull_request" ]; then
2026-10-08T22:14:38.1209901Z   # The PR's merge-base with its target: exactly the code this
2026-10-08T22:14:38.1210372Z   # PR forked from, so the drift comparison isolates the PR.
2026-10-08T22:14:38.1210770Z   REF=$(git merge-base "origin/main" HEAD)
2026-10-08T22:14:38.1211165Z   # The branch's OWN claim list is read from the PR head, not the
2026-10-08T22:14:38.1211637Z   # synthetic merge tree this checkout is (env_drift's CLAIM_HEAD).
2026-10-08T22:14:38.1212158Z   echo "CLAIM_HEAD=2629bf6a649495a05125473300995ffea4be0aa6" >> "$GITHUB_ENV"
2026-10-08T22:14:38.1212606Z elif [ "pull_request" = "merge_group" ]; then
2026-10-08T22:14:38.1213004Z   # A queue entry is a merge commit (merge method MERGE): its first
2026-10-08T22:14:38.1213502Z   # parent is the main tip or the entry ahead of it, its second the
2026-10-08T22:14:38.1213966Z   # pull request's head. That is the shape of a pull request's
2026-10-08T22:14:38.1214413Z   # synthetic merge, whose merge-base with its target is the same
2026-10-08T22:14:38.1214872Z   # first parent, so the drift comparison and the claim list are
2026-10-08T22:14:38.1215320Z   # read exactly as on the pull request. No second parent means the
2026-10-08T22:14:38.1215749Z   # queue's merge method changed; fail rather than guess.
2026-10-08T22:14:38.1216188Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-08T22:14:38.1216647Z   PR_TIP=$(git rev-parse --verify --quiet 'HEAD^2^{commit}') || {
2026-10-08T22:14:38.1217219Z     echo "This merge_group commit has no second parent; the queue must merge with merge method MERGE."
2026-10-08T22:14:38.1217737Z     exit 1
2026-10-08T22:14:38.1217952Z   }
2026-10-08T22:14:38.1218651Z   echo "CLAIM_HEAD=${PR_TIP}" >> "$GITHUB_ENV"
2026-10-08T22:14:38.1218982Z elif [ "" = "true" ]; then
2026-10-08T22:14:38.1219348Z   # Autofix dispatch is not a pull_request event. Compare against
2026-10-08T22:14:38.1219814Z   # main the same way a PR would, not HEAD^1 (the autofix commit's
2026-10-08T22:14:38.1220234Z   # parent), so leftover drift vs main cannot hide.
2026-10-08T22:14:38.1220575Z   git fetch --no-tags origin main
2026-10-08T22:14:38.1220877Z   REF=$(git merge-base origin/main HEAD)
2026-10-08T22:14:38.1221162Z else
2026-10-08T22:14:38.1221448Z   # Push to main: compare against the state before this push.
2026-10-08T22:14:38.1221927Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-08T22:14:38.1222285Z fi
2026-10-08T22:14:38.1222489Z if [ -z "${REF}" ]; then
2026-10-08T22:14:38.1222816Z   # An empty GOLDEN_REF is not "no preference": run.sh and
