diff --git a/tools/audit/archscore/planted/redteam/42d_literal_module_attr.py b/tools/audit/archscore/planted/redteam/42d_literal_module_attr.py
new file mode 100644
index 000000000..102ed3e47
--- /dev/null
+++ b/tools/audit/archscore/planted/redteam/42d_literal_module_attr.py
@@ -0,0 +1,23 @@
+"""Game literal_clone_copies by reading a bound through a module binding: in config_flow every copy of
+``_number(1, 24, 1, slider=True)`` after the first reads its upper bound as ``_rt_c.LAST_HOUR_<i>``, with
+``from . import const as _rt_c`` and each ``LAST_HOUR_<i> = 24`` appended to const.py. The same selector is
+declared as often as before; a census that folded only ``from .m import X`` constants read each copy as a
+different declaration (#2373 round-2 review, P5). Counter C21."""
+import sys
+from rt_lib import pkg
+root = sys.argv[1]
+p = pkg(root) / "config_flow.py"
+s = p.read_text()
+spelled = "_number(1, 24, 1, slider=True)"
+parts = s.split(spelled)
+assert len(parts) >= 4, len(parts)
+out = parts[0] + spelled + parts[1]
+for i, rest in enumerate(parts[2:]):
+    out += f"_number(1, _rt_c.LAST_HOUR_{i}, 1, slider=True)" + rest
+anchor = "\ndef _number("
+assert out.count(anchor) == 1
+out = out.replace(anchor, "\nfrom . import const as _rt_c\n\n" + anchor, 1)
+p.write_text(out)
+c = pkg(root) / "const.py"
+c.write_text(c.read_text() + "".join(f"\nLAST_HOUR_{i} = 24" for i in range(len(parts) - 2)) + "\n")
+print("read through the binding", len(parts) - 2)
diff --git a/tools/audit/archscore/planted/redteam/44c_card_empty_statement.py b/tools/audit/archscore/planted/redteam/44c_card_empty_statement.py
new file mode 100644
index 000000000..d347be11c
--- /dev/null
+++ b/tools/audit/archscore/planted/redteam/44c_card_empty_statement.py
@@ -0,0 +1,19 @@
+"""Game card_clone_copies by splitting windows with empty statements: after every second card line that is a
+``const``/``let`` statement, a lone ``;`` is inserted, so a 20-token window of a copied function no longer
+recurs. Nothing is deduplicated and the card behaves the same (#2373 round-2 review, P4). Counter C22 (an empty
+statement after ``;`` or ``{`` dropped before windowing)."""
+import sys
+from rt_lib import pkg
+root = sys.argv[1]
+n = 0
+for js in sorted((pkg(root) / "www").glob("*.js")):
+    out = []
+    for ln in js.read_text().split("\n"):
+        out.append(ln)
+        if ln.rstrip().endswith(";") and ln.lstrip().startswith(("const ", "let ")):
+            n += 1
+            if n % 2 == 0:
+                out.append(ln[:len(ln) - len(ln.lstrip())] + ";")
+    js.write_text("\n".join(out))
+assert n > 2, n
+print("inserted", n // 2)
