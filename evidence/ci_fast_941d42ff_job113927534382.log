2026-10-09T16:52:44.3507056Z ##[group]Run if [ "pull_request" = "pull_request" ]; then
2026-10-09T16:52:44.3507670Z if [ "pull_request" = "pull_request" ]; then
2026-10-09T16:52:44.3508121Z   # The PR's merge-base with its target: exactly the code this
2026-10-09T16:52:44.3508589Z   # PR forked from, so the drift comparison isolates the PR.
2026-10-09T16:52:44.3509088Z   REF=$(git merge-base "origin/main" HEAD)
2026-10-09T16:52:44.3509539Z   # The branch's OWN claim list is read from the PR head, not the
2026-10-09T16:52:44.3510051Z   # synthetic merge tree this checkout is (env_drift's CLAIM_HEAD).
2026-10-09T16:52:44.3510612Z   echo "CLAIM_HEAD=941d42ff04a791e7cbdc1d6d5904c7b3203c0d8f" >> "$GITHUB_ENV"
2026-10-09T16:52:44.3511121Z elif [ "pull_request" = "merge_group" ]; then
2026-10-09T16:52:44.3511613Z   # A queue entry is a merge commit (merge method MERGE): its first
2026-10-09T16:52:44.3512176Z   # parent is the main tip or the entry ahead of it, its second the
2026-10-09T16:52:44.3512821Z   # pull request's head. That is the shape of a pull request's
2026-10-09T16:52:44.3513310Z   # synthetic merge, whose merge-base with its target is the same
2026-10-09T16:52:44.3513798Z   # first parent, so the drift comparison and the claim list are
2026-10-09T16:52:44.3514306Z   # read exactly as on the pull request. No second parent means the
2026-10-09T16:52:44.3514914Z   # queue's merge method changed; fail rather than guess.
2026-10-09T16:52:44.3515444Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-09T16:52:44.3515940Z   PR_TIP=$(git rev-parse --verify --quiet 'HEAD^2^{commit}') || {
2026-10-09T16:52:44.3516547Z     echo "This merge_group commit has no second parent; the queue must merge with merge method MERGE."
2026-10-09T16:52:44.3517070Z     exit 1
2026-10-09T16:52:44.3517362Z   }
2026-10-09T16:52:44.3517696Z   echo "CLAIM_HEAD=${PR_TIP}" >> "$GITHUB_ENV"
2026-10-09T16:52:44.3518064Z elif [ "" = "true" ]; then
2026-10-09T16:52:44.3518546Z   # Autofix dispatch is not a pull_request event. Compare against
2026-10-09T16:52:44.3519046Z   # main the same way a PR would, not HEAD^1 (the autofix commit's
2026-10-09T16:52:44.3519499Z   # parent), so leftover drift vs main cannot hide.
2026-10-09T16:52:44.3519907Z   git fetch --no-tags origin main
2026-10-09T16:52:44.3520278Z   REF=$(git merge-base origin/main HEAD)
2026-10-09T16:52:44.3520627Z else
2026-10-09T16:52:44.3521012Z   # Push to main: compare against the state before this push.
2026-10-09T16:52:44.3521492Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-09T16:52:44.3521946Z fi
2026-10-09T16:52:44.3522223Z if [ -z "${REF}" ]; then
2026-10-09T16:52:44.3522759Z   # An empty GOLDEN_REF is not "no preference": run.sh and
2026-10-09T16:52:44.3523264Z   # env_drift.py both fall back to origin/main, which on a push to
2026-10-09T16:52:44.3523733Z   # main IS this commit -- the tree would be compared against
2026-10-09T16:52:44.3524220Z   # itself and pass no matter what it did. Fail here instead, where
2026-10-09T16:52:44.3524646Z   # the reason is visible.
2026-10-09T16:52:44.3525090Z   echo "Could not resolve a comparison ref for this pull_request."
2026-10-09T16:52:44.3525603Z   echo "The drift gate needs a baseline that is not this commit;"
2026-10-09T16:52:44.3526067Z   echo "an empty ref silently becomes origin/main == HEAD."
2026-10-09T16:52:44.3526456Z   exit 1
2026-10-09T16:52:44.3526740Z fi
2026-10-09T16:52:44.3527070Z echo "GOLDEN_REF=${REF}" >> "$GITHUB_ENV"
