2026-10-10T11:40:47.4549216Z # The pushed SHA's pull_request runs are created asynchronously,
2026-10-10T11:40:47.4550149Z # so a listing fired the instant the push step ends can precede
2026-10-10T11:40:47.4550935Z # every run and approve nothing while they appear moments later
2026-10-10T11:40:47.4551769Z # (#1283). Bounded poll first: re-list every 5s for up to 60s
2026-10-10T11:40:47.4552579Z # until one action_required run sits at the pushed SHA the push
2026-10-10T11:40:47.4553424Z # step exported. An expired window stays fail-soft -- the flow
2026-10-10T11:40:47.4554266Z # below prints the after-state it always printed, plus one
2026-10-10T11:40:47.4555101Z # notice naming the timeout, because a genuinely run-less push
2026-10-10T11:40:47.4555965Z # is legitimate (nothing-staged paths exit before token_push).
2026-10-10T11:40:47.4556936Z sha_held() {
2026-10-10T11:40:47.4557490Z   curl -fsS -H @"$tok_h" -H "$ACCEPT" \
2026-10-10T11:40:47.4558499Z     "$API/repos/$REPO/actions/runs?branch=$HEAD_REF&status=action_required&per_page=100" \
2026-10-10T11:40:47.4559563Z     | python3 -I -c 'import sys,json
2026-10-10T11:40:47.4560282Z for r in json.load(sys.stdin).get("workflow_runs", []):
2026-10-10T11:40:47.4561003Z     if r["head_sha"] == sys.argv[1]:
2026-10-10T11:40:47.4561627Z         print(r["id"])' "$PUSH_SHA"
2026-10-10T11:40:47.4562183Z }
2026-10-10T11:40:47.4562620Z waited=0
2026-10-10T11:40:47.4563054Z hits=$(sha_held)
2026-10-10T11:40:47.4563627Z while [ -z "$hits" ] && [ "$waited" -lt 60 ]; do
2026-10-10T11:40:47.4564253Z   sleep 5
2026-10-10T11:40:47.4564750Z   waited=$((waited + 5))
2026-10-10T11:40:47.4565286Z   hits=$(sha_held)
2026-10-10T11:40:47.4565784Z done
2026-10-10T11:40:47.4566844Z [ -n "$hits" ] || echo "::notice::no action_required run at $PUSH_SHA appeared within ${waited}s of the push; printing the after-state (fail-soft)"
