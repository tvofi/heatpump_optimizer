2026-10-06T09:03:40.8137175Z NUM=$(curl -fsS -H "$AUTH" -H "$ACCEPT" \
2026-10-06T09:03:40.8137686Z   "$API/repos/$REPO/pulls?head=$REPO:record/autofix&state=open" \
2026-10-06T09:03:40.8138343Z   | python3 -I -c 'import sys,json; a=json.load(sys.stdin); print(a[0]["number"] if a else "")')
2026-10-06T09:03:40.8138934Z if [ -n "$NUM" ]; then
2026-10-06T09:03:40.8139317Z   curl_json "record-pr update" PATCH \
2026-10-06T09:03:40.8139809Z     "$RUNNER_TEMP/payload.json" "$API/repos/$REPO/pulls/$NUM"
2026-10-06T09:03:40.8140260Z else
2026-10-06T09:03:40.8140893Z   curl_json "record-pr open" POST \
2026-10-06T09:03:40.8141360Z     "$RUNNER_TEMP/create.json" "$API/repos/$REPO/pulls"
2026-10-06T09:03:40.8142046Z   NUM=$(python3 -I -c 'import json,os; print(json.load(open(os.environ["RUNNER_TEMP"]+"/resp.json"))["number"])')
2026-10-06T09:03:40.8142646Z fi
2026-10-06T09:03:40.8143043Z # The beat's #201 coordination comment, naming the pull request it
2026-10-06T09:03:40.8143601Z # opened (delivery-status-tracking item 3); one per beat.
2026-10-06T09:03:40.8144102Z python3 -I tools/audit/seat/record_row.py \
2026-10-06T09:03:40.8144643Z   --print-comment --plan-file "$RUNNER_TEMP/plan.json" --pr "$NUM" \
2026-10-06T09:03:40.8145152Z   > "$RUNNER_TEMP/comment.md"
2026-10-06T09:03:40.8145783Z python3 -I -c 'import json,os; print(json.dumps({"body": open(os.environ["RUNNER_TEMP"]+"/comment.md").read()}))' \
2026-10-06T09:03:40.8146420Z   > "$RUNNER_TEMP/comment.json"
2026-10-06T09:03:40.8146971Z curl_json "record-pr comment" POST \
2026-10-06T09:03:40.8147471Z   "$RUNNER_TEMP/comment.json" "$API/repos/$REPO/issues/201/comments"
2026-10-06T09:03:40.8147972Z echo "pr=$NUM" >> "$GITHUB_OUTPUT"
