2026-10-06T09:03:40.8101221Z # The header carries its NAME, not just its value: run 37281783211
2026-10-06T09:03:40.8101840Z # self-reported the 401 as `{"message": "Requires authentication"}`
2026-10-06T09:03:40.8102424Z # -- GitHub saw no Authorization header at all -- because curl
2026-10-06T09:03:40.8102983Z # SILENTLY DROPS an -H argument without a colon (measured:
2026-10-06T09:03:40.8103640Z # `curl -H "***"` sends no header, `curl -H
2026-10-06T09:03:40.8104398Z # "Authorization: ***"` sends it), and every 401 before
2026-10-06T09:03:40.8104945Z # it, run 37261904851 included, was the same nameless header. The
2026-10-06T09:03:40.8105531Z # lengths below pin this in the log without ever printing a value:
2026-10-06T09:03:40.8106144Z # TOKEN and AUTH are both non-empty here, and the request still
2026-10-06T09:03:40.8106717Z # carried no header -- an empty-variable explanation is refuted by
2026-10-06T09:03:40.8107212Z # the same run that prints them.
2026-10-06T09:03:40.8107675Z AUTH=$(printf 'Authorization: ***' "$TOKEN")
2026-10-06T09:03:40.8108089Z echo "::add-mask::$TOKEN"
2026-10-06T09:03:40.8108490Z echo "TOKEN len=${#TOKEN} AUTH len=${#AUTH}"
2026-10-06T09:03:40.8108925Z API=https://api.github.com
2026-10-06T09:03:40.8109367Z ACCEPT='Accept: application/vnd.github+json'
2026-10-06T09:03:40.8109799Z HEAD_SHA=$(git rev-parse HEAD)
2026-10-06T09:03:40.8110292Z # Every write below reports its own evidence: URL, HTTP status and,
2026-10-06T09:03:40.8111065Z # on any non-2xx, the response body -- deliberately without curl's
2026-10-06T09:03:40.8111649Z # -f, which discarded all three. This is what turned the 401s from
2026-10-06T09:03:40.8112212Z # run 37261904851 (attempts 06:08 and 06:17, `curl: (22) ... 401`
2026-10-06T09:03:40.8112760Z # and nothing else) into run 37281783211's self-describing refusal
2026-10-06T09:03:40.8113308Z # and so into the header fix above. The token stays masked and the
2026-10-06T09:03:40.8113867Z # Authorization header value is never printed, so a future red
2026-10-06T09:03:40.8114450Z # self-explains without leaking the credential. The body file is
2026-10-06T09:03:40.8115029Z # shared, so no call runs inside a command substitution (a subshell
2026-10-06T09:03:40.8115519Z # would swallow the diagnostics).
2026-10-06T09:03:40.8116090Z curl_json() { # curl_json LABEL METHOD DATA_FILE URL; body lands in $RUNNER_TEMP/resp.json
2026-10-06T09:03:40.8116669Z   label=$1 method=$2 data=$3 url=$4
2026-10-06T09:03:40.8117136Z   code=$(curl -sS -o "$RUNNER_TEMP/resp.json" -w '%{http_code}' \
2026-10-06T09:03:40.8117680Z     -X "$method" -H "$AUTH" -H "$ACCEPT" -d @"$data" "$url") || {
2026-10-06T09:03:40.8118200Z     echo "::error::$label: transport failure against $url"
2026-10-06T09:03:40.8118636Z     return 1
2026-10-06T09:03:40.8118952Z   }
2026-10-06T09:03:40.8119241Z   case "$code" in
2026-10-06T09:03:40.8119621Z     2*) echo "$label: $method $url -> HTTP $code" ;;
2026-10-06T09:03:40.8120028Z     *)
2026-10-06T09:03:40.8120732Z       echo "::error::$label: $method $url returned HTTP $code; response body follows"
2026-10-06T09:03:40.8121310Z       cat "$RUNNER_TEMP/resp.json"
2026-10-06T09:03:40.8121689Z       return 1
2026-10-06T09:03:40.8121994Z       ;;
2026-10-06T09:03:40.8122274Z   esac
2026-10-06T09:03:40.8122553Z }
2026-10-06T09:03:40.8122957Z # The payload the pull request carries: title, body. The generator
2026-10-06T09:03:40.8123720Z # refuses a body with a closing keyword before an issue number, so
2026-10-06T09:03:40.8124314Z # the generation is the guard, not this step's prose. POST /pulls
2026-10-06T09:03:40.8124884Z # also REQUIRES head and base -- a title-and-body payload is
2026-10-06T09:03:40.8125442Z # refused 422 "Invalid request ... weren't supplied" (verified
2026-10-06T09:03:40.8125996Z # from the orchestrator's box; the CI 401s masked it) -- so the
2026-10-06T09:03:40.8126554Z # create payload adds them: head is the branch the lookup below
2026-10-06T09:03:40.8127105Z # keys on, base is main. PATCH takes title and body only.
2026-10-06T09:03:40.8127746Z python3 -I - "$HEAD_SHA" "$BASE_SHA" <<'PY' > /dev/null
2026-10-06T09:03:40.8128200Z import json, os, subprocess, sys
2026-10-06T09:03:40.8128601Z head, base = sys.argv[1], sys.argv[2]
2026-10-06T09:03:40.8129040Z plan = os.environ["RUNNER_TEMP"] + "/plan.json"
2026-10-06T09:03:40.8129503Z row = "tools/audit/seat/record_row.py"
2026-10-06T09:03:40.8129891Z def gen(*flags):
2026-10-06T09:03:40.8130329Z     return subprocess.run(["python3", "-I", row, *flags], check=True,
2026-10-06T09:03:40.8131017Z                           capture_output=True, text=True).stdout
2026-10-06T09:03:40.8131529Z title = gen("--print-title", "--plan-file", plan).strip()
2026-10-06T09:03:40.8132021Z body = gen("--print-body", "--plan-file", plan,
2026-10-06T09:03:40.8132458Z            "--head", head, "--base", base)
2026-10-06T09:03:40.8132891Z json.dump({"title": title, "body": body},
2026-10-06T09:03:40.8133377Z           open(os.environ["RUNNER_TEMP"] + "/payload.json", "w"))
2026-10-06T09:03:40.8133858Z json.dump({"title": title, "body": body,
2026-10-06T09:03:40.8134306Z            "head": "record/autofix", "base": "main"},
2026-10-06T09:03:40.8134800Z           open(os.environ["RUNNER_TEMP"] + "/create.json", "w"))
2026-10-06T09:03:40.8135236Z PY
2026-10-06T09:03:40.8135632Z # Open or update: the beat's own open pull request from a previous
2026-10-06T09:03:40.8136207Z # unmerged beat is updated in place (fresh rows commit, regenerated
