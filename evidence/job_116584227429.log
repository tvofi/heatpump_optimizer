2026-10-15T18:00:47.2444886Z # --record-only, on both paths: merging here would overwrite the
2026-10-15T18:00:47.2445399Z # committed tests/closures.json with what this run just measured, and
2026-10-15T18:00:47.2446276Z # the check below would then compare the file against itself.
2026-10-15T18:00:47.2446684Z if [ "$SCOPE_CASE" = "scoped" ]; then
2026-10-15T18:00:47.2447186Z   printf '%s\n' "$SCOPE_SCRIPTS" > "$RUNNER_TEMP/rederive.txt"
2026-10-15T18:00:47.2447705Z   echo "Scoped re-derive; every other closure is left as committed:"
2026-10-15T18:00:47.2448106Z   cat "$RUNNER_TEMP/rederive.txt"
2026-10-15T18:00:47.2448633Z   # One --scripts-from lane run, not a --single per script: a
2026-10-15T18:00:47.2449115Z   # serial loop pays the SUM of the selected recordings (51m18s
2026-10-15T18:00:47.2449724Z   # over 24 scripts on #2071's job) where a lane-balanced run pays
2026-10-15T18:00:47.2450164Z   # the MAX of its lanes. The runner shards the list itself
2026-10-15T18:00:47.2450688Z   # (closure.py lane-plan: the producer/consumer and driver/child
2026-10-15T18:00:47.2451203Z   # orderings kept inside one lane) and bounds itself to three
2026-10-15T18:00:47.2451636Z   # lanes on this runner, so nothing is passed in here. The
2026-10-15T18:00:47.2452100Z   # recordings are the same recordings the loop took (R9-F10.15).
2026-10-15T18:00:47.2452527Z   GOLDEN_REF="$REF" ./tests/derive_closures.sh \
2026-10-15T18:00:47.2452900Z     --scripts-from "$RUNNER_TEMP/rederive.txt" \
2026-10-15T18:00:47.2453280Z     --out-dir "$RUNNER_TEMP/closures" --record-only
2026-10-15T18:00:47.2453596Z else
2026-10-15T18:00:47.2453852Z   GOLDEN_REF="$REF" ./tests/derive_closures.sh \
2026-10-15T18:00:47.2454219Z     --out-dir "$RUNNER_TEMP/closures" --record-only
2026-10-15T18:00:47.2454532Z fi
