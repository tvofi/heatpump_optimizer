2026-10-18T07:04:14.5727442Z ##[group]Run if [ "pull_request" = "pull_request" ]; then
2026-10-18T07:04:14.5727729Z if [ "pull_request" = "pull_request" ]; then
2026-10-18T07:04:14.5727951Z   # The PR's merge-base with its target: exactly the code this
2026-10-18T07:04:14.5728202Z   # PR forked from, so the drift comparison isolates the PR.
2026-10-18T07:04:14.5728440Z   REF=$(git merge-base "origin/main" HEAD)
2026-10-18T07:04:14.5728661Z   # The branch's OWN claim list is read from the PR head, not the
2026-10-18T07:04:14.5728926Z   # synthetic merge tree this checkout is (env_drift's CLAIM_HEAD).
2026-10-18T07:04:14.5729209Z   echo "CLAIM_HEAD=a0c0f86652e684c7e8449b9760273a343582d4ca" >> "$GITHUB_ENV"
2026-10-18T07:04:14.5729462Z elif [ "pull_request" = "merge_group" ]; then
2026-10-18T07:04:14.5729686Z   # A queue entry is a merge commit (merge method MERGE): its first
2026-10-18T07:04:14.5729981Z   # parent is the main tip or the entry ahead of it, its second the
2026-10-18T07:04:14.5730230Z   # pull request's head. That is the shape of a pull request's
2026-10-18T07:04:14.5730480Z   # synthetic merge, whose merge-base with its target is the same
2026-10-18T07:04:14.5730736Z   # first parent, so the drift comparison and the claim list are
2026-10-18T07:04:14.5730992Z   # read exactly as on the pull request. No second parent means the
2026-10-18T07:04:14.5731237Z   # queue's merge method changed; fail rather than guess.
2026-10-18T07:04:14.5731483Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-18T07:04:14.5731738Z   PR_TIP=$(git rev-parse --verify --quiet 'HEAD^2^{commit}') || {
2026-10-18T07:04:14.5732048Z     echo "This merge_group commit has no second parent; the queue must merge with merge method MERGE."
2026-10-18T07:04:14.5732311Z     exit 1
2026-10-18T07:04:14.5732432Z   }
2026-10-18T07:04:14.5732778Z   echo "CLAIM_HEAD=${PR_TIP}" >> "$GITHUB_ENV"
2026-10-18T07:04:14.5732968Z elif [ "" = "true" ]; then
2026-10-18T07:04:14.5733168Z   # Autofix dispatch is not a pull_request event. Compare against
2026-10-18T07:04:14.5733422Z   # main the same way a PR would, not HEAD^1 (the autofix commit's
2026-10-18T07:04:14.5733657Z   # parent), so leftover drift vs main cannot hide.
2026-10-18T07:04:14.5733847Z   git fetch --no-tags origin main
2026-10-18T07:04:14.5734016Z   REF=$(git merge-base origin/main HEAD)
2026-10-18T07:04:14.5734174Z else
2026-10-18T07:04:14.5734348Z   # Push to main: compare against the state before this push.
2026-10-18T07:04:14.5734595Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-18T07:04:14.5734788Z fi
2026-10-18T07:04:14.5734904Z if [ -z "${REF}" ]; then
2026-10-18T07:04:14.5735090Z   # An empty GOLDEN_REF is not "no preference": run.sh and
2026-10-18T07:04:14.5735328Z   # env_drift.py both fall back to origin/main, which on a push to
2026-10-18T07:04:14.5735572Z   # main IS this commit -- the tree would be compared against
2026-10-18T07:04:14.5735812Z   # itself and pass no matter what it did. Fail here instead, where
2026-10-18T07:04:14.5736167Z   # the reason is visible.
2026-10-18T07:04:14.5736363Z   echo "Could not resolve a comparison ref for this pull_request."
2026-10-18T07:04:14.5736609Z   echo "The drift gate needs a baseline that is not this commit;"
2026-10-18T07:04:14.5736843Z   echo "an empty ref silently becomes origin/main == HEAD."
2026-10-18T07:04:14.5737031Z   exit 1
2026-10-18T07:04:14.5737142Z fi
2026-10-18T07:04:14.5737272Z echo "GOLDEN_REF=${REF}" >> "$GITHUB_ENV"
