2026-10-18T00:38:24.7328641Z ##[group]Run if [ "pull_request" = "pull_request" ]; then
2026-10-18T00:38:24.7329117Z if [ "pull_request" = "pull_request" ]; then
2026-10-18T00:38:24.7329513Z   # The PR's merge-base with its target: exactly the code this
2026-10-18T00:38:24.7329955Z   # PR forked from, so the drift comparison isolates the PR.
2026-10-18T00:38:24.7330350Z   REF=$(git merge-base "origin/main" HEAD)
2026-10-18T00:38:24.7330757Z   # The branch's OWN claim list is read from the PR head, not the
2026-10-18T00:38:24.7331238Z   # synthetic merge tree this checkout is (env_drift's CLAIM_HEAD).
2026-10-18T00:38:24.7331748Z   echo "CLAIM_HEAD=b00c4a33a77e12059933d2d9972b3853874fc310" >> "$GITHUB_ENV"
2026-10-18T00:38:24.7332196Z elif [ "pull_request" = "merge_group" ]; then
2026-10-18T00:38:24.7332593Z   # A queue entry is a merge commit (merge method MERGE): its first
2026-10-18T00:38:24.7333291Z   # parent is the main tip or the entry ahead of it, its second the
2026-10-18T00:38:24.7333752Z   # pull request's head. That is the shape of a pull request's
2026-10-18T00:38:24.7334207Z   # synthetic merge, whose merge-base with its target is the same
2026-10-18T00:38:24.7334667Z   # first parent, so the drift comparison and the claim list are
2026-10-18T00:38:24.7335132Z   # read exactly as on the pull request. No second parent means the
2026-10-18T00:38:24.7335565Z   # queue's merge method changed; fail rather than guess.
2026-10-18T00:38:24.7336013Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-18T00:38:24.7336478Z   PR_TIP=$(git rev-parse --verify --quiet 'HEAD^2^{commit}') || {
2026-10-18T00:38:24.7337046Z     echo "This merge_group commit has no second parent; the queue must merge with merge method MERGE."
2026-10-18T00:38:24.7337524Z     exit 1
2026-10-18T00:38:24.7337733Z   }
2026-10-18T00:38:24.7337977Z   echo "CLAIM_HEAD=${PR_TIP}" >> "$GITHUB_ENV"
2026-10-18T00:38:24.7338286Z elif [ "" = "true" ]; then
2026-10-18T00:38:24.7338644Z   # Autofix dispatch is not a pull_request event. Compare against
2026-10-18T00:38:24.7339115Z   # main the same way a PR would, not HEAD^1 (the autofix commit's
2026-10-18T00:38:24.7339534Z   # parent), so leftover drift vs main cannot hide.
2026-10-18T00:38:24.7339875Z   git fetch --no-tags origin main
2026-10-18T00:38:24.7340188Z   REF=$(git merge-base origin/main HEAD)
2026-10-18T00:38:24.7340470Z else
2026-10-18T00:38:24.7340762Z   # Push to main: compare against the state before this push.
2026-10-18T00:38:24.7341210Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-18T00:38:24.7341568Z fi
2026-10-18T00:38:24.7341772Z if [ -z "${REF}" ]; then
2026-10-18T00:38:24.7342101Z   # An empty GOLDEN_REF is not "no preference": run.sh and
2026-10-18T00:38:24.7342540Z   # env_drift.py both fall back to origin/main, which on a push to
2026-10-18T00:38:24.7343113Z   # main IS this commit -- the tree would be compared against
2026-10-18T00:38:24.7343558Z   # itself and pass no matter what it did. Fail here instead, where
2026-10-18T00:38:24.7343932Z   # the reason is visible.
2026-10-18T00:38:24.7344284Z   echo "Could not resolve a comparison ref for this pull_request."
2026-10-18T00:38:24.7344901Z   echo "The drift gate needs a baseline that is not this commit;"
2026-10-18T00:38:24.7345350Z   echo "an empty ref silently becomes origin/main == HEAD."
2026-10-18T00:38:24.7345683Z   exit 1
2026-10-18T00:38:24.7345876Z fi
2026-10-18T00:38:24.7346099Z echo "GOLDEN_REF=${REF}" >> "$GITHUB_ENV"
