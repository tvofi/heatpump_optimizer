2026-10-18T14:45:04.5232237Z ##[group]Run if [ "workflow_dispatch" = "pull_request" ]; then
2026-10-18T14:45:04.5232728Z if [ "workflow_dispatch" = "pull_request" ]; then
2026-10-18T14:45:04.5233139Z   # The PR's merge-base with its target: exactly the code this
2026-10-18T14:45:04.5233585Z   # PR forked from, so the drift comparison isolates the PR.
2026-10-18T14:45:04.5234294Z   REF=$(git merge-base "origin/" HEAD)
2026-10-18T14:45:04.5234680Z   # The branch's OWN claim list is read from the PR head, not the
2026-10-18T14:45:04.5235347Z   # synthetic merge tree this checkout is (env_drift's CLAIM_HEAD).
2026-10-18T14:45:04.5235738Z   echo "CLAIM_HEAD=" >> "$GITHUB_ENV"
2026-10-18T14:45:04.5236080Z elif [ "workflow_dispatch" = "merge_group" ]; then
2026-10-18T14:45:04.5236489Z   # A queue entry is a merge commit (merge method MERGE): its first
2026-10-18T14:45:04.5236977Z   # parent is the main tip or the entry ahead of it, its second the
2026-10-18T14:45:04.5237440Z   # pull request's head. That is the shape of a pull request's
2026-10-18T14:45:04.5237908Z   # synthetic merge, whose merge-base with its target is the same
2026-10-18T14:45:04.5238365Z   # first parent, so the drift comparison and the claim list are
2026-10-18T14:45:04.5238819Z   # read exactly as on the pull request. No second parent means the
2026-10-18T14:45:04.5239267Z   # queue's merge method changed; fail rather than guess.
2026-10-18T14:45:04.5239737Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-18T14:45:04.5240213Z   PR_TIP=$(git rev-parse --verify --quiet 'HEAD^2^{commit}') || {
2026-10-18T14:45:04.5240782Z     echo "This merge_group commit has no second parent; the queue must merge with merge method MERGE."
2026-10-18T14:45:04.5241265Z     exit 1
2026-10-18T14:45:04.5241472Z   }
2026-10-18T14:45:04.5241720Z   echo "CLAIM_HEAD=${PR_TIP}" >> "$GITHUB_ENV"
2026-10-18T14:45:04.5242035Z elif [ "true" = "true" ]; then
2026-10-18T14:45:04.5242399Z   # Autofix dispatch is not a pull_request event. Compare against
2026-10-18T14:45:04.5242855Z   # main the same way a PR would, not HEAD^1 (the autofix commit's
2026-10-18T14:45:04.5243265Z   # parent), so leftover drift vs main cannot hide.
2026-10-18T14:45:04.5243618Z   git fetch --no-tags origin main
2026-10-18T14:45:04.5244201Z   REF=$(git merge-base origin/main HEAD)
2026-10-18T14:45:04.5244490Z else
2026-10-18T14:45:04.5244769Z   # Push to main: compare against the state before this push.
2026-10-18T14:45:04.5245216Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-18T14:45:04.5245567Z fi
2026-10-18T14:45:04.5245762Z if [ -z "${REF}" ]; then
2026-10-18T14:45:04.5246090Z   # An empty GOLDEN_REF is not "no preference": run.sh and
2026-10-18T14:45:04.5246522Z   # env_drift.py both fall back to origin/main, which on a push to
2026-10-18T14:45:04.5246962Z   # main IS this commit -- the tree would be compared against
2026-10-18T14:45:04.5247407Z   # itself and pass no matter what it did. Fail here instead, where
2026-10-18T14:45:04.5247780Z   # the reason is visible.
2026-10-18T14:45:04.5248154Z   echo "Could not resolve a comparison ref for this workflow_dispatch."
2026-10-18T14:45:04.5248634Z   echo "The drift gate needs a baseline that is not this commit;"
2026-10-18T14:45:04.5249062Z   echo "an empty ref silently becomes origin/main == HEAD."
2026-10-18T14:45:04.5249395Z   exit 1
2026-10-18T14:45:04.5249598Z fi
2026-10-18T14:45:04.5249823Z echo "GOLDEN_REF=${REF}" >> "$GITHUB_ENV"
