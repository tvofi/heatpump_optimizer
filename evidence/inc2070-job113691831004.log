2026-10-09T05:57:54.6185478Z # Under the 170-minute step timeout with room for the runs in flight
2026-10-09T05:57:54.6185897Z # (R9-F10.12): admission charges a lazy driver its run alone, so a
2026-10-09T05:57:54.6186369Z # red run's baseline and null control are paid past the deadline --
2026-10-09T05:57:54.6186778Z # boost_drift_replay.py's three runs are ~26 minutes at its recorded
2026-10-09T05:57:54.6187184Z # seconds. At 90 minutes four shards of 14 pinned 19 of #2025's 56
2026-10-09T05:57:54.6187595Z # sites, each site ~2000 s of driver work; six sites a shard fit 120
2026-10-09T05:57:54.6187968Z # (R9-CI-1). Only a base program that has a flag gets it.
2026-10-09T05:57:54.6188257Z budget=()
2026-10-09T05:57:54.6188445Z shard=()
2026-10-09T05:57:54.6188624Z run=1
2026-10-09T05:57:54.6189040Z if grep -qE '^MUTATION TABLE REFUSED -- [0-9]+ unpinned site\(s\) against' \
2026-10-09T05:57:54.6189479Z      "$RUNNER_TEMP/mutation-table.txt" \
2026-10-09T05:57:54.6189875Z    && git show "$PR_BASE":tests/mutation_table.py > tests/_mutation_table_base.py \
2026-10-09T05:57:54.6190318Z    && grep -q -- '--pin-killed' tests/_mutation_table_base.py; then
2026-10-09T05:57:54.6190685Z   echo tests/_mutation_table_base.py >> .git/info/exclude
2026-10-09T05:57:54.6191060Z   grep -q -- '--budget-minutes' tests/_mutation_table_base.py \
2026-10-09T05:57:54.6191551Z     && budget=(--budget-minutes 120)
2026-10-09T05:57:54.6191813Z   if grep -q -- '--shard' tests/_mutation_table_base.py; then
2026-10-09T05:57:54.6192077Z     shard=(--shard "$SHARD/$SHARDS")
2026-10-09T05:57:54.6192300Z   elif [ "$SHARD" != 1 ]; then
2026-10-09T05:57:54.6192493Z     run=0
2026-10-09T05:57:54.6192730Z     echo "base program has no --shard: shard 1 measures the whole pool"
2026-10-09T05:57:54.6192997Z   fi
2026-10-09T05:57:54.6193227Z   # A refusal exits non-zero; the runner's `bash -e` would end the
2026-10-09T05:57:54.6193536Z   # step there, before measurement() wrote any status, and
2026-10-09T05:57:54.6193860Z   # mutation-autofix then read a missing file as skip-no-measurement
2026-10-09T05:57:54.6194195Z   # (#2025, run 37663843895). measurement() grades the run instead.
2026-10-09T05:57:54.6194573Z   [ "$run" = 1 ] && { python3 tests/_mutation_table_base.py --pin-killed --base origin/main --jobs 3 \
2026-10-09T05:57:54.6194963Z     "${budget[@]}" "${shard[@]}" 2>&1 | tee "$RUNNER_TEMP/pin-run.txt" \
2026-10-09T05:57:54.6195271Z     || echo "pin run exited non-zero; measurement() grades it"; }
2026-10-09T05:57:54.6195517Z fi
2026-10-09T05:57:54.6195680Z rm -f tests/_mutation_table_base.py
2026-10-09T05:57:54.6195884Z [ "$run" = 1 ] || exit 0
2026-10-09T05:57:54.6196089Z python3 - "$RUNNER_TEMP" "$out" <<'PY'
2026-10-09T05:57:54.6196309Z import json, sys
