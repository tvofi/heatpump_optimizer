2026-10-09T05:57:54.6196689Z sys.path.insert(0, "tests")
2026-10-09T05:57:54.6197085Z import mutation_table
2026-10-09T05:57:54.6197316Z tmp, out = Path(sys.argv[1]), Path(sys.argv[2])
2026-10-09T05:57:54.6197555Z run = tmp / "pin-run.txt"
2026-10-09T05:57:54.6197780Z status, added = mutation_table.measurement(
2026-10-09T05:57:54.6198033Z     (tmp / "mutation-table.txt").read_text(),
2026-10-09T05:57:54.6198290Z     run.read_text() if run.exists() else None,
2026-10-09T05:57:54.6198562Z     json.loads((tmp / "ledger-before.json").read_text()),
2026-10-09T05:57:54.6198818Z     mutation_table.load_budgets())
2026-10-09T05:57:54.6199266Z (out / "pins.json").write_text(json.dumps(added, indent=2))
2026-10-09T05:57:54.6199542Z (out / "status").write_text(status + "\n")
2026-10-09T05:57:54.6199804Z print(f"measure: {status}, {len(added)} anchor(s)")
