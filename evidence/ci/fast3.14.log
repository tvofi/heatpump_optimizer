2026-10-02T16:53:36.9338123Z elif [ "pull_request" = "merge_group" ]; then
2026-10-02T16:53:36.9338512Z   # A queue entry is a merge commit (merge method MERGE): its first
2026-10-02T16:53:36.9338995Z   # parent is the main tip or the entry ahead of it, its second the
2026-10-02T16:53:36.9339437Z   # pull request's head. That is the shape of a pull request's
2026-10-02T16:53:36.9339878Z   # synthetic merge, whose merge-base with its target is the same
2026-10-02T16:53:36.9340336Z   # first parent, so the drift comparison and the claim list are
2026-10-02T16:53:36.9340781Z   # read exactly as on the pull request. No second parent means the
2026-10-02T16:53:36.9341206Z   # queue's merge method changed; fail rather than guess.
2026-10-02T16:53:36.9341839Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-02T16:53:36.9342294Z   PR_TIP=$(git rev-parse --verify --quiet 'HEAD^2^{commit}') || {
2026-10-02T16:53:36.9342855Z     echo "This merge_group commit has no second parent; the queue must merge with merge method MERGE."
2026-10-02T16:53:36.9343321Z     exit 1
2026-10-02T16:53:36.9343527Z   }
2026-10-02T16:53:36.9343762Z   echo "CLAIM_HEAD=${PR_TIP}" >> "$GITHUB_ENV"
2026-10-02T16:53:36.9344069Z elif [ "" = "true" ]; then
2026-10-02T16:53:36.9344424Z   # Autofix dispatch is not a pull_request event. Compare against
2026-10-02T16:53:36.9345075Z   # main the same way a PR would, not HEAD^1 (the autofix commit's
2026-10-02T16:53:36.9345480Z   # parent), so leftover drift vs main cannot hide.
2026-10-02T16:53:36.9345808Z   git fetch --no-tags origin main
2026-10-02T16:53:36.9346108Z   REF=$(git merge-base origin/main HEAD)
2026-10-02T16:53:36.9346382Z else
2026-10-02T16:53:36.9346656Z   # Push to main: compare against the state before this push.
2026-10-02T16:53:36.9347090Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-02T16:53:36.9347433Z fi
2026-10-02T16:53:36.9347627Z if [ -z "${REF}" ]; then
2026-10-02T16:53:36.9347939Z   # An empty GOLDEN_REF is not "no preference": run.sh and
2026-10-02T16:53:36.9348358Z   # env_drift.py both fall back to origin/main, which on a push to
2026-10-02T16:53:36.9348788Z   # main IS this commit -- the tree would be compared against
2026-10-02T16:53:36.9349214Z   # itself and pass no matter what it did. Fail here instead, where
2026-10-02T16:53:36.9349570Z   # the reason is visible.
2026-10-02T16:53:36.9349906Z   echo "Could not resolve a comparison ref for this pull_request."
2026-10-02T16:53:36.9350346Z   echo "The drift gate needs a baseline that is not this commit;"
2026-10-02T16:53:36.9350767Z   echo "an empty ref silently becomes origin/main == HEAD."
2026-10-02T16:53:36.9351089Z   exit 1
2026-10-02T16:53:36.9351274Z fi
2026-10-02T16:53:36.9351487Z echo "GOLDEN_REF=${REF}" >> "$GITHUB_ENV"
