2026-10-02T15:42:24.8974168Z ##[group]Run if [ "pull_request" = "pull_request" ]; then
2026-10-02T15:42:24.8974649Z if [ "pull_request" = "pull_request" ]; then
2026-10-02T15:42:24.8975047Z   # The PR's merge-base with its target: exactly the code this
2026-10-02T15:42:24.8975505Z   # PR forked from, so the drift comparison isolates the PR.
2026-10-02T15:42:24.8975888Z   REF=$(git merge-base "origin/main" HEAD)
2026-10-02T15:42:24.8976293Z   # The branch's OWN claim list is read from the PR head, not the
2026-10-02T15:42:24.8976758Z   # synthetic merge tree this checkout is (env_drift's CLAIM_HEAD).
2026-10-02T15:42:24.8977474Z   echo "CLAIM_HEAD=29b763d7c2eb23a7f01f5cf10531caeeb866f7ca" >> "$GITHUB_ENV"
2026-10-02T15:42:24.8977937Z elif [ "pull_request" = "merge_group" ]; then
2026-10-02T15:42:24.8978326Z   # A queue entry is a merge commit (merge method MERGE): its first
2026-10-02T15:42:24.8978807Z   # parent is the main tip or the entry ahead of it, its second the
2026-10-02T15:42:24.8979257Z   # pull request's head. That is the shape of a pull request's
2026-10-02T15:42:24.8979702Z   # synthetic merge, whose merge-base with its target is the same
2026-10-02T15:42:24.8980153Z   # first parent, so the drift comparison and the claim list are
2026-10-02T15:42:24.8980594Z   # read exactly as on the pull request. No second parent means the
2026-10-02T15:42:24.8981034Z   # queue's merge method changed; fail rather than guess.
2026-10-02T15:42:24.8981476Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-02T15:42:24.8981937Z   PR_TIP=$(git rev-parse --verify --quiet 'HEAD^2^{commit}') || {
2026-10-02T15:42:24.8982516Z     echo "This merge_group commit has no second parent; the queue must merge with merge method MERGE."
2026-10-02T15:42:24.8982998Z     exit 1
2026-10-02T15:42:24.8983204Z   }
