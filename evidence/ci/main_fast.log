2026-10-02T16:51:56.1235207Z ##[group]Run if [ "push" = "pull_request" ]; then
2026-10-02T16:51:56.1235655Z if [ "push" = "pull_request" ]; then
2026-10-02T16:51:56.1236046Z   # The PR's merge-base with its target: exactly the code this
2026-10-02T16:51:56.1236486Z   # PR forked from, so the drift comparison isolates the PR.
2026-10-02T16:51:56.1236866Z   REF=$(git merge-base "origin/" HEAD)
2026-10-02T16:51:56.1237242Z   # The branch's OWN claim list is read from the PR head, not the
2026-10-02T16:51:56.1237720Z   # synthetic merge tree this checkout is (env_drift's CLAIM_HEAD).
2026-10-02T16:51:56.1238114Z   echo "CLAIM_HEAD=" >> "$GITHUB_ENV"
2026-10-02T16:51:56.1238424Z elif [ "push" = "merge_group" ]; then
2026-10-02T16:51:56.1239124Z   # A queue entry is a merge commit (merge method MERGE): its first
2026-10-02T16:51:56.1239630Z   # parent is the main tip or the entry ahead of it, its second the
2026-10-02T16:51:56.1240075Z   # pull request's head. That is the shape of a pull request's
2026-10-02T16:51:56.1240524Z   # synthetic merge, whose merge-base with its target is the same
2026-10-02T16:51:56.1240967Z   # first parent, so the drift comparison and the claim list are
2026-10-02T16:51:56.1241404Z   # read exactly as on the pull request. No second parent means the
2026-10-02T16:51:56.1241826Z   # queue's merge method changed; fail rather than guess.
2026-10-02T16:51:56.1242263Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-02T16:51:56.1242718Z   PR_TIP=$(git rev-parse --verify --quiet 'HEAD^2^{commit}') || {
2026-10-02T16:51:56.1243288Z     echo "This merge_group commit has no second parent; the queue must merge with merge method MERGE."
2026-10-02T16:51:56.1243764Z     exit 1
2026-10-02T16:51:56.1243970Z   }
