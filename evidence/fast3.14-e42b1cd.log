2026-10-02T14:43:08.9537537Z ##[group]Run if [ "pull_request" = "pull_request" ]; then
2026-10-02T14:43:08.9538046Z if [ "pull_request" = "pull_request" ]; then
2026-10-02T14:43:08.9538429Z   # The PR's merge-base with its target: exactly the code this
2026-10-02T14:43:08.9538877Z   # PR forked from, so the drift comparison isolates the PR.
2026-10-02T14:43:08.9539225Z   REF=$(git merge-base "origin/main" HEAD)
2026-10-02T14:43:08.9539638Z   # The branch's OWN claim list is read from the PR head, not the
2026-10-02T14:43:08.9540060Z   # synthetic merge tree this checkout is (env_drift's CLAIM_HEAD).
2026-10-02T14:43:08.9540538Z   echo "CLAIM_HEAD=e42b1cdd805b011701479b3e19e2bbf4d6876dcc" >> "$GITHUB_ENV"
2026-10-02T14:43:08.9540965Z elif [ "pull_request" = "merge_group" ]; then
2026-10-02T14:43:08.9541343Z   # A queue entry is a merge commit (merge method MERGE): its first
2026-10-02T14:43:08.9541872Z   # parent is the main tip or the entry ahead of it, its second the
2026-10-02T14:43:08.9542292Z   # pull request's head. That is the shape of a pull request's
2026-10-02T14:43:08.9542717Z   # synthetic merge, whose merge-base with its target is the same
2026-10-02T14:43:08.9543124Z   # first parent, so the drift comparison and the claim list are
2026-10-02T14:43:08.9543731Z   # read exactly as on the pull request. No second parent means the
2026-10-02T14:43:08.9544141Z   # queue's merge method changed; fail rather than guess.
2026-10-02T14:43:08.9544537Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-02T14:43:08.9544995Z   PR_TIP=$(git rev-parse --verify --quiet 'HEAD^2^{commit}') || {
2026-10-02T14:43:08.9545479Z     echo "This merge_group commit has no second parent; the queue must merge with merge method MERGE."
2026-10-02T14:43:08.9545924Z     exit 1
2026-10-02T14:43:08.9546179Z   }
2026-10-02T14:43:08.9546451Z   echo "CLAIM_HEAD=${PR_TIP}" >> "$GITHUB_ENV"
2026-10-02T14:43:08.9546783Z elif [ "" = "true" ]; then
2026-10-02T14:43:08.9547130Z   # Autofix dispatch is not a pull_request event. Compare against
2026-10-02T14:43:08.9547531Z   # main the same way a PR would, not HEAD^1 (the autofix commit's
2026-10-02T14:43:08.9547982Z   # parent), so leftover drift vs main cannot hide.
2026-10-02T14:43:08.9548311Z   git fetch --no-tags origin main
2026-10-02T14:43:08.9548628Z   REF=$(git merge-base origin/main HEAD)
2026-10-02T14:43:08.9548957Z else
2026-10-02T14:43:08.9549270Z   # Push to main: compare against the state before this push.
2026-10-02T14:43:08.9549708Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-02T14:43:08.9550050Z fi
2026-10-02T14:43:08.9550330Z if [ -z "${REF}" ]; then
2026-10-02T14:43:08.9550648Z   # An empty GOLDEN_REF is not "no preference": run.sh and
2026-10-02T14:43:08.9551050Z   # env_drift.py both fall back to origin/main, which on a push to
