2026-10-07T08:46:02.7024485Z fi
2026-10-07T08:46:02.7024720Z umask 077
2026-10-07T08:46:02.7025011Z API=https://api.github.com
2026-10-07T08:46:02.7025376Z ACCEPT='Accept: application/vnd.github+json'
2026-10-07T08:46:02.7025742Z key="$RUNNER_TEMP/hpo-record.pem"
2026-10-07T08:46:02.7026085Z jwt_h="$RUNNER_TEMP/hpo-record-jwt.h"
2026-10-07T08:46:02.7026468Z trap 'rm -f "$key" "$jwt_h"' EXIT
2026-10-07T08:46:02.7026782Z trap 'exit 130' INT TERM HUP
2026-10-07T08:46:02.7027101Z printf '%s\n' "$RECORD_PEM" > "$key"
2026-10-07T08:46:02.7027467Z b64() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }
2026-10-07T08:46:02.7027825Z now=$(date +%s)
2026-10-07T08:46:02.7028124Z h=$(printf '{"alg":"RS256","typ":"JWT"}' | b64)
2026-10-07T08:46:02.7028571Z p=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((now - 60)) $((now + 540)) "$RECORD_APPID" | b64)
2026-10-07T08:46:02.7029125Z s=$(printf '%s.%s' "$h" "$p" | openssl dgst -sha256 -sign "$key" -binary | b64) && [ -n "$s" ] || {
2026-10-07T08:46:02.7029629Z   echo "::warning::signing the record-writer App JWT failed"
2026-10-07T08:46:02.7029987Z   exit 1
2026-10-07T08:46:02.7030228Z }
2026-10-07T08:46:02.7030732Z printf 'Authorization: ***' "$h" "$p" "$s" > "$jwt_h"
2026-10-07T08:46:02.7031438Z inst=$(curl -fsS -H @"$jwt_h" -H "$ACCEPT" "$API/repos/$REPO/installation" \
2026-10-07T08:46:02.7032138Z   | python3 -I -c 'import sys,json; print(int(json.load(sys.stdin)["id"]))') || {
2026-10-07T08:46:02.7032694Z   echo "::warning::the hpo-author App has no installation on $REPO, or its JWT was refused"
2026-10-07T08:46:02.7033116Z   exit 1
2026-10-07T08:46:02.7033360Z }
2026-10-07T08:46:02.7033660Z tok=$(curl -fsS -X POST -H @"$jwt_h" -H "$ACCEPT" \
2026-10-07T08:46:02.7034140Z   -d '{"permissions":{"contents":"write","pull_requests":"write","issues":"write"}}' \
2026-10-07T08:46:02.7034601Z   "$API/app/installations/$inst/access_tokens" \
2026-10-07T08:46:02.7035079Z   | python3 -I -c 'import sys,json; print(json.load(sys.stdin)["token"])') && [ -n "$tok" ] || {
2026-10-07T08:46:02.7035612Z   echo "::warning::minting the record-writer App installation token failed"
2026-10-07T08:46:02.7036015Z   exit 1
2026-10-07T08:46:02.7036255Z }
2026-10-07T08:46:02.7036506Z echo "::add-mask::$tok"
2026-10-07T08:46:02.7036814Z echo "token=$tok" >> "$GITHUB_OUTPUT"
