2026-10-07T08:46:03.4612391Z status="skip-unknown"
2026-10-07T08:46:03.4612686Z if [ -z "$TOKEN" ]; then
2026-10-07T08:46:03.4612994Z   status="skip-no-writer"
2026-10-07T08:46:03.4613295Z else
2026-10-07T08:46:03.4613615Z   AUTH=$(printf 'x-access-token:%s' "$TOKEN" | base64 -w0)
2026-10-07T08:46:03.4613987Z   echo "::add-mask::$AUTH"
2026-10-07T08:46:03.4614357Z   # Contrast for the PR step's length line: the SAME attempt's
2026-10-07T08:46:03.4614798Z   # token drives this basic-auth push successfully, so a length
2026-10-07T08:46:03.4615251Z   # that agrees here and there pins the value as live in both
2026-10-07T08:46:03.4615638Z   # steps. A length, never a value.
2026-10-07T08:46:03.4615984Z   echo "TOKEN len=${#TOKEN} AUTH len=${#AUTH}"
2026-10-07T08:46:03.4616405Z   git config user.name "hpo-author[bot]"
2026-10-07T08:46:03.4616820Z   git config user.email "hpo-author[bot]@users.noreply.github.com"
2026-10-07T08:46:03.4617251Z   # The explicit refspec, so the roster is readable at
2026-10-07T08:46:03.4617686Z   # origin/<ROSTER_REF> below (a bare fetch lands it on FETCH_HEAD
2026-10-07T08:46:03.4618122Z   # only). Fail-soft: an unreadable roster rows in the neutral
2026-10-07T08:46:03.4618503Z   # phrasing a seat edits at approval.
2026-10-07T08:46:03.4618953Z   git fetch -q origin "+refs/heads/$ROSTER_REF:refs/remotes/origin/$ROSTER_REF" || \
2026-10-07T08:46:03.4619521Z     echo "::warning::the roster ref $ROSTER_REF is unreadable; rows land in the neutral phrasing"
2026-10-07T08:46:03.4619989Z   for try in 1 2 3; do
