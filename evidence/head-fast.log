2026-10-28T11:40:58.5838042Z ##[group]Run if [ "pull_request" = "pull_request" ]; then
2026-10-28T11:40:58.5838521Z if [ "pull_request" = "pull_request" ]; then
2026-10-28T11:40:58.5838917Z   # The PR's merge-base with its target: exactly the code this
2026-10-28T11:40:58.5839355Z   # PR forked from, so the drift comparison isolates the PR.
2026-10-28T11:40:58.5839739Z   REF=$(git merge-base "origin/main" HEAD)
2026-10-28T11:40:58.5840134Z   # The branch's OWN claim list is read from the PR head, not the
2026-10-28T11:40:58.5840600Z   # synthetic merge tree this checkout is (env_drift's CLAIM_HEAD).
2026-10-28T11:40:58.5841488Z   echo "CLAIM_HEAD=ea4630aceaaba32d0e6c79ef16e443de15c4dc66" >> "$GITHUB_ENV"
2026-10-28T11:40:58.5841954Z elif [ "pull_request" = "merge_group" ]; then
2026-10-28T11:40:58.5842542Z   # A queue entry is a merge commit (merge method MERGE): its first
2026-10-28T11:40:58.5843065Z   # parent is the main tip or the entry ahead of it, its second the
2026-10-28T11:40:58.5843522Z   # pull request's head. That is the shape of a pull request's
2026-10-28T11:40:58.5843983Z   # synthetic merge, whose merge-base with its target is the same
2026-10-28T11:40:58.5844446Z   # first parent, so the drift comparison and the claim list are
2026-10-28T11:40:58.5844899Z   # read exactly as on the pull request. No second parent means the
2026-10-28T11:40:58.5845331Z   # queue's merge method changed; fail rather than guess.
2026-10-28T11:40:58.5845760Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-28T11:40:58.5846220Z   PR_TIP=$(git rev-parse --verify --quiet 'HEAD^2^{commit}') || {
2026-10-28T11:40:58.5846787Z     echo "This merge_group commit has no second parent; the queue must merge with merge method MERGE."
2026-10-28T11:40:58.5847277Z     exit 1
2026-10-28T11:40:58.5847489Z   }
2026-10-28T11:40:58.5847731Z   echo "CLAIM_HEAD=${PR_TIP}" >> "$GITHUB_ENV"
2026-10-28T11:40:58.5848095Z elif [ "pull_request" = "workflow_dispatch" ]; then
2026-10-28T11:40:58.5848516Z   # Autofix dispatch is not a pull_request event. Compare against
2026-10-28T11:40:58.5848975Z   # main the same way a PR would, not HEAD^1 (the autofix commit's
2026-10-28T11:40:58.5849386Z   # parent), so leftover drift vs main cannot hide.
2026-10-28T11:40:58.5849718Z   git fetch --no-tags origin main
2026-10-28T11:40:58.5850024Z   REF=$(git merge-base origin/main HEAD)
2026-10-28T11:40:58.5850301Z else
2026-10-28T11:40:58.5850594Z   # Push to main: compare against the state before this push.
2026-10-28T11:40:58.5851289Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-28T11:40:58.5851644Z fi
2026-10-28T11:40:58.5851840Z if [ -z "${REF}" ]; then
2026-10-28T11:40:58.5852165Z   # An empty GOLDEN_REF is not "no preference": run.sh and
2026-10-28T11:40:58.5852612Z   # env_drift.py both fall back to origin/main, which on a push to
2026-10-28T11:40:58.5853064Z   # main IS this commit -- the tree would be compared against
2026-10-28T11:40:58.5853501Z   # itself and pass no matter what it did. Fail here instead, where
2026-10-28T11:40:58.5853869Z   # the reason is visible.
2026-10-28T11:40:58.5854222Z   echo "Could not resolve a comparison ref for this pull_request."
2026-10-28T11:40:58.5854672Z   echo "The drift gate needs a baseline that is not this commit;"
2026-10-28T11:40:58.5855102Z   echo "an empty ref silently becomes origin/main == HEAD."
2026-10-28T11:40:58.5855429Z   exit 1
2026-10-28T11:40:58.5855626Z fi
2026-10-28T11:40:58.5855855Z echo "GOLDEN_REF=${REF}" >> "$GITHUB_ENV"
