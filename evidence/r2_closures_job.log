2026-10-18T04:01:17.5572058Z # --record-only, on both paths: merging here would overwrite the
2026-10-18T04:01:17.5572444Z # committed tests/closures.json with what this run just measured, and
2026-10-18T04:01:17.5572811Z # the check below would then compare the file against itself.
2026-10-18T04:01:17.5573116Z if [ "$SCOPE_CASE" = "scoped" ]; then
2026-10-18T04:01:17.5573425Z   printf '%s\n' "$SCOPE_SCRIPTS" > "$RUNNER_TEMP/rederive.txt"
2026-10-18T04:01:17.5573787Z   echo "Scoped re-derive; every other closure is left as committed:"
2026-10-18T04:01:17.5574095Z   cat "$RUNNER_TEMP/rederive.txt"
2026-10-18T04:01:17.5574377Z   # One --scripts-from lane run, not a --single per script: a
2026-10-18T04:01:17.5574742Z   # serial loop pays the SUM of the selected recordings (51m18s
2026-10-18T04:01:17.5575093Z   # over 24 scripts on #2071's job) where a lane-balanced run pays
2026-10-18T04:01:17.5575433Z   # the MAX of its lanes. The runner shards the list itself
2026-10-18T04:01:17.5575778Z   # (closure.py lane-plan: the producer/consumer and driver/child
2026-10-18T04:01:17.5576123Z   # orderings kept inside one lane) and bounds itself to three
2026-10-18T04:01:17.5576458Z   # lanes on this runner, so nothing is passed in here. The
2026-10-18T04:01:17.5576801Z   # recordings are the same recordings the loop took (R9-F10.15).
2026-10-18T04:01:17.5577148Z   GOLDEN_REF="$REF" ./tests/derive_closures.sh \
2026-10-18T04:01:17.5577478Z     --scripts-from "$RUNNER_TEMP/rederive.txt" \
2026-10-18T04:01:17.5577791Z     --out-dir "$RUNNER_TEMP/closures" --record-only
2026-10-18T04:01:17.5590797Z else
2026-10-18T04:01:17.5591083Z   GOLDEN_REF="$REF" ./tests/derive_closures.sh \
2026-10-18T04:01:17.5591553Z     --out-dir "$RUNNER_TEMP/closures" --record-only
2026-10-18T04:01:17.5591824Z fi
