2026-11-28T13:38:31.8985507Z ##[group]Run if [ "pull_request" = "pull_request" ]; then
2026-11-28T13:38:31.8985765Z if [ "pull_request" = "pull_request" ]; then
2026-11-28T13:38:31.8985978Z   # The PR's merge-base with its target: exactly the code this
2026-11-28T13:38:31.8986217Z   # PR forked from, so the drift comparison isolates the PR.
2026-11-28T13:38:31.8986426Z   REF=$(git merge-base "origin/main" HEAD)
2026-11-28T13:38:31.8986635Z   # The branch's OWN claim list is read from the PR head, not the
2026-11-28T13:38:31.8987043Z   # synthetic merge tree this checkout is (env_drift's CLAIM_HEAD).
2026-11-28T13:38:31.8987315Z   echo "CLAIM_HEAD=90b1fb1da7327eafed1f1dd7f225cf0007f6095a" >> "$GITHUB_ENV"
2026-11-28T13:38:31.8987559Z elif [ "pull_request" = "merge_group" ]; then
2026-11-28T13:38:31.8987769Z   # A queue entry is a merge commit (merge method MERGE): its first
2026-11-28T13:38:31.8988029Z   # parent is the main tip or the entry ahead of it, its second the
2026-11-28T13:38:31.8988269Z   # pull request's head. That is the shape of a pull request's
2026-11-28T13:38:31.8988506Z   # synthetic merge, whose merge-base with its target is the same
2026-11-28T13:38:31.8988745Z   # first parent, so the drift comparison and the claim list are
2026-11-28T13:38:31.8988991Z   # read exactly as on the pull request. No second parent means the
2026-11-28T13:38:31.8989218Z   # queue's merge method changed; fail rather than guess.
2026-11-28T13:38:31.8989456Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-11-28T13:38:31.8989701Z   PR_TIP=$(git rev-parse --verify --quiet 'HEAD^2^{commit}') || {
2026-11-28T13:38:31.8990005Z     echo "This merge_group commit has no second parent; the queue must merge with merge method MERGE."
2026-11-28T13:38:31.8990252Z     exit 1
2026-11-28T13:38:31.8990370Z   }
2026-11-28T13:38:31.8990505Z   echo "CLAIM_HEAD=${PR_TIP}" >> "$GITHUB_ENV"
2026-11-28T13:38:31.8990710Z elif [ "pull_request" = "workflow_dispatch" ]; then
2026-11-28T13:38:31.8990930Z   # Autofix dispatch is not a pull_request event. Compare against
2026-11-28T13:38:31.8991168Z   # main the same way a PR would, not HEAD^1 (the autofix commit's
2026-11-28T13:38:31.8991393Z   # parent), so leftover drift vs main cannot hide.
2026-11-28T13:38:31.8991597Z   git fetch --no-tags origin main
2026-11-28T13:38:31.8991765Z   REF=$(git merge-base origin/main HEAD)
2026-11-28T13:38:31.8992150Z elif [ "$LIGHT" = "true" ] && [ -n "$RANGE_BASE" ]; then
2026-11-28T13:38:31.8992379Z   # A light push (#3885): scoped against its range base, so the drift
2026-11-28T13:38:31.8992604Z   # comparison spans every commit the scope does.
2026-11-28T13:38:31.8992840Z   REF=$(git rev-parse --verify --quiet "${RANGE_BASE}^{commit}") || REF=""
2026-11-28T13:38:31.8993043Z else
2026-11-28T13:38:31.8993200Z   # Push to main: compare against the state before this push.
2026-11-28T13:38:31.8993433Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-11-28T13:38:31.8993623Z fi
2026-11-28T13:38:31.8993738Z if [ -z "${REF}" ]; then
2026-11-28T13:38:31.8993914Z   # An empty GOLDEN_REF is not "no preference": run.sh and
2026-11-28T13:38:31.8994147Z   # env_drift.py both fall back to origin/main, which on a push to
2026-11-28T13:38:31.8994382Z   # main IS this commit -- the tree would be compared against
2026-11-28T13:38:31.8994614Z   # itself and pass no matter what it did. Fail here instead, where
2026-11-28T13:38:31.8994813Z   # the reason is visible.
2026-11-28T13:38:31.8995004Z   echo "Could not resolve a comparison ref for this pull_request."
2026-11-28T13:38:31.8995372Z   echo "The drift gate needs a baseline that is not this commit;"
2026-11-28T13:38:31.8995602Z   echo "an empty ref silently becomes origin/main == HEAD."
2026-11-28T13:38:31.8995779Z   exit 1
2026-11-28T13:38:31.8995895Z fi
2026-11-28T13:38:31.8996024Z echo "GOLDEN_REF=${REF}" >> "$GITHUB_ENV"
