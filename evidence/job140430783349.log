2026-11-27T10:28:04.2971381Z ##[group]Run if [ "pull_request" = "pull_request" ]; then
2026-11-27T10:28:04.2971750Z if [ "pull_request" = "pull_request" ]; then
2026-11-27T10:28:04.2972067Z   # The PR's merge-base with its target: exactly the code this
2026-11-27T10:28:04.2972421Z   # PR forked from, so the drift comparison isolates the PR.
2026-11-27T10:28:04.2972727Z   REF=$(git merge-base "origin/main" HEAD)
2026-11-27T10:28:04.2973039Z   # The branch's OWN claim list is read from the PR head, not the
2026-11-27T10:28:04.2973432Z   # synthetic merge tree this checkout is (env_drift's CLAIM_HEAD).
2026-11-27T10:28:04.2973841Z   echo "CLAIM_HEAD=a8dff54818f8749246fffb9e18344dbbb1318735" >> "$GITHUB_ENV"
2026-11-27T10:28:04.2974401Z elif [ "pull_request" = "merge_group" ]; then
2026-11-27T10:28:04.2974733Z   # A queue entry is a merge commit (merge method MERGE): its first
2026-11-27T10:28:04.2975136Z   # parent is the main tip or the entry ahead of it, its second the
2026-11-27T10:28:04.2975507Z   # pull request's head. That is the shape of a pull request's
2026-11-27T10:28:04.2975869Z   # synthetic merge, whose merge-base with its target is the same
2026-11-27T10:28:04.2976227Z   # first parent, so the drift comparison and the claim list are
2026-11-27T10:28:04.2976588Z   # read exactly as on the pull request. No second parent means the
2026-11-27T10:28:04.2976931Z   # queue's merge method changed; fail rather than guess.
2026-11-27T10:28:04.2977288Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-11-27T10:28:04.2977656Z   PR_TIP=$(git rev-parse --verify --quiet 'HEAD^2^{commit}') || {
2026-11-27T10:28:04.2978104Z     echo "This merge_group commit has no second parent; the queue must merge with merge method MERGE."
2026-11-27T10:28:04.2978479Z     exit 1
2026-11-27T10:28:04.2978669Z   }
2026-11-27T10:28:04.2978882Z   echo "CLAIM_HEAD=${PR_TIP}" >> "$GITHUB_ENV"
2026-11-27T10:28:04.2979179Z elif [ "pull_request" = "workflow_dispatch" ]; then
2026-11-27T10:28:04.2979520Z   # Autofix dispatch is not a pull_request event. Compare against
2026-11-27T10:28:04.2979873Z   # main the same way a PR would, not HEAD^1 (the autofix commit's
2026-11-27T10:28:04.2980201Z   # parent), so leftover drift vs main cannot hide.
2026-11-27T10:28:04.2980478Z   git fetch --no-tags origin main
2026-11-27T10:28:04.2980728Z   REF=$(git merge-base origin/main HEAD)
2026-11-27T10:28:04.2981016Z elif [ "$LIGHT" = "true" ] && [ -n "$RANGE_BASE" ]; then
2026-11-27T10:28:04.2981361Z   # A light push (#3885): scoped against its range base, so the drift
2026-11-27T10:28:04.2981696Z   # comparison spans every commit the scope does.
2026-11-27T10:28:04.2982205Z   REF=$(git rev-parse --verify --quiet "${RANGE_BASE}^{commit}") || REF=""
2026-11-27T10:28:04.2982509Z else
2026-11-27T10:28:04.2982753Z   # Push to main: compare against the state before this push.
2026-11-27T10:28:04.2983098Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-11-27T10:28:04.2983374Z fi
2026-11-27T10:28:04.2983551Z if [ -z "${REF}" ]; then
2026-11-27T10:28:04.2983806Z   # An empty GOLDEN_REF is not "no preference": run.sh and
2026-11-27T10:28:04.2984144Z   # env_drift.py both fall back to origin/main, which on a push to
2026-11-27T10:28:04.2984637Z   # main IS this commit -- the tree would be compared against
2026-11-27T10:28:04.2984988Z   # itself and pass no matter what it did. Fail here instead, where
2026-11-27T10:28:04.2985279Z   # the reason is visible.
2026-11-27T10:28:04.2985564Z   echo "Could not resolve a comparison ref for this pull_request."
2026-11-27T10:28:04.2986058Z   echo "The drift gate needs a baseline that is not this commit;"
2026-11-27T10:28:04.2986408Z   echo "an empty ref silently becomes origin/main == HEAD."
2026-11-27T10:28:04.2986669Z   exit 1
2026-11-27T10:28:04.2986834Z fi
2026-11-27T10:28:04.2987026Z echo "GOLDEN_REF=${REF}" >> "$GITHUB_ENV"
