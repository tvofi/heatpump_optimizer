2026-10-18T14:44:57.3925124Z          | select(.status == "completed" and .conclusion == "failure")
2026-10-18T14:44:57.3925514Z          | select(.name != "pr-contract")
2026-10-18T14:44:57.3925859Z          | .name' | sort -u > /tmp/pr-reds.txt
2026-10-18T14:44:57.3926318Z printf 'red checks the body must answer: %s\n' \
2026-10-18T14:44:57.3926673Z   "$(paste -sd, /tmp/pr-reds.txt)"
