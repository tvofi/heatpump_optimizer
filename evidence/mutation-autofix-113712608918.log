2026-10-09T07:12:28.2202393Z   echo "### mutation-autofix: approve held runs"
2026-10-09T07:12:28.2202816Z   echo
2026-10-09T07:12:28.2203127Z   echo '```'
2026-10-09T07:12:28.2203746Z   echo "$approved run(s) on $HEAD_REF approved by the Actions-only App"
2026-10-09T07:12:28.2204393Z   echo "after-state: $(held_ids | wc -l | tr -d ' ') run(s) still action_required"
2026-10-09T07:12:28.2204939Z   held_ids | sed 's/^/  still held: /'
