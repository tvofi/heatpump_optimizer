2026-10-09T07:12:28.2179630Z # The pushed SHA's pull_request runs are created asynchronously,
2026-10-09T07:12:28.2180178Z # so a listing fired the instant the push step ends can precede
2026-10-09T07:12:28.2180723Z # every run and approve nothing while they appear moments later
2026-10-09T07:12:28.2181251Z # (#1283). Bounded poll first: re-list every 5s for up to 60s
2026-10-09T07:12:28.2181890Z # until one action_required run sits at the pushed SHA the push
2026-10-09T07:12:28.2182682Z # step exported. An expired window stays fail-soft -- the flow
2026-10-09T07:12:28.2183246Z # below prints the after-state it always printed, plus one
2026-10-09T07:12:28.2183794Z # notice naming the timeout, because a genuinely run-less push
2026-10-09T07:12:28.2184354Z # is legitimate (nothing-staged paths exit before token_push).
2026-10-09T07:12:28.2184830Z sha_held() {
2026-10-09T07:12:28.2185207Z   curl -fsS -H @"$tok_h" -H "$ACCEPT" \
2026-10-09T07:12:28.2185795Z     "$API/repos/$REPO/actions/runs?branch=$HEAD_REF&status=action_required&per_page=100" \
2026-10-09T07:12:28.2186359Z     | python3 -I -c 'import sys,json
2026-10-09T07:12:28.2186834Z for r in json.load(sys.stdin).get("workflow_runs", []):
2026-10-09T07:12:28.2187312Z     if r["head_sha"] == sys.argv[1]:
2026-10-09T07:12:28.2187727Z         print(r["id"])' "$PUSH_SHA"
2026-10-09T07:12:28.2188120Z }
2026-10-09T07:12:28.2188421Z waited=0
2026-10-09T07:12:28.2188785Z hits=$(sha_held)
2026-10-09T07:12:28.2189175Z while [ -z "$hits" ] && [ "$waited" -lt 60 ]; do
2026-10-09T07:12:28.2189599Z   sleep 5
2026-10-09T07:12:28.2190206Z   waited=$((waited + 5))
2026-10-09T07:12:28.2190685Z   hits=$(sha_held)
2026-10-09T07:12:28.2191051Z done
2026-10-09T07:12:28.2191721Z [ -n "$hits" ] || echo "::notice::no action_required run at $PUSH_SHA appeared within ${waited}s of the push; printing the after-state (fail-soft)"
2026-10-09T07:12:28.2192597Z held_ids() {
2026-10-09T07:12:28.2192971Z   curl -fsS -H @"$tok_h" -H "$ACCEPT" \
2026-10-09T07:12:28.2193554Z     "$API/repos/$REPO/actions/runs?branch=$HEAD_REF&status=action_required&per_page=100" \
2026-10-09T07:12:28.2194136Z     | python3 -I -c 'import sys,json
2026-10-09T07:12:28.2194610Z for r in json.load(sys.stdin).get("workflow_runs", []):
2026-10-09T07:12:28.2195075Z     print(r["id"], r["name"])'
2026-10-09T07:12:28.2195457Z }
2026-10-09T07:12:28.2195801Z held=$(held_ids) || {
2026-10-09T07:12:28.2196360Z   echo "::warning::listing action_required runs on $HEAD_REF failed; nothing approved (fail-soft)"
2026-10-09T07:12:28.2196926Z   exit 0
2026-10-09T07:12:28.2197253Z }
2026-10-09T07:12:28.2197588Z approved=0
2026-10-09T07:12:28.2197930Z while read -r id name; do
2026-10-09T07:12:28.2198339Z   [ -n "$id" ] || continue
2026-10-09T07:12:28.2198897Z   if curl -fsS -X POST -H @"$tok_h" -H "$ACCEPT" "$API/repos/$REPO/actions/runs/$id/approve"; then
2026-10-09T07:12:28.2199473Z     echo "approved run $id ($name)"
2026-10-09T07:12:28.2199881Z     approved=$((approved + 1))
2026-10-09T07:12:28.2200269Z   else
