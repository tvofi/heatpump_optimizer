2026-10-09T05:58:23.8582578Z # Under the 170-minute step timeout with room for the runs in flight
2026-10-09T05:58:23.8582875Z # (R9-F10.12): admission charges a lazy driver its run alone, so a
2026-10-09T05:58:23.8583175Z # red run's baseline and null control are paid past the deadline --
2026-10-09T05:58:23.8583464Z # boost_drift_replay.py's three runs are ~26 minutes at its recorded
2026-10-09T05:58:23.8583748Z # seconds. At 90 minutes four shards of 14 pinned 19 of #2025's 56
2026-10-09T05:58:23.8584033Z # sites, each site ~2000 s of driver work; six sites a shard fit 120
2026-10-09T05:58:23.8584332Z # (R9-CI-1). Only a base program that has a flag gets it.
2026-10-09T05:58:23.8584537Z budget=()
2026-10-09T05:58:23.8584667Z shard=()
2026-10-09T05:58:23.8584792Z run=1
2026-10-09T05:58:23.8584998Z if grep -qE '^MUTATION TABLE REFUSED -- [0-9]+ unpinned site\(s\) against' \
2026-10-09T05:58:23.8585266Z      "$RUNNER_TEMP/mutation-table.txt" \
2026-10-09T05:58:23.8585531Z    && git show "$PR_BASE":tests/mutation_table.py > tests/_mutation_table_base.py \
2026-10-09T05:58:23.8585841Z    && grep -q -- '--pin-killed' tests/_mutation_table_base.py; then
2026-10-09T05:58:23.8586098Z   echo tests/_mutation_table_base.py >> .git/info/exclude
2026-10-09T05:58:23.8586345Z   grep -q -- '--budget-minutes' tests/_mutation_table_base.py \
2026-10-09T05:58:23.8586786Z     && budget=(--budget-minutes 120)
2026-10-09T05:58:23.8587000Z   if grep -q -- '--shard' tests/_mutation_table_base.py; then
2026-10-09T05:58:23.8587217Z     shard=(--shard "$SHARD/$SHARDS")
2026-10-09T05:58:23.8587396Z   elif [ "$SHARD" != 1 ]; then
2026-10-09T05:58:23.8587547Z     run=0
2026-10-09T05:58:23.8587743Z     echo "base program has no --shard: shard 1 measures the whole pool"
2026-10-09T05:58:23.8587983Z   fi
2026-10-09T05:58:23.8588165Z   # A refusal exits non-zero; the runner's `bash -e` would end the
2026-10-09T05:58:23.8588428Z   # step there, before measurement() wrote any status, and
2026-10-09T05:58:23.8589159Z   # mutation-autofix then read a missing file as skip-no-measurement
2026-10-09T05:58:23.8589526Z   # (#2025, run 37663843895). measurement() grades the run instead.
2026-10-09T05:58:23.8589888Z   [ "$run" = 1 ] && { python3 tests/_mutation_table_base.py --pin-killed --base origin/main --jobs 3 \
2026-10-09T05:58:23.8590261Z     "${budget[@]}" "${shard[@]}" 2>&1 | tee "$RUNNER_TEMP/pin-run.txt" \
2026-10-09T05:58:23.8590558Z     || echo "pin run exited non-zero; measurement() grades it"; }
2026-10-09T05:58:23.8590781Z fi
