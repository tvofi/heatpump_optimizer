2026-10-09T05:57:51.2413903Z tmp, out = Path(sys.argv[1]), Path(sys.argv[2])
2026-10-09T05:57:51.2414245Z run = tmp / "pin-run.txt"
2026-10-09T05:57:51.2414560Z status, added = mutation_table.measurement(
2026-10-09T05:57:51.2414916Z     (tmp / "mutation-table.txt").read_text(),
2026-10-09T05:57:51.2415262Z     run.read_text() if run.exists() else None,
2026-10-09T05:57:51.2415836Z     json.loads((tmp / "ledger-before.json").read_text()),
2026-10-09T05:57:51.2416446Z     mutation_table.load_budgets())
2026-10-09T05:57:51.2417279Z (out / "pins.json").write_text(json.dumps(added, indent=2))
2026-10-09T05:57:51.2417949Z (out / "status").write_text(status + "\n")
2026-10-09T05:57:51.2418561Z print(f"measure: {status}, {len(added)} anchor(s)")
