2026-10-09T05:57:51.2398532Z # Under the 170-minute step timeout with room for the runs in flight
2026-10-09T05:57:51.2399029Z # (R9-F10.12): admission charges a lazy driver its run alone, so a
2026-10-09T05:57:51.2399542Z # red run's baseline and null control are paid past the deadline --
2026-10-09T05:57:51.2400027Z # boost_drift_replay.py's three runs are ~26 minutes at its recorded
2026-10-09T05:57:51.2400496Z # seconds. At 90 minutes four shards of 14 pinned 19 of #2025's 56
2026-10-09T05:57:51.2400962Z # sites, each site ~2000 s of driver work; six sites a shard fit 120
2026-10-09T05:57:51.2401400Z # (R9-CI-1). Only a base program that has a flag gets it.
2026-10-09T05:57:51.2401735Z budget=()
2026-10-09T05:57:51.2401944Z shard=()
2026-10-09T05:57:51.2402151Z run=1
2026-10-09T05:57:51.2402491Z if grep -qE '^MUTATION TABLE REFUSED -- [0-9]+ unpinned site\(s\) against' \
2026-10-09T05:57:51.2402932Z      "$RUNNER_TEMP/mutation-table.txt" \
2026-10-09T05:57:51.2403385Z    && git show "$PR_BASE":tests/mutation_table.py > tests/_mutation_table_base.py \
2026-10-09T05:57:51.2403906Z    && grep -q -- '--pin-killed' tests/_mutation_table_base.py; then
2026-10-09T05:57:51.2404342Z   echo tests/_mutation_table_base.py >> .git/info/exclude
2026-10-09T05:57:51.2404778Z   grep -q -- '--budget-minutes' tests/_mutation_table_base.py \
2026-10-09T05:57:51.2405339Z     && budget=(--budget-minutes 120)
2026-10-09T05:57:51.2405703Z   if grep -q -- '--shard' tests/_mutation_table_base.py; then
2026-10-09T05:57:51.2406072Z     shard=(--shard "$SHARD/$SHARDS")
2026-10-09T05:57:51.2406361Z   elif [ "$SHARD" != 1 ]; then
2026-10-09T05:57:51.2406628Z     run=0
2026-10-09T05:57:51.2407224Z     echo "base program has no --shard: shard 1 measures the whole pool"
2026-10-09T05:57:51.2407614Z   fi
2026-10-09T05:57:51.2407911Z   # A refusal exits non-zero; the runner's `bash -e` would end the
2026-10-09T05:57:51.2408358Z   # step there, before measurement() wrote any status, and
2026-10-09T05:57:51.2408820Z   # mutation-autofix then read a missing file as skip-no-measurement
2026-10-09T05:57:51.2409289Z   # (#2025, run 37663843895). measurement() grades the run instead.
2026-10-09T05:57:51.2409839Z   [ "$run" = 1 ] && { python3 tests/_mutation_table_base.py --pin-killed --base origin/main --jobs 3 \
2026-10-09T05:57:51.2410414Z     "${budget[@]}" "${shard[@]}" 2>&1 | tee "$RUNNER_TEMP/pin-run.txt" \
2026-10-09T05:57:51.2410867Z     || echo "pin run exited non-zero; measurement() grades it"; }
2026-10-09T05:57:51.2411217Z fi
2026-10-09T05:57:51.2411450Z rm -f tests/_mutation_table_base.py
2026-10-09T05:57:51.2411935Z [ "$run" = 1 ] || exit 0
2026-10-09T05:57:51.2412241Z python3 - "$RUNNER_TEMP" "$out" <<'PY'
