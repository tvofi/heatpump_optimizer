2026-10-09T05:57:51.6468561Z # Under the 170-minute step timeout with room for the runs in flight
2026-10-09T05:57:51.6469049Z # (R9-F10.12): admission charges a lazy driver its run alone, so a
2026-10-09T05:57:51.6469556Z # red run's baseline and null control are paid past the deadline --
2026-10-09T05:57:51.6470047Z # boost_drift_replay.py's three runs are ~26 minutes at its recorded
2026-10-09T05:57:51.6470520Z # seconds. At 90 minutes four shards of 14 pinned 19 of #2025's 56
2026-10-09T05:57:51.6470981Z # sites, each site ~2000 s of driver work; six sites a shard fit 120
2026-10-09T05:57:51.6471414Z # (R9-CI-1). Only a base program that has a flag gets it.
2026-10-09T05:57:51.6471743Z budget=()
2026-10-09T05:57:51.6471961Z shard=()
2026-10-09T05:57:51.6472164Z run=1
2026-10-09T05:57:51.6472502Z if grep -qE '^MUTATION TABLE REFUSED -- [0-9]+ unpinned site\(s\) against' \
2026-10-09T05:57:51.6472942Z      "$RUNNER_TEMP/mutation-table.txt" \
2026-10-09T05:57:51.6473714Z    && git show "$PR_BASE":tests/mutation_table.py > tests/_mutation_table_base.py \
2026-10-09T05:57:51.6474241Z    && grep -q -- '--pin-killed' tests/_mutation_table_base.py; then
2026-10-09T05:57:51.6474675Z   echo tests/_mutation_table_base.py >> .git/info/exclude
2026-10-09T05:57:51.6475094Z   grep -q -- '--budget-minutes' tests/_mutation_table_base.py \
2026-10-09T05:57:51.6475641Z     && budget=(--budget-minutes 120)
2026-10-09T05:57:51.6476002Z   if grep -q -- '--shard' tests/_mutation_table_base.py; then
2026-10-09T05:57:51.6476361Z     shard=(--shard "$SHARD/$SHARDS")
2026-10-09T05:57:51.6476641Z   elif [ "$SHARD" != 1 ]; then
2026-10-09T05:57:51.6476910Z     run=0
2026-10-09T05:57:51.6477232Z     echo "base program has no --shard: shard 1 measures the whole pool"
2026-10-09T05:57:51.6477600Z   fi
2026-10-09T05:57:51.6477887Z   # A refusal exits non-zero; the runner's `bash -e` would end the
2026-10-09T05:57:51.6478324Z   # step there, before measurement() wrote any status, and
2026-10-09T05:57:51.6478771Z   # mutation-autofix then read a missing file as skip-no-measurement
2026-10-09T05:57:51.6479231Z   # (#2025, run 37663843895). measurement() grades the run instead.
2026-10-09T05:57:51.6479768Z   [ "$run" = 1 ] && { python3 tests/_mutation_table_base.py --pin-killed --base origin/main --jobs 3 \
2026-10-09T05:57:51.6480324Z     "${budget[@]}" "${shard[@]}" 2>&1 | tee "$RUNNER_TEMP/pin-run.txt" \
2026-10-09T05:57:51.6480759Z     || echo "pin run exited non-zero; measurement() grades it"; }
2026-10-09T05:57:51.6481094Z fi
2026-10-09T05:57:51.6481312Z rm -f tests/_mutation_table_base.py
2026-10-09T05:57:51.6481589Z [ "$run" = 1 ] || exit 0
2026-10-09T05:57:51.6481859Z python3 - "$RUNNER_TEMP" "$out" <<'PY'
2026-10-09T05:57:51.6482144Z import json, sys
2026-10-09T05:57:51.6482384Z from pathlib import Path
2026-10-09T05:57:51.6482675Z sys.path.insert(0, "tests")
2026-10-09T05:57:51.6483322Z import mutation_table
2026-10-09T05:57:51.6483674Z tmp, out = Path(sys.argv[1]), Path(sys.argv[2])
2026-10-09T05:57:51.6484001Z run = tmp / "pin-run.txt"
2026-10-09T05:57:51.6484313Z status, added = mutation_table.measurement(
2026-10-09T05:57:51.6484665Z     (tmp / "mutation-table.txt").read_text(),
2026-10-09T05:57:51.6485003Z     run.read_text() if run.exists() else None,
2026-10-09T05:57:51.6485369Z     json.loads((tmp / "ledger-before.json").read_text()),
2026-10-09T05:57:51.6485729Z     mutation_table.load_budgets())
2026-10-09T05:57:51.6486084Z (out / "pins.json").write_text(json.dumps(added, indent=2))
2026-10-09T05:57:51.6486453Z (out / "status").write_text(status + "\n")
2026-10-09T05:57:51.6486799Z print(f"measure: {status}, {len(added)} anchor(s)")
