2026-10-09T05:58:21.3569498Z # Under the 170-minute step timeout with room for the runs in flight
2026-10-09T05:58:21.3569998Z # (R9-F10.12): admission charges a lazy driver its run alone, so a
2026-10-09T05:58:21.3570515Z # red run's baseline and null control are paid past the deadline --
2026-10-09T05:58:21.3570995Z # boost_drift_replay.py's three runs are ~26 minutes at its recorded
2026-10-09T05:58:21.3571469Z # seconds. At 90 minutes four shards of 14 pinned 19 of #2025's 56
2026-10-09T05:58:21.3571932Z # sites, each site ~2000 s of driver work; six sites a shard fit 120
2026-10-09T05:58:21.3572372Z # (R9-CI-1). Only a base program that has a flag gets it.
2026-10-09T05:58:21.3572705Z budget=()
2026-10-09T05:58:21.3572908Z shard=()
2026-10-09T05:58:21.3573103Z run=1
2026-10-09T05:58:21.3573441Z if grep -qE '^MUTATION TABLE REFUSED -- [0-9]+ unpinned site\(s\) against' \
2026-10-09T05:58:21.3573881Z      "$RUNNER_TEMP/mutation-table.txt" \
2026-10-09T05:58:21.3574339Z    && git show "$PR_BASE":tests/mutation_table.py > tests/_mutation_table_base.py \
2026-10-09T05:58:21.3574866Z    && grep -q -- '--pin-killed' tests/_mutation_table_base.py; then
2026-10-09T05:58:21.3575311Z   echo tests/_mutation_table_base.py >> .git/info/exclude
2026-10-09T05:58:21.3575732Z   grep -q -- '--budget-minutes' tests/_mutation_table_base.py \
2026-10-09T05:58:21.3576278Z     && budget=(--budget-minutes 120)
2026-10-09T05:58:21.3576639Z   if grep -q -- '--shard' tests/_mutation_table_base.py; then
2026-10-09T05:58:21.3576998Z     shard=(--shard "$SHARD/$SHARDS")
2026-10-09T05:58:21.3577277Z   elif [ "$SHARD" != 1 ]; then
2026-10-09T05:58:21.3577531Z     run=0
2026-10-09T05:58:21.3577857Z     echo "base program has no --shard: shard 1 measures the whole pool"
2026-10-09T05:58:21.3578553Z   fi
2026-10-09T05:58:21.3578858Z   # A refusal exits non-zero; the runner's `bash -e` would end the
2026-10-09T05:58:21.3579291Z   # step there, before measurement() wrote any status, and
2026-10-09T05:58:21.3579750Z   # mutation-autofix then read a missing file as skip-no-measurement
2026-10-09T05:58:21.3580218Z   # (#2025, run 37663843895). measurement() grades the run instead.
2026-10-09T05:58:21.3580763Z   [ "$run" = 1 ] && { python3 tests/_mutation_table_base.py --pin-killed --base origin/main --jobs 3 \
2026-10-09T05:58:21.3581335Z     "${budget[@]}" "${shard[@]}" 2>&1 | tee "$RUNNER_TEMP/pin-run.txt" \
2026-10-09T05:58:21.3581775Z     || echo "pin run exited non-zero; measurement() grades it"; }
2026-10-09T05:58:21.3582115Z fi
2026-10-09T05:58:21.3582329Z rm -f tests/_mutation_table_base.py
2026-10-09T05:58:21.3582617Z [ "$run" = 1 ] || exit 0
2026-10-09T05:58:21.3582890Z python3 - "$RUNNER_TEMP" "$out" <<'PY'
2026-10-09T05:58:21.3583184Z import json, sys
2026-10-09T05:58:21.3583422Z from pathlib import Path
2026-10-09T05:58:21.3583686Z sys.path.insert(0, "tests")
2026-10-09T05:58:21.3584122Z import mutation_table
2026-10-09T05:58:21.3584421Z tmp, out = Path(sys.argv[1]), Path(sys.argv[2])
2026-10-09T05:58:21.3584733Z run = tmp / "pin-run.txt"
2026-10-09T05:58:21.3585028Z status, added = mutation_table.measurement(
2026-10-09T05:58:21.3585372Z     (tmp / "mutation-table.txt").read_text(),
2026-10-09T05:58:21.3585704Z     run.read_text() if run.exists() else None,
2026-10-09T05:58:21.3586071Z     json.loads((tmp / "ledger-before.json").read_text()),
2026-10-09T05:58:21.3586428Z     mutation_table.load_budgets())
2026-10-09T05:58:21.3586774Z (out / "pins.json").write_text(json.dumps(added, indent=2))
2026-10-09T05:58:21.3587143Z (out / "status").write_text(status + "\n")
2026-10-09T05:58:21.3587488Z print(f"measure: {status}, {len(added)} anchor(s)")
