##[group]Run REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=HEAD
REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=HEAD
# --record-only, on both paths: merging here would overwrite the
# committed tests/closures.json with what this run just measured, and
# the check below would then compare the file against itself.
if [ "$SCOPE_CASE" = "scoped" ]; then
  printf '%s\n' "$SCOPE_SCRIPTS" > "$RUNNER_TEMP/rederive.txt"
  echo "Scoped re-derive; every other closure is left as committed:"
  cat "$RUNNER_TEMP/rederive.txt"
  while read -r s; do
    [ -n "$s" ] || continue
    GOLDEN_REF="$REF" ./tests/derive_closures.sh \
      --single "$s" --out-dir "$RUNNER_TEMP/closures" --record-only
  done < "$RUNNER_TEMP/rederive.txt"
else
  GOLDEN_REF="$REF" ./tests/derive_closures.sh \
    --out-dir "$RUNNER_TEMP/closures" --record-only
fi
