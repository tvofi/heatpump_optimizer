2026-10-18T12:00:35.3365154Z ##[group]Run REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=HEAD
2026-10-18T12:00:35.3365761Z REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=HEAD
2026-10-18T12:00:35.3366267Z # --record-only, on both paths: merging here would overwrite the
2026-10-18T12:00:35.3366784Z # committed tests/closures.json with what this run just measured, and
2026-10-18T12:00:35.3367265Z # the check below would then compare the file against itself.
2026-10-18T12:00:35.3367653Z if [ "$SCOPE_CASE" = "scoped" ]; then
2026-10-18T12:00:35.3368281Z   printf '%s\n' "$SCOPE_SCRIPTS" > "$RUNNER_TEMP/rederive.txt"
2026-10-18T12:00:35.3368790Z   echo "Scoped re-derive; every other closure is left as committed:"
2026-10-18T12:00:35.3369198Z   cat "$RUNNER_TEMP/rederive.txt"
2026-10-18T12:00:35.3369784Z   # One --scripts-from lane run, not a --single per script: a
2026-10-18T12:00:35.3370290Z   # serial loop pays the SUM of the selected recordings (51m18s
2026-10-18T12:00:35.3370760Z   # over 24 scripts on #2071's job) where a lane-balanced run pays
2026-10-18T12:00:35.3371204Z   # the MAX of its lanes. The runner shards the list itself
2026-10-18T12:00:35.3371650Z   # (closure.py lane-plan: the producer/consumer and driver/child
2026-10-18T12:00:35.3372111Z   # orderings kept inside one lane) and bounds itself to three
2026-10-18T12:00:35.3372547Z   # lanes on this runner, so nothing is passed in here. The
