2026-10-16T00:35:56.2037794Z ##[group]Run if [ "pull_request" = "pull_request" ]; then
2026-10-16T00:35:56.2038158Z if [ "pull_request" = "pull_request" ]; then
2026-10-16T00:35:56.2038468Z   # The PR's merge-base with its target: exactly the code this
2026-10-16T00:35:56.2038837Z   # PR forked from, so the drift comparison isolates the PR.
2026-10-16T00:35:56.2039164Z   REF=$(git merge-base "origin/main" HEAD)
2026-10-16T00:35:56.2039468Z   # The branch's OWN claim list is read from the PR head, not the
2026-10-16T00:35:56.2039829Z   # synthetic merge tree this checkout is (env_drift's CLAIM_HEAD).
2026-10-16T00:35:56.2040227Z   echo "CLAIM_HEAD=f687e6175e44dd21c691e04b43ed0e5fdd51602d" >> "$GITHUB_ENV"
2026-10-16T00:35:56.2040573Z elif [ "pull_request" = "merge_group" ]; then
2026-10-16T00:35:56.2040881Z   # A queue entry is a merge commit (merge method MERGE): its first
2026-10-16T00:35:56.2041274Z   # parent is the main tip or the entry ahead of it, its second the
2026-10-16T00:35:56.2041631Z   # pull request's head. That is the shape of a pull request's
2026-10-16T00:35:56.2041989Z   # synthetic merge, whose merge-base with its target is the same
2026-10-16T00:35:56.2042337Z   # first parent, so the drift comparison and the claim list are
2026-10-16T00:35:56.2042682Z   # read exactly as on the pull request. No second parent means the
2026-10-16T00:35:56.2043014Z   # queue's merge method changed; fail rather than guess.
2026-10-16T00:35:56.2043362Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-16T00:35:56.2043715Z   PR_TIP=$(git rev-parse --verify --quiet 'HEAD^2^{commit}') || {
2026-10-16T00:35:56.2044147Z     echo "This merge_group commit has no second parent; the queue must merge with merge method MERGE."
2026-10-16T00:35:56.2044511Z     exit 1
2026-10-16T00:35:56.2044687Z   }
2026-10-16T00:35:56.2044880Z   echo "CLAIM_HEAD=${PR_TIP}" >> "$GITHUB_ENV"
2026-10-16T00:35:56.2045126Z elif [ "" = "true" ]; then
2026-10-16T00:35:56.2045408Z   # Autofix dispatch is not a pull_request event. Compare against
2026-10-16T00:35:56.2045767Z   # main the same way a PR would, not HEAD^1 (the autofix commit's
2026-10-16T00:35:56.2046450Z   # parent), so leftover drift vs main cannot hide.
2026-10-16T00:35:56.2046717Z   git fetch --no-tags origin main
2026-10-16T00:35:56.2046954Z   REF=$(git merge-base origin/main HEAD)
2026-10-16T00:35:56.2047181Z else
2026-10-16T00:35:56.2047403Z   # Push to main: compare against the state before this push.
2026-10-16T00:35:56.2047742Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-16T00:35:56.2048009Z fi
2026-10-16T00:35:56.2048179Z if [ -z "${REF}" ]; then
2026-10-16T00:35:56.2048439Z   # An empty GOLDEN_REF is not "no preference": run.sh and
2026-10-16T00:35:56.2048771Z   # env_drift.py both fall back to origin/main, which on a push to
2026-10-16T00:35:56.2049103Z   # main IS this commit -- the tree would be compared against
2026-10-16T00:35:56.2049436Z   # itself and pass no matter what it did. Fail here instead, where
2026-10-16T00:35:56.2049720Z   # the reason is visible.
2026-10-16T00:35:56.2049988Z   echo "Could not resolve a comparison ref for this pull_request."
2026-10-16T00:35:56.2050329Z   echo "The drift gate needs a baseline that is not this commit;"
2026-10-16T00:35:56.2050657Z   echo "an empty ref silently becomes origin/main == HEAD."
2026-10-16T00:35:56.2050910Z   exit 1
2026-10-16T00:35:56.2051071Z fi
2026-10-16T00:35:56.2051254Z echo "GOLDEN_REF=${REF}" >> "$GITHUB_ENV"
