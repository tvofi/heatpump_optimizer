2026-10-05T09:10:07.6707175Z   # The explicit refspec, so the roster is readable at
2026-10-05T09:10:07.6707741Z   # origin/<ROSTER_REF> below (a bare fetch lands it on FETCH_HEAD
2026-10-05T09:10:07.6708341Z   # only). Fail-soft: an unreadable roster rows in the neutral
2026-10-05T09:10:07.6708886Z   # phrasing a seat edits at approval.
2026-10-05T09:10:07.6709473Z   git fetch -q origin "+refs/heads/$ROSTER_REF:refs/remotes/origin/$ROSTER_REF" || \
2026-10-05T09:10:07.6710319Z     echo "::warning::the roster ref $ROSTER_REF is unreadable; rows land in the neutral phrasing"
2026-10-05T09:10:07.6711033Z   for try in 1 2 3; do
2026-10-05T09:10:07.6712310Z     git -c "http.https://github.com/.extraheader=AUTHORIZATION: basic $AUTH" \
2026-10-05T09:10:07.6713398Z       fetch -q origin main && git reset -q --hard origin/main || { status="skip-fetch-failed"; break; }
2026-10-05T09:10:07.6714119Z     # The job's own previous run may have left its rows commit on
2026-10-05T09:10:07.6714699Z     # record/autofix; fetch that tip, per try, so the lease below
2026-10-05T09:10:07.6715322Z     # is anchored on the freshest observation. Fail-soft with no
2026-10-05T09:10:07.6715913Z     # annotation: absent (the ordinary state between beats) and
2026-10-05T09:10:07.6716494Z     # unreadable both leave the expectation empty, and the empty
2026-10-05T09:10:07.6717074Z     # lease then requires the branch not to exist -- so a branch
2026-10-05T09:10:07.6717622Z     # that is present but was not observed refuses, fail-closed.
2026-10-05T09:10:07.6718520Z     git fetch -q origin "+refs/heads/record/autofix:refs/remotes/origin/record/autofix" || true
2026-10-05T09:10:07.6719175Z     python3 -I tools/audit/seat/record_row.py \
2026-10-05T09:10:07.6719678Z       --plan --merges-file "$RUNNER_TEMP/merges.json" \
2026-10-05T09:10:07.6720156Z       --roster-ref "origin/$ROSTER_REF" \
2026-10-05T09:10:07.6720666Z       > "$RUNNER_TEMP/plan.json" || { status="skip-plan"; break; }
2026-10-05T09:10:07.6721433Z     if [ -z "$(python3 -I tools/audit/seat/record_row.py --row-numbers --plan-file "$RUNNER_TEMP/plan.json")" ]; then
2026-10-05T09:10:07.6722158Z       status="nothing-owed"
2026-10-05T09:10:07.6722527Z       break
2026-10-05T09:10:07.6722835Z     fi
2026-10-05T09:10:07.6723509Z     python3 -I tools/audit/seat/record_row.py \
2026-10-05T09:10:07.6724152Z       --apply --plan-file "$RUNNER_TEMP/plan.json" || { status="skip-apply"; break; }
2026-10-05T09:10:07.6724714Z     git add docs/delivery
2026-10-05T09:10:07.6725214Z     if git diff --cached --quiet; then status="nothing-owed"; break; fi
2026-10-05T09:10:07.6725881Z     git commit -q -m "ci: record delivery rows" || { status="nothing-owed"; break; }
2026-10-05T09:10:07.6726572Z     expect=$(git rev-parse -q --verify refs/remotes/origin/record/autofix || :)
2026-10-05T09:10:07.6727290Z     if git -c "http.https://github.com/.extraheader=AUTHORIZATION: basic $AUTH" \
