2026-10-05T09:10:10.8711728Z # Every write below reports its own evidence: URL, HTTP status and,
2026-10-05T09:10:10.8712369Z # on any non-2xx, the response body -- deliberately without curl's
2026-10-05T09:10:10.8712988Z # -f, which discarded all three. The 401s of run 37261904851
2026-10-05T09:10:10.8713923Z # (attempts 06:08 and 06:17) printed only `curl: (22) ... 401`,
2026-10-05T09:10:10.8714517Z # while the byte-equivalent request returns 201/422 from the
2026-10-05T09:10:10.8715180Z # orchestrator's box; the token stays masked and the Authorization
2026-10-05T09:10:10.8715800Z # header value is never printed, so the next red self-explains
2026-10-05T09:10:10.8716420Z # without leaking the credential. The body file is shared, so no
2026-10-05T09:10:10.8717051Z # call runs inside a command substitution (a subshell would
2026-10-05T09:10:10.8717555Z # swallow the diagnostics).
2026-10-05T09:10:10.8718142Z curl_json() { # curl_json LABEL METHOD DATA_FILE URL; body lands in $RUNNER_TEMP/resp.json
2026-10-05T09:10:10.8718765Z   label=$1 method=$2 data=$3 url=$4
2026-10-05T09:10:10.8719297Z   code=$(curl -sS -o "$RUNNER_TEMP/resp.json" -w '%{http_code}' \
2026-10-05T09:10:10.8719878Z     -X "$method" -H "$AUTH" -H "$ACCEPT" -d @"$data" "$url") || {
2026-10-05T09:10:10.8720426Z     echo "::error::$label: transport failure against $url"
2026-10-05T09:10:10.8720885Z     return 1
2026-10-05T09:10:10.8721197Z   }
2026-10-05T09:10:10.8721502Z   case "$code" in
2026-10-05T09:10:10.8721893Z     2*) echo "$label: $method $url -> HTTP $code" ;;
2026-10-05T09:10:10.8722337Z     *)
2026-10-05T09:10:10.8722809Z       echo "::error::$label: $method $url returned HTTP $code; response body follows"
2026-10-05T09:10:10.8723724Z       cat "$RUNNER_TEMP/resp.json"
2026-10-05T09:10:10.8724126Z       return 1
2026-10-05T09:10:10.8724693Z       ;;
2026-10-05T09:10:10.8724995Z   esac
2026-10-05T09:10:10.8725282Z }
2026-10-05T09:10:10.8725702Z # The payload the pull request carries: title, body. The generator
2026-10-05T09:10:10.8726331Z # refuses a body with a closing keyword before an issue number, so
2026-10-05T09:10:10.8726937Z # the generation is the guard, not this step's prose. POST /pulls
2026-10-05T09:10:10.8727542Z # also REQUIRES head and base -- a title-and-body payload is
2026-10-05T09:10:10.8728119Z # refused 422 "Invalid request ... weren't supplied" (verified
2026-10-05T09:10:10.8728690Z # from the orchestrator's box; the CI 401s masked it) -- so the
2026-10-05T09:10:10.8729283Z # create payload adds them: head is the branch the lookup below
2026-10-05T09:10:10.8729849Z # keys on, base is main. PATCH takes title and body only.
2026-10-05T09:10:10.8730399Z python3 -I - "$HEAD_SHA" "$BASE_SHA" <<'PY' > /dev/null
2026-10-05T09:10:10.8730886Z import json, os, subprocess, sys
2026-10-05T09:10:10.8731300Z head, base = sys.argv[1], sys.argv[2]
2026-10-05T09:10:10.8731762Z plan = os.environ["RUNNER_TEMP"] + "/plan.json"
2026-10-05T09:10:10.8732229Z row = "tools/audit/seat/record_row.py"
2026-10-05T09:10:10.8732636Z def gen(*flags):
2026-10-05T09:10:10.8733556Z     return subprocess.run(["python3", "-I", row, *flags], check=True,
2026-10-05T09:10:10.8734177Z                           capture_output=True, text=True).stdout
2026-10-05T09:10:10.8734734Z title = gen("--print-title", "--plan-file", plan).strip()
2026-10-05T09:10:10.8735262Z body = gen("--print-body", "--plan-file", plan,
2026-10-05T09:10:10.8735723Z            "--head", head, "--base", base)
2026-10-05T09:10:10.8736169Z json.dump({"title": title, "body": body},
2026-10-05T09:10:10.8736695Z           open(os.environ["RUNNER_TEMP"] + "/payload.json", "w"))
2026-10-05T09:10:10.8737197Z json.dump({"title": title, "body": body,
2026-10-05T09:10:10.8737652Z            "head": "record/autofix", "base": "main"},
2026-10-05T09:10:10.8738177Z           open(os.environ["RUNNER_TEMP"] + "/create.json", "w"))
2026-10-05T09:10:10.8738647Z PY
2026-10-05T09:10:10.8739068Z # Open or update: the beat's own open pull request from a previous
2026-10-05T09:10:10.8739682Z # unmerged beat is updated in place (fresh rows commit, regenerated
2026-10-05T09:10:10.8740228Z # body naming the new head), never duplicated.
2026-10-05T09:10:10.8740700Z NUM=$(curl -fsS -H "$AUTH" -H "$ACCEPT" \
2026-10-05T09:10:10.8741219Z   "$API/repos/$REPO/pulls?head=$REPO:record/autofix&state=open" \
2026-10-05T09:10:10.8741920Z   | python3 -I -c 'import sys,json; a=json.load(sys.stdin); print(a[0]["number"] if a else "")')
2026-10-05T09:10:10.8742516Z if [ -n "$NUM" ]; then
2026-10-05T09:10:10.8742902Z   curl_json "record-pr update" PATCH \
2026-10-05T09:10:10.8743736Z     "$RUNNER_TEMP/payload.json" "$API/repos/$REPO/pulls/$NUM"
2026-10-05T09:10:10.8744203Z else
2026-10-05T09:10:10.8744536Z   curl_json "record-pr open" POST \
2026-10-05T09:10:10.8744996Z     "$RUNNER_TEMP/create.json" "$API/repos/$REPO/pulls"
2026-10-05T09:10:10.8745713Z   NUM=$(python3 -I -c 'import json,os; print(json.load(open(os.environ["RUNNER_TEMP"]+"/resp.json"))["number"])')
2026-10-05T09:10:10.8746347Z fi
2026-10-05T09:10:10.8746755Z # The beat's #201 coordination comment, naming the pull request it
2026-10-05T09:10:10.8747342Z # opened (delivery-status-tracking item 3); one per beat.
2026-10-05T09:10:10.8747865Z python3 -I tools/audit/seat/record_row.py \
2026-10-05T09:10:10.8748422Z   --print-comment --plan-file "$RUNNER_TEMP/plan.json" --pr "$NUM" \
2026-10-05T09:10:10.8749116Z   > "$RUNNER_TEMP/comment.md"
2026-10-05T09:10:10.8749768Z python3 -I -c 'import json,os; print(json.dumps({"body": open(os.environ["RUNNER_TEMP"]+"/comment.md").read()}))' \
2026-10-05T09:10:10.8750441Z   > "$RUNNER_TEMP/comment.json"
2026-10-05T09:10:10.8750858Z curl_json "record-pr comment" POST \
2026-10-05T09:10:10.8751377Z   "$RUNNER_TEMP/comment.json" "$API/repos/$REPO/issues/201/comments"
2026-10-05T09:10:10.8751953Z echo "pr=$NUM" >> "$GITHUB_OUTPUT"
