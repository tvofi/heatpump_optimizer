2026-11-27T10:29:41.4699819Z ##[group]Run if [ "pull_request" = "pull_request" ]; then
2026-11-27T10:29:41.4700077Z if [ "pull_request" = "pull_request" ]; then
2026-11-27T10:29:41.4700302Z   # The PR's merge-base with its target: exactly the code this
2026-11-27T10:29:41.4700550Z   # PR forked from, so the drift comparison isolates the PR.
2026-11-27T10:29:41.4700770Z   REF=$(git merge-base "origin/main" HEAD)
2026-11-27T10:29:41.4700996Z   # The branch's OWN claim list is read from the PR head, not the
2026-11-27T10:29:41.4701256Z   # synthetic merge tree this checkout is (env_drift's CLAIM_HEAD).
2026-11-27T10:29:41.4701551Z   echo "CLAIM_HEAD=a8dff54818f8749246fffb9e18344dbbb1318735" >> "$GITHUB_ENV"
2026-11-27T10:29:41.4701804Z elif [ "pull_request" = "merge_group" ]; then
2026-11-27T10:29:41.4702383Z   # A queue entry is a merge commit (merge method MERGE): its first
2026-11-27T10:29:41.4702661Z   # parent is the main tip or the entry ahead of it, its second the
2026-11-27T10:29:41.4702914Z   # pull request's head. That is the shape of a pull request's
2026-11-27T10:29:41.4703167Z   # synthetic merge, whose merge-base with its target is the same
2026-11-27T10:29:41.4703427Z   # first parent, so the drift comparison and the claim list are
2026-11-27T10:29:41.4703683Z   # read exactly as on the pull request. No second parent means the
2026-11-27T10:29:41.4703923Z   # queue's merge method changed; fail rather than guess.
2026-11-27T10:29:41.4704170Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-11-27T10:29:41.4704431Z   PR_TIP=$(git rev-parse --verify --quiet 'HEAD^2^{commit}') || {
2026-11-27T10:29:41.4704746Z     echo "This merge_group commit has no second parent; the queue must merge with merge method MERGE."
2026-11-27T10:29:41.4705008Z     exit 1
2026-11-27T10:29:41.4705135Z   }
2026-11-27T10:29:41.4705282Z   echo "CLAIM_HEAD=${PR_TIP}" >> "$GITHUB_ENV"
2026-11-27T10:29:41.4705490Z elif [ "pull_request" = "workflow_dispatch" ]; then
2026-11-27T10:29:41.4705727Z   # Autofix dispatch is not a pull_request event. Compare against
2026-11-27T10:29:41.4705986Z   # main the same way a PR would, not HEAD^1 (the autofix commit's
2026-11-27T10:29:41.4706218Z   # parent), so leftover drift vs main cannot hide.
2026-11-27T10:29:41.4706414Z   git fetch --no-tags origin main
2026-11-27T10:29:41.4706588Z   REF=$(git merge-base origin/main HEAD)
2026-11-27T10:29:41.4706803Z elif [ "$LIGHT" = "true" ] && [ -n "$RANGE_BASE" ]; then
2026-11-27T10:29:41.4707047Z   # A light push (#3885): scoped against its range base, so the drift
2026-11-27T10:29:41.4707283Z   # comparison spans every commit the scope does.
2026-11-27T10:29:41.4707535Z   REF=$(git rev-parse --verify --quiet "${RANGE_BASE}^{commit}") || REF=""
2026-11-27T10:29:41.4707747Z else
2026-11-27T10:29:41.4707913Z   # Push to main: compare against the state before this push.
2026-11-27T10:29:41.4708168Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-11-27T10:29:41.4708372Z fi
2026-11-27T10:29:41.4708496Z if [ -z "${REF}" ]; then
2026-11-27T10:29:41.4708687Z   # An empty GOLDEN_REF is not "no preference": run.sh and
2026-11-27T10:29:41.4708931Z   # env_drift.py both fall back to origin/main, which on a push to
2026-11-27T10:29:41.4709181Z   # main IS this commit -- the tree would be compared against
2026-11-27T10:29:41.4709569Z   # itself and pass no matter what it did. Fail here instead, where
2026-11-27T10:29:41.4709778Z   # the reason is visible.
2026-11-27T10:29:41.4709982Z   echo "Could not resolve a comparison ref for this pull_request."
2026-11-27T10:29:41.4710349Z   echo "The drift gate needs a baseline that is not this commit;"
2026-11-27T10:29:41.4710596Z   echo "an empty ref silently becomes origin/main == HEAD."
2026-11-27T10:29:41.4710783Z   exit 1
2026-11-27T10:29:41.4710904Z fi
2026-11-27T10:29:41.4711047Z echo "GOLDEN_REF=${REF}" >> "$GITHUB_ENV"
