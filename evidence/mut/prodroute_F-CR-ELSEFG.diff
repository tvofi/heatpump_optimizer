   tn=$(wc -l < "$t/tpids" | tr -d ' '); kill -TERM "$rp"; wait "$rp"
   live=0; for p in $(cat "$t/tpids"); do kill -0 "$p" 2>/dev/null && live=$((live + 1)); kill -KILL "$p" 2>/dev/null; done
