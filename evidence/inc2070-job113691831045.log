2026-10-09T05:58:06.0232553Z # Under the 170-minute step timeout with room for the runs in flight
2026-10-09T05:58:06.0233032Z # (R9-F10.12): admission charges a lazy driver its run alone, so a
2026-10-09T05:58:06.0233768Z # red run's baseline and null control are paid past the deadline --
2026-10-09T05:58:06.0234247Z # boost_drift_replay.py's three runs are ~26 minutes at its recorded
2026-10-09T05:58:06.0234701Z # seconds. At 90 minutes four shards of 14 pinned 19 of #2025's 56
2026-10-09T05:58:06.0235143Z # sites, each site ~2000 s of driver work; six sites a shard fit 120
2026-10-09T05:58:06.0235573Z # (R9-CI-1). Only a base program that has a flag gets it.
2026-10-09T05:58:06.0235917Z budget=()
2026-10-09T05:58:06.0236139Z shard=()
2026-10-09T05:58:06.0236357Z run=1
2026-10-09T05:58:06.0236703Z if grep -qE '^MUTATION TABLE REFUSED -- [0-9]+ unpinned site\(s\) against' \
2026-10-09T05:58:06.0237138Z      "$RUNNER_TEMP/mutation-table.txt" \
2026-10-09T05:58:06.0237586Z    && git show "$PR_BASE":tests/mutation_table.py > tests/_mutation_table_base.py \
2026-10-09T05:58:06.0238100Z    && grep -q -- '--pin-killed' tests/_mutation_table_base.py; then
2026-10-09T05:58:06.0238530Z   echo tests/_mutation_table_base.py >> .git/info/exclude
2026-10-09T05:58:06.0238952Z   grep -q -- '--budget-minutes' tests/_mutation_table_base.py \
2026-10-09T05:58:06.0239534Z     && budget=(--budget-minutes 120)
2026-10-09T05:58:06.0239899Z   if grep -q -- '--shard' tests/_mutation_table_base.py; then
2026-10-09T05:58:06.0240260Z     shard=(--shard "$SHARD/$SHARDS")
2026-10-09T05:58:06.0240550Z   elif [ "$SHARD" != 1 ]; then
2026-10-09T05:58:06.0240822Z     run=0
2026-10-09T05:58:06.0241152Z     echo "base program has no --shard: shard 1 measures the whole pool"
2026-10-09T05:58:06.0241525Z   fi
2026-10-09T05:58:06.0241829Z   # A refusal exits non-zero; the runner's `bash -e` would end the
2026-10-09T05:58:06.0242272Z   # step there, before measurement() wrote any status, and
2026-10-09T05:58:06.0242723Z   # mutation-autofix then read a missing file as skip-no-measurement
2026-10-09T05:58:06.0243430Z   # (#2025, run 37663843895). measurement() grades the run instead.
2026-10-09T05:58:06.0244034Z   [ "$run" = 1 ] && { python3 tests/_mutation_table_base.py --pin-killed --base origin/main --jobs 3 \
2026-10-09T05:58:06.0244591Z     "${budget[@]}" "${shard[@]}" 2>&1 | tee "$RUNNER_TEMP/pin-run.txt" \
2026-10-09T05:58:06.0245027Z     || echo "pin run exited non-zero; measurement() grades it"; }
2026-10-09T05:58:06.0245367Z fi
2026-10-09T05:58:06.0245610Z rm -f tests/_mutation_table_base.py
2026-10-09T05:58:06.0245899Z [ "$run" = 1 ] || exit 0
2026-10-09T05:58:06.0246194Z python3 - "$RUNNER_TEMP" "$out" <<'PY'
2026-10-09T05:58:06.0246492Z import json, sys
2026-10-09T05:58:06.0246754Z from pathlib import Path
2026-10-09T05:58:06.0247024Z sys.path.insert(0, "tests")
2026-10-09T05:58:06.0247486Z import mutation_table
2026-10-09T05:58:06.0247798Z tmp, out = Path(sys.argv[1]), Path(sys.argv[2])
2026-10-09T05:58:06.0248133Z run = tmp / "pin-run.txt"
2026-10-09T05:58:06.0248434Z status, added = mutation_table.measurement(
2026-10-09T05:58:06.0248784Z     (tmp / "mutation-table.txt").read_text(),
2026-10-09T05:58:06.0249122Z     run.read_text() if run.exists() else None,
2026-10-09T05:58:06.0249492Z     json.loads((tmp / "ledger-before.json").read_text()),
2026-10-09T05:58:06.0249845Z     mutation_table.load_budgets())
2026-10-09T05:58:06.0250197Z (out / "pins.json").write_text(json.dumps(added, indent=2))
2026-10-09T05:58:06.0250565Z (out / "status").write_text(status + "\n")
2026-10-09T05:58:06.0250921Z print(f"measure: {status}, {len(added)} anchor(s)")
