# Fail-closed, on the paths-file step's own principle: a derivation
# that fails must fail the step, because an empty red list read from
# a failed fetch is "no reds" -- the fail-open this wiring closes.
gh api --paginate \
  "repos/${GITHUB_REPOSITORY}/commits/${PR_HEAD}/check-runs" \
  --jq '.check_runs[]
         | select(.status == "completed" and .conclusion == "failure")
         | select(.name != "pr-contract")
         | .name' | sort -u > /tmp/pr-reds.txt
printf 'red checks the body must answer: %s\n' \
