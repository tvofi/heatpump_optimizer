    --pr-body /tmp/pr-body.md --head "$PR_HEAD" --title "$PR_TITLE" \
    --author "$(cat /tmp/pr-author.txt)" \
    --paths-file /tmp/pr-files.txt --existing-file /tmp/pr-existing.txt \
    "${RED_ARGS[@]}"
fi
