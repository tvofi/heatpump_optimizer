##[group]Run set -euo pipefail
set -euo pipefail
# --no-renames, and it is not cosmetic: a rename is reported by its
# DESTINATION only, so moving CLAUDE.md to RENAMED.md yields a list
# matching no glob and the approval gate would not fire on the change
# that removed a policy file. Measured both ways before wiring it.
git diff --no-renames --name-only "$PR_BASE...$PR_HEAD" > /tmp/pr-files.txt
wc -l < /tmp/pr-files.txt
# The same diff less its additions: what the base already had. A
# reporter that grades `main` is exempt from `## Red checks` only
# while the diff touches none of its inputs, and a delivery row the
# pull request ADDS (its own) is not one; a row it edits or deletes is.
git diff --no-renames --name-only --diff-filter=a "$PR_BASE...$PR_HEAD" > /tmp/pr-existing.txt
