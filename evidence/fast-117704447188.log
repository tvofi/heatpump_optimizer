2026-10-18T14:45:17.3949212Z ##[group]Run if [ "pull_request" = "pull_request" ]; then
2026-10-18T14:45:17.3949668Z if [ "pull_request" = "pull_request" ]; then
2026-10-18T14:45:17.3950045Z   # The PR's merge-base with its target: exactly the code this
2026-10-18T14:45:17.3950456Z   # PR forked from, so the drift comparison isolates the PR.
2026-10-18T14:45:17.3950835Z   REF=$(git merge-base "origin/main" HEAD)
2026-10-18T14:45:17.3951202Z   # The branch's OWN claim list is read from the PR head, not the
2026-10-18T14:45:17.3951638Z   # synthetic merge tree this checkout is (env_drift's CLAIM_HEAD).
2026-10-18T14:45:17.3952121Z   echo "CLAIM_HEAD=36723a96968fc49768a09b32dc53f15ae16f7ab9" >> "$GITHUB_ENV"
2026-10-18T14:45:17.3952577Z elif [ "pull_request" = "merge_group" ]; then
2026-10-18T14:45:17.3952951Z   # A queue entry is a merge commit (merge method MERGE): its first
2026-10-18T14:45:17.3953414Z   # parent is the main tip or the entry ahead of it, its second the
2026-10-18T14:45:17.3953826Z   # pull request's head. That is the shape of a pull request's
2026-10-18T14:45:17.3954237Z   # synthetic merge, whose merge-base with its target is the same
2026-10-18T14:45:17.3954658Z   # first parent, so the drift comparison and the claim list are
2026-10-18T14:45:17.3955072Z   # read exactly as on the pull request. No second parent means the
2026-10-18T14:45:17.3955470Z   # queue's merge method changed; fail rather than guess.
2026-10-18T14:45:17.3955873Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-18T14:45:17.3956303Z   PR_TIP=$(git rev-parse --verify --quiet 'HEAD^2^{commit}') || {
2026-10-18T14:45:17.3956814Z     echo "This merge_group commit has no second parent; the queue must merge with merge method MERGE."
2026-10-18T14:45:17.3957246Z     exit 1
2026-10-18T14:45:17.3957462Z   }
2026-10-18T14:45:17.3957703Z   echo "CLAIM_HEAD=${PR_TIP}" >> "$GITHUB_ENV"
2026-10-18T14:45:17.3958002Z elif [ "" = "true" ]; then
2026-10-18T14:45:17.3958335Z   # Autofix dispatch is not a pull_request event. Compare against
2026-10-18T14:45:17.3959283Z   # main the same way a PR would, not HEAD^1 (the autofix commit's
2026-10-18T14:45:17.3959896Z   # parent), so leftover drift vs main cannot hide.
2026-10-18T14:45:17.3960392Z   git fetch --no-tags origin main
2026-10-18T14:45:17.3960952Z   REF=$(git merge-base origin/main HEAD)
2026-10-18T14:45:17.3961374Z else
2026-10-18T14:45:17.3961807Z   # Push to main: compare against the state before this push.
2026-10-18T14:45:17.3962462Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-18T14:45:17.3962985Z fi
2026-10-18T14:45:17.3963285Z if [ -z "${REF}" ]; then
2026-10-18T14:45:17.3963768Z   # An empty GOLDEN_REF is not "no preference": run.sh and
2026-10-18T14:45:17.3964410Z   # env_drift.py both fall back to origin/main, which on a push to
2026-10-18T14:45:17.3965047Z   # main IS this commit -- the tree would be compared against
2026-10-18T14:45:17.3965695Z   # itself and pass no matter what it did. Fail here instead, where
2026-10-18T14:45:17.3966242Z   # the reason is visible.
2026-10-18T14:45:17.3966770Z   echo "Could not resolve a comparison ref for this pull_request."
2026-10-18T14:45:17.3967434Z   echo "The drift gate needs a baseline that is not this commit;"
2026-10-18T14:45:17.3968074Z   echo "an empty ref silently becomes origin/main == HEAD."
2026-10-18T14:45:17.3968897Z   exit 1
2026-10-18T14:45:17.3969198Z fi
2026-10-18T14:45:17.3969543Z echo "GOLDEN_REF=${REF}" >> "$GITHUB_ENV"
