2026-11-27T10:12:00.4066721Z ##[group]Run if [ "pull_request" = "pull_request" ]; then
2026-11-27T10:12:00.4067115Z if [ "pull_request" = "pull_request" ]; then
2026-11-27T10:12:00.4067465Z   # The PR's merge-base with its target: exactly the code this
2026-11-27T10:12:00.4067846Z   # PR forked from, so the drift comparison isolates the PR.
2026-11-27T10:12:00.4068190Z   REF=$(git merge-base "origin/main" HEAD)
2026-11-27T10:12:00.4068534Z   # The branch's OWN claim list is read from the PR head, not the
2026-11-27T10:12:00.4068964Z   # synthetic merge tree this checkout is (env_drift's CLAIM_HEAD).
2026-11-27T10:12:00.4069399Z   echo "CLAIM_HEAD=a8dff54818f8749246fffb9e18344dbbb1318735" >> "$GITHUB_ENV"
2026-11-27T10:12:00.4069769Z elif [ "pull_request" = "merge_group" ]; then
2026-11-27T10:12:00.4070104Z   # A queue entry is a merge commit (merge method MERGE): its first
2026-11-27T10:12:00.4070537Z   # parent is the main tip or the entry ahead of it, its second the
2026-11-27T10:12:00.4070924Z   # pull request's head. That is the shape of a pull request's
2026-11-27T10:12:00.4071313Z   # synthetic merge, whose merge-base with its target is the same
2026-11-27T10:12:00.4071707Z   # first parent, so the drift comparison and the claim list are
2026-11-27T10:12:00.4072106Z   # read exactly as on the pull request. No second parent means the
2026-11-27T10:12:00.4072490Z   # queue's merge method changed; fail rather than guess.
2026-11-27T10:12:00.4072880Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-11-27T10:12:00.4073294Z   PR_TIP=$(git rev-parse --verify --quiet 'HEAD^2^{commit}') || {
2026-11-27T10:12:00.4073781Z     echo "This merge_group commit has no second parent; the queue must merge with merge method MERGE."
2026-11-27T10:12:00.4074306Z     exit 1
2026-11-27T10:12:00.4074446Z   }
2026-11-27T10:12:00.4074598Z   echo "CLAIM_HEAD=${PR_TIP}" >> "$GITHUB_ENV"
2026-11-27T10:12:00.4074809Z elif [ "pull_request" = "workflow_dispatch" ]; then
2026-11-27T10:12:00.4075049Z   # Autofix dispatch is not a pull_request event. Compare against
2026-11-27T10:12:00.4075306Z   # main the same way a PR would, not HEAD^1 (the autofix commit's
2026-11-27T10:12:00.4075545Z   # parent), so leftover drift vs main cannot hide.
2026-11-27T10:12:00.4075744Z   git fetch --no-tags origin main
2026-11-27T10:12:00.4075920Z   REF=$(git merge-base origin/main HEAD)
2026-11-27T10:12:00.4076125Z elif [ "$LIGHT" = "true" ] && [ -n "$RANGE_BASE" ]; then
2026-11-27T10:12:00.4076374Z   # A light push (#3885): scoped against its range base, so the drift
2026-11-27T10:12:00.4076614Z   # comparison spans every commit the scope does.
2026-11-27T10:12:00.4076862Z   REF=$(git rev-parse --verify --quiet "${RANGE_BASE}^{commit}") || REF=""
2026-11-27T10:12:00.4077081Z else
2026-11-27T10:12:00.4077247Z   # Push to main: compare against the state before this push.
2026-11-27T10:12:00.4077500Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-11-27T10:12:00.4077699Z fi
2026-11-27T10:12:00.4077824Z if [ -z "${REF}" ]; then
2026-11-27T10:12:00.4078016Z   # An empty GOLDEN_REF is not "no preference": run.sh and
2026-11-27T10:12:00.4078407Z   # env_drift.py both fall back to origin/main, which on a push to
2026-11-27T10:12:00.4078656Z   # main IS this commit -- the tree would be compared against
2026-11-27T10:12:00.4078911Z   # itself and pass no matter what it did. Fail here instead, where
2026-11-27T10:12:00.4079121Z   # the reason is visible.
2026-11-27T10:12:00.4079321Z   echo "Could not resolve a comparison ref for this pull_request."
2026-11-27T10:12:00.4079702Z   echo "The drift gate needs a baseline that is not this commit;"
2026-11-27T10:12:00.4079952Z   echo "an empty ref silently becomes origin/main == HEAD."
2026-11-27T10:12:00.4080145Z   exit 1
2026-11-27T10:12:00.4080262Z fi
2026-11-27T10:12:00.4080400Z echo "GOLDEN_REF=${REF}" >> "$GITHUB_ENV"
