+    )
+    boost_mod.held_for(arb_coord).set("dhw", True, boost_mod.dt_util.now(), block=True)
+    arb_held = arb.state_for(arb_coord)
+    asyncio.run(arb._arbitrate(arb_coord, arb_held, warm, "observe", boost_mod.dt_util.now()))
+    check(
