2026-10-09T06:42:52.1167468Z # Under the 170-minute step timeout with room for the runs in flight
2026-10-09T06:42:52.1167969Z # (R9-F10.12): admission charges a lazy driver its run alone, so a
2026-10-09T06:42:52.1168467Z # red run's baseline and null control are paid past the deadline --
2026-10-09T06:42:52.1168957Z # boost_drift_replay.py's three runs are ~26 minutes at its recorded
2026-10-09T06:42:52.1169419Z # seconds. At 90 minutes four shards of 14 pinned 19 of #2025's 56
2026-10-09T06:42:52.1169872Z # sites, each site ~2000 s of driver work; six sites a shard fit 120
2026-10-09T06:42:52.1170299Z # (R9-CI-1). Only a base program that has a flag gets it.
2026-10-09T06:42:52.1170852Z budget=()
2026-10-09T06:42:52.1171080Z shard=()
2026-10-09T06:42:52.1171295Z run=1
2026-10-09T06:42:52.1171656Z if grep -qE '^MUTATION TABLE REFUSED -- [0-9]+ unpinned site\(s\) against' \
2026-10-09T06:42:52.1172090Z      "$RUNNER_TEMP/mutation-table.txt" \
2026-10-09T06:42:52.1172538Z    && git show "$PR_BASE":tests/mutation_table.py > tests/_mutation_table_base.py \
2026-10-09T06:42:52.1173055Z    && grep -q -- '--pin-killed' tests/_mutation_table_base.py; then
2026-10-09T06:42:52.1173703Z   echo tests/_mutation_table_base.py >> .git/info/exclude
2026-10-09T06:42:52.1174134Z   grep -q -- '--budget-minutes' tests/_mutation_table_base.py \
2026-10-09T06:42:52.1174518Z     && budget=(--budget-minutes 120)
2026-10-09T06:42:52.1174888Z   if grep -q -- '--shard' tests/_mutation_table_base.py; then
2026-10-09T06:42:52.1175250Z     shard=(--shard "$SHARD/$SHARDS")
2026-10-09T06:42:52.1175545Z   elif [ "$SHARD" != 1 ]; then
2026-10-09T06:42:52.1175814Z     run=0
2026-10-09T06:42:52.1176166Z     echo "base program has no --shard: shard 1 measures the whole pool"
2026-10-09T06:42:52.1176544Z   fi
2026-10-09T06:42:52.1176851Z   # A refusal exits non-zero; the runner's `bash -e` would end the
2026-10-09T06:42:52.1177297Z   # step there, before measurement() wrote any status, and
2026-10-09T06:42:52.1177765Z   # mutation-autofix then read a missing file as skip-no-measurement
2026-10-09T06:42:52.1178240Z   # (#2025, run 37663843895). measurement() grades the run instead.
2026-10-09T06:42:52.1178794Z   [ "$run" = 1 ] && { python3 tests/_mutation_table_base.py --pin-killed --base origin/main --jobs 3 \
2026-10-09T06:42:52.1179354Z     "${budget[@]}" "${shard[@]}" 2>&1 | tee "$RUNNER_TEMP/pin-run.txt" \
2026-10-09T06:42:52.1179792Z     || echo "pin run exited non-zero; measurement() grades it"; }
2026-10-09T06:42:52.1180142Z fi
2026-10-09T06:42:52.1180383Z rm -f tests/_mutation_table_base.py
