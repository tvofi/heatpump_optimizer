2026-10-09T11:41:17.6490237Z # Under the 170-minute step timeout with room for the runs in flight
2026-10-09T11:41:17.6490745Z # (R9-F10.12): admission charges a lazy driver its run alone, so a
2026-10-09T11:41:17.6491258Z # red run's baseline and null control are paid past the deadline --
2026-10-09T11:41:17.6491759Z # boost_drift_replay.py's three runs are ~26 minutes at its recorded
2026-10-09T11:41:17.6492556Z # seconds. At 90 minutes four shards of 14 pinned 19 of #2025's 56
2026-10-09T11:41:17.6493047Z # sites, each site ~2000 s of driver work; six sites a shard fit 120
2026-10-09T11:41:17.6493497Z # (R9-CI-1). Only a base program that has a flag gets it.
2026-10-09T11:41:17.6493841Z budget=()
2026-10-09T11:41:17.6494061Z shard=()
2026-10-09T11:41:17.6494266Z run=1
2026-10-09T11:41:17.6494622Z if grep -qE '^MUTATION TABLE REFUSED -- [0-9]+ unpinned site\(s\) against' \
2026-10-09T11:41:17.6495073Z      "$RUNNER_TEMP/mutation-table.txt" \
2026-10-09T11:41:17.6495708Z    && git show "$PR_BASE":tests/mutation_table.py > tests/_mutation_table_base.py \
2026-10-09T11:41:17.6496245Z    && grep -q -- '--pin-killed' tests/_mutation_table_base.py; then
2026-10-09T11:41:17.6496731Z   echo tests/_mutation_table_base.py >> .git/info/exclude
2026-10-09T11:41:17.6497182Z   grep -q -- '--budget-minutes' tests/_mutation_table_base.py \
2026-10-09T11:41:17.6497576Z     && budget=(--budget-minutes 120)
2026-10-09T11:41:17.6497947Z   if grep -q -- '--shard' tests/_mutation_table_base.py; then
2026-10-09T11:41:17.6498331Z     shard=(--shard "$SHARD/$SHARDS")
2026-10-09T11:41:17.6498620Z   elif [ "$SHARD" != 1 ]; then
2026-10-09T11:41:17.6498880Z     run=0
2026-10-09T11:41:17.6499214Z     echo "base program has no --shard: shard 1 measures the whole pool"
2026-10-09T11:41:17.6499596Z   fi
2026-10-09T11:41:17.6499901Z   # A refusal exits non-zero; the runner's `bash -e` would end the
2026-10-09T11:41:17.6500348Z   # step there, before measurement() wrote any status, and
2026-10-09T11:41:17.6500816Z   # mutation-autofix then read a missing file as skip-no-measurement
2026-10-09T11:41:17.6501293Z   # (#2025, run 37663843895). measurement() grades the run instead.
2026-10-09T11:41:17.6501854Z   [ "$run" = 1 ] && { python3 tests/_mutation_table_base.py --pin-killed --base origin/main --jobs 3 \
2026-10-09T11:41:17.6502711Z     "${budget[@]}" "${shard[@]}" 2>&1 | tee "$RUNNER_TEMP/pin-run.txt" \
2026-10-09T11:41:17.6503171Z     || echo "pin run exited non-zero; measurement() grades it"; }
2026-10-09T11:41:17.6503521Z fi
2026-10-09T11:41:17.6503747Z rm -f tests/_mutation_table_base.py
2026-10-09T11:41:17.6504045Z [ "$run" = 1 ] || exit 0
