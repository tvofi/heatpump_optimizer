2026-10-09T05:30:05.0487440Z # Under the 170-minute step timeout with room for the runs in flight
2026-10-09T05:30:05.0487934Z # (R9-F10.12): admission charges a lazy driver its run alone, so a
2026-10-09T05:30:05.0488755Z # red run's baseline and null control are paid past the deadline --
2026-10-09T05:30:05.0489250Z # boost_drift_replay.py's three runs are ~26 minutes at its recorded
2026-10-09T05:30:05.0489726Z # seconds. At 90 minutes four shards of 14 pinned 19 of #2025's 56
2026-10-09T05:30:05.0490199Z # sites, each site ~2000 s of driver work; six sites a shard fit 120
2026-10-09T05:30:05.0490645Z # (R9-CI-1). Only a base program that has a flag gets it.
2026-10-09T05:30:05.0490986Z budget=()
2026-10-09T05:30:05.0491201Z shard=()
2026-10-09T05:30:05.0491402Z run=1
2026-10-09T05:30:05.0491748Z if grep -qE '^MUTATION TABLE REFUSED -- [0-9]+ unpinned site\(s\) against' \
2026-10-09T05:30:05.0492197Z      "$RUNNER_TEMP/mutation-table.txt" \
2026-10-09T05:30:05.0492778Z    && git show "$PR_BASE":tests/mutation_table.py > tests/_mutation_table_base.py \
2026-10-09T05:30:05.0493341Z    && grep -q -- '--pin-killed' tests/_mutation_table_base.py; then
2026-10-09T05:30:05.0493783Z   echo tests/_mutation_table_base.py >> .git/info/exclude
2026-10-09T05:30:05.0494222Z   grep -q -- '--budget-minutes' tests/_mutation_table_base.py \
2026-10-09T05:30:05.0494609Z     && budget=(--budget-minutes 120)
2026-10-09T05:30:05.0495169Z   if grep -q -- '--shard' tests/_mutation_table_base.py; then
2026-10-09T05:30:05.0495662Z     shard=(--shard "$SHARD/$SHARDS")
2026-10-09T05:30:05.0496019Z   elif [ "$SHARD" != 1 ]; then
2026-10-09T05:30:05.0496282Z     run=0
2026-10-09T05:30:05.0496620Z     echo "base program has no --shard: shard 1 measures the whole pool"
2026-10-09T05:30:05.0496995Z   fi
2026-10-09T05:30:05.0497295Z   # A refusal exits non-zero; the runner's `bash -e` would end the
2026-10-09T05:30:05.0497750Z   # step there, before measurement() wrote any status, and
2026-10-09T05:30:05.0498529Z   # mutation-autofix then read a missing file as skip-no-measurement
2026-10-09T05:30:05.0499029Z   # (#2025, run 37663843895). measurement() grades the run instead.
2026-10-09T05:30:05.0499588Z   [ "$run" = 1 ] && { python3 tests/_mutation_table_base.py --pin-killed --base origin/main --jobs 3 \
2026-10-09T05:30:05.0500164Z     "${budget[@]}" "${shard[@]}" 2>&1 | tee "$RUNNER_TEMP/pin-run.txt" \
2026-10-09T05:30:05.0500613Z     || echo "pin run exited non-zero; measurement() grades it"; }
2026-10-09T05:30:05.0500960Z fi
2026-10-09T05:30:05.0501187Z rm -f tests/_mutation_table_base.py
2026-10-09T05:30:05.0501481Z [ "$run" = 1 ] || exit 0
2026-10-09T05:30:05.0501762Z python3 - "$RUNNER_TEMP" "$out" <<'PY'
