2026-10-09T05:30:05.0505090Z     json.loads((tmp / "ledger-before.json").read_text()),
2026-10-09T05:30:05.0505450Z     mutation_table.load_budgets())
2026-10-09T05:30:05.0505822Z (out / "pins.json").write_text(json.dumps(added, indent=2))
2026-10-09T05:30:05.0506198Z (out / "status").write_text(status + "\n")
2026-10-09T05:30:05.0506562Z print(f"measure: {status}, {len(added)} anchor(s)")
