-[ "$(ps -o pgid= -p $$ | tr -d ' ')" = "$$" ] || exec python3 -I -c 'import os, sys; os.setpgid(0, 0); os.execvp(sys.argv[1], sys.argv[1:])' bash "$0" "$@"  # mut:pgrp
