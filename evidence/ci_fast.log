2026-10-15T16:15:18.7739924Z ##[group]Run if [ "pull_request" = "pull_request" ]; then
2026-10-15T16:15:18.7740452Z if [ "pull_request" = "pull_request" ]; then
2026-10-15T16:15:18.7741187Z   # The PR's merge-base with its target: exactly the code this
2026-10-15T16:15:18.7741884Z   # PR forked from, so the drift comparison isolates the PR.
2026-10-15T16:15:18.7742308Z   REF=$(git merge-base "origin/main" HEAD)
2026-10-15T16:15:18.7742714Z   # The branch's OWN claim list is read from the PR head, not the
2026-10-15T16:15:18.7743196Z   # synthetic merge tree this checkout is (env_drift's CLAIM_HEAD).
2026-10-15T16:15:18.7743725Z   echo "CLAIM_HEAD=f3cbd393c8aa12ae5406b66ee894c500bac0a1cb" >> "$GITHUB_ENV"
2026-10-15T16:15:18.7744201Z elif [ "pull_request" = "merge_group" ]; then
2026-10-15T16:15:18.7744609Z   # A queue entry is a merge commit (merge method MERGE): its first
2026-10-15T16:15:18.7745110Z   # parent is the main tip or the entry ahead of it, its second the
2026-10-15T16:15:18.7745782Z   # pull request's head. That is the shape of a pull request's
2026-10-15T16:15:18.7746253Z   # synthetic merge, whose merge-base with its target is the same
2026-10-15T16:15:18.7746720Z   # first parent, so the drift comparison and the claim list are
2026-10-15T16:15:18.7747185Z   # read exactly as on the pull request. No second parent means the
2026-10-15T16:15:18.7747640Z   # queue's merge method changed; fail rather than guess.
2026-10-15T16:15:18.7748104Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-15T16:15:18.7748576Z   PR_TIP=$(git rev-parse --verify --quiet 'HEAD^2^{commit}') || {
2026-10-15T16:15:18.7749150Z     echo "This merge_group commit has no second parent; the queue must merge with merge method MERGE."
2026-10-15T16:15:18.7749639Z     exit 1
2026-10-15T16:15:18.7749867Z   }
2026-10-15T16:15:18.7750119Z   echo "CLAIM_HEAD=${PR_TIP}" >> "$GITHUB_ENV"
2026-10-15T16:15:18.7750445Z elif [ "" = "true" ]; then
2026-10-15T16:15:18.7751088Z   # Autofix dispatch is not a pull_request event. Compare against
2026-10-15T16:15:18.7751591Z   # main the same way a PR would, not HEAD^1 (the autofix commit's
2026-10-15T16:15:18.7752020Z   # parent), so leftover drift vs main cannot hide.
2026-10-15T16:15:18.7752370Z   git fetch --no-tags origin main
2026-10-15T16:15:18.7752687Z   REF=$(git merge-base origin/main HEAD)
2026-10-15T16:15:18.7752987Z else
2026-10-15T16:15:18.7753276Z   # Push to main: compare against the state before this push.
2026-10-15T16:15:18.7753735Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-15T16:15:18.7754099Z fi
2026-10-15T16:15:18.7754318Z if [ -z "${REF}" ]; then
2026-10-15T16:15:18.7754654Z   # An empty GOLDEN_REF is not "no preference": run.sh and
2026-10-15T16:15:18.7755101Z   # env_drift.py both fall back to origin/main, which on a push to
2026-10-15T16:15:18.7755697Z   # main IS this commit -- the tree would be compared against
2026-10-15T16:15:18.7756164Z   # itself and pass no matter what it did. Fail here instead, where
2026-10-15T16:15:18.7756552Z   # the reason is visible.
2026-10-15T16:15:18.7756916Z   echo "Could not resolve a comparison ref for this pull_request."
2026-10-15T16:15:18.7757384Z   echo "The drift gate needs a baseline that is not this commit;"
2026-10-15T16:15:18.7757828Z   echo "an empty ref silently becomes origin/main == HEAD."
2026-10-15T16:15:18.7758168Z   exit 1
2026-10-15T16:15:18.7758373Z fi
2026-10-15T16:15:18.7758609Z echo "GOLDEN_REF=${REF}" >> "$GITHUB_ENV"
