2026-10-09T00:38:28.8548467Z   # A queue entry is a merge commit (merge method MERGE): its first
2026-10-09T00:38:28.8549915Z   # parent is the main tip or the entry ahead of it, its second the
2026-10-09T00:38:28.8550151Z   # pull request's head. That is the shape of a pull request's
2026-10-09T00:38:28.8550388Z   # synthetic merge, whose merge-base with its target is the same
2026-10-09T00:38:28.8550625Z   # first parent, so the drift comparison and the claim list are
2026-10-09T00:38:28.8550860Z   # read exactly as on the pull request. No second parent means the
2026-10-09T00:38:28.8551085Z   # queue's merge method changed; fail rather than guess.
2026-10-09T00:38:28.8552535Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-09T00:38:28.8552774Z   PR_TIP=$(git rev-parse --verify --quiet 'HEAD^2^{commit}') || {
2026-10-09T00:38:28.8554477Z     echo "This merge_group commit has no second parent; the queue must merge with merge method MERGE."
2026-10-09T00:38:28.8554727Z     exit 1
2026-10-09T00:38:28.8556262Z   }
2026-10-09T00:38:28.8556395Z   echo "CLAIM_HEAD=${PR_TIP}" >> "$GITHUB_ENV"
2026-10-09T00:38:28.8556560Z elif [ "" = "true" ]; then
2026-10-09T00:38:28.8558086Z   # Autofix dispatch is not a pull_request event. Compare against
2026-10-09T00:38:28.8558336Z   # main the same way a PR would, not HEAD^1 (the autofix commit's
2026-10-09T00:38:28.8558551Z   # parent), so leftover drift vs main cannot hide.
2026-10-09T00:38:28.8559924Z   git fetch --no-tags origin main
2026-10-09T00:38:28.8560090Z   REF=$(git merge-base origin/main HEAD)
2026-10-09T00:38:28.8560241Z else
2026-10-09T00:38:28.8560403Z   # Push to main: compare against the state before this push.
2026-10-09T00:38:28.8560635Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-09T00:38:28.8560820Z fi
2026-10-09T00:38:28.8560938Z if [ -z "${REF}" ]; then
2026-10-09T00:38:28.8561120Z   # An empty GOLDEN_REF is not "no preference": run.sh and
2026-10-09T00:38:28.8562607Z   # env_drift.py both fall back to origin/main, which on a push to
2026-10-09T00:38:28.8562839Z   # main IS this commit -- the tree would be compared against
2026-10-09T00:38:28.8564209Z   # itself and pass no matter what it did. Fail here instead, where
2026-10-09T00:38:28.8564410Z   # the reason is visible.
2026-10-09T00:38:28.8564597Z   echo "Could not resolve a comparison ref for this pull_request."
2026-10-09T00:38:28.8564834Z   echo "The drift gate needs a baseline that is not this commit;"
2026-10-09T00:38:28.8566168Z   echo "an empty ref silently becomes origin/main == HEAD."
2026-10-09T00:38:28.8566355Z   exit 1
2026-10-09T00:38:28.8566471Z fi
2026-10-09T00:38:28.8566601Z echo "GOLDEN_REF=${REF}" >> "$GITHUB_ENV"
2026-10-09T00:38:28.8680675Z shell: /usr/bin/bash -e {0}
