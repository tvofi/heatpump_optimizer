2026-10-02T14:14:12.5117879Z set -euo pipefail
2026-10-02T14:14:12.5118176Z # Fail-closed, on the paths-file step's own principle: a derivation
2026-10-02T14:14:12.5118791Z # that fails must fail the step, because an empty red list read from
2026-10-02T14:14:12.5119162Z # a failed fetch is "no reds" -- the fail-open this wiring closes.
2026-10-02T14:14:12.5119455Z gh api --paginate \
2026-10-02T14:14:12.5119726Z   "repos/${GITHUB_REPOSITORY}/commits/${PR_HEAD}/check-runs" \
2026-10-02T14:14:12.5120029Z   --jq '.check_runs[]
2026-10-02T14:14:12.5120306Z          | select(.status == "completed" and .conclusion == "failure")
2026-10-02T14:14:12.5120636Z          | select(.name != "pr-contract")
2026-10-02T14:14:12.5120902Z          | .name' | sort -u > /tmp/pr-reds.txt
2026-10-02T14:14:12.5121221Z printf 'red checks the body must answer: %s\n' \
2026-10-02T14:14:12.5121498Z   "$(paste -sd, /tmp/pr-reds.txt)"
