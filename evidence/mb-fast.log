2026-10-28T10:16:29.3772077Z ##[group]Run if [ "push" = "pull_request" ]; then
2026-10-28T10:16:29.3772342Z if [ "push" = "pull_request" ]; then
2026-10-28T10:16:29.3772549Z   # The PR's merge-base with its target: exactly the code this
2026-10-28T10:16:29.3772800Z   # PR forked from, so the drift comparison isolates the PR.
2026-10-28T10:16:29.3773003Z   REF=$(git merge-base "origin/" HEAD)
2026-10-28T10:16:29.3773208Z   # The branch's OWN claim list is read from the PR head, not the
2026-10-28T10:16:29.3773452Z   # synthetic merge tree this checkout is (env_drift's CLAIM_HEAD).
2026-10-28T10:16:29.3773661Z   echo "CLAIM_HEAD=" >> "$GITHUB_ENV"
2026-10-28T10:16:29.3773823Z elif [ "push" = "merge_group" ]; then
2026-10-28T10:16:29.3774020Z   # A queue entry is a merge commit (merge method MERGE): its first
2026-10-28T10:16:29.3774289Z   # parent is the main tip or the entry ahead of it, its second the
2026-10-28T10:16:29.3774524Z   # pull request's head. That is the shape of a pull request's
2026-10-28T10:16:29.3774758Z   # synthetic merge, whose merge-base with its target is the same
2026-10-28T10:16:29.3775001Z   # first parent, so the drift comparison and the claim list are
2026-10-28T10:16:29.3775236Z   # read exactly as on the pull request. No second parent means the
2026-10-28T10:16:29.3775463Z   # queue's merge method changed; fail rather than guess.
2026-10-28T10:16:29.3775691Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-28T10:16:29.3775933Z   PR_TIP=$(git rev-parse --verify --quiet 'HEAD^2^{commit}') || {
2026-10-28T10:16:29.3776230Z     echo "This merge_group commit has no second parent; the queue must merge with merge method MERGE."
2026-10-28T10:16:29.3776477Z     exit 1
2026-10-28T10:16:29.3776588Z   }
2026-10-28T10:16:29.3776725Z   echo "CLAIM_HEAD=${PR_TIP}" >> "$GITHUB_ENV"
2026-10-28T10:16:29.3776912Z elif [ "push" = "workflow_dispatch" ]; then
2026-10-28T10:16:29.3777119Z   # Autofix dispatch is not a pull_request event. Compare against
2026-10-28T10:16:29.3777501Z   # main the same way a PR would, not HEAD^1 (the autofix commit's
2026-10-28T10:16:29.3777720Z   # parent), so leftover drift vs main cannot hide.
2026-10-28T10:16:29.3777904Z   git fetch --no-tags origin main
2026-10-28T10:16:29.3778066Z   REF=$(git merge-base origin/main HEAD)
2026-10-28T10:16:29.3778216Z else
2026-10-28T10:16:29.3778384Z   # Push to main: compare against the state before this push.
2026-10-28T10:16:29.3778616Z   REF=$(git rev-parse --verify --quiet 'HEAD^1^{commit}') || REF=""
2026-10-28T10:16:29.3778800Z fi
2026-10-28T10:16:29.3778909Z if [ -z "${REF}" ]; then
2026-10-28T10:16:29.3779082Z   # An empty GOLDEN_REF is not "no preference": run.sh and
2026-10-28T10:16:29.3779307Z   # env_drift.py both fall back to origin/main, which on a push to
2026-10-28T10:16:29.3779538Z   # main IS this commit -- the tree would be compared against
2026-10-28T10:16:29.3779769Z   # itself and pass no matter what it did. Fail here instead, where
2026-10-28T10:16:29.3779964Z   # the reason is visible.
2026-10-28T10:16:29.3780139Z   echo "Could not resolve a comparison ref for this push."
2026-10-28T10:16:29.3780616Z   echo "The drift gate needs a baseline that is not this commit;"
2026-10-28T10:16:29.3780842Z   echo "an empty ref silently becomes origin/main == HEAD."
2026-10-28T10:16:29.3781016Z   exit 1
2026-10-28T10:16:29.3781123Z fi
2026-10-28T10:16:29.3781248Z echo "GOLDEN_REF=${REF}" >> "$GITHUB_ENV"
