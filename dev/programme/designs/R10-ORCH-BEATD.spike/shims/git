#!/bin/bash
# Spike of tools/audit/seat/shims/git (design R10-ORCH-BEATD, never merged).
# A fetch or pull that fails on `cannot lock ref` is re-run, at most HPO_GIT_RETRIES
# (default 2) more times, 1 s then 2 s apart; every other git command is exec'd as is.
self=$(cd "$(dirname "$0")" && pwd)
real=$(IFS=:; for d in $PATH; do [ "$d" = "$self" ] && continue; [ -x "$d/git" ] && { echo "$d/git"; break; }; done)
[ -n "$real" ] || { echo "git shim: no git on PATH besides $self" >&2; exit 127; }
sub=; skip=0
for a in "$@"; do
  if [ $skip = 1 ]; then skip=0; continue; fi
  case $a in -C|-c|--git-dir|--work-tree|--namespace) skip=1;; -*) ;; *) sub=$a; break;; esac
done
case $sub in fetch|pull) ;; *) exec "$real" "$@";; esac
err=$(mktemp); n=0; max=${HPO_GIT_RETRIES:-2}
while :; do
  "$real" "$@" 2>"$err"; rc=$?
  if [ $rc = 0 ] || [ $n -ge "$max" ] || ! grep -q 'cannot lock ref' "$err"; then cat "$err" >&2; rm -f "$err"; exit $rc; fi
  n=$((n + 1))
  [ -z "${HPO_GIT_SHIM_LOG:-}" ] || printf '%s retry=%d rc=%d %s\n' "$(date -u +%FT%TZ)" "$n" "$rc" "$sub" >> "$HPO_GIT_SHIM_LOG"
  sleep $n
done
