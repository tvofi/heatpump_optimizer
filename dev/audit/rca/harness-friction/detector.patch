   const taughtWords = examples.map(([f, ex]) => [f, ex.match(/^blocked <sha> ([a-z][a-z0-9-]*):/)?.[1]]).filter(([, w]) => w)
   t('the briefs teach at least one block class word (floor, not a count)', taughtWords.length > 0, `found ${taughtWords.length}`)
