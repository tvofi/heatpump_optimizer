+    def _fixed_mode_action(self) -> CurrentAction | None:
+        """Comfort, boost or off's fixed-rule action, priced; None in a solved mode.
+
+        Built whole before it is adopted: ``boost.adopt_plan`` keeps the dict
+        as the plan base the overlay copies, so a field written onto the live
+        action afterwards landed on that base too, through the alias.
+        """
+        ctx, top = _ctx_of(self), self._ecl110_displace_max
+        # Dict literals with a literal "mode": tests/entities.py reads the
+        # action sensor's produced states off its producers' source.
+        row: dict[str, Any] | None = {
+            MODE_COMFORT: {"mode": "comfort", "power_normalized": 0.7, "heat_pump_on": True,
+                           "setpoint": ctx._opt_config.target_temp, "displace_value": min(4.0, top)},
+            MODE_BOOST: {"mode": "boost", "power_normalized": 1.0, "heat_pump_on": True,
+                         "setpoint": ctx._opt_config.max_temp, "displace_value": top},
+            MODE_OFF: {"mode": "off", "power_normalized": 0.0, "heat_pump_on": False,
+                       "setpoint": ctx._opt_config.min_temp, "displace_value": self._ecl110_displace_min},
+        }.get(self._mode)
+        if row is None:
+            return None
+        p_max = self._thermal_model.params.max_electrical_power
+        return cast(CurrentAction, {**row, "power": p_max * row["power_normalized"],
+                                    "price": self._get_current_price()})
+
