+class PriceTileRotation:
+    """#39's what-if tiles and the rotation that refreshes them, one per solve.
+
+    ``take`` hands out the next spec and moves the rotation on whatever the
+    solve then does: a consistently failing spec must not block the others,
+    so it is retried on the next pass, not at once. ``settle`` files an
+    answer (an errored one files nothing); ``retire`` drops every tile when
+    the gate closes, because stale what-if money left published would
+    outlive the user's decision to stop paying for it.
+    """
+
+    def __init__(self) -> None:
+        self.tiles: dict[str, PriceTile] = {}
+        self.cursor = 0
+
+    def take(self, specs: list[tuple[str, dict[str, Any]]]) -> tuple[str, dict[str, Any]]:
+        spec = specs[self.cursor % len(specs)]
+        self.cursor += 1
+        return spec
+
+    def settle(self, name: str, overrides: dict[str, Any], answer: Mapping[str, Any],
+               now: datetime) -> None:
+        if answer.get("error"):
+            return
+        self.tiles[name] = {
+            "overrides": overrides,
+            "monthly_cost_delta": answer.get("monthly_cost_delta"),
+            "min_room_temperature": answer.get("min_room_temperature"),
+            "computed_at": now.isoformat(timespec="seconds"),
+        }
+
+    def retire(self) -> None:
+        self.tiles.clear()
+
+
