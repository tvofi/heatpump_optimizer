+def state_power_kw(
+    state: Any, sign: Literal["signed", "clamp", "positive"] = "signed"
+) -> float | None:
+    """A power entity's live state as finite kW, or ``None``.
+
+    The one parse of a power state outside ``InputReader`` (which adds the
+    staleness and plausibility of a configured input): the state must be a
+    finite number, its declared unit one ``normalize_power_kw`` knows, and
+    the converted figure finite too -- a MW reading near the float ceiling
+    overflows on conversion. ``sign`` is the caller's policy, because the
+    meters differ in what a sign means: ``signed`` keeps it (a grid meter
+    exports below zero), ``clamp`` reads a negative as 0.0 (a production
+    meter's standby draw is no production), ``positive`` reads zero or less
+    as no reading (a ceiling cannot be zero).
+    """
+    if state is None:
+        return None
+    value = _finite(getattr(state, "state", None))
+    if value is None:
+        return None
+    kw = normalize_power_kw(value, state_unit(state))
+    if kw is None or not math.isfinite(kw):
+        return None
+    if sign == "clamp":
+        return max(0.0, kw)
+    if sign == "positive":
+        return kw if kw > 0.0 else None
+    return kw
+
+
