+// ---- Reading a published value ----------------------------------------------
+// The three rules every tab applies to what Home Assistant hands it, each in
+// one place: whether an entity has a reading at all, the token a render
+// signature keys an entity by, and whether a published value is a number.
+// Every tab's reads go through these, so the Plan chart, the headline, the
+// Advisor, Health and Setup pages cannot disagree about what "no value" is.
+
+/** The state object when the entity has a reading, else null: missing,
+ * `unavailable` and `unknown` are Home Assistant's three ways of having none. */
+function liveState(st) {
+  return st && st.state !== "unavailable" && st.state !== "unknown" ? st : null;
+}
+
+/** An entity's token in a render signature: its state and update stamp. */
+function stateSig(st) {
+  return st ? `${st.state}@${st.last_updated || ""}` : "-";
+}
+
+/** A published value as a finite number, or null. `Number(null)` and
+ * `Number("")` are 0, and 0 is finite -- without the first test a value the
+ * backend published as None would read as a measured zero. */
+function readNumber(raw) {
+  if (raw === null || raw === undefined || raw === "") return null;
+  const n = Number(raw);
+  return Number.isFinite(n) ? n : null;
+}
