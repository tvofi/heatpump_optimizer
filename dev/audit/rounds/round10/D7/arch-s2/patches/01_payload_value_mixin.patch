+class _PayloadValueMixin(_SensorMixinBase):
+    """A sensor whose state is one numeric key of the coordinator payload.
+
+    Seventeen sensors each spelled the same read -- the key, ``None`` while the
+    payload is empty or the key absent, rounded for display -- as their own
+    ``native_value``. The read is declared here once; a sensor names its key
+    and, when it is not one decimal, its precision.
+    """
+
+    #: The payload key whose value is this sensor's state.
+    _payload_key: str = ""
+    #: Decimals the published state is rounded to.
+    _payload_digits: int = 1
+
+    @property
+    def native_value(self) -> float | None:
+        val = (self.coordinator.data or {}).get(self._payload_key)
+        return round(val, self._payload_digits) if val is not None else None
+
+
