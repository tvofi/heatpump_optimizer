+class _PayloadPathMixin(_SensorMixinBase):
+    """A sensor whose state is the number at one path of the coordinator payload.
+
+    Seven advisor sensors each walked their own section of the payload and
+    kept the leaf only when it was a number. The walk and the guard are
+    declared here once: a missing or non-mapping section reads as empty, and
+    a leaf that is not one of ``_payload_types`` publishes ``None``.
+    """
+
+    #: Section keys, then the leaf key.
+    _payload_path: tuple[str, ...] = ()
+    #: The leaf types published as a state.
+    _payload_types: tuple[type[int | float], ...] = (int, float)
+
+    @property
+    def native_value(self) -> float | None:
+        node: Any = self._data()
+        for key in self._payload_path[:-1]:
+            node = node.get(key) or {}
+        value = node.get(self._payload_path[-1])
+        return value if isinstance(value, self._payload_types) else None
+
+
