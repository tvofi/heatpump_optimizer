{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Audit finder report",
  "type": "object",
  "required": ["dimension", "baseline_sha", "coverage", "unfinished", "findings", "non_findings", "harnesses", "leads"],
  "properties": {
    "dimension": {"type": "string", "pattern": "^D(1[0-7]|[0-9])$"},
    "baseline_sha": {"type": "string", "minLength": 7},
    "exposure": {"type": "string", "description": "Sources the finder had to read that carry earlier audit findings (D5/D6), or GitHub's own records (D11); empty otherwise"},
    "coverage": {
      "type": "array",
      "description": "The denominator, one row per method step of the brief this seat owns (D<k>.M<n>; COMMON.md, 'The denominator'): what the step ranges over, how much of it this seat examined, and what it did not reach. dev/audit/config/rotation.json records it and the next round's dispatch opens with not_reached",
      "items": {
        "type": "object",
        "required": ["step", "enumerator", "universe", "examined", "not_reached", "redispatched", "evidence"],
        "properties": {
          "step": {"type": "string", "pattern": "^D(1[0-7]|[0-9])\\.M[0-9]+$"},
          "enumerator": {"type": "string", "minLength": 1, "description": "The command that, run alone from the export root, prints this step's universe one item per line; where the step has no item list, the command printing the population it read"},
          "universe": {"type": "integer", "minimum": 0, "description": "Lines the enumerator printed at the baseline"},
          "examined": {"type": "integer", "minimum": 0, "description": "Items of it this seat ran the step's method on; never more than universe"},
          "not_reached": {"type": "array", "maxItems": 200, "items": {"type": "string", "minLength": 1}, "description": "Every item not examined, by the enumerator's own name for it, or by the enumerator's groups (a file, a class, a grid plane) where the items outnumber the cap; empty exactly when examined equals universe"},
          "redispatched": {"type": "array", "description": "Each item the task handed over from the round before (its C<n> id), and whether it was examined this time", "items": {"type": "object", "required": ["item", "state"], "properties": {"item": {"type": "string", "pattern": "^C[0-9]+$"}, "state": {"enum": ["examined", "not_reached"]}}}},
          "evidence": {"type": "string"}
        }
      }
    },
    "unfinished": {
      "type": "array",
      "description": "Steps this seat could not finish, and what is left; the next round's dispatch hands each back as first work",
      "items": {
        "type": "object",
        "required": ["step", "what"],
        "properties": {"step": {"type": "string", "pattern": "^D(1[0-7]|[0-9])\\.M[0-9]+$"}, "what": {"type": "string"}}
      }
    },
    "findings": {"type": "array", "items": {"$ref": "#/definitions/finding"}},
    "non_findings": {
      "type": "array",
      "description": "What was checked and held, each with the executed number that showed it",
      "items": {
        "type": "object",
        "required": ["claim", "command", "value"],
        "properties": {"claim": {"type": "string"}, "command": {"type": "string"}, "value": {"type": "string"}}
      }
    },
    "harnesses": {"type": "array", "items": {"type": "string", "pattern": "^(?:tools/audit/round|dev/audit/rounds/round)[0-9]+/D(1[0-7]|[0-9])/"}},
    "leads": {
      "type": "array",
      "description": "What this seat noticed outside its cells (COMMON.md, the scope wall): not a finding and no harness. The driver routes each to the leads seat, which converts one only with an executed number",
      "items": {
        "type": "object",
        "required": ["owner_seat", "file", "symbol", "what"],
        "properties": {"owner_seat": {"type": "string", "pattern": "^(D(1[0-7]|[0-9])-s[0-9]+|unknown)$", "description": "The seat whose cells hold it (check_scopes.py --seat lists a seat's cells), or unknown"}, "file": {"type": "string"}, "symbol": {"type": "string"}, "what": {"type": "string"}}
      }
    }
  },
  "definitions": {
    "evidence": {
      "type": "object",
      "required": ["command", "harness_path", "value", "unit", "baseline_sha", "machine", "cpu_or_wall", "contention_note", "tolerance", "load1", "thread_factor"],
      "properties": {
        "command": {"type": "string"},
        "harness_path": {"type": "string", "pattern": "^(?:tools/audit/round|dev/audit/rounds/round)[0-9]+/D(1[0-7]|[0-9])/"},
        "value": {"type": ["number", "string"]},
        "unit": {"type": "string"},
        "baseline_sha": {"type": "string"},
        "machine": {"type": "string"},
        "cpu_or_wall": {"enum": ["cpu", "wall", "count", "bytes", "ratio", "n/a"]},
        "contention_note": {"type": "string", "description": "What else was running; 'quiet' only for a quiet-window re-take"},
        "tolerance": {"type": "string", "description": "e.g. '±3 %' or 'exact'"},
        "load1": {"type": "number"},
        "thread_factor": {"type": "number"}
      }
    },
    "finding": {
      "type": "object",
      "required": ["id", "scope", "step", "title", "severity", "claim", "evidence", "instrumented_symbol", "perturbation", "metric_definition", "phenomenon_property", "seam_rule", "stop_rule_class", "class_guess", "files", "proposed_fix_scope"],
      "properties": {
        "id": {"type": "string", "pattern": "^D(1[0-7]|[0-9])(-s[0-9]+)?-[0-9]{2}$", "description": "D<k>-<nn>, or D<k>-s<seat>-<nn> when a round runs more than one finder seat per dimension"},
        "scope": {"type": "string", "pattern": "^D(1[0-7]|[0-9])-s[0-9]+$", "description": "The finder seat whose cells the finding measures, a seat of dev/audit/config/scopes.json; the finding's id starts with it"},
        "step": {"type": "string", "pattern": "^D(1[0-7]|[0-9])\\.M[0-9]+$", "description": "The brief's method step the finding came from"},
        "title": {"type": "string", "maxLength": 120},
        "severity": {"enum": ["critical", "high", "medium", "low"]},
        "claim": {"type": "string", "description": "One sentence, falsifiable"},
        "mechanism": {"type": "string"},
        "evidence": {"$ref": "#/definitions/evidence"},
        "instrumented_symbol": {"type": "string", "description": "module:symbol the harness hooks"},
        "perturbation": {
          "type": "object",
          "required": ["change", "expected_direction"],
          "properties": {"change": {"type": "string"}, "expected_direction": {"enum": ["up", "down", "to_zero", "sign_flip"]}, "observed_value": {"type": ["number", "string"]}}
        },
        "metric_definition": {"type": "string", "maxLength": 200},
        "phenomenon_property": {"type": "string", "description": "The phenomenon stated as a property; the fixer is held to it, not the block's text (fixer.md step 8)"},
        "seam_rule": {"type": "string", "description": "The command that enumerates the class's seams, in the same form as harness_path"},
        "null_control": {"type": "object", "properties": {"command": {"type": "string"}, "value": {"type": ["number", "string"]}, "note": {"type": "string"}}},
        "leave_one_out": {"type": "object", "properties": {"cells": {"type": "integer", "minimum": 5}, "min": {"type": "number"}, "max": {"type": "number"}, "drop_most_favourable": {"type": "number"}}},
        "reproduction_steps": {"type": "array", "items": {"type": "string"}},
        "proposed_fix_scope": {"type": "string"},
        "files": {"type": "array", "items": {"type": "string"}},
        "expected_golden_drift": {"type": "array", "items": {"type": "string"}},
        "stop_rule_class": {"enum": ["bug", "hygiene"]},
"class_guess": {"enum": ["P1", "P2", "P3", "P4", "P5", "P6", "P7", "P8", "P9", "P10", "I1", "I2", "I3", "I4", "I5", "N-future-instant", "P11", "N-restart", "N-solve-recompute", "N-structure-blind", "N-name-sort", "N-shared-config", "N-approval-rebuy", "N-finally-return", "N-step-grid", "N-reap-lock", "N-staleness", "N-silent-zero", "N-orphaned-handoff", "N-postreview-merge-red", "R9-ROW-STALE", "N-registry-leak", "N-future-clamp", "N-no-expiry", "N-log-flood", "N-gate-yield", "N-move-stale-path", "N-period-rollover", "N-confounded-learner", "N-leaf-imports-solver", "N-order-coupling", "N-restore-race", "N-silent-stop", "N-body-lint-bounce", "N-train-only-predicate", "N-p2b-assembly-reader", "N-vocabulary-drift", "N-unmetered-reference", "N-livehead-operator-cancel", "N-dispatch-overreach", "R10-TOPIC-FAMILY", "N-relay-handoff-starvation", "N-stamp-claim-conflict", "R10-SELFTEST-RED-INTRODUCED", "N-provisional-gate-red-read-final", "new"], "description": "The finder's guess at the bug class: an id in dev/audit/config/bugclasses.json, or new. The verifier's V3 lens confirms or corrects it; the judge assigns the class. The enum is exactly that file's ids plus new (check-wave-script.mjs holds the two equal), so a class the judge adds lands in both in one pull request"}
      },
      "allOf": [
        {
          "if": {"properties": {"evidence": {"properties": {"cpu_or_wall": {"enum": ["cpu", "wall"]}}}}},
          "then": {"required": ["null_control"]}
        }
      ]
    }
  }
}
